+  private rememberReplyContext(threadId: string, msgId?: string): void {
+    if (!msgId) return;
+    const now = Date.now();
+    for (const [key, context] of this.replyContexts) {
+      if (context.expiresAt <= now) this.replyContexts.delete(key);
+    }
+    // A repeated delivery must not reset msg_seq or extend its reply window.
+    if (this.replyContexts.get(threadId)?.msgId === msgId) return;
+    this.replyContexts.delete(threadId);
+    if (this.replyContexts.size >= 1024) {
+      const oldest = this.replyContexts.keys().next().value;
+      if (oldest !== undefined) this.replyContexts.delete(oldest);
+    }
+    this.replyContexts.set(threadId, { expiresAt: now + 5 * 60_000, msgId, seq: 0 });
+  }
+
+  private nextReplyOptions(threadId: string): { msgId: string; msgSeq: number } | undefined {
+    const context = this.replyContexts.get(threadId);
+    if (!context) return undefined;
+    if (context.expiresAt <= Date.now()) {
+      this.replyContexts.delete(threadId);
+      return undefined;
+    }
+    // Reserve before awaiting HTTP so concurrent posts cannot reuse a sequence.
+    return { msgId: context.msgId, msgSeq: ++context.seq };
   }
 
