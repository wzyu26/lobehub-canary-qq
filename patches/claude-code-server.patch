+import { describe, expect, it } from 'vitest';
+
+import { DurableEventGuard } from './durableEventGuard';
+import type { AgentStreamEvent } from './types';
+
+describe('durable worker delivery', () => {
+  it('deduplicates replay even when gateway envelope IDs change, scoped by operation', () => {
+    const guard = new DurableEventGuard();
+    const event = { data: { claudeCodeSequence: 1 }, operationId: 'one' } as AgentStreamEvent;
+    expect(guard.accept(event)).toBe(true);
+    expect(guard.accept({ ...event, id: 'different-gateway-id' })).toBe(false);
+    expect(guard.accept({ ...event, operationId: 'two' })).toBe(true);
+    expect(guard.accept({ ...event, data: { claudeCodeSequence: 2 } })).toBe(true);
+    expect(guard.accept(event)).toBe(false);
+  });
+
+  it('preserves existing API and external coding agent events', () => {
+    const guard = new DurableEventGuard();
+    const event = { data: { content: 'a' }, operationId: 'api' } as AgentStreamEvent;
+    expect(guard.accept(event)).toBe(true);
+    expect(guard.accept(event)).toBe(true);
+  });
+});
