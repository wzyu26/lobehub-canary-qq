@@ -0,0 +1,96 @@
+import path from 'node:path';
+
+/** Ordinary LobeHub assistants use the user's saved CLI login, never API provider credentials. */
+export type SpawnIntegrationMode = 'lobehub-assistant';
+
+const ASSISTANT_ENV_KEYS = new Set([
+  'CLAUDE_CONFIG_DIR',
+  'COMSPEC',
+  'HOME',
+  'LANG',
+  'LC_ALL',
+  'LC_CTYPE',
+  'LOGNAME',
+  'PATH',
+  'PATHEXT',
+  'SHELL',
+  'SYSTEMROOT',
+  'TEMP',
+  'TMP',
+  'TMPDIR',
+  'TZ',
+  'USER',
+  'USERPROFILE',
+  'WINDIR',
+]);
+
+// Caller-supplied arguments are service-owned, but an accidental --settings,
+// --bare, plugin or provider flag must not override the subscription boundary.
+const ASSISTANT_VALUE_FLAGS = new Set([
+  '--append-system-prompt',
+  '--append-system-prompt-file',
+  '--effort',
+  '--max-turns',
+  '--mcp-config',
+  '--model',
+  '--session-id',
+  '--system-prompt',
+  '--system-prompt-file',
+]);
+
+const SESSION_ID = /^[\da-f]{8}-[\da-f]{4}-[\da-f]{4}-[\da-f]{4}-[\da-f]{12}$/i;
+
+export const assertAssistantSessionId = (sessionId: string): void => {
+  if (!SESSION_ID.test(sessionId)) {
+    throw new Error('Claude Code assistant sessions must use a server-assigned UUID');
+  }
+};
+
+export const assertAssistantArgs = (args: readonly string[]): void => {
+  for (let index = 0; index < args.length; index += 1) {
+    const argument = args[index];
+    const separator = argument.indexOf('=');
+    const flag = separator === -1 ? argument : argument.slice(0, separator);
+    if (!ASSISTANT_VALUE_FLAGS.has(flag)) {
+      throw new Error(`Unsupported Claude Code assistant flag: ${flag}`);
+    }
+
+    const value = separator === -1 ? args[++index] : argument.slice(separator + 1);
+    if (!value || value.startsWith('-')) {
+      throw new Error(`Claude Code assistant flag requires a value: ${flag}`);
+    }
+    if (flag === '--session-id') assertAssistantSessionId(value);
+  }
+};
+
+/** No inherited values, provider presets, OAuth tokens, or LobeHub bearer tokens enter the CLI. */
+export const buildAssistantEnvironment = (
+  env: Readonly<Record<string, string>> = {},
+): NodeJS.ProcessEnv => {
+  const result: Record<string, string | undefined> = {};
+  for (const [key, value] of Object.entries(env)) {
+    if (!ASSISTANT_ENV_KEYS.has(key.toUpperCase())) {
+      // Report only the key: rejected values may be secrets.
+      throw new Error(`Unsupported Claude Code assistant environment variable: ${key}`);
+    }
+    result[key] = value;
+  }
+
+  for (const key of ['HOME', 'CLAUDE_CONFIG_DIR'] as const) {
+    if (!env[key] || !path.isAbsolute(env[key])) {
+      throw new Error(`Claude Code assistant requires an explicit absolute ${key}`);
+    }
+  }
+
+  // These are launcher-owned values, never inherited from the API host.
+  result.MCP_CONNECTION_NONBLOCKING = 'false';
+  result.DISABLE_AUTOUPDATER = '1';
+  result.DISABLE_UPDATES = '1';
+  result.CLAUDE_CODE_DISABLE_AUTO_MEMORY = '1';
+  result.CLAUDE_CODE_RESUME_INTERRUPTED_TURN = '0';
+  // The web app augments ProcessEnv with required browser build settings;
+  // those settings are deliberately absent from this child process.
+  return result as NodeJS.ProcessEnv;
+};
+
+export const ASSISTANT_ISOLATION_ARGS = ['--setting-sources', '', '--strict-mcp-config'] as const;
