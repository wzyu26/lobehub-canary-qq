@@ -0,0 +1,28 @@
+import { spawnSync } from 'node:child_process';
+import { cp, mkdir, realpath } from 'node:fs/promises';
+import { createRequire } from 'node:module';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+import { assertWorkerStartup } from './smokeWorkerStartup.mjs';
+
+const workerRoot = fileURLToPath(new URL('../', import.meta.url));
+const outputDirectory = path.resolve(process.argv[2] ?? path.join(workerRoot, 'dist'));
+// Bun 1.4.4 can evaluate the MCP schema module before bundled Zod constructors
+// initialize. Keep Zod's own ESM boundaries and ship the installed package.
+const built = spawnSync(process.execPath, [
+  'build', path.join(workerRoot, 'src/index.ts'), '--target=bun', '--external=zod',
+  `--outdir=${outputDirectory}`,
+], { cwd: workerRoot, stdio: 'inherit' });
+if (built.error || built.status !== 0) throw new Error('Worker bundle build failed');
+
+const require = createRequire(import.meta.url);
+const zodDirectory = path.dirname(await realpath(require.resolve('zod/package.json')));
+await mkdir(path.join(outputDirectory, 'node_modules'), { recursive: true });
+await cp(zodDirectory, path.join(outputDirectory, 'node_modules/zod'), {
+  dereference: true,
+  force: true,
+  recursive: true,
+});
+assertWorkerStartup(path.join(outputDirectory, 'index.js'));
+console.info('Worker bundle and runtime dependency startup verified');
