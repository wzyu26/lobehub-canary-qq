new file mode 100644
index 0000000000..5f75d3b3b2
--- /dev/null
+++ b/apps/claude-code-worker/src/toolBridge.ts
@@ -0,0 +1,80 @@
+import { setTimeout as delay } from 'node:timers/promises';
+
+import type { AgentStreamEvent } from '@lobechat/agent-gateway-client';
+import type {
+  ClaudeCodeAssistantTool,
+  ClaudeCodeWorkerToolResponse,
+  ClaudeCodeWorkerToolResult,
+} from '@lobechat/heterogeneous-agents/protocol';
+
+import type { WorkerApi } from './api';
+import { runRoute, WorkerApiError } from './api';
+
+export const awaitToolResult = async (
+  api: WorkerApi,
+  operationId: string,
+  request: { args: Record<string, unknown>; leaseToken: string; name: string; toolCallId: string },
+  signal: AbortSignal,
+): Promise<ClaudeCodeWorkerToolResult> => {
+  while (true) {
+    signal.throwIfAborted();
+    let response: ClaudeCodeWorkerToolResponse;
+    try {
+      response = await api.post<ClaudeCodeWorkerToolResponse>(
+        runRoute(operationId, 'tool'),
+        request,
+        signal,
+      );
+    } catch (error) {
+      signal.throwIfAborted();
+      if (error instanceof WorkerApiError && error.status < 500 && error.status !== 429)
+        throw error;
+      // A lost reply may follow a successful write. Only the same receipt ID
+      // may be retried; never tell the model to submit a new operation.
+      await delay(500, undefined, { signal });
+      continue;
+    }
+    if (response.status === 'completed' && response.result) return response.result;
+    if (response.status !== 'pending') throw new Error('LobeHub tool execution was interrupted');
+    await delay(500, undefined, { signal });
+  }
+};
+
+/** Only names registered for this operation may acquire a native LobeHub card. */
+export const mapToolEvent = (
+  event: AgentStreamEvent,
+  tools: readonly ClaudeCodeAssistantTool[],
+  results: ReadonlyMap<string, ClaudeCodeWorkerToolResult>,
+): AgentStreamEvent => {
+  const registered = new Map(tools.map((tool) => [`mcp__lobe_cc__${tool.name}`, tool]));
+  const mapCalling = (calling: Record<string, unknown>) => {
+    const tool = registered.get(calling.apiName as string);
+    return tool
+      ? { ...calling, apiName: tool.apiName, identifier: tool.identifier, type: tool.type }
+      : calling;
+  };
+  const data = { ...event.data };
+  if (event.type === 'tool_start' && data.toolCalling)
+    data.toolCalling = mapCalling(data.toolCalling);
+  if (event.type === 'stream_chunk' && Array.isArray(data.toolsCalling)) {
+    data.toolsCalling = data.toolsCalling.map(mapCalling);
+  }
+  if (event.type === 'tool_end' && data.payload?.toolCalling) {
+    data.payload = { ...data.payload, toolCalling: mapCalling(data.payload.toolCalling) };
+  }
+  const receipt = results.get(data.toolCallId);
+  if (receipt && event.type === 'tool_result') {
+    data.content = receipt.content.map((item) => item.text).join('\n');
+    data.isError = receipt.isError === true;
+    data.pluginState = receipt.structuredContent;
+  }
+  if (receipt && event.type === 'tool_end') {
+    data.isSuccess = receipt.isError !== true;
+    data.result = {
+      content: receipt.content.map((item) => item.text).join('\n'),
+      state: receipt.structuredContent,
+      success: receipt.isError !== true,
+    };
+  }
+  return { ...event, data };
+};
