@@ -0,0 +1,116 @@
+import { createHash } from 'node:crypto';
+
+import type { AgentStreamEvent } from '@lobechat/agent-gateway-client';
+
+import { getTestDB } from '@/database/core/getTestDB';
+import { ClaudeCodeModel } from '@/database/models/claudeCode';
+import {
+  agentOperations,
+  claudeCodeRuns,
+  messages,
+  threads,
+  topics,
+  users,
+} from '@/database/schemas';
+
+export const db = await getTestDB();
+export const owner = 'cc-projection-owner';
+export const other = 'cc-projection-other';
+export const topicId = 'cc-projection-topic';
+export const leaseToken = 'test-lease-token-with-at-least-32-characters';
+export const model = () => new ClaudeCodeModel(db, owner);
+
+export const resetRows = async () => {
+  await db.delete(claudeCodeRuns);
+  await db.delete(agentOperations);
+  await db.delete(users);
+};
+
+export const prepareRows = async () => {
+  await resetRows();
+  await db.insert(users).values([{ id: owner }, { id: other }]);
+  await db.insert(topics).values({ id: topicId, userId: owner });
+  await model().provisionBinding({
+    workerId: 'worker-projection',
+    secretHash: createHash('sha256').update('service-token').digest('hex'),
+  });
+  await model().setBindingEnabled(true);
+  await model().updateWorkerStatus('worker-projection', {
+    authStatus: 'logged_in',
+    capabilities: {},
+  });
+};
+
+export const running = async (operationId = 'projection-op', threadId?: string) => {
+  const userMessageId = `${operationId}-user`;
+  const assistantMessageId = `${operationId}-assistant`;
+  if (threadId)
+    await db
+      .insert(threads)
+      .values({ id: threadId, topicId, type: 'continuation', userId: owner })
+      .onConflictDoNothing();
+  await db.insert(messages).values([
+    {
+      id: userMessageId,
+      role: 'user',
+      content: 'Question',
+      topicId,
+      threadId,
+      userId: owner,
+      createdAt: new Date('2026-01-01'),
+    },
+    {
+      id: assistantMessageId,
+      role: 'assistant',
+      content: '',
+      parentId: userMessageId,
+      topicId,
+      threadId,
+      userId: owner,
+      metadata: { operationId },
+      createdAt: new Date('2026-01-02'),
+    },
+  ]);
+  await db
+    .insert(agentOperations)
+    .values({ id: operationId, status: 'running', topicId, threadId, userId: owner });
+  await model().enqueueRun({
+    operationId,
+    requestId: `request-${operationId}`,
+    topicId,
+    threadId,
+    preparedRequest: {
+      request: {
+        model: 'default',
+        prompt: 'Question',
+        protocol: 1,
+        systemPrompt: 'Assistant',
+        tools: [],
+      },
+      state: {
+        createdAt: new Date('2026-01-01').toISOString(),
+        messages: [],
+        metadata: {},
+        origin: { userId: owner, topicId, threadId, assistantMessageId },
+        status: 'running',
+        stepCount: 0,
+      },
+    },
+  });
+  await model().claimNextRun('worker-projection', leaseToken);
+  return { assistantMessageId, scope: { db, operationId, userId: owner }, userMessageId };
+};
+
+export const event = (
+  sequence: number,
+  type: AgentStreamEvent['type'],
+  data: Record<string, unknown>,
+  operationId = 'projection-op',
+  stepIndex = 0,
+) => ({
+  sequence,
+  payload: { data, operationId, stepIndex, timestamp: 1000, type } as unknown as Record<
+    string,
+    unknown
+  >,
+});
