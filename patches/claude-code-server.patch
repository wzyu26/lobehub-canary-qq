+import { describe, expect, it } from 'vitest';
+
+import { selectRuntimeType } from './agentDispatcher';
+import { resolveAssistantTransport } from './resolveAssistantTransport';
+
+describe('ordinary Claude Code assistant transport', () => {
+  it.each([false, true])(
+    'requires server execution with gateway disabled on desktop=%s',
+    (isDesktop) => {
+      const transport = resolveAssistantTransport(
+        { model: 'claude-code', provider: 'claude-code' },
+        false,
+      );
+      expect(transport.heterogeneousProvider).toBeUndefined();
+      expect(
+        selectRuntimeType(
+          { ...transport, isGatewayMode: false, parentRuntime: 'client' },
+          { isDesktop },
+        ),
+      ).toBe('gateway');
+    },
+  );
+
+  it('uses the current topic backend when the assistant default is an API model', () => {
+    const transport = resolveAssistantTransport(
+      { model: 'gpt-test', provider: 'openai' },
+      false,
+      undefined,
+      { model: 'default', provider: 'claude-code' },
+    );
+    expect(transport.runtimeBackend).toBe('claude-code');
+    expect(selectRuntimeType({ ...transport, isGatewayMode: false })).toBe('gateway');
+  });
+
+  it('switches back to the pinned API model without inferring a legacy agent from the default model', () => {
+    const transport = resolveAssistantTransport(
+      { model: 'claude-code', provider: 'claude-code' },
+      false,
+      undefined,
+      { model: 'gpt-test', provider: 'openai' },
+    );
+    expect(transport.heterogeneousProvider).toBeUndefined();
+    expect(selectRuntimeType({ ...transport, isGatewayMode: false })).toBe('client');
+  });
+
+  it('does not apply another agent topic pin to a sub-agent', () => {
+    const transport = resolveAssistantTransport(
+      { id: 'child', model: 'default', provider: 'claude-code' },
+      false,
+      undefined,
+      { agentId: 'parent', model: 'gpt-test', provider: 'openai' },
+    );
+    expect(selectRuntimeType({ ...transport, isGatewayMode: false })).toBe('gateway');
+  });
+
+  it('preserves the existing explicitly configured Claude Code entry', () => {
+    const configured = { command: 'claude', type: 'claude-code' as const };
+    const transport = resolveAssistantTransport(
+      { model: 'claude-code', provider: 'claude-code' },
+      false,
+      configured,
+    );
+    expect(transport.heterogeneousProvider).toBe(configured);
+    expect(selectRuntimeType({ ...transport, isGatewayMode: false }, { isDesktop: true })).toBe(
+      'hetero',
+    );
+  });
+
+  it('preserves bare legacy CLI model recovery', () => {
+    const transport = resolveAssistantTransport(
+      { model: 'claude-code', provider: 'anthropic' },
+      false,
+    );
+    expect(transport.heterogeneousProvider).toEqual({ type: 'claude-code' });
+    expect(selectRuntimeType({ ...transport, isGatewayMode: false }, { isDesktop: true })).toBe(
+      'hetero',
+    );
+  });
+});
