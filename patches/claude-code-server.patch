@@ -0,0 +1,75 @@
+import { fromJsonSchema } from '@modelcontextprotocol/server';
+import {
+  addFormats,
+  Ajv,
+  AjvJsonSchemaValidator,
+} from '@modelcontextprotocol/server/validators/ajv';
+
+import { ASK_USER_TOOL_NAME } from '../askUser/constants';
+import type { McpToolResult } from './LobeBuiltinMcpServer';
+
+/** Transport identity. Business arguments never supply or override these fields. */
+export interface McpOperationToolContext {
+  operationId: string;
+  /** The original Claude tool_use id, not the MCP JSON-RPC request id. */
+  toolCallId: string;
+}
+
+export interface McpOperationTool {
+  description: string;
+  handler: (
+    context: McpOperationToolContext,
+    args: Record<string, unknown>,
+  ) => Promise<McpToolResult>;
+  inputSchema: Parameters<typeof fromJsonSchema>[0];
+  name: string;
+  title?: string;
+}
+
+export interface McpOperationOptions {
+  /** Defaults to true. The shared question bridge remains available when enabled. */
+  includeAskUser?: boolean;
+  /**
+   * The complete tool set allowed for this operation. When supplied (even []),
+   * replaces process-wide extraTools instead of adding to them.
+   */
+  tools?: readonly McpOperationTool[];
+}
+
+export interface PreparedMcpOperationTool extends Omit<McpOperationTool, 'inputSchema'> {
+  inputSchema: ReturnType<typeof fromJsonSchema<Record<string, unknown>>>;
+}
+
+/**
+ * Preserve the existing JSON Schema without translating away constraints.
+ * Compile before registering an operation: unsupported keywords/refs fail
+ * closed instead of quietly exposing a tool with weaker argument validation.
+ */
+export const prepareMcpOperationTools = (
+  tools: readonly McpOperationTool[],
+  includeAskUser: boolean,
+): PreparedMcpOperationTool[] => {
+  const names = new Set(includeAskUser ? [ASK_USER_TOOL_NAME] : []);
+
+  return tools.map((tool) => {
+    if (!/^[\w.-]{1,128}$/.test(tool.name) || names.has(tool.name)) {
+      throw new Error(`Invalid or duplicate MCP operation tool name: ${tool.name}`);
+    }
+    names.add(tool.name);
+
+    // Snapshot caller-owned schemas so changing the next turn's allowlist
+    // cannot mutate an already registered operation's input contract.
+    const schema = structuredClone(tool.inputSchema);
+    if (schema.type !== 'object') {
+      throw new Error(`MCP operation tool ${tool.name} requires an object input schema`);
+    }
+
+    const ajv = new Ajv({ allErrors: true, allowUnionTypes: true, strict: true });
+    addFormats(ajv);
+    ajv.compile(schema);
+    return {
+      ...tool,
+      inputSchema: fromJsonSchema<Record<string, unknown>>(schema, new AjvJsonSchemaValidator(ajv)),
+    };
+  });
+};
