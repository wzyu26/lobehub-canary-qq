index 0000000000..9ed2fcd85e
--- /dev/null
+++ b/apps/claude-code-worker/__tests__/startup.integration.test.ts
@@ -0,0 +1,68 @@
+import { spawnSync } from 'node:child_process';
+import { cp, mkdtemp, readFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+import { afterEach, describe, expect, it } from 'vitest';
+
+const workerRoot = fileURLToPath(new URL('../', import.meta.url));
+const configuredBun = process.env.BUN_EXECUTABLE ?? 'bun';
+const temporaryDirectories: string[] = [];
+const temporaryDirectory = async () => {
+  const directory = await mkdtemp(path.join(tmpdir(), 'claude-worker-startup-'));
+  temporaryDirectories.push(directory);
+  return directory;
+};
+afterEach(async () => {
+  for (const directory of temporaryDirectories.splice(0)) {
+    // Only remove the exact absolute mkdtemp directories created by this test.
+    if (!path.isAbsolute(directory) || path.dirname(directory) !== path.resolve(tmpdir()) ||
+        !path.basename(directory).startsWith('claude-worker-startup-')) {
+      throw new Error('Unexpected startup test cleanup path');
+    }
+    await rm(directory, { force: true, recursive: true });
+  }
+});
+
+describe('built worker initialization outside the source workspace', () => {
+  it('ships Zod and reaches safe configuration validation without credentials', async () => {
+    // setup-bun adds its binary to PATH. Resolve it before the real startup
+    // intentionally drops PATH along with all credentials and configuration.
+    const located = spawnSync(configuredBun, ['-e', 'process.stdout.write(process.execPath)'], {
+      cwd: workerRoot, encoding: 'utf8', timeout: 15_000,
+    });
+    expect(located.error).toBeUndefined();
+    expect(located.status, located.stderr).toBe(0);
+    const bun = located.stdout.trim();
+    expect(path.isAbsolute(bun)).toBe(true);
+    const directory = await temporaryDirectory();
+    const built = spawnSync(bun, [path.join(workerRoot, 'scripts/buildWorker.mjs'), directory], {
+      cwd: workerRoot, encoding: 'utf8', timeout: 30_000,
+    });
+    expect(built.error).toBeUndefined();
+    expect(built.status, built.stderr).toBe(0);
+    const runtime = JSON.parse(await readFile(path.join(directory, 'node_modules/zod/package.json'), 'utf8'));
+    expect(runtime.name).toBe('zod');
+    const started = spawnSync(bun, ['--no-install', path.join(directory, 'index.js')], {
+      cwd: directory, encoding: 'utf8', env: {}, timeout: 15_000,
+    });
+    expect(started.error).toBeUndefined();
+    expect(started.status, started.stderr).toBe(1);
+    expect(started.stdout).toBe('');
+    expect(started.stderr.trim()).toBe('Claude Code worker could not start; check its deployment configuration');
+
+    // The smoke must also detect a packaging regression where Docker copies
+    // only index.js and silently omits the external runtime dependency.
+    const missingRuntime = await temporaryDirectory();
+    await cp(path.join(directory, 'index.js'), path.join(missingRuntime, 'index.js'));
+    const incomplete = spawnSync(bun, [
+      '--no-install',
+      path.join(workerRoot, 'scripts/smokeWorkerStartup.mjs'), path.join(missingRuntime, 'index.js'),
+    ], { cwd: missingRuntime, encoding: 'utf8', timeout: 15_000 });
+    expect(incomplete.error).toBeUndefined();
+    expect(incomplete.status).not.toBe(0);
+    expect(incomplete.stderr).toContain('Worker module startup failed before safe configuration validation');
+    expect(incomplete.stderr).toMatch(/Cannot find (?:package|module) ['"]zod['"]/);
+  }, 60_000);
+});
