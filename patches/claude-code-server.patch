+    context.messages = [{ content: 'Only a system message', role: 'system' }];
+    expect(() => prepare(makeState(), context)).toThrow('no user input');
+  });
+});
diff --git a/apps/server/src/services/claudeCode/prepareContext.ts b/apps/server/src/services/claudeCode/prepareContext.ts
new file mode 100644
index 0000000000..1ec39dfa82
--- /dev/null
+++ b/apps/server/src/services/claudeCode/prepareContext.ts
@@ -0,0 +1,134 @@
+import type { AgentState, ContextBuildOutput } from '@lobechat/agent-runtime';
+import { ToolNameResolver } from '@lobechat/context-engine';
+import type {
+  AgentContentBlock,
+  ClaudeCodeAssistantRequest,
+  ClaudeCodeAssistantTool,
+} from '@lobechat/heterogeneous-agents/protocol';
+import { CLAUDE_CODE_WORKER_PROTOCOL } from '@lobechat/heterogeneous-agents/protocol';
+
+import { resolveClaudeCodeTools } from './resolveTools';
+
+interface PreparedMessage {
+  content?: unknown;
+  role: string;
+  tool_call_id?: string;
+  tool_calls?: unknown;
+}
+
+const contentBlocks = (content: unknown): AgentContentBlock[] => {
+  if (content == null || content === '') return [];
+  if (typeof content === 'string') return [{ text: content, type: 'text' }];
+  if (!Array.isArray(content)) throw new Error('Unsupported Claude Code message content');
+  return content.flatMap((part): AgentContentBlock[] => {
+    if (part?.type === 'text' && typeof part.text === 'string') {
+      return [{ text: part.text, type: 'text' }];
+    }
+    if (part?.type === 'image_url' && typeof part.image_url?.url === 'string') {
+      return [{ source: { type: 'url', url: part.image_url.url }, type: 'image' }];
+    }
+    // Never silently discard a video/audio/file which was not converted by CE.
+    throw new Error(`Claude Code cannot consume the prepared attachment type: ${part?.type}`);
+  });
+};
+
+const preparedMessages = (messages: unknown[]): PreparedMessage[] =>
+  messages.map((message) => {
+    if (!message || typeof message !== 'object' || !('role' in message)) {
+      throw new Error('Invalid prepared assistant message');
+    }
+    if (typeof message.role !== 'string') throw new Error('Invalid prepared message role');
+    return message as PreparedMessage;
+  });
+
+/**
+ * Takes the ordinary ContextBuilder output, never reconstructs knowledge/skills
+ * from a second implementation. Each invocation starts an independent CLI turn.
+ */
+export const prepareClaudeCodeContext = ({
+  context,
+  effort,
+  isServerTool,
+  state,
+}: {
+  context: ContextBuildOutput;
+  effort?: ClaudeCodeAssistantRequest['effort'];
+  isServerTool: (identifier: string, apiName: string, type: string) => boolean;
+  state: AgentState;
+}): { request: ClaudeCodeAssistantRequest; unavailableTools: string[] } => {
+  const origin = state.origin;
+  if (!origin?.userId || !origin.topicId) throw new Error('Claude Code requires an owned topic');
+  if (state.modelRuntimeConfig?.provider !== 'claude-code') {
+    throw new Error('Claude Code context cannot be used for an API model');
+  }
+
+  const messages = preparedMessages(context.messages);
+  const resolver = new ToolNameResolver();
+  const tools: ClaudeCodeAssistantTool[] = [];
+  const unavailableTools: string[] = [];
+  const resolved = resolveClaudeCodeTools(state, context);
+  for (const tool of resolved?.tools ?? []) {
+    const name = tool.function.name;
+    const [identity] = resolver.resolve(
+      [{ function: { arguments: '{}', name }, id: name, type: 'function' }],
+      resolved!.manifestMap,
+      [name],
+    );
+    if (!identity) throw new Error(`Prepared tool cannot be resolved: ${name}`);
+    if (state.world?.disabledPluginIds?.includes(identity.identifier)) continue;
+    const type = identity.type ?? 'builtin';
+    if (!isServerTool(identity.identifier, identity.apiName, type)) {
+      unavailableTools.push(name);
+      continue;
+    }
+    const parameters = tool.function.parameters;
+    if (!parameters || parameters.type !== 'object') {
+      throw new Error(`Prepared tool has no object schema: ${name}`);
+    }
+    tools.push({
+      apiName: identity.apiName,
+      description: tool.function.description ?? name,
+      identifier: identity.identifier,
+      inputSchema: parameters as ClaudeCodeAssistantTool['inputSchema'],
+      name,
+      type,
+    });
+  }
+
+  const systemPrompt = messages
+    .filter((message) => message.role === 'system')
+    .flatMap((message) => contentBlocks(message.content))
+    .map((part) => {
+      if (part.type !== 'text') throw new Error('System context must be text');
+      return part.text;
+    })
+    .join('\n\n');
+  const conversation = messages.filter((message) => message.role !== 'system');
+  if (!conversation.some((message) => message.role === 'user')) {
+    throw new Error('Prepared context has no user input');
+  }
+  const currentContext = unavailableTools.length
+    ? `${systemPrompt}\n\nThe following tools cannot execute on this server and are unavailable: ${unavailableTools.join(', ')}.`
+    : systemPrompt;
+  const prompt = conversation.flatMap((message): AgentContentBlock[] => [
+    {
+      text: JSON.stringify({ role: message.role, tool_call_id: message.tool_call_id }),
+      type: 'text',
+    },
+    ...contentBlocks(message.content),
+    ...(message.tool_calls
+      ? [{ text: JSON.stringify({ tool_calls: message.tool_calls }), type: 'text' as const }]
+      : []),
+  ]);
+  return {
+    request: {
+      ...(effort ? { effort } : {}),
+      model: state.modelRuntimeConfig?.model ?? 'default',
+      prompt,
+      protocol: CLAUDE_CODE_WORKER_PROTOCOL,
+      systemPrompt: currentContext,
+      tools,
+    },
+    unavailableTools,
+  };
+};
diff --git a/apps/server/src/services/claudeCode/projectEvents.ts b/apps/server/src/services/claudeCode/projectEvents.ts
new file mode 100644
index 0000000000..d4fe39601f
--- /dev/null
+++ b/apps/server/src/services/claudeCode/projectEvents.ts
@@ -0,0 +1,148 @@
+import type { AgentStreamEvent } from '@lobechat/agent-gateway-client';
+import type { AgentState } from '@lobechat/agent-runtime';
+import superjson from 'superjson';
+
+import { ClaudeCodeModel, type ClaudeCodeRunView } from '@/database/models/claudeCode';
+import { MessageModel } from '@/database/models/message';
+import { ThreadModel } from '@/database/models/thread';
+import { TopicModel } from '@/database/models/topic';
+import type { LobeChatDatabase } from '@/database/type';
+import { createStreamEventManager } from '@/server/modules/AgentRuntime';
+import type { IStreamEventManager } from '@/server/modules/AgentRuntime/types';
+import { HeterogeneousPersistenceHandler } from '@/server/services/heterogeneousAgent/HeterogeneousPersistenceHandler';
+import type { OperationState } from '@/server/services/heterogeneousAgent/HeterogeneousPersistenceHandler/types';
+
+export interface ClaudeCodeProjectionScope {
+  db: LobeChatDatabase;
+  operationId: string;
+  userId: string;
+  workspaceId?: string;
+}
+
+export const restoreClaudeCodeProjection = (checkpoint?: Record<string, unknown>) => {
+  const states = new Map<string, OperationState>();
+  if (typeof checkpoint?.reducer === 'string') {
+    const state = superjson.parse<OperationState | undefined>(checkpoint.reducer);
+    // A cancelled run can finish before the CLI emits its first event.
+    if (state) states.set(state.operationId, state);
+  }
+  return states;
+};
+
+/** The durable sequence distinguishes legitimate equal deltas in one millisecond. */
+const sequencedEvent = (row: {
+  payload: Record<string, unknown>;
+  sequence: number;
+}): AgentStreamEvent => {
+  const event = row.payload as unknown as AgentStreamEvent;
+  return { ...event, data: { ...event.data, claudeCodeSequence: row.sequence } };
+};
+
+const createHandler = (
+  db: LobeChatDatabase,
+  run: ClaudeCodeRunView,
+  states: Map<string, OperationState>,
+) =>
+  new HeterogeneousPersistenceHandler({
+    authoritativeOperation: {
+      operationId: run.operationId,
+      threadId: run.threadId ?? undefined,
+      topicId: run.topicId,
+    },
+    messageModel: new MessageModel(db, run.userId, run.workspaceId ?? undefined),
+    operationStates: states,
+    persistSessionOnTopic: false,
+    threadModel: new ThreadModel(db, run.userId, run.workspaceId ?? undefined),
+    topicModel: new TopicModel(db, run.userId, run.workspaceId ?? undefined),
+    // InterventionBridge owns notifications outside the message transaction.
+  });
+
+/** Terminal queue records also close questions when no terminal CLI event exists. */
+export const closeClaudeCodeInterventions = async (
+  db: LobeChatDatabase,
+  run: ClaudeCodeRunView,
+  states: Map<string, OperationState>,
+) => {
+  const state = run.preparedRequest.state as unknown as AgentState;
+  await createHandler(db, run, states).closeInterventions({
+    assistantMessageId: state.origin?.assistantMessageId ?? state.metadata?.assistantMessageId,
+    operationId: run.operationId,
+    topicId: run.topicId,
+  });
+};
+
+/** Message projection and reducer checkpoint commit together. Re-delivery can
+ * only repeat projection of an uncommitted transaction, never execute tools. */
+export const projectClaudeCodeEvents = async (
+  scope: ClaudeCodeProjectionScope,
+  streamManager: IStreamEventManager = createStreamEventManager(),
+) => {
+  const model = new ClaudeCodeModel(scope.db, scope.userId, scope.workspaceId);
+  await model.projectEvents(scope.operationId, async (tx, run, row, checkpoint) => {
+    const states = restoreClaudeCodeProjection(checkpoint);
+    const handler = createHandler(tx as unknown as LobeChatDatabase, run, states);
+    const state = run.preparedRequest.state as unknown as AgentState;
+    const event = sequencedEvent(row);
+    await handler.ingest({
+      assistantMessageId:
+        state.origin?.assistantMessageId ??
+        (state.metadata?.assistantMessageId as string | undefined),
+      events: [event],
+      operationId: run.operationId,
+      topicId: run.topicId,
+    });
+    if (!['queued', 'running', 'cancelling'].includes(run.status)) {
+      // A late request from the interrupted worker must not reopen a live form.
+      await closeClaudeCodeInterventions(tx as unknown as LobeChatDatabase, run, states);
+    }
+    return { ...checkpoint, reducer: superjson.stringify(states.get(run.operationId)) };
+  });
+
+  // Serialize publishers under the run lock. Redis deduplication closes the
+  // crash window between XADD and this transaction's cursor commit.
+  await model.withProjectionState(scope.operationId, async (tx, run, checkpoint) => {
+    const txModel = new ClaudeCodeModel(
+      tx as unknown as LobeChatDatabase,
+      scope.userId,
+      scope.workspaceId,
+    );
+    const states = restoreClaudeCodeProjection(checkpoint);
+    const handler = createHandler(tx as unknown as LobeChatDatabase, run, states);
+    let publishedSequence = Number(checkpoint?.publishedSequence ?? 0);
+    const events = await txModel.getEvents(run.operationId, publishedSequence, 1000);
+    for (const row of events) {
+      if (!row.projected) break;
+      const event = sequencedEvent(row);
+      // Completion is published only after terminal DB/lifecycle persistence.
+      if (event.type !== 'agent_runtime_end') {
+        await streamManager.publishStreamEvent(run.operationId, {
+          data: {
+            ...handler.publishData(run.operationId, event),
+            claudeCodeSequence: row.sequence,
+          },
+          deduplicationKey: `claude-code:${row.sequence}`,
+          stepIndex: event.stepIndex,
+          type: event.type,
+        });
+      }
+      handler.markEventPublished(run.operationId, event);
+      publishedSequence = row.sequence;
+    }
+    return {
+      ...checkpoint,
+      publishedSequence,
+      reducer: superjson.stringify(states.get(run.operationId)),
+    };
+  });
+};
+
+/** Completion must include every committed event, beyond one batch. */
+export const drainClaudeCodeEvents = async (scope: ClaudeCodeProjectionScope) => {
+  const model = new ClaudeCodeModel(scope.db, scope.userId, scope.workspaceId);
+  let run;
+  do {
+    await projectClaudeCodeEvents(scope);
+    run = await model.getRun(scope.operationId);
+  } while (run && run.projectedSequence < run.lastEventSequence);
+  return run;
+};
diff --git a/apps/server/src/services/claudeCode/recover.ts b/apps/server/src/services/claudeCode/recover.ts
new file mode 100644
index 0000000000..32366955c8
--- /dev/null
+++ b/apps/server/src/services/claudeCode/recover.ts
@@ -0,0 +1,52 @@
+import { and, asc, eq, inArray, isNull, sql } from 'drizzle-orm';
+
+import { ClaudeCodeModel } from '@/database/models/claudeCode';
+import { claudeCodeRuns } from '@/database/schemas/claudeCode';
+import type { LobeChatDatabase } from '@/database/type';
+
+import { settleClaudeCodeRun } from './finish';
+
+/** Recovery drains persisted results only. Never enqueue a replacement model or tool call. */
+export const recoverClaudeCodeRuns = async (
+  db: LobeChatDatabase,
+  scope?: { userId: string; workspaceId?: string },
+) => {
+  await ClaudeCodeModel.interruptStaleRuns(db);
+  const runs = await db
+    .select({
+      operationId: claudeCodeRuns.operationId,
+      userId: claudeCodeRuns.userId,
+      workspaceId: claudeCodeRuns.workspaceId,
+    })
+    .from(claudeCodeRuns)
+    .where(
+      and(
+        inArray(claudeCodeRuns.status, ['completed', 'error', 'cancelled', 'interrupted']),
+        sql`coalesce(${claudeCodeRuns.preparedRequest} #>> '{_serverProjectionState,settled}', 'false') != 'true'`,
+        ...(scope
+          ? [
+              eq(claudeCodeRuns.userId, scope.userId),
+              scope.workspaceId
+                ? eq(claudeCodeRuns.workspaceId, scope.workspaceId)
+                : isNull(claudeCodeRuns.workspaceId),
+            ]
+          : []),
+      ),
+    )
+    .orderBy(asc(claudeCodeRuns.queuedAt))
+    .limit(20);
+  for (const run of runs) {
+    try {
+      await settleClaudeCodeRun({
+        db,
+        operationId: run.operationId,
+        userId: run.userId,
+        workspaceId: run.workspaceId ?? undefined,
+      });
+    } catch {
+      // One bad journal must not block other users' recovery or worker heartbeats.
+      // Keep it unsettled for retry; never log context, tool arguments or credentials.
+      console.warn('[Claude Code] Run settlement requires retry:', run.operationId);
+    }
+  }
+};
