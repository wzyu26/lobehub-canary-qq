+import { describe, expect, it } from 'vitest';
+
+import type { Operation } from '@/store/chat/slices/operation/types';
+
+import { resolveHeteroInterventionExecutionOperation } from './heteroInterventionOperation';
+
+describe('heterogeneous intervention operation locator', () => {
+  it('preserves a durable server ID after the browser local operation has expired', () => {
+    expect(resolveHeteroInterventionExecutionOperation({}, 'server-run')).toEqual({
+      operation: undefined,
+      operationId: 'server-run',
+    });
+  });
+
+  it('resolves a tool child to the existing execution operation rather than its sendMessage root', () => {
+    const operations = {
+      root: { type: 'sendMessage' },
+      runtime: { parentOperationId: 'root', type: 'execServerAgentRuntime' },
+      tool: { parentOperationId: 'runtime', type: 'toolCalling' },
+    } as Record<string, Operation>;
+    expect(resolveHeteroInterventionExecutionOperation(operations, 'tool')).toEqual({
+      operation: operations.runtime,
+      operationId: 'runtime',
+    });
+  });
+});
diff --git a/src/store/chat/slices/agentRun/actions/entries/heteroInterventionOperation.ts b/src/store/chat/slices/agentRun/actions/entries/heteroInterventionOperation.ts
