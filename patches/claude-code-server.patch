+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+import { HttpWorkerApi, runRoute, WorkerApiError } from './api';
+
+describe('internal worker HTTP client', () => {
+  afterEach(() => vi.restoreAllMocks());
+
+  it('allows bounded claim preparation while preserving prompt shutdown and short receipt timeouts', async () => {
+    const timeoutSignals: AbortController[] = [];
+    const timeout = vi.spyOn(AbortSignal, 'timeout').mockImplementation(() => {
+      const controller = new AbortController();
+      timeoutSignals.push(controller);
+      return controller.signal;
+    });
+    const fetcher = vi.fn(
+      async (_url: string | URL | Request, _options?: RequestInit) =>
+        new Response('null', { status: 200 }),
+    );
+    const api = new HttpWorkerApi(
+      { serverUrl: 'https://lobe.example', token: 'secret', workerId: 'worker' },
+      fetcher,
+    );
+    const shutdown = new AbortController();
+    await api.post('/claim', {}, shutdown.signal);
+    await api.post('/runs/run/events', {});
+    expect(timeout.mock.calls.map(([milliseconds]) => milliseconds)).toEqual([120_000, 20_000]);
+    const claimSignal = fetcher.mock.calls[0][1]!.signal!;
+    expect(claimSignal.aborted).toBe(false);
+    shutdown.abort();
+    expect(claimSignal.aborted).toBe(true);
+    expect(fetcher.mock.calls[1][1]!.signal).toBe(timeoutSignals[1].signal);
+  });
+
+  it('binds service authentication to a fixed origin and refuses redirects', async () => {
+    const fetcher = vi.fn(async () => new Response(JSON.stringify({ ok: true }), { status: 200 }));
+    const api = new HttpWorkerApi(
+      { serverUrl: 'https://lobe.example', token: 'worker-only', workerId: 'worker-1' },
+      fetcher,
+    );
+    await api.post('/heartbeat', { authStatus: 'logged_in' });
+    expect(fetcher).toHaveBeenCalledWith(
+      'https://lobe.example/api/claude-code/worker/heartbeat',
+      expect.objectContaining({
+        headers: {
+          'Authorization': 'Bearer worker-only',
+          'Content-Type': 'application/json',
+          'x-lobehub-worker-id': 'worker-1',
+        },
+        redirect: 'error',
+      }),
+    );
+    await expect(api.post('https://foreign.example', {})).rejects.toThrow('Invalid worker route');
+    expect(runRoute('other/user?query', 'events')).toBe('/runs/other%2Fuser%3Fquery/events');
+  });
+
+  it('does not expose an upstream body that could contain account or credential information', async () => {
+    const api = new HttpWorkerApi(
+      { serverUrl: 'https://lobe.example', token: 'secret', workerId: 'worker' },
+      vi.fn(async () => new Response('private account information', { status: 401 })),
+    );
+    await expect(api.post('/claim', {})).rejects.toEqual(new WorkerApiError(401));
+  });
+});
diff --git a/apps/claude-code-worker/src/api.ts b/apps/claude-code-worker/src/api.ts
new file mode 100644
index 0000000000..ca413fa2c8
--- /dev/null
+++ b/apps/claude-code-worker/src/api.ts
@@ -0,0 +1,40 @@
+import type { WorkerConfig } from './config';
+
+export interface WorkerApi {
+  post: <T>(route: string, body: unknown, signal?: AbortSignal) => Promise<T>;
+}
+
+export class WorkerApiError extends Error {
+  constructor(public readonly status: number) {
+    super(`Worker API returned HTTP ${status}`);
+  }
+}
+
+export class HttpWorkerApi implements WorkerApi {
+  constructor(
+    private readonly config: Pick<WorkerConfig, 'serverUrl' | 'workerId' | 'token'>,
+    private readonly fetcher: typeof fetch = fetch,
+  ) {}
+
+  async post<T>(route: string, body: unknown, signal?: AbortSignal): Promise<T> {
+    if (!route.startsWith('/') || route.includes('..')) throw new Error('Invalid worker route');
+    // Claim includes fresh context preparation (bounded to 90s by the server).
+    const timeout = AbortSignal.timeout(route === '/claim' ? 120_000 : 20_000);
+    const response = await this.fetcher(`${this.config.serverUrl}/api/claude-code/worker${route}`, {
+      body: JSON.stringify(body),
+      headers: {
+        'Authorization': `Bearer ${this.config.token}`,
+        'Content-Type': 'application/json',
+        'x-lobehub-worker-id': this.config.workerId,
+      },
+      method: 'POST',
+      redirect: 'error',
+      signal: signal ? AbortSignal.any([signal, timeout]) : timeout,
+    });
+    if (!response.ok) throw new WorkerApiError(response.status);
+    return response.json() as Promise<T>;
+  }
+}
+
+export const runRoute = (operationId: string, action: string): string =>
+  `/runs/${encodeURIComponent(operationId)}/${action}`;
