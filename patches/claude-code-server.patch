--- /dev/null
+++ b/apps/server/src/services/claudeCode/loadClaimHistory.ts
@@ -0,0 +1,58 @@
+import type { AgentState } from '@lobechat/agent-runtime';
+import { parse } from '@lobechat/conversation-flow';
+
+import type { MessageModel } from '@/database/models/message';
+import { computeBranchSelection } from '@/server/services/aiAgent/pipeline/resolveUserMessageParentId';
+import { pruneRegeneratedBranch } from '@/server/services/aiAgent/pruneRegeneratedBranch';
+
+/** Select this queued LobeHub turn's branch without changing the UI's current selection. */
+export const loadClaudeCodeClaimHistory = async ({
+  messageModel,
+  postProcessUrl,
+  runFromHistory,
+  state,
+}: {
+  messageModel: MessageModel;
+  postProcessUrl: (path: string | null) => Promise<string>;
+  runFromHistory: boolean;
+  state: AgentState;
+}) => {
+  const origin = state.origin!;
+  const topicId = origin.topicId!;
+  const threadId = origin.threadId ?? null;
+  const [rows, mainTree, threadTree] = await Promise.all([
+    messageModel.query(
+      { agentId: origin.agentId, groupId: origin.groupId, skipWorks: true, threadId, topicId },
+      { postProcessUrl },
+    ),
+    messageModel.queryTopicMessageTree({ topicId }),
+    threadId ? messageModel.queryTopicMessageTree({ threadId, topicId }) : Promise.resolve([]),
+  ]);
+  const source = rows.find((message) => message.id === origin.sourceMessageId);
+  if (!runFromHistory && (!source || source.role !== 'user')) {
+    throw new Error('Queued input is no longer present in the conversation');
+  }
+  // A new ask or regenerated user turn ends at that user. Other continuations
+  // keep the source assistant's tool results and end at this run's placeholder.
+  const anchorId = source?.role === 'user' ? source.id : origin.assistantMessageId!;
+  const bounded = pruneRegeneratedBranch(rows, [...mainTree, ...threadTree], anchorId);
+  const selection = computeBranchSelection(bounded, anchorId, threadId);
+  const selected = bounded.map((message) =>
+    selection.has(message.id)
+      ? {
+          ...message,
+          metadata: { ...message.metadata, activeBranchIndex: selection.get(message.id) },
+        }
+      : message,
+  );
+  const { flatList } = parse(selected, undefined, { threadId });
+  if (source?.role === 'user' && !flatList.some((message) => message.id === source.id)) {
+    throw new Error('Queued input is no longer present on its conversation branch');
+  }
+  // A fresh user message is appended by the ordinary initializer with freshly
+  // resolved attachments. Regenerations already contain it in their history.
+  const historyMessages = runFromHistory
+    ? flatList
+    : flatList.filter((message) => message.id !== source!.id);
+  return { historyMessages: historyMessages as AgentState['messages'], source };
+};
diff --git a/apps/server/src/services/claudeCode/messageScope.ts b/apps/server/src/services/claudeCode/messageScope.ts
