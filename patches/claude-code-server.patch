index 0000000000..33e814a6f5
--- /dev/null
+++ b/apps/server/src/services/claudeCode/messageScope.ts
@@ -0,0 +1,110 @@
+import { createHash } from 'node:crypto';
+
+import type { AgentState } from '@lobechat/agent-runtime';
+import type { ChatToolPayload } from '@lobechat/types';
+import { and, desc, eq, isNull, or, sql } from 'drizzle-orm';
+
+import { ClaudeCodeModel, type ClaudeCodeRunView } from '@/database/models/claudeCode';
+import { MessageModel } from '@/database/models/message';
+import { messagePlugins, messages } from '@/database/schemas';
+import type { LobeChatDatabase } from '@/database/type';
+
+const messageScope = (run: ClaudeCodeRunView) =>
+  and(
+    eq(messages.userId, run.userId),
+    run.workspaceId ? eq(messages.workspaceId, run.workspaceId) : isNull(messages.workspaceId),
+    eq(messages.topicId, run.topicId),
+    run.threadId ? eq(messages.threadId, run.threadId) : isNull(messages.threadId),
+  );
+
+export const findClaudeCodeToolMessage = async (
+  db: LobeChatDatabase,
+  run: ClaudeCodeRunView,
+  toolCallId: string,
+) => {
+  const [row] = await db
+    .select({ message: messages, plugin: messagePlugins })
+    .from(messages)
+    .innerJoin(messagePlugins, eq(messagePlugins.id, messages.id))
+    .where(
+      and(
+        messageScope(run),
+        eq(messagePlugins.toolCallId, toolCallId),
+        or(
+          sql`${messages.metadata}->>'operationId' = ${run.operationId}`,
+          sql`EXISTS (SELECT 1 FROM ${messages} AS cc_parent
+            WHERE cc_parent.id = ${messages.parentId}
+              AND cc_parent.metadata->>'operationId' = ${run.operationId})`,
+        ),
+      ),
+    )
+    .limit(1);
+  return row;
+};
+
+/** The run lock is shared with projection, so a late tools_calling cannot create a second row. */
+export const ensureClaudeCodeToolMessage = async (
+  db: LobeChatDatabase,
+  run: ClaudeCodeRunView,
+  tool: ChatToolPayload,
+) => {
+  let messageId = '';
+  await new ClaudeCodeModel(db, run.userId, run.workspaceId ?? undefined).withProjectionState(
+    run.operationId,
+    async (tx, locked, snapshot) => {
+      const database = tx as unknown as LobeChatDatabase;
+      const existing = await findClaudeCodeToolMessage(database, locked, tool.id);
+      if (existing) {
+        messageId = existing.message.id;
+        return snapshot;
+      }
+      const state = locked.preparedRequest.state as AgentState;
+      const [assistant] = await tx
+        .select()
+        .from(messages)
+        .where(
+          and(
+            messageScope(locked),
+            eq(messages.role, 'assistant'),
+            or(
+              sql`${messages.metadata}->>'operationId' = ${locked.operationId}`,
+              state.pendingAssistantMessageId
+                ? eq(messages.id, state.pendingAssistantMessageId)
+                : undefined,
+              state.origin?.assistantMessageId
+                ? eq(messages.id, state.origin.assistantMessageId)
+                : undefined,
+            ),
+          ),
+        )
+        .orderBy(desc(messages.createdAt))
+        .limit(1);
+      if (!assistant) throw new Error('Claude Code assistant message has not been prepared');
+      messageId = `msg_cc_${createHash('sha256').update(`${locked.operationId}:${tool.id}`).digest('hex').slice(0, 32)}`;
+      const model = new MessageModel(database, locked.userId, locked.workspaceId ?? undefined);
+      await model.create(
+        {
+          agentId: state.origin?.agentId,
+          content: '',
+          metadata: { operationId: locked.operationId },
+          parentId: assistant.id,
+          plugin: tool,
+          role: 'tool',
+          threadId: locked.threadId ?? undefined,
+          tool_call_id: tool.id,
+          topicId: locked.topicId,
+        },
+        messageId,
+      );
+      const previousTools = (assistant.tools ?? []) as ChatToolPayload[];
+      await model.update(assistant.id, {
+        tools: [
+          ...previousTools.filter(({ id }) => id !== tool.id),
+          { ...tool, result_msg_id: messageId },
+        ],
+      });
+      return snapshot;
+    },
+  );
+  return messageId;
+};
diff --git a/apps/server/src/services/claudeCode/prepareClaim.ts b/apps/server/src/services/claudeCode/prepareClaim.ts
new file mode 100644
index 0000000000..99e2711e8e
--- /dev/null
+++ b/apps/server/src/services/claudeCode/prepareClaim.ts
@@ -0,0 +1,283 @@
+import type { AgentState } from '@lobechat/agent-runtime';
+import type { AgentRunInitRequest } from '@lobechat/types';
+import { isDeviceOnlyMcpEndpoint } from '@lobechat/utils/mcpEndpoint';
+
+import { AiModelModel } from '@/database/models/aiModel';
+import { ClaudeCodeModel } from '@/database/models/claudeCode';
+import { MessageModel } from '@/database/models/message';
+import { TopicModel } from '@/database/models/topic';
+import { WorkspaceMemberModel } from '@/database/models/workspaceMember';
+import type { LobeChatDatabase } from '@/database/type';
+import { ServerContextBuilder } from '@/server/modules/AgentRuntime/adapters/ServerContextBuilder';
+import { AgentService } from '@/server/services/agent';
+import { AgentRuntimeService } from '@/server/services/agentRuntime';
+import { resolveRunAgentConfig } from '@/server/services/aiAgent/pipeline/resolveRunAgentConfig';
+import { loadResumeParentMessage } from '@/server/services/aiAgent/pipeline/resumeParent';
+import { resolveRunSettings } from '@/server/services/aiAgent/pipeline/runSettings';
+import { createRunFacts } from '@/server/services/aiAgent/runFacts';
+import { FileService } from '@/server/services/file';
+import { resolveAttachmentsByFileIds } from '@/server/services/file/resolveAttachments';
+import { hasServerRuntime } from '@/server/services/toolExecution/serverRuntimes';
+
+import { buildClaudeCodeContext } from './buildContext';
+import { assertClaudeCodeAvailable, type ClaudeCodeTurnOverrides } from './enqueue';
+import { loadClaudeCodeClaimHistory } from './loadClaimHistory';
+import { prepareClaudeCodeContext } from './prepareContext';
+
+type ClaimedRun = NonNullable<Awaited<ReturnType<ClaudeCodeModel['getRun']>>>;
+
+/** Re-read the ordinary assistant inputs after reserving the single execution slot. */
+export const prepareClaimedClaudeCodeRun = async ({
+  db,
+  leaseToken,
+  run,
+  signal,
+  userId,
+  workspaceId,
+}: {
+  db: LobeChatDatabase;
+  leaseToken: string;
+  run: ClaimedRun;
+  signal?: AbortSignal;
+  userId: string;
+  workspaceId?: string;
+}) => {
+  signal?.throwIfAborted();
+  const state = structuredClone(run.preparedRequest.state) as AgentState;
+  const initRequest = run.preparedRequest.initRequest as unknown as AgentRunInitRequest;
+  const origin = state.origin;
+  if (
+    !origin ||
+    origin.userId !== userId ||
+    (origin.workspaceId ?? undefined) !== workspaceId ||
+    origin.topicId !== run.topicId ||
+    (origin.threadId ?? null) !== run.threadId ||
+    !state.world?.agent?.id ||
+    !initRequest ||
+    state.modelRuntimeConfig?.provider !== 'claude-code' ||
+    (initRequest.requestedTopicId && initRequest.requestedTopicId !== run.topicId)
+  ) {
+    throw new Error('Invalid queued Claude Code operation');
+  }
+  const agentId = state.world.agent.id;
+  const binding = await assertClaudeCodeAvailable(db, userId, workspaceId);
+  if (
+    binding.workerId !== run.workerId ||
+    !binding.capabilities.models?.some(({ id }) => id === state.modelRuntimeConfig!.model)
+  ) {
+    throw new Error('Queued model is no longer available in the assigned worker');
+  }
+  const agentService = new AgentService(db, userId, workspaceId);
+  const verifyAccess = async () => {
+    if (
+      workspaceId &&
+      !(await new WorkspaceMemberModel(db, userId).getMember(workspaceId, userId))
+    ) {
+      throw new Error('Workspace access has been revoked');
+    }
+    const topic = await new TopicModel(db, userId, workspaceId).findById(run.topicId);
+    if (!topic || topic.userId !== userId || (topic.workspaceId ?? undefined) !== workspaceId) {
+      throw new Error('Queued topic is no longer accessible');
+    }
+    if (!(await agentService.getAgentConfig(agentId))) {
+      throw new Error('Queued assistant is no longer accessible');
+    }
+  };
+  await verifyAccess();
+  const { agentConfig, disabledPluginIds } = await resolveRunAgentConfig(
+    {
+      db,
+      userId,
+      workspaceId,
+      resolveAgentConfigOrThrow: async (identifier) => {
+        const config = await agentService.getAgentConfig(identifier);
+        if (!config) throw new Error('Queued assistant is no longer accessible');
+        return config;
+      },
+    },
+    {
+      ...(run.preparedRequest.overrides as ClaudeCodeTurnOverrides | undefined),
+      appContext: { ...origin, isSubAgent: origin.lineage?.isSubAgent },
+      identifier: agentId,
+      // The model selected for this queued turn stays explicit; never switch billing backends.
+      modelOverride: state.modelRuntimeConfig.model,
+      providerOverride: 'claude-code',
+      throwIfExecutionAborted: async () => {},
+    },
+  );
+  if (agentConfig.agencyConfig?.heterogeneousProvider) {
+    throw new Error('Queued assistant is no longer an ordinary assistant');
+  }
+  const settings = await resolveRunSettings({
+    agentConfig,
+    runFacts: createRunFacts({ db, userId, workspaceId }),
+  });
+  const messageModel = new MessageModel(db, userId, workspaceId);
+  const source = origin.sourceMessageId
+    ? await messageModel.findById(origin.sourceMessageId)
+    : undefined;
+  const belongsToTurn = (message: NonNullable<typeof source>) =>
+    message.userId === userId &&
+    (message.workspaceId ?? undefined) === workspaceId &&
+    message.topicId === run.topicId &&
+    (message.threadId ?? null) === run.threadId;
+  if (
+    !initRequest.resumeFromHistory &&
+    (!source || source.role !== 'user' || !belongsToTurn(source))
+  ) {
+    throw new Error('Queued user message is no longer available');
+  }
+  const assistant = origin.assistantMessageId
+    ? await messageModel.findById(origin.assistantMessageId)
+    : undefined;
+  if (
+    !assistant ||
+    assistant.role !== 'assistant' ||
+    !belongsToTurn(assistant) ||
+    (assistant.metadata?.operationId && assistant.metadata.operationId !== run.operationId)
+  ) {
+    throw new Error('Queued assistant message is no longer available');
+  }
+  if (
+    initRequest.resume ||
+    initRequest.resumeApproval ||
+    initRequest.resumeApprovals?.length ||
+    initRequest.resumeToolResult
+  ) {
+    await loadResumeParentMessage(
+      { messageModel },
+      { appContext: origin, parentMessageId: initRequest.parentMessageId },
+    );
+  }
+  const fileService = new FileService(db, userId, workspaceId);
+  const { historyMessages, source: sourceWithFiles } = await loadClaudeCodeClaimHistory({
+    messageModel,
+    postProcessUrl: async (path) => fileService.getFullFileUrl(path),
+    runFromHistory: !!initRequest.resumeFromHistory,
+    state,
+  });
+  // Message relations and explicit skill selections may have changed while queued.
+  const attachmentIds =
+    !initRequest.resumeFromHistory && sourceWithFiles
+      ? [
+          ...(sourceWithFiles.fileList ?? []),
+          ...(sourceWithFiles.imageList ?? []),
+          ...(sourceWithFiles.videoList ?? []),
+          ...(sourceWithFiles.audioList ?? []),
+        ].map(({ id }) => id)
+      : (initRequest.runAttachments.fileIds ?? initRequest.attachedFileIds ?? []);
+  const attachments = await resolveAttachmentsByFileIds({
+    db,
+    fileIds: attachmentIds,
+    userId,
+    workspaceId,
+  });
+  signal?.throwIfAborted();
+  // A removed attachment must never be replaced by the cached content from enqueue time.
+  const missing = attachmentIds.filter((id) => !attachments.orderedFileIds.includes(id));
+  const request: AgentRunInitRequest = {
+    ...initRequest,
+    attachedFileIds: attachments.orderedFileIds,
+    detachedFileContentIds: undefined,
+    disableLocalSystem: true,
+    globalMemoryEnabled: settings.globalMemoryEnabled,
+    isFixedDeviceTarget: false,
+    localDeviceId: undefined,
+    prompt: source ? (source.content ?? '') : initRequest.prompt,
+    requestedDeviceId: undefined,
+    selectedSkillIds: !initRequest.resumeFromHistory
+      ? sourceWithFiles?.metadata?.selectedSkillIds
+      : initRequest.selectedSkillIds,
+    topicBoundDeviceId: undefined,
+    runAttachments: {
+      ...attachments,
+      fileIds: attachments.orderedFileIds,
+      warnings: [
+        ...attachments.warnings,
+        ...missing.map((id) => `Attachment "${id}" is no longer accessible and was skipped.`),
+      ],
+    },
+  };
+  state.world = {
+    ...state.world,
+    agent: agentConfig,
+    disabledPluginIds,
+    enableExpertise: settings.enableExpertise,
+    expertise: undefined,
+    userMemory: undefined,
+    userTimezone: settings.userTimezone,
+  };
+  state.enableExpertise = settings.enableExpertise;
+  state.expertise = undefined;
+  state.activatedStepSkills = undefined;
+  state.binding = { ...state.binding, device: undefined };
+  state.plan = { ...state.plan, workingDirectory: undefined };
+  state.principal = {
+    ...state.principal,
+    policy: {
+      ...state.principal?.policy,
+      deviceAccess: { canUseDevice: false, reason: 'server-worker' },
+    },
+  };
+  // Reuse the same discovery, knowledge, history, skill and memory preparation as API runs.
+  // Dynamic import avoids the AiAgentService -> enqueue import cycle.
+  const { AiAgentService } = await import('@/server/services/aiAgent');
+  const initialized = await new AiAgentService(db, userId, { workspaceId }).runDeferredInit({
+    historyMessages,
+    operationId: run.operationId,
+    request,
+    state,
+  });
+  const freshState = initialized.state as AgentState;
+  signal?.throwIfAborted();
+  const runtime = new AgentRuntimeService(db, userId, { workspaceId });
+  const { executorContext } = await runtime.prepareExternalRuntime({
+    agentState: freshState,
+    operationId: run.operationId,
+    stepIndex: 0,
+  });
+  const context = await buildClaudeCodeContext(
+    new ServerContextBuilder(executorContext),
+    freshState,
+  );
+  // The same per-model reasoning setting the composer saves for API models. Read at claim
+  // time, like the rest of the context, so a change made while queued still applies.
+  const { opus47Effort: effort } =
+    (await new AiModelModel(db, userId, workspaceId).getModelReasoningConfig(
+      freshState.modelRuntimeConfig!.model,
+      'claude-code',
+    )) ?? {};
+  const prepared = prepareClaudeCodeContext({
+    context,
+    effort,
+    state: freshState,
+    isServerTool: (identifier, _apiName, type) => {
+      if (type === 'mcp') {
+        const manifest = (context.resolvedTools?.manifestMap[identifier] ??
+          freshState.operationToolSet?.manifestMap[identifier]) as
+          { mcpParams?: Parameters<typeof isDeviceOnlyMcpEndpoint>[0] } | undefined;
+        return !!manifest?.mcpParams && !isDeviceOnlyMcpEndpoint(manifest.mcpParams);
+      }
+      return (
+        hasServerRuntime(identifier) &&
+        !['lobe-local-system', 'lobe-browser', 'lobe-auv', 'lobe-remote-device'].includes(
+          identifier,
+        )
+      );
+    },
+  });
+  await assertClaudeCodeAvailable(db, userId, workspaceId);
+  await verifyAccess();
+  signal?.throwIfAborted();
+  const refreshed = await new ClaudeCodeModel(db, userId, workspaceId).replaceClaimedRequest(
+    run.operationId,
+    leaseToken,
+    {
+      ...prepared,
+      runtimeBackend: 'claude-code',
+      state: freshState,
+    },
+  );
+  await runtime.getCoordinator().saveAgentState(run.operationId, freshState);
+  return refreshed;
+};
diff --git a/apps/server/src/services/claudeCode/prepareContext.test.ts b/apps/server/src/services/claudeCode/prepareContext.test.ts
new file mode 100644
index 0000000000..19706fa3f5
--- /dev/null
+++ b/apps/server/src/services/claudeCode/prepareContext.test.ts
@@ -0,0 +1,224 @@
+import type { AgentState, ContextBuildOutput } from '@lobechat/agent-runtime';
+import { CanvasManifest } from '@lobechat/builtin-tool-canvas';
+import { ToolNameResolver } from '@lobechat/context-engine';
+import { describe, expect, it } from 'vitest';
+
+import { prepareClaudeCodeContext } from './prepareContext';
+
+const makeState = (): AgentState =>
+  ({
+    messages: [{ content: 'Raw input before preparation', id: 'current', role: 'user' }],
+    modelRuntimeConfig: { model: 'default', provider: 'claude-code' },
+    origin: { topicId: 'topic-one', userId: 'user-one', workspaceId: 'workspace-one' },
+  }) as AgentState;
+const resolver = new ToolNameResolver();
+const serverName = resolver.generate('lobe-notebook', 'createDocument');
+const browserName = resolver.generate('lobe-browser', 'openTab');
+const parameters = {
+  properties: { title: { type: 'string' } },
+  required: ['title'],
+  type: 'object',
+};
+const makeContext = (): ContextBuildOutput => ({
+  messages: [
+    { content: 'Assistant instructions', role: 'system' },
+    { content: 'Current injected memory', role: 'user' },
+    { content: 'old question', role: 'user' },
+    { content: 'old answer', role: 'assistant' },
+    { content: 'new question with attachment context', role: 'user' },
+  ],
+  replayAssistantReasoning: false,
+  resolvedTools: {
+    enabledToolIds: ['lobe-notebook', 'lobe-browser'],
+    manifestMap: {
+      'lobe-browser': {
+        api: [{ description: 'Open a tab', name: 'openTab', parameters }],
+        identifier: 'lobe-browser',
+        meta: {},
+      },
+      'lobe-notebook': {
+        api: [{ description: 'Create a document', name: 'createDocument', parameters }],
+        identifier: 'lobe-notebook',
+        meta: {},
+      },
+    },
+    promptManifestMap: {},
+    sourceMap: {},
+    tools: [
+      {
+        function: { description: 'Create a document', name: serverName, parameters },
+        type: 'function',
+      },
+      { function: { description: 'Open a tab', name: browserName, parameters }, type: 'function' },
+    ],
+  },
+});
+const prepare = (state = makeState(), context = makeContext()) =>
+  prepareClaudeCodeContext({
+    context,
+    isServerTool: (identifier) => identifier === 'lobe-notebook',
+    state,
+  });
+
+describe('ordinary assistant Claude Code prepared context', () => {
+  it('sends every prepared message once without reconstructing raw history or CLI session data', () => {
+    const { request } = prepare();
+    expect(request.prompt).toEqual([
+      { text: '{"role":"user"}', type: 'text' },
+      { text: 'Current injected memory', type: 'text' },
+      { text: '{"role":"user"}', type: 'text' },
+      { text: 'old question', type: 'text' },
+      { text: '{"role":"assistant"}', type: 'text' },
+      { text: 'old answer', type: 'text' },
+      { text: '{"role":"user"}', type: 'text' },
+      { text: 'new question with attachment context', type: 'text' },
+    ]);
+    expect(request.systemPrompt).toContain('Assistant instructions');
+    expect(Object.keys(request).sort()).toEqual([
+      'model',
+      'prompt',
+      'protocol',
+      'systemPrompt',
+      'tools',
+    ]);
+    expect(JSON.stringify(request)).not.toContain('Raw input before preparation');
+  });
+
+  it('registers permitted Canvas operations but excludes disabled, unknown, client and manifest-only tools', () => {
+    const state = makeState();
+    const context = makeContext();
+    const disabled = { ...CanvasManifest, identifier: 'disabled-canvas' };
+    const forbidden = { ...CanvasManifest, identifier: 'ungranted-canvas' };
+    state.world = { disabledPluginIds: [disabled.identifier] };
+    state.operationToolSet = {
+      activatableToolIds: [
+        CanvasManifest.identifier,
+        disabled.identifier,
+        'missing',
+        'lobe-browser',
+      ],
+      enabledToolIds: ['lobe-notebook'],
+      manifestMap: {
+        ...context.resolvedTools!.manifestMap,
+        [CanvasManifest.identifier]: CanvasManifest,
+        [disabled.identifier]: disabled,
+        [forbidden.identifier]: forbidden,
+      },
+      sourceMap: {},
+      tools: context.resolvedTools!.tools,
+    };
+    const { request, unavailableTools } = prepareClaudeCodeContext({
+      context,
+      isServerTool: (identifier) => identifier !== 'lobe-browser',
+      state,
+    });
+    const canvas = request.tools.filter((tool) => tool.identifier === CanvasManifest.identifier);
+    expect(canvas.map((tool) => tool.apiName)).toEqual(CanvasManifest.api.map((api) => api.name));
+    expect(canvas).not.toHaveLength(0);
+    expect(
+      request.tools.some((tool) =>
+        [disabled.identifier, forbidden.identifier, 'missing', 'lobe-browser'].includes(
+          tool.identifier,
+        ),
+      ),
+    ).toBe(false);
+    expect(unavailableTools).toEqual([browserName]);
+    expect(new Set(request.tools.map((tool) => tool.name)).size).toBe(request.tools.length);
+  });
+
+  it('sends the saved effort only when one is set', () => {
+    const base = { context: makeContext(), isServerTool: () => true, state: makeState() };
+    expect(prepareClaudeCodeContext(base).request).not.toHaveProperty('effort');
+    expect(prepareClaudeCodeContext({ ...base, effort: 'xhigh' }).request.effort).toBe('xhigh');
+  });
+
+  it('uses current permissions after a tool is disabled', () => {
+    const state = makeState();
+    state.world = { disabledPluginIds: ['lobe-notebook'] };
+    expect(prepare(state).request.tools).toEqual([]);
+  });
+
+  it('preserves multimodal input and rejects unsupported attachments', () => {
+    const context = makeContext();
+    context.messages[4] = {
+      content: [
+        { type: 'text', text: 'Read the image' },
+        { type: 'image_url', image_url: { url: 'https://example.com/image.png' } },
+      ],
+      role: 'user',
