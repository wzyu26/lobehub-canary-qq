+      selectedSkillIds: [skills[0].identifier],
+    });
+    await addMessage('claim-chosen-tail', 'assistant', 'chosen-tail', 'claim-chosen-user');
+    await addMessage('claim-inactive-answer', 'assistant', 'inactive-answer', 'claim-root');
+    await addMessage('claim-inactive-user', 'user', 'inactive-question', 'claim-inactive-answer', {
+      selectedSkillIds: [skills[1].identifier],
+    });
+    const queued = await caller().execAgent({
+      agentId: agent.id,
+      appContext: { topicId: topic.id },
+      clientIds: { userMessageParentId: 'claim-chosen-tail' },
+      prompt: 'queued-question',
+    });
