--- /dev/null
+++ b/packages/heterogeneous-agents/src/spawn/spawnAgent.cancellation.test.ts
@@ -0,0 +1,62 @@
+import type { ChildProcess } from 'node:child_process';
+import * as childProcess from 'node:child_process';
+import { EventEmitter } from 'node:events';
+import type * as os from 'node:os';
+import { PassThrough } from 'node:stream';
+
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+import { spawnAgent } from './spawnAgent';
+
+vi.mock('node:child_process', async (importOriginal) => ({
+  ...(await importOriginal<typeof childProcess>()),
+  spawn: vi.fn(),
+}));
+
+vi.mock('node:os', async (importOriginal) => ({
+  ...(await importOriginal<typeof os>()),
+  platform: () => 'linux',
+}));
+
+describe('spawnAgent process cancellation', () => {
+  afterEach(() => vi.restoreAllMocks());
+
+  it('allows SIGKILL escalation after an inherited-group child ignores SIGTERM', async () => {
+    const proc = Object.assign(new EventEmitter(), {
+      exitCode: null as number | null,
+      kill: vi.fn((_signal?: NodeJS.Signals) => {
+        proc.killed = true;
+        return true;
+      }),
+      killed: false,
+      pid: 12345,
+      signalCode: null as NodeJS.Signals | null,
+      stderr: new PassThrough(),
+      stdin: new PassThrough(),
+      stdout: new PassThrough(),
+    });
+    vi.mocked(childProcess.spawn).mockReturnValue(proc as unknown as ChildProcess);
+    const handle = await spawnAgent({
+      agentType: 'claude-code',
+      detached: false,
+      operationId: 'op-cancel',
+      prompt: 'hello',
+    });
+
+    handle.kill('SIGTERM');
+    expect(proc.killed).toBe(true);
+    expect(proc.signalCode).toBeNull();
+    handle.kill('SIGKILL');
+    expect(proc.kill.mock.calls.map(([signal]) => signal)).toEqual(['SIGTERM', 'SIGKILL']);
+
+    // Once exit is observed, a repeated stop must not signal a recycled PID.
+    proc.signalCode = 'SIGKILL';
+    proc.emit('exit', null, 'SIGKILL');
+    handle.kill('SIGKILL');
+    expect(proc.kill).toHaveBeenCalledTimes(2);
+    proc.stdout.end();
+    proc.stderr.end();
+    for await (const _event of handle.events);
+    await expect(handle.exit).resolves.toEqual({ code: null, signal: 'SIGKILL' });
+  });
+});
