+import { getSessionStoreState } from '@/store/session';
+import { useUserStore } from '@/store/user';
+
+import { createMockAgentConfig, TEST_IDS } from './fixtures';
+import { resetTestEnvironment, setupMockSelectors, spyOnMessageService } from './helpers';
+
+const hetero = vi.hoisted(() => vi.fn());
+vi.mock('../transports/hetero/heterogeneousAgentExecutor', () => ({
+  executeHeterogeneousAgent: hetero,
+}));
+vi.mock('@/libs/trpc/client', () => ({
+  lambdaClient: { session: { updateSession: { mutate: vi.fn() } } },
+}));
+vi.mock('@/services/resourcePermission', () => ({
+  resourcePermissionService: { getGeneralAccess: vi.fn() },
+}));
+
+beforeEach(() => {
+  resetTestEnvironment();
+  spyOnMessageService();
+  setupMockSelectors({
+    agentConfig: { agencyConfig: undefined, model: 'claude-code', provider: 'claude-code' },
+  });
+  vi.spyOn(agentService, 'getAgentConfigById').mockResolvedValue(createMockAgentConfig() as any);
+  vi.spyOn(getSessionStoreState(), 'triggerSessionUpdate').mockResolvedValue(undefined);
+  useUserStore.setState({ workspaceUserPreference: {} });
+  useFileStore.setState({ chatContextSelectionsByContext: {} });
+  useChatStore.setState({
+    executeClientAgent: vi.fn(),
+    isGatewayModeEnabled: () => false,
+    refreshMessages: vi.fn(),
+    refreshTopic: vi.fn(),
+    mainInputEditor: null,
+  });
+});
+afterEach(() => {
+  vi.restoreAllMocks();
+  hetero.mockReset();
+});
+
+describe('ordinary Claude Code send routing', () => {
+  it.each([false, true])(
+    'routes through server with gateway preference off, topic model override=%s',
+    async (topicOverride) => {
+      if (topicOverride) {
+        setupMockSelectors({ agentConfig: { model: 'gpt-test', provider: 'openai' } });
+        vi.spyOn(topicSelectors, 'getTopicById').mockReturnValue(
+          () => ({ id: TEST_IDS.TOPIC_ID, model: 'default', provider: 'claude-code' }) as any,
+        );
+      }
+      const gateway = vi.fn().mockImplementation(async (params) => {
+        useChatStore.getState().completeOperation(params.parentOperationId);
+        return {
+          assistantMessageId: TEST_IDS.ASSISTANT_MESSAGE_ID,
+          operationId: 'server-operation',
+          userMessageId: TEST_IDS.USER_MESSAGE_ID,
+        };
+      });
+      useChatStore.setState({ executeGatewayAgent: gateway });
+      const api = vi.spyOn(aiChatService, 'sendMessageInServer');
+      await act(async () => {
+        await useChatStore.getState().sendMessage({
+          context: { agentId: TEST_IDS.SESSION_ID, topicId: TEST_IDS.TOPIC_ID },
+          forceRuntime: 'client',
+          message: 'Use the server assistant',
+        });
+      });
+      expect(gateway).toHaveBeenCalledTimes(1);
+      expect(useChatStore.getState().executeClientAgent).not.toHaveBeenCalled();
+      expect(hetero).not.toHaveBeenCalled();
+      expect(api).not.toHaveBeenCalled();
+    },
+  );
+
+  it('does not fall back to client execution when the server transport rejects', async () => {
+    const gateway = vi.fn().mockRejectedValue(new Error('serverConfig.agentGatewayUrl is missing'));
+    useChatStore.setState({ executeGatewayAgent: gateway });
+    await act(async () => {
+      await useChatStore.getState().sendMessage({
+        context: { agentId: TEST_IDS.SESSION_ID, topicId: TEST_IDS.TOPIC_ID },
+        message: 'Use the server assistant',
+      });
+    });
+    expect(gateway).toHaveBeenCalledTimes(1);
+    expect(useChatStore.getState().executeClientAgent).not.toHaveBeenCalled();
+    expect(hetero).not.toHaveBeenCalled();
+    expect(
+      Object.values(useChatStore.getState().operations).some(
+        (operation) =>
+          operation.status === 'failed' &&
+          operation.metadata.error?.message.includes('agentGatewayUrl is missing'),
+      ),
+    ).toBe(true);
+  });
+});
