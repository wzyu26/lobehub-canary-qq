+++ b/apps/server/src/services/claudeCode/__tests__/interventionSettlement.integration.test.ts
@@ -0,0 +1,222 @@
+// @vitest-environment node
+import type { AgentInterventionRequestData } from '@lobechat/agent-gateway-client';
+import { eq } from 'drizzle-orm';
+import superjson from 'superjson';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { ClaudeCodeModel } from '@/database/models/claudeCode';
+import { MessageModel } from '@/database/models/message';
+import { claudeCodeRuns, messagePlugins } from '@/database/schemas';
+
+import { settleClaudeCodeRun } from '../finish';
+import { waitClaudeCodeIntervention } from '../interventionBridge';
+import { projectClaudeCodeEvents, restoreClaudeCodeProjection } from '../projectEvents';
+import { recoverClaudeCodeRuns } from '../recover';
+import { db, event, leaseToken, model, owner, prepareRows, resetRows, running } from './testUtils';
+
+const { dispatchHooks, publishStreamEvent, saveAgentState } = vi.hoisted(() => ({
+  dispatchHooks: vi.fn(),
+  publishStreamEvent: vi.fn(),
+  saveAgentState: vi.fn(),
+}));
+vi.mock('@/server/modules/AgentRuntime', () => ({
+  AgentRuntimeCoordinator: class {
+    saveAgentState = saveAgentState;
+  },
+  createStreamEventManager: () => ({ publishStreamEvent }),
+}));
+vi.mock('@/server/modules/AgentRuntime/factory', () => ({
+  createStreamEventManager: () => ({ publishStreamEvent }),
+}));
+vi.mock('@/server/services/agentRuntime/CompletionLifecycle', () => ({
+  CompletionLifecycle: class {
+    dispatchHooks = dispatchHooks;
+  },
+}));
+
+const question = (toolCallId: string): AgentInterventionRequestData => ({
+  apiName: 'askUserQuestion',
+  arguments: JSON.stringify({
+    questions: [{ header: 'Proceed', question: 'Continue?', options: [{ label: 'Yes' }] }],
+  }),
+  deadline: Date.now() + 60_000,
+  identifier: 'claude-code',
+  interactionKind: 'question',
+  provider: 'claude-code',
+  toolCallId,
+});
+const card = async (toolCallId: string) => {
+  const rows = await db
+    .select()
+    .from(messagePlugins)
+    .where(eq(messagePlugins.toolCallId, toolCallId));
+  expect(rows).toHaveLength(1);
+  return rows[0];
+};
+const expire = async (operationId: string) => {
+  await db
+    .update(claudeCodeRuns)
+    .set({ leaseExpiresAt: new Date(Date.now() - 1000) })
+    .where(eq(claudeCodeRuns.operationId, operationId));
+  await ClaudeCodeModel.interruptStaleRuns(db);
+};
+
+describe('Claude Code question settlement through real message and recovery models', () => {
+  beforeEach(async () => {
+    vi.resetAllMocks();
+    await prepareRows();
+  });
+  afterEach(async () => {
+    vi.restoreAllMocks();
+    await resetRows();
+  });
+
+  it('closes only the crashed operation questions without flushing a stale text accumulator', async () => {
+    const { scope, assistantMessageId } = await running();
+    await model().appendEvents(scope.operationId, leaseToken, [
+      event(1, 'stream_chunk', { chunkType: 'text', content: 'latest persisted answer' }),
+      event(2, 'agent_intervention_request', { ...question('crashed-question') }),
+    ]);
+    await projectClaudeCodeEvents(scope);
+    await model().withProjectionState(scope.operationId, async (_tx, _run, checkpoint) => {
+      const projection = restoreClaudeCodeProjection(checkpoint).get(scope.operationId)!;
+      projection.main.accContent = 'stale accumulator';
+      return { ...checkpoint, reducer: superjson.stringify(projection) };
+    });
+    await expire(scope.operationId);
+    const other = await running('active-operation');
+    await model().appendEvents(other.scope.operationId, leaseToken, [
+      event(
+        1,
+        'agent_intervention_request',
+        { ...question('active-question') },
+        other.scope.operationId,
+      ),
+    ]);
+    await projectClaudeCodeEvents(other.scope);
+
+    await recoverClaudeCodeRuns(db, { userId: owner });
+    await recoverClaudeCodeRuns(db, { userId: owner });
+
+    expect((await card('crashed-question')).intervention).toMatchObject({
+      operationId: scope.operationId,
+      rejectedReason: 'session_ended',
+      resolving: false,
+      status: 'aborted',
+    });
+    expect((await card('active-question')).intervention?.status).toBe('pending');
+    expect((await new MessageModel(db, owner).findById(assistantMessageId))?.content).toBe(
+      'latest persisted answer',
+    );
+    expect((await model().getRun(scope.operationId))?.status).toBe('interrupted');
+    expect((await model().getRun(other.scope.operationId))?.status).toBe('running');
+    expect(dispatchHooks).toHaveBeenCalledTimes(1);
+    const checkpoint = await model().getProjectionState(scope.operationId);
+    expect(restoreClaudeCodeProjection(checkpoint).get(scope.operationId)?.main.ended).toBe(true);
+  });
+
+  it('closes a bridge question after bounded polling exited even without any CLI stream event', async () => {
+    const { scope } = await running();
+    await expect(
+      waitClaudeCodeIntervention({
+        ...scope,
+        leaseToken,
+        maxWaitMs: 0,
+        request: question('bridge-question'),
+      }),
+    ).resolves.toEqual({ pending: true });
+    expect((await card('bridge-question')).intervention?.status).toBe('pending');
+    await expire(scope.operationId);
+
+    await recoverClaudeCodeRuns(db, { userId: owner });
+
+    expect((await card('bridge-question')).state).toMatchObject({
+      claudeCodeServer: true,
+      heterogeneousIntervention: { operationId: scope.operationId, transition: 'session_ended' },
+    });
+    expect((await card('bridge-question')).intervention?.status).toBe('aborted');
+    expect((await model().getRun(scope.operationId))?.lastEventSequence).toBe(0);
+    expect((await model().getProjectionState(scope.operationId))?.settled).toBe(true);
+  });
+
+  it('archives late questions as closed and receipt retries never recreate a card or lifecycle', async () => {
+    const { scope } = await running();
+    await expire(scope.operationId);
+    await settleClaudeCodeRun(scope);
+    const tail = [event(1, 'agent_intervention_request', { ...question('late-question') })];
+    await model().appendEvents(scope.operationId, leaseToken, tail);
+    await settleClaudeCodeRun(scope);
+    await model().appendEvents(scope.operationId, leaseToken, tail);
+    await settleClaudeCodeRun(scope);
+
+    expect((await card('late-question')).intervention?.status).toBe('aborted');
+    expect((await card('late-question')).state).toMatchObject({
+      heterogeneousIntervention: { transition: 'session_ended' },
+    });
+    expect(dispatchHooks).toHaveBeenCalledTimes(1);
+    expect((await model().getRun(scope.operationId))?.projectedSequence).toBe(1);
+    expect(
+      publishStreamEvent.mock.calls.filter(([, e]) => e.type === 'agent_runtime_end'),
+    ).toHaveLength(1);
+  });
+
+  it('cannot restore a pending card when settlement wins before the bridge lock and HTTP disconnected', async () => {
+    const { scope } = await running();
+    const original = ClaudeCodeModel.prototype.withProjectionState;
+    let lockCount = 0;
+    vi.spyOn(ClaudeCodeModel.prototype, 'withProjectionState').mockImplementation(async function (
+      this: ClaudeCodeModel,
+      ...args
+    ) {
+      lockCount += 1;
+      // The first lock belongs to ensureClaudeCodeToolMessage. Let settlement
+      // finish before the bridge acquires its distinct pending-card lock.
+      if (lockCount === 2) {
+        await expire(scope.operationId);
+        await settleClaudeCodeRun(scope);
+      }
+      return original.apply(this, args);
+    });
+    await expect(
+      waitClaudeCodeIntervention({
+        ...scope,
+        leaseToken,
+        maxWaitMs: 0,
+        request: question('raced-question'),
+        signal: AbortSignal.abort(),
+      }),
+    ).resolves.toEqual({ cancelReason: 'session_ended', cancelled: true });
+    expect((await card('raced-question')).intervention).toMatchObject({
+      rejectedReason: 'session_ended',
+      status: 'rejected',
+    });
+    expect(
+      publishStreamEvent.mock.calls.some(([, e]) => e.type === 'agent_intervention_request'),
+    ).toBe(false);
+    expect((await model().getProjectionState(scope.operationId))?.settled).toBe(true);
+  });
+
+  it('retries a lost request-publication reply with one card and the same event identity', async () => {
+    const { scope } = await running();
+    const request = question('publication-question');
+    const delivered = new Set<string>();
+    let loseReply = true;
+    publishStreamEvent.mockImplementation(async (_operationId, published) => {
+      delivered.add(published.deduplicationKey);
+      if (loseReply) {
+        loseReply = false;
+        throw new Error('Request publication reply lost');
+      }
+    });
+    const params = { ...scope, leaseToken, maxWaitMs: 0, request };
+    await expect(waitClaudeCodeIntervention(params)).rejects.toThrow(
+      'Request publication reply lost',
+    );
+    expect((await card(request.toolCallId)).intervention).toBeNull();
+
+    await expect(waitClaudeCodeIntervention(params)).resolves.toEqual({ pending: true });
+
+    expect((await card(request.toolCallId)).intervention?.status).toBe('pending');
+    expect(delivered).toEqual(new Set([`claude-code:intervention:${request.toolCallId}:request`]));
+  });
+});
diff --git a/apps/server/src/services/claudeCode/__tests__/ordinaryAssistant.integration.test.ts b/apps/server/src/services/claudeCode/__tests__/ordinaryAssistant.integration.test.ts
