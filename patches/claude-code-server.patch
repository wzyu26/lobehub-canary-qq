+import { HttpWorkerApi } from './api';
+import { loadWorkerConfig } from './config';
+import { serveWorker } from './service';
+
+const shutdown = new AbortController();
+process.once('SIGTERM', () => shutdown.abort());
+process.once('SIGINT', () => shutdown.abort());
+
+try {
+  const config = await loadWorkerConfig(process.env);
+  console.info(
+    JSON.stringify({
+      buildRevision: config.buildRevision,
+      cliVersion: config.cliVersion,
+      service: 'claude-code-worker',
+    }),
+  );
+  await serveWorker(config, new HttpWorkerApi(config), shutdown.signal);
+} catch {
+  console.error('Claude Code worker could not start; check its deployment configuration');
+  process.exitCode = 1;
+}
