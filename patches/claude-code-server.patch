+import { ClaudeCodeModel } from '@/database/models/claudeCode';
+import type { LobeChatDatabase } from '@/database/type';
+
+/** Explicit opt-in; absence must leave both HTTP APIs and model entry disabled. */
+export const isClaudeCodeServerEnabled = () => process.env.CLAUDE_CODE_SERVER_ENABLED === '1';
+
+export const getClaudeCodeStatus = async (
+  db: LobeChatDatabase,
+  userId: string,
+  workspaceId?: string,
+) => {
+  const disabled = { authStatus: 'unknown' as const, available: false, enabled: false, models: [] };
+  const binding = await new ClaudeCodeModel(db, userId, workspaceId).getBinding();
+  if (!binding) return disabled;
+  await (await import('./recover')).recoverClaudeCodeRuns(db, { userId, workspaceId });
+  if (!isClaudeCodeServerEnabled() || !binding.enabled) return disabled;
+  const available =
+    binding.authStatus === 'logged_in' &&
+    binding.capabilities?.protocolVersion === 1 &&
+    !!binding.lastSeenAt &&
+    Date.now() - binding.lastSeenAt.getTime() < 60_000;
+  return {
+    authStatus: binding.authStatus,
+    available,
+    cliVersion: binding.capabilities?.cliVersion,
+    enabled: true,
+    models: (binding.capabilities?.models ?? []).map(({ id, label }) => ({
+      displayName: label,
+      id,
+    })),
+  };
+};
