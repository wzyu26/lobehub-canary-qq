+import { inMemoryAgentStateManager } from '@/server/modules/AgentRuntime/InMemoryAgentStateManager';
+import { inMemoryStreamEventManager } from '@/server/modules/AgentRuntime/InMemoryStreamEventManager';
+import { aiAgentRouter } from '@/server/routers/lambda/aiAgent';
+
+import { prepareClaimedClaudeCodeRun } from '../prepareClaim';
+
+let db: LobeChatDatabase;
+vi.mock('@/database/core/db-adaptor', () => ({ getServerDB: () => db }));
+vi.mock('@/server/services/file', () => ({
+  FileService: class {
+    getFullFileUrl(path: string) {
+      return path ? `/files${path}` : null;
+    }
+    getFileAccessUrl({ url }: { url: string }) {
+      return url;
+    }
+  },
+}));
+const deviceReads = vi.hoisted(() => vi.fn().mockResolvedValue([]));
+vi.mock('@/server/services/deviceGateway/scopedDevices', () => ({
+  getScopedOnlineDevices: deviceReads,
+}));
+vi.mock('@/server/modules/AgentRuntime/adapters/ServerModelRuntime', () => ({
+  ServerModelRuntime: class {
+    generate() {
+      throw new Error('Unexpected API billing');
+    }
+  },
+}));
+
+const userId = 'claude-claim-history-test';
+const workerId = 'claude-claim-history-worker';
+const leaseToken = 'claim-history-integration-lease-token';
+const caller = () => aiAgentRouter.createCaller({ jwtPayload: { userId }, userId });
+const claim = async () => {
+  const run = await new ClaudeCodeModel(db, userId).claimNextRun(workerId, leaseToken);
+  expect(run).toBeDefined();
+  return prepareClaimedClaudeCodeRun({ db, leaseToken, run: run!, userId });
+};
+const createAgent = async () => {
+  const [agent] = await db
+    .insert(agents)
+    .values({ model: 'default', provider: 'claude-code', userId })
+    .returning();
+  return agent;
+};
+
+beforeEach(async () => {
+  vi.stubEnv('CLAUDE_CODE_SERVER_ENABLED', '1');
+  db = await getTestDB();
+  await db.insert(users).values({ id: userId });
+  const model = new ClaudeCodeModel(db, userId);
+  await model.provisionBinding({
+    secretHash: createHash('sha256').update('test-service-token').digest('hex'),
+    workerId,
+  });
+  await model.setBindingEnabled(true);
+  await model.updateWorkerStatus(workerId, {
+    authStatus: 'logged_in',
+    capabilities: {
+      cliVersion: '2.1.301',
+      models: [{ id: 'default', label: 'Default' }],
+      protocolVersion: 1,
+    },
+  });
+});
+afterEach(async () => {
+  await db.delete(users).where(eq(users.id, userId));
+  inMemoryAgentStateManager.clear();
+  inMemoryStreamEventManager.clear();
+  vi.unstubAllEnvs();
+  vi.clearAllMocks();
+});
+
+describe('claim-time ordinary conversation scope', () => {
+  it('prepares only the queued branch, excluding inactive and later-turn selected skill content', async () => {
+    const agent = await createAgent();
+    const [topic] = await db.insert(topics).values({ agentId: agent.id, userId }).returning();
+    const skills = await db
+      .insert(agentSkills)
+      .values(
+        ['chosen', 'inactive', 'future'].map((name) => ({
+          content: `secret-${name}-skill-body`,
+          description: name,
+          identifier: name,
+          name,
+          source: 'user' as const,
+          userId,
+        })),
+      )
+      .returning();
+    const addMessage = async (
+      id: string,
+      role: string,
+      content: string,
