+import type { ClaudeCodeStatus } from '@lobechat/types';
+import { renderHook } from '@testing-library/react';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { useClaudeCodeModels } from './useClaudeCodeModels';
+
+const state = vi.hoisted(() => ({
+  isSignedIn: true,
+  status: undefined as ClaudeCodeStatus | undefined,
+  useSWR: vi.fn(),
+  userId: 'user-one',
+}));
+
+vi.mock('@/store/user', () => ({
+  useUserStore: (select: (value: object) => unknown) =>
+    select({ isSignedIn: state.isSignedIn, user: { id: state.userId } }),
+}));
+
+vi.mock('@/libs/swr', () => ({
+  useClientDataSWR: (...args: unknown[]) => {
+    state.useSWR(...args);
+    return { data: state.status };
+  },
+}));
+
+vi.mock('@/services/claudeCode', () => ({
+  claudeCodeService: { getStatus: vi.fn() },
+}));
+
+describe('server backend model status scope', () => {
+  beforeEach(() => {
+    state.isSignedIn = true;
+    state.userId = 'user-one';
+    state.status = {
+      authStatus: 'logged_in',
+      available: true,
+      enabled: true,
+      models: [{ displayName: 'Default', id: 'default' }],
+    };
+    state.useSWR.mockClear();
+  });
+
+  it('uses separate user keys and never retains the previous account response during a key change', () => {
+    const { result, rerender } = renderHook(() => useClaudeCodeModels([]));
+    const firstKey = state.useSWR.mock.calls.at(-1)?.[0];
+    expect(result.current.enabledList[0]?.id).toBe('claude-code');
+
+    state.userId = 'user-two';
+    state.status = undefined;
+    rerender();
+
+    expect(state.useSWR.mock.calls.at(-1)?.[0]).not.toEqual(firstKey);
+    expect(state.useSWR.mock.calls.at(-1)?.[2]).toMatchObject({ keepPreviousData: false });
+    expect(result.current.enabledList).toEqual([]);
+  });
+
+  it('does not request or expose models on an opted-out picker or after sign-out', () => {
+    const { result, rerender } = renderHook(({ enabled }) => useClaudeCodeModels([], enabled), {
+      initialProps: { enabled: false },
+    });
+    expect(state.useSWR.mock.calls.at(-1)?.[0]).toBeNull();
+    expect(result.current.enabledList).toEqual([]);
+
+    state.isSignedIn = false;
+    rerender({ enabled: true });
+    expect(state.useSWR.mock.calls.at(-1)?.[0]).toBeNull();
+    expect(result.current.enabledList).toEqual([]);
+  });
+});
