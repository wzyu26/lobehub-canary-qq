+import { ClaudeCodeModel } from '@/database/models/claudeCode';
+
+import type { ClaudeCodeProjectionScope } from './projectEvents';
+
+/** A queued cancellation has no worker that could deliver its terminal callback. */
+export const cancelClaudeCodeRun = async (scope: ClaudeCodeProjectionScope) => {
+  const run = await new ClaudeCodeModel(scope.db, scope.userId, scope.workspaceId).cancelRun(
+    scope.operationId,
+  );
+  if (run && !['queued', 'running', 'cancelling'].includes(run.status)) {
+    await (await import('./finish')).settleClaudeCodeRun(scope);
+  }
+  return run;
+};
