+}));
+vi.mock('@lobechat/agent-runtime', () => ({ callTool: () => mocks.execute }));
+vi.mock('@/database/models/claudeCode', () => ({
+  ClaudeCodeModel: class {
+    claimToolCall = mocks.claim;
+    completeToolCall = mocks.complete;
+    getBinding = mocks.getBinding;
+    getRun = mocks.getRun;
+    heartbeatToolCall = mocks.heartbeat;
+    updateRuntimeState = mocks.updateState;
+  },
+  ClaudeCodeStateError: class extends Error {
+    constructor(
+      readonly code: string,
+      message: string,
+    ) {
+      super(message);
+    }
+  },
+}));
+vi.mock('@/database/models/message', () => ({
+  MessageModel: class {
+    updateToolMessage = mocks.updateMessage;
+  },
+}));
+vi.mock('@/server/services/agentRuntime', () => ({
+  AgentRuntimeService: class {
+    prepareExternalRuntime = mocks.prepare;
+  },
+}));
+vi.mock('@/server/modules/AgentRuntime/buildHost', () => ({ buildHost: mocks.buildHost }));
+vi.mock('@/server/modules/AgentRuntime/factory', () => ({ createStreamEventManager: () => ({}) }));
+vi.mock('./interventionBridge', () => ({ waitClaudeCodeIntervention: mocks.wait }));
+vi.mock('./messageScope', () => ({
+  ensureClaudeCodeToolMessage: mocks.ensure,
+  findClaudeCodeToolMessage: mocks.findMessage,
+}));
+
+const state = () => ({
+  messages: [],
+  origin: { topicId: 'topic', userId: 'owner' },
+  status: 'running',
+  stepCount: 1,
+});
+const run = () => ({
+  leaseExpiresAt: new Date(Date.now() + 60_000),
+  operationId: 'run',
+  preparedRequest: {
+    request: {
+      tools: [
+        {
+          apiName: 'write',
+          identifier: 'documents',
+          inputSchema: {
+            properties: { title: { type: 'string' } },
+            required: ['title'],
+            type: 'object',
+          },
+          name: 'documents_write',
+          type: 'builtin',
+        },
+      ],
+    },
+    state: state(),
+  },
+  status: 'running',
+  threadId: null,
+  topicId: 'topic',
+  userId: 'owner',
+  workspaceId: null,
+});
+const params = {
+  args: { title: 'Test' },
+  db: {} as LobeChatDatabase,
+  leaseToken: 'lease',
+  name: 'documents_write',
+  operationId: 'run',
+  toolCallId: 'real-claude-tool-id',
+  userId: 'owner',
+};
+
+beforeEach(() => {
+  vi.resetAllMocks();
+  mocks.getRun.mockImplementation(async () => run());
+  mocks.getBinding.mockResolvedValue({ authStatus: 'logged_in', enabled: true });
+  mocks.claim.mockResolvedValue({ disposition: 'execute' });
+  mocks.ensure.mockResolvedValue('existing-native-card');
+  mocks.prepare.mockResolvedValue({
+    agent: { checkInterventionNeeded: mocks.checkPolicy },
+    executorContext: {},
+    runtime: { tick: mocks.tick },
+  });
+  mocks.checkPolicy.mockResolvedValue([[], []]);
+  mocks.buildHost.mockReturnValue({ transports: { tools: { maxRetries: 2 } } });
+  mocks.execute.mockResolvedValue({
+    events: [
+      {
+        result: { content: 'Saved document', state: { documentId: 'doc' }, success: true },
+        type: 'tool_result',
+      },
+    ],
+    newState: state(),
+  });
+});
+
+describe('executeClaudeCodeTool', () => {
+  it('validates the server schema and rejects undeclared identity arguments without coercing them', async () => {
+    await expect(executeClaudeCodeTool({ ...params, args: { title: 2 } })).rejects.toMatchObject({
+      code: 'invalid_tool_arguments',
+    });
+    await expect(
+      executeClaudeCodeTool({ ...params, args: { title: 'Test', userId: 'other' } }),
+    ).rejects.toMatchObject({ code: 'invalid_tool_arguments' });
+    expect(mocks.claim).not.toHaveBeenCalled();
+    expect(() =>
+      validateClaudeCodeToolArguments(
+        { type: 'object', properties: { userId: { type: 'string' } }, required: ['userId'] },
+        { userId: 'platform-target' },
+      ),
+    ).not.toThrow();
+  });
+  it('uses the shared executor and native card with real call ID, without a model tick or write retry', async () => {
+    const result = await executeClaudeCodeTool(params);
+    expect(result).toMatchObject({
+      result: {
+        content: [{ text: 'Saved document' }],
+        structuredContent: { state: { documentId: 'doc' } },
+      },
+      status: 'completed',
+    });
+    expect(mocks.execute).toHaveBeenCalledWith(
+      {
+        payload: {
+          parentMessageId: 'existing-native-card',
+          skipCreateToolMessage: true,
+          toolCalling: {
+            apiName: 'write',
+            arguments: '{"title":"Test"}',
+            id: params.toolCallId,
+            identifier: 'documents',
+            type: 'builtin',
+          },
+        },
+        type: 'call_tool',
+      },
+      state(),
+    );
+    expect(mocks.buildHost.mock.results[0].value.transports.tools.maxRetries).toBe(0);
+    expect(mocks.tick).not.toHaveBeenCalled();
+    expect(mocks.complete).toHaveBeenCalledWith('run', 'lease', params.toolCallId, result.result);
+    expect(mocks.updateState).toHaveBeenCalledOnce();
+  });
+
+  it('rejects unregistered tools and mismatched runtime identity before executing', async () => {
+    await expect(executeClaudeCodeTool({ ...params, name: 'unregistered' })).rejects.toThrow(
+      'not enabled',
+    );
+    mocks.getRun.mockResolvedValue({
+      ...run(),
+      preparedRequest: {
+        ...run().preparedRequest,
+        state: { ...state(), origin: { userId: 'other' } },
+      },
+    });
+    await expect(executeClaudeCodeTool(params)).rejects.toThrow('identity');
+    expect(mocks.claim).not.toHaveBeenCalled();
+    expect(mocks.execute).not.toHaveBeenCalled();
+  });
+
+  it('replays a completed receipt and waits for a concurrent receipt without re-executing', async () => {
+    const result = { content: [{ text: 'already saved', type: 'text' }] };
+    mocks.claim.mockResolvedValueOnce({ disposition: 'replay', receipt: { result } });
+    expect(await executeClaudeCodeTool(params)).toEqual({ result, status: 'completed' });
+    mocks.claim.mockResolvedValueOnce({ disposition: 'in_progress' });
+    expect(await executeClaudeCodeTool(params)).toEqual({ status: 'pending' });
+    mocks.claim.mockResolvedValueOnce({ disposition: 'busy' });
+    expect(await executeClaudeCodeTool(params)).toEqual({ status: 'pending' });
+    expect(mocks.execute).not.toHaveBeenCalled();
+  });
+
+  it('fails closed on cancelled permission or display labels instead of the stable consent ID', async () => {
+    mocks.checkPolicy.mockResolvedValue([[{}], []]);
+    mocks.wait.mockImplementation(async ({ request }) => {
+      const question = JSON.parse(request.arguments).questions[0].question;
+      return { result: { [question]: 'Allow once' } };
+    });
+    expect(await executeClaudeCodeTool(params)).toMatchObject({
+      result: { isError: true },
+      status: 'completed',
+    });
+    expect(mocks.execute).not.toHaveBeenCalled();
+    expect(mocks.wait.mock.calls[0][0].request.toolCallId).toBe(`approval:${params.toolCallId}`);
+  });
+
+  it('executes exactly once after approval of the displayed arguments', async () => {
+    mocks.checkPolicy.mockResolvedValue([[{}], []]);
+    mocks.wait.mockImplementation(async ({ request }) => {
+      const question = JSON.parse(request.arguments).questions[0].question;
+      expect(question).toContain('Test');
+      return { result: { [question]: 'allow_once' } };
+    });
+    await executeClaudeCodeTool(params);
+    expect(mocks.execute).toHaveBeenCalledOnce();
+  });
+
+  it('waits for a deferred terminal result instead of returning the submission description', async () => {
+    mocks.execute.mockResolvedValue({
+      events: [],
+      newState: {
+        ...state(),
+        interruption: { reason: 'async_tool' },
+        status: 'waiting_for_async_tool',
+      },
+    });
+    mocks.findMessage
+      .mockResolvedValueOnce({
+        message: { content: 'Task submitted' },
+        plugin: { state: { status: 'running' } },
+      })
+      .mockResolvedValueOnce({
+        message: { content: 'Actual completed result' },
+        plugin: { state: { status: 'completed' } },
+      });
+    expect(await executeClaudeCodeTool(params)).toMatchObject({
+      result: { content: [{ text: 'Actual completed result' }] },
+    });
+    expect(mocks.findMessage).toHaveBeenCalledTimes(2);
+    expect(mocks.updateState.mock.calls[0][2].status).toBe('running');
+    expect(mocks.tick).not.toHaveBeenCalled();
+  });
+
+  it('does not treat unknown or pending async statuses as complete', () => {
+    expect(isClaudeCodeDeferredResultTerminal('running')).toBe(false);
+    expect(isClaudeCodeDeferredResultTerminal(undefined)).toBe(false);
+    expect(isClaudeCodeDeferredResultTerminal('completed')).toBe(true);
+    expect(isClaudeCodeDeferredResultTerminal('error')).toBe(true);
+  });
+});
