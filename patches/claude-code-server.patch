+++ b/apps/server/src/services/claudeCode/interventionBridge.test.ts
@@ -0,0 +1,198 @@
+// @vitest-environment node
+import type { AgentInterventionRequestData } from '@lobechat/agent-gateway-client';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import type { LobeChatDatabase } from '@/database/type';
+
+import { resolveClaudeCodeIntervention, waitClaudeCodeIntervention } from './interventionBridge';
+
+const mocks = vi.hoisted(() => ({
+  ensure: vi.fn(),
+  exists: vi.fn(),
+  find: vi.fn(),
+  get: vi.fn(),
+  getRun: vi.fn(),
+  publish: vi.fn(),
+  readLedger: vi.fn(),
+  register: vi.fn(),
+  resolve: vi.fn(),
+  update: vi.fn(),
+  updateState: vi.fn(),
+  withProjection: vi.fn(),
+}));
+vi.mock('@/database/models/claudeCode', () => ({
+  ClaudeCodeModel: class {
+    getIntervention = mocks.get;
+    getRun = mocks.getRun;
+    registerIntervention = mocks.register;
+    resolveIntervention = mocks.resolve;
+    withProjectionState = mocks.withProjection;
+  },
+}));
+vi.mock('@/database/models/message', () => ({
+  MessageModel: class {
+    updateMessagePlugin = mocks.update;
+    updatePluginState = mocks.updateState;
+  },
+}));
+vi.mock('@/server/modules/AgentRuntime/factory', () => ({
+  createStreamEventManager: () => ({ publishStreamEvent: mocks.publish }),
+}));
+vi.mock('./messageScope', () => ({
+  ensureClaudeCodeToolMessage: mocks.ensure,
+  findClaudeCodeToolMessage: mocks.find,
+}));
+
+const request = (): AgentInterventionRequestData => ({
+  apiName: 'askUserQuestion',
+  arguments: JSON.stringify({
+    questions: [
+      {
+        header: 'Choice',
+        multiSelect: false,
+        options: [{ label: 'A' }],
+        question: 'Which option?',
+      },
+    ],
+  }),
+  deadline: Date.now() + 60_000,
+  identifier: 'claude-code',
+  interactionKind: 'question',
+  provider: 'claude-code',
+  toolCallId: 'native-id',
+});
+const params = () => ({
+  db: { query: { claudeCodeRuns: { findFirst: mocks.exists } } } as unknown as LobeChatDatabase,
+  leaseToken: 'lease',
+  operationId: 'run',
+  request: request(),
+  userId: 'owner',
+});
+beforeEach(() => {
+  vi.resetAllMocks();
+  mocks.register.mockResolvedValue({ request: request() });
+  mocks.getRun.mockResolvedValue({
+    leaseExpiresAt: new Date(Date.now() + 60_000),
+    operationId: 'run',
+    status: 'running',
+  });
+  mocks.readLedger.mockResolvedValue([
+    {
+      preparedRequest: { _serverInterventions: { 'native-id': { request: request() } } },
+    },
+  ]);
+  mocks.withProjection.mockImplementation(async (_operationId, mutate) =>
+    mutate(
+      { select: () => ({ from: () => ({ where: mocks.readLedger }) }) },
+      await mocks.getRun(),
+      undefined,
+    ),
+  );
+  mocks.ensure.mockResolvedValue('native-card');
+  mocks.exists.mockResolvedValue({ operationId: 'run' });
+  mocks.find.mockResolvedValue({ message: { id: 'native-card' }, plugin: { state: {} } });
+});
+
+describe('Claude Code native interventions', () => {
+  it('bounds HTTP polling without cancelling or resetting an existing question', async () => {
+    mocks.get.mockResolvedValue({ request: request() });
+    mocks.find.mockResolvedValue({
+      message: { id: 'native-card' },
+      plugin: { state: { claudeCodeServer: true } },
+    });
+    expect(await waitClaudeCodeIntervention({ ...params(), maxWaitMs: 0 })).toEqual({
+      pending: true,
+    });
+    expect(mocks.resolve).not.toHaveBeenCalled();
+    expect(mocks.publish).not.toHaveBeenCalled();
+    expect(mocks.update).not.toHaveBeenCalled();
+  });
+  it('registers a native question durably and returns the same answer to its original worker', async () => {
+    const answer = { result: { 'Which option?': 'A' } };
+    mocks.get.mockResolvedValue({ answer });
+    expect(await waitClaudeCodeIntervention(params())).toEqual(answer);
+    expect(mocks.register).toHaveBeenCalledWith(
+      'run',
+      'lease',
+      'native-id',
+      expect.objectContaining({ provider: 'claude-code' }),
+    );
+    expect(mocks.ensure.mock.calls[0][2].id).toBe('native-id');
+    expect(mocks.update).toHaveBeenLastCalledWith(
+      'native-card',
+      expect.objectContaining({
+        intervention: expect.objectContaining({ operationId: 'run', status: 'approved' }),
+      }),
+    );
+    expect(mocks.publish).toHaveBeenLastCalledWith(
+      'run',
+      expect.objectContaining({
+        data: { ...answer, producerAck: true, toolCallId: 'native-id' },
+        type: 'agent_intervention_response',
+      }),
+    );
+  });
+
+  it('returns a previously committed answer after a server reconnect without registering another card', async () => {
+    mocks.register.mockResolvedValue({
+      answer: { cancelled: true, cancelReason: 'user_cancelled' },
+    });
+    expect(await waitClaudeCodeIntervention(params())).toEqual({
+      cancelled: true,
+      cancelReason: 'user_cancelled',
+    });
+    expect(mocks.ensure).not.toHaveBeenCalled();
+  });
+
+  it('uses an answer committed before acquiring the card lock without resetting it to pending', async () => {
+    const answer = { result: { 'Which option?': 'A' } };
+    mocks.readLedger.mockResolvedValueOnce([
+      {
+        preparedRequest: { _serverInterventions: { 'native-id': { answer, request: request() } } },
+      },
+    ]);
+    expect(await waitClaudeCodeIntervention(params())).toEqual(answer);
+    expect(mocks.update).toHaveBeenCalledTimes(1);
+    expect(mocks.update).toHaveBeenCalledWith(
+      'native-card',
+      expect.objectContaining({
+        intervention: expect.objectContaining({ status: 'approved' }),
+      }),
+    );
+    expect(
+      mocks.publish.mock.calls.some(([, event]) => event.type === 'agent_intervention_request'),
+    ).toBe(false);
+  });
+
+  it('rejects another provider or unbounded question without registering it', async () => {
+    await expect(
+      waitClaudeCodeIntervention({ ...params(), request: { ...request(), provider: 'cursor' } }),
+    ).rejects.toThrow('Invalid');
+    await expect(
+      waitClaudeCodeIntervention({
+        ...params(),
+        request: { ...request(), deadline: Date.now() + 2_000_000 },
+      }),
+    ).rejects.toThrow('Invalid');
+    expect(mocks.register).not.toHaveBeenCalled();
+  });
+
+  it('returns session-ended cancellation after losing its lease, never an approval', async () => {
+    mocks.get.mockRejectedValue(new Error('lease expired'));
+    expect(await waitClaudeCodeIntervention(params())).toEqual({
+      cancelled: true,
+      cancelReason: 'session_ended',
+    });
+  });
+
+  it('routes only this backend and denies a workspace peer who does not own its run', async () => {
+    const input = { ...params(), answer: { result: 'A' }, toolCallId: 'native-id' };
+    mocks.exists.mockResolvedValueOnce(undefined);
+    expect(await resolveClaudeCodeIntervention(input)).toBe(false);
+    mocks.getRun.mockResolvedValueOnce(undefined);
+    await expect(resolveClaudeCodeIntervention(input)).rejects.toThrow('does not belong');
+    expect(mocks.resolve).not.toHaveBeenCalled();
+    expect(await resolveClaudeCodeIntervention(input)).toBe(true);
+    expect(mocks.resolve).toHaveBeenCalledWith('run', 'native-id', { result: 'A' });
+  });
+});
diff --git a/apps/server/src/services/claudeCode/interventionBridge.ts b/apps/server/src/services/claudeCode/interventionBridge.ts
new file mode 100644
index 0000000000..631a31ca52
--- /dev/null
+++ b/apps/server/src/services/claudeCode/interventionBridge.ts
@@ -0,0 +1,194 @@
+import type { AgentInterventionRequestData } from '@lobechat/agent-gateway-client';
+import { sanitizeAgentInterventionRequestForReview } from '@lobechat/agent-gateway-client';
+import type { InterventionAnswer } from '@lobechat/heterogeneous-agents/askUser';
+import { eq } from 'drizzle-orm';
+
+import { type ClaudeCodeInterventionReceipt, ClaudeCodeModel } from '@/database/models/claudeCode';
+import { MessageModel } from '@/database/models/message';
+import { claudeCodeRuns } from '@/database/schemas/claudeCode';
+import type { LobeChatDatabase } from '@/database/type';
+import { createStreamEventManager } from '@/server/modules/AgentRuntime/factory';
+
+import { ensureClaudeCodeToolMessage, findClaudeCodeToolMessage } from './messageScope';
+
+export interface ClaudeCodeBridgeScope {
+  db: LobeChatDatabase;
+  leaseToken: string;
+  operationId: string;
+  userId: string;
+  workspaceId?: string;
+}
+
+interface InterventionParams extends ClaudeCodeBridgeScope {
+  request: AgentInterventionRequestData;
+  signal?: AbortSignal;
+}
+export function waitClaudeCodeIntervention(params: InterventionParams): Promise<InterventionAnswer>;
+export function waitClaudeCodeIntervention(
+  params: InterventionParams & { maxWaitMs: number },
+): Promise<InterventionAnswer | { pending: true }>;
+/** Existing AskUser form and submission channel, with a durable first-winner answer. */
+export async function waitClaudeCodeIntervention(
+  params: InterventionParams & { maxWaitMs?: number },
+): Promise<InterventionAnswer | { pending: true }> {
+  const startedAt = Date.now();
+  const { db, leaseToken, operationId, userId, workspaceId } = params;
+  const request = sanitizeAgentInterventionRequestForReview(params.request);
+  if (
+    !request ||
+    request.provider !== 'claude-code' ||
+    request.identifier !== 'claude-code' ||
+    !request.toolCallId ||
+    request.deadline > Date.now() + 15 * 60_000
+  ) {
+    throw new Error('Invalid Claude Code intervention');
+  }
+  const model = new ClaudeCodeModel(db, userId, workspaceId);
+  const registered = await model.registerIntervention(operationId, leaseToken, request.toolCallId, {
+    ...request,
+  });
+  if (registered.answer) return registered.answer as InterventionAnswer;
+  const run = await model.getRun(operationId);
+  if (!run) throw new Error('Claude Code run not found');
+  const messageId = await ensureClaudeCodeToolMessage(db, run, {
+    apiName: 'askUserQuestion',
+    arguments: request.arguments,
+    id: request.toolCallId,
+    identifier: 'claude-code',
+    type: 'builtin',
+  });
+  const messageModel = new MessageModel(db, userId, workspaceId);
+  const stream = createStreamEventManager();
+  let answer: InterventionAnswer | undefined;
+  // Serialize the pending card and its publication with terminal settlement.
+  // ensureClaudeCodeToolMessage owns a separate run lock, so it must stay above
+  // this callback instead of nesting its transaction on the same connection.
+  await model.withProjectionState(operationId, async (tx, locked, checkpoint) => {
+    if (
+      locked.status !== 'running' ||
+      !locked.leaseExpiresAt ||
+      locked.leaseExpiresAt.getTime() <= Date.now()
+    ) {
+      answer = { cancelReason: 'session_ended', cancelled: true };
+      return checkpoint;
+    }
+    // runView intentionally omits the internal answer ledger. Read it on the
+    // already-locked transaction, without opening getIntervention's transaction.
+    const [row] = await tx
+      .select({ preparedRequest: claudeCodeRuns.preparedRequest })
+      .from(claudeCodeRuns)
+      .where(eq(claudeCodeRuns.operationId, operationId));
+    const ledger = row.preparedRequest._serverInterventions as Record<
+      string,
+      ClaudeCodeInterventionReceipt
+    >;
+    const receipt = ledger[request.toolCallId];
+    if (receipt?.answer) {
+      answer = receipt.answer as InterventionAnswer;
+      return checkpoint;
+    }
+    const database = tx as unknown as LobeChatDatabase;
+    const existing = await findClaudeCodeToolMessage(database, locked, request.toolCallId);
+    const existingState = existing?.plugin.state as Record<string, unknown> | undefined;
+    if (existingState?.claudeCodeServer === true) return checkpoint;
+    const transactionMessages = new MessageModel(database, userId, workspaceId);
+    await transactionMessages.updateMessagePlugin(messageId, {
+      intervention: { operationId, status: 'pending', stepIndex: 0 },
+    });
+    await transactionMessages.updatePluginState(messageId, {
+      claudeCodeServer: true,
+      heterogeneousIntervention: { ...request, transition: 'pending' },
+    });
+    await stream.publishStreamEvent(operationId, {
+      data: request,
+      deduplicationKey: `claude-code:intervention:${request.toolCallId}:request`,
+      stepIndex: 0,
+      type: 'agent_intervention_request',
+    });
+    return checkpoint;
+  });
+
+  while (!answer) {
+    try {
+      const receipt = await model.getIntervention(operationId, leaseToken, request.toolCallId);
+      if (receipt?.answer) {
+        answer = receipt.answer as InterventionAnswer;
+        break;
+      }
+      const current = await model.getRun(operationId);
+      if (current?.status !== 'running') {
+        answer = { cancelReason: 'session_ended', cancelled: true };
+        break;
+      }
+    } catch {
+      answer = { cancelReason: 'session_ended', cancelled: true };
+      break;
+    }
+    // Only a still-active question may outlive its HTTP polling request.
+    if (params.signal?.aborted && params.maxWaitMs !== undefined) return { pending: true };
+    if (params.signal?.aborted) {
+      answer = { cancelReason: 'session_ended', cancelled: true };
+      break;
+    }
+    if (Date.now() >= request.deadline) {
+      answer = { cancelReason: 'timeout', cancelled: true };
+      await model
+        .resolveIntervention(operationId, request.toolCallId, { ...answer })
+        .catch(() => undefined);
+      break;
+    }
+    if (params.maxWaitMs !== undefined && Date.now() - startedAt >= params.maxWaitMs) {
+      return { pending: true };
+    }
+    await new Promise((resolve) => setTimeout(resolve, 500));
+  }
+  await messageModel.updateMessagePlugin(messageId, {
+    intervention: {
+      operationId,
+      resolving: false,
+      rejectedReason: answer.cancelReason,
+      status: answer.cancelled ? 'rejected' : 'approved',
+    },
+  });
+  await messageModel.updatePluginState(messageId, {
+    askUserAnswers: answer.result ?? {},
+    heterogeneousIntervention: {
+      ...request,
+      transition: answer.cancelled
+        ? answer.cancelReason === 'timeout'
+          ? 'timed_out'
+          : 'cancelled'
+        : 'resolved',
+    },
+  });
+  await stream.publishStreamEvent(operationId, {
+    data: { ...answer, producerAck: true, toolCallId: request.toolCallId },
+    stepIndex: 0,
+    type: 'agent_intervention_response',
+  });
+  return answer;
+}
+
+/** Returns false only for the old heterogeneous backend, which keeps its existing handler. */
+export const resolveClaudeCodeIntervention = async (params: {
+  answer: InterventionAnswer;
+  db: LobeChatDatabase;
+  operationId: string;
+  toolCallId: string;
+  userId: string;
+  workspaceId?: string;
+}) => {
+  const { answer, db, operationId, toolCallId, userId, workspaceId } = params;
+  const exists = await db.query.claudeCodeRuns.findFirst({
+    columns: { operationId: true },
+    where: (runs, { eq }) => eq(runs.operationId, operationId),
+  });
+  if (!exists) return false;
+  const model = new ClaudeCodeModel(db, userId, workspaceId);
+  const run = await model.getRun(operationId);
+  if (!run) throw new Error('Claude Code run does not belong to this account');
+  const message = await findClaudeCodeToolMessage(db, run, toolCallId);
+  if (!message) throw new Error('Claude Code question is not registered');
+  await model.resolveIntervention(operationId, toolCallId, { ...answer });
+  return true;
+};
diff --git a/apps/server/src/services/claudeCode/loadClaimHistory.ts b/apps/server/src/services/claudeCode/loadClaimHistory.ts
