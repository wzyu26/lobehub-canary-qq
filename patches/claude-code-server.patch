@@ -0,0 +1,280 @@
+import type { AgentState, GeneralChatAgent, ToolRunResult } from '@lobechat/agent-runtime';
+import { callTool } from '@lobechat/agent-runtime';
+import type {
+  ClaudeCodeAssistantRequest,
+  ClaudeCodeWorkerToolResponse,
+  ClaudeCodeWorkerToolResult,
+} from '@lobechat/heterogeneous-agents/protocol';
+import type { ChatToolPayload } from '@lobechat/types';
+import Ajv from 'ajv';
+
+import { ClaudeCodeModel, ClaudeCodeStateError } from '@/database/models/claudeCode';
+import { MessageModel } from '@/database/models/message';
+import { buildHost } from '@/server/modules/AgentRuntime/buildHost';
+import { createStreamEventManager } from '@/server/modules/AgentRuntime/factory';
+import { AgentRuntimeService } from '@/server/services/agentRuntime';
+
+import type { ClaudeCodeBridgeScope } from './interventionBridge';
+import { waitClaudeCodeIntervention } from './interventionBridge';
+import { ensureClaudeCodeToolMessage, findClaudeCodeToolMessage } from './messageScope';
+
+const toWorkerResult = (result: ToolRunResult): ClaudeCodeWorkerToolResult => ({
+  content: [{ text: result.content, type: 'text' }],
+  isError: !result.success,
+  structuredContent: {
+    ...(result.state ? { state: result.state } : {}),
+    ...(result.error ? { error: result.error } : {}),
+    success: result.success,
+  },
+});
+
+export const validateClaudeCodeToolArguments = (
+  schema: ClaudeCodeAssistantRequest['tools'][number]['inputSchema'],
+  args: Record<string, unknown>,
+) => {
+  const properties = schema.properties as Record<string, unknown> | undefined;
+  for (const key of [
+    'userId',
+    'workspaceId',
+    'topicId',
+    'threadId',
+    'operationId',
+    'workerId',
+    'leaseToken',
+  ]) {
+    if (Object.hasOwn(args, key) && !Object.hasOwn(properties ?? {}, key)) {
+      throw new ClaudeCodeStateError(
+        'invalid_tool_arguments',
+        `Tool arguments cannot supply ${key}`,
+      );
+    }
+  }
+  // Compile the server's registered schema, never a schema received from this request.
+  // Unknown format annotations are ignored; type/required/enum/pattern/range still validate.
+  const ajv = new Ajv({
+    allErrors: true,
+    coerceTypes: false,
+    strict: false,
+    validateFormats: false,
+  });
+  const validate = ajv.compile(schema);
+  if (schema.$async === true || !validate(args)) {
+    throw new ClaudeCodeStateError(
+      'invalid_tool_arguments',
+      `Invalid tool arguments: ${ajv.errorsText(validate.errors)}`,
+    );
+  }
+};
+
+/** Only explicit terminal states settle deferred work; a submitted-task description does not. */
+export const isClaudeCodeDeferredResultTerminal = (status: unknown) =>
+  typeof status === 'string' && ['completed', 'error', 'cancelled', 'interrupted'].includes(status);
+
+export const executeClaudeCodeTool = async (
+  params: ClaudeCodeBridgeScope & {
+    args: Record<string, unknown>;
+    name: string;
+    toolCallId: string;
+  },
+): Promise<ClaudeCodeWorkerToolResponse> => {
+  const { args, db, leaseToken, name, operationId, toolCallId, userId, workspaceId } = params;
+  const model = new ClaudeCodeModel(db, userId, workspaceId);
+  const run = await model.getRun(operationId);
+  if (!run) throw new Error('Claude Code run does not belong to this account');
+  const request = run.preparedRequest.request as ClaudeCodeAssistantRequest;
+  let state = run.preparedRequest.state as AgentState;
+  if (
+    !state?.origin ||
+    state.origin.userId !== run.userId ||
+    (state.origin.workspaceId ?? null) !== run.workspaceId ||
+    state.origin.topicId !== run.topicId ||
+    (state.origin.threadId ?? null) !== run.threadId
+  ) {
+    throw new Error('Claude Code runtime identity is invalid');
+  }
+  const registered = request?.tools?.find((tool) => tool.name === name);
+  if (!registered) throw new Error('Tool is not enabled for this operation');
+  validateClaudeCodeToolArguments(registered.inputSchema, args);
+  const claim = await model.claimToolCall(operationId, leaseToken, {
+    arguments: args,
+    name,
+    toolCallId,
+  });
+  if (claim.disposition === 'replay') {
+    return {
+      result: claim.receipt.result as unknown as ClaudeCodeWorkerToolResult,
+      status: 'completed',
+    };
+  }
+  if (claim.disposition !== 'execute') {
+    return { status: claim.disposition === 'interrupted' ? 'interrupted' : 'pending' };
+  }
+  // A preceding serialized tool may have activated a skill or changed runtime context.
+  state = ((await model.getRun(operationId))?.preparedRequest.state ?? state) as AgentState;
+
+  const tool: ChatToolPayload = {
+    apiName: registered.apiName,
+    arguments: JSON.stringify(args),
+    id: toolCallId,
+    identifier: registered.identifier,
+    type: registered.type as ChatToolPayload['type'],
+  };
+  const abort = new AbortController();
+  let checking = false;
+  const checkActive = async () => {
+    if (checking) return;
+    checking = true;
+    try {
+      const [current, binding] = await Promise.all([model.getRun(operationId), model.getBinding()]);
+      if (
+        current?.status !== 'running' ||
+        !current.leaseExpiresAt ||
+        current.leaseExpiresAt.getTime() <= Date.now() ||
+        !binding?.enabled ||
+        binding.authStatus !== 'logged_in'
+      )
+        abort.abort();
+    } catch {
+      abort.abort();
+    } finally {
+      checking = false;
+    }
+  };
+  const timer = setInterval(() => void checkActive(), 1000);
+  const handlerTimer = setInterval(() => {
+    void model.heartbeatToolCall(operationId, leaseToken, toolCallId).catch(() => abort.abort());
+  }, 10_000);
+  let toolMessageId: string | undefined;
+  try {
+    const messageId = await ensureClaudeCodeToolMessage(db, run, tool);
+    toolMessageId = messageId;
+    const service = new AgentRuntimeService(db, userId, {
+      queueService: null,
+      streamEventManager: createStreamEventManager(),
+      workspaceId,
+    });
+    const { agent, executorContext } = await service.prepareExternalRuntime({
+      abortSignal: abort.signal,
+      agentState: state,
+      operationId,
+      stepIndex: state.stepCount,
+    });
+    const policy = agent as GeneralChatAgent;
+    if (typeof policy.checkInterventionNeeded !== 'function')
+      throw new Error('Tool approval policy is unavailable');
+    const [needsApproval] = await policy.checkInterventionNeeded([tool], state);
+    if (needsApproval.length > 0) {
+      const question = `Allow ${tool.identifier}/${tool.apiName}?\n${JSON.stringify(args, null, 2).slice(0, 3000)}`;
+      const answer = await waitClaudeCodeIntervention({
+        db,
+        leaseToken,
+        operationId,
+        signal: abort.signal,
+        userId,
+        workspaceId,
+        request: {
+          apiName: 'askUserQuestion',
+          arguments: JSON.stringify({
+            questions: [
+              {
+                header: 'Tool permission',
+                multiSelect: false,
+                options: [
+                  { id: 'allow_once', label: 'Allow once' },
+                  { id: 'deny', label: 'Deny' },
+                ],
+                question,
+              },
+            ],
+          }),
+          deadline: Date.now() + 10 * 60_000,
+          identifier: 'claude-code',
+          interactionKind: 'permission',
+          provider: 'claude-code',
+          toolCallId: `approval:${toolCallId}`,
+        },
+      });
+      const selected = (answer.result as Record<string, unknown> | undefined)?.[question];
+      if (
+        answer.cancelled ||
+        !(
+          selected === 'allow_once' ||
+          (Array.isArray(selected) && selected.length === 1 && selected[0] === 'allow_once')
+        )
+      ) {
+        const denied = toWorkerResult({
+          content: 'The user did not approve this tool call.',
+          success: false,
+        });
+        await new MessageModel(db, userId, workspaceId).updateToolMessage(messageId, {
+          content: denied.content[0].text,
+          pluginError: { message: denied.content[0].text },
+        });
+        await model.completeToolCall(operationId, leaseToken, toolCallId, { ...denied });
+        return { result: denied, status: 'completed' };
+      }
+    }
+    await checkActive();
+    if (abort.signal.aborted) return { status: 'interrupted' };
+    const host = buildHost(executorContext);
+    // No execution retry: an ambiguous write failure is not evidence it did not commit.
+    if (host.transports.tools) host.transports.tools.maxRetries = 0;
+    const output = await callTool(host)(
+      {
+        payload: { parentMessageId: messageId, skipCreateToolMessage: true, toolCalling: tool },
+        type: 'call_tool',
+      },
+      state,
+    );
+    let result = output.events?.find((event) => event.type === 'tool_result')?.result;
+    if (output.newState.status === 'waiting_for_async_tool') {
+      if (output.newState.interruption?.reason !== 'async_tool') {
+        throw new Error('This tool cannot execute on the server');
+      }
+      // Never park the ordinary runtime: its completion hook would start an API model.
+      while (!abort.signal.aborted) {
+        const row = await findClaudeCodeToolMessage(db, run, toolCallId);
+        const status = (row?.plugin.state as Record<string, unknown> | null)?.status;
+        if (row && isClaudeCodeDeferredResultTerminal(status)) {
+          result = {
+            content: row.message.content ?? '',
+            error: row.plugin.error ?? undefined,
+            state: row.plugin.state ?? undefined,
+            success: status === 'completed' && !row.plugin.error,
+          };
+          break;
+        }
+        await new Promise((resolve) => setTimeout(resolve, 500));
+      }
+    }
+    if (abort.signal.aborted) return { status: 'interrupted' };
+    if (!result) throw new Error('Tool finished without an authoritative result');
+    const response = toWorkerResult(result);
+    const nextState = {
+      ...output.newState,
+      interruption: undefined,
+      pendingToolsCalling: undefined,
+      status: state.status,
+    };
+    await model.updateRuntimeState(operationId, leaseToken, nextState);
+    await model.completeToolCall(operationId, leaseToken, toolCallId, { ...response });
+    return { result: response, status: 'completed' };
+  } catch (error) {
+    if (abort.signal.aborted) return { status: 'interrupted' };
+    const response = toWorkerResult({
+      content: error instanceof Error ? error.message : 'Tool execution failed',
+      success: false,
+    });
+    if (toolMessageId)
+      await new MessageModel(db, userId, workspaceId).updateToolMessage(toolMessageId, {
+        content: response.content[0].text,
+        pluginError: { message: response.content[0].text },
+      });
+    // A lost lease leaves an interrupted receipt. It must never be claimed again.
+    await model.completeToolCall(operationId, leaseToken, toolCallId, { ...response });
+    return { result: response, status: 'completed' };
+  } finally {
+    clearInterval(timer);
+    clearInterval(handlerTimer);
+  }
+};
