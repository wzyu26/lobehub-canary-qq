@@ -0,0 +1,32 @@
+import { spawnSync } from 'node:child_process';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const configurationError = 'Claude Code worker could not start; check its deployment configuration';
+
+/** Execute all top-level imports, then require the safe missing-config failure.
+ * A successful CLI --version or an existing bundle does not test this path. */
+export const assertWorkerStartup = (entrypoint, executable = process.execPath) => {
+  const absoluteEntrypoint = path.resolve(entrypoint);
+  // A missing dependency must fail, even when Bun could fetch it or use its
+  // global package cache. Only the distributed runtime is under test here.
+  const result = spawnSync(executable, ['--no-install', absoluteEntrypoint], {
+    cwd: path.dirname(absoluteEntrypoint),
+    encoding: 'utf8',
+    // Never inherit service tokens, Claude credentials or network configuration.
+    env: process.platform === 'win32' && process.env.SystemRoot
+      ? { SystemRoot: process.env.SystemRoot }
+      : {},
+    timeout: 15_000,
+  });
+  if (result.error || result.status !== 1 || result.stdout.trim() !== '' ||
+      result.stderr.trim() !== configurationError) {
+    throw new Error(`Worker module startup failed before safe configuration validation\n${result.stderr ?? ''}`);
+  }
+};
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  if (!process.argv[2]) throw new Error('Pass the built worker entrypoint');
+  assertWorkerStartup(process.argv[2]);
+  console.info('Worker module startup smoke passed');
+}
