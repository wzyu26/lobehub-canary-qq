+import { parse } from '@lobechat/conversation-flow';
+import { eq } from 'drizzle-orm';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { ClaudeCodeModel } from '@/database/models/claudeCode';
+import { MessageModel } from '@/database/models/message';
+import { claudeCodeRuns } from '@/database/schemas';
+
+import { finishClaudeCodeRun, settleClaudeCodeRun } from '../finish';
+import {
+  db,
+  event,
+  leaseToken,
+  model,
+  owner,
+  prepareRows,
+  resetRows,
+  running,
+  topicId,
+} from './testUtils';
+
+const { dispatchHooks, publishStreamEvent, saveAgentState } = vi.hoisted(() => ({
+  dispatchHooks: vi.fn(),
+  publishStreamEvent: vi.fn(),
+  saveAgentState: vi.fn(),
+}));
+
+vi.mock('@/server/modules/AgentRuntime', () => ({
+  AgentRuntimeCoordinator: class {
+    saveAgentState = saveAgentState;
+  },
+  createStreamEventManager: () => ({ publishStreamEvent }),
+}));
+vi.mock('@/server/services/agentRuntime/CompletionLifecycle', () => ({
+  CompletionLifecycle: class {
+    dispatchHooks = dispatchHooks;
+  },
+}));
+
+describe('ordinary Claude Code finish with real durable state and message projection', () => {
+  beforeEach(async () => {
+    vi.resetAllMocks();
+    await prepareRows();
+  });
+  afterEach(async () => {
+    vi.restoreAllMocks();
+    await resetRows();
+  });
+
+  it('drains more than one event batch before dispatching the complete branch history', async () => {
+    const { scope, assistantMessageId } = await running('large-op', 'branch-large');
+    const batch = Array.from({ length: 205 }, (_, index) =>
+      event(index + 1, 'stream_chunk', { chunkType: 'text', content: 'a' }, scope.operationId),
+    );
+    await model().appendEvents(scope.operationId, leaseToken, batch);
+    await finishClaudeCodeRun({
+      ...scope,
+      leaseToken,
+      status: 'completed',
+    });
+    const history = await new MessageModel(db, owner).query({ topicId, threadId: 'branch-large' });
+    expect((await new MessageModel(db, owner).findById(assistantMessageId))?.content).toBe(
+      'a'.repeat(205),
+    );
+    expect(dispatchHooks).toHaveBeenCalledWith(
+      scope.operationId,
+      expect.objectContaining({
+        messages: parse(history, undefined, { threadId: 'branch-large' }).flatList,
+      }),
+      'done',
+    );
+    expect((await model().getRun(scope.operationId))?.projectedSequence).toBe(205);
+  }, 30_000);
+
+  it('does not dispatch lifecycle again when terminal socket publication committed but its reply was lost', async () => {
+    const { scope } = await running();
+    await model().appendEvents(scope.operationId, leaseToken, [
+      event(1, 'stream_chunk', { chunkType: 'text', content: 'answer' }),
+    ]);
+    let loseReply = true;
+    const terminalDeliveries = new Set<string>();
+    publishStreamEvent.mockImplementation(async (_operationId, published) => {
+      if (published.type !== 'agent_runtime_end') return;
+      terminalDeliveries.add(published.deduplicationKey);
+      if (loseReply) {
+        loseReply = false;
+        throw new Error('terminal reply lost');
+      }
+    });
+    await expect(
+      finishClaudeCodeRun({ ...scope, leaseToken, status: 'completed' }),
+    ).rejects.toThrow('terminal reply lost');
+    expect((await model().getProjectionState(scope.operationId))?.lifecycleComplete).toBe(true);
+    await finishClaudeCodeRun({
+      ...scope,
+      leaseToken,
+      status: 'completed',
+    });
+    expect(dispatchHooks).toHaveBeenCalledTimes(1);
+    expect(terminalDeliveries.size).toBe(1);
+    expect((await model().getProjectionState(scope.operationId))?.settled).toBe(true);
+  });
+
+  it('preserves cancellation despite a late completed reply', async () => {
+    const { scope } = await running();
+    await model().appendEvents(scope.operationId, leaseToken, [event(1, 'agent_runtime_end', {})]);
+    await model().cancelRun(scope.operationId);
+    await expect(
+      finishClaudeCodeRun({
+        ...scope,
+        leaseToken,
+        status: 'completed',
+      }),
+    ).resolves.toEqual({ status: 'cancelled' });
+    await finishClaudeCodeRun({
+      ...scope,
+      leaseToken,
+      status: 'completed',
+    });
+    expect(dispatchHooks).toHaveBeenCalledTimes(1);
+    expect(dispatchHooks).toHaveBeenCalledWith(
+      scope.operationId,
+      expect.objectContaining({ status: 'interrupted' }),
+      'interrupted',
+    );
+  });
+
+  it('shows a failure on the assistant message when the worker dies mid-turn', async () => {
+    const { scope, assistantMessageId } = await running();
+    await db
+      .update(claudeCodeRuns)
+      .set({ leaseExpiresAt: new Date(Date.now() - 1000) })
+      .where(eq(claudeCodeRuns.operationId, scope.operationId));
+    await ClaudeCodeModel.interruptStaleRuns(db);
+    await settleClaudeCodeRun(scope);
+    const message = await new MessageModel(db, owner).findById(assistantMessageId);
+    expect(message?.error).toMatchObject({ type: 'AgentRuntimeError' });
+  });
+
+  it('leaves a cancelled turn without a failure', async () => {
+    const { scope, assistantMessageId } = await running();
+    await model().cancelRun(scope.operationId);
+    await finishClaudeCodeRun({ ...scope, leaseToken, status: 'cancelled' });
+    const message = await new MessageModel(db, owner).findById(assistantMessageId);
+    expect(message?.error).toBeFalsy();
+  });
+
+  it('archives post-crash tail events without reviving the interrupted run', async () => {
+    const { scope } = await running();
+    await db
+      .update(claudeCodeRuns)
+      .set({ leaseExpiresAt: new Date(Date.now() - 1000) })
+      .where(eq(claudeCodeRuns.operationId, scope.operationId));
+    await ClaudeCodeModel.interruptStaleRuns(db);
+    await model().appendEvents(scope.operationId, leaseToken, [
+      event(1, 'stream_chunk', { chunkType: 'text', content: 'last durable fragment' }),
+    ]);
+    await settleClaudeCodeRun(scope);
+    await expect(
+      finishClaudeCodeRun({ ...scope, leaseToken, status: 'completed' }),
+    ).resolves.toEqual({ status: 'interrupted' });
+    expect(dispatchHooks).toHaveBeenCalledWith(
+      scope.operationId,
+      expect.objectContaining({ status: 'interrupted' }),
+      'interrupted',
+    );
+  });
+
+  it('settles a cancellation before the first CLI event with an empty reducer checkpoint', async () => {
+    const { scope, assistantMessageId } = await running();
+    await model().cancelRun(scope.operationId);
+    await expect(
+      finishClaudeCodeRun({ ...scope, leaseToken, status: 'cancelled' }),
+    ).resolves.toEqual({ status: 'cancelled' });
+    await settleClaudeCodeRun(scope);
+    expect(dispatchHooks).toHaveBeenCalledTimes(1);
+    expect(dispatchHooks).toHaveBeenCalledWith(
+      scope.operationId,
+      expect.objectContaining({ metadata: expect.objectContaining({ assistantMessageId }) }),
+      'interrupted',
+    );
+    expect((await model().getProjectionState(scope.operationId))?.settled).toBe(true);
+  });
+
+  it('retries lifecycle after the terminal transition committed but the response was lost', async () => {
+    const { scope } = await running();
+    const original = ClaudeCodeModel.prototype.finishRun;
+    const injected = vi
+      .spyOn(ClaudeCodeModel.prototype, 'finishRun')
+      .mockImplementationOnce(async function (this: ClaudeCodeModel, ...args) {
+        await original.apply(this, args);
+        throw new Error('Terminal transition response lost');
+      });
+    await expect(
+      finishClaudeCodeRun({
+        ...scope,
+        leaseToken,
+        status: 'completed',
+      }),
+    ).rejects.toThrow('Terminal transition response lost');
+    injected.mockRestore();
+    expect((await model().getRun(scope.operationId))?.status).toBe('completed');
+    expect(dispatchHooks).not.toHaveBeenCalled();
+    await finishClaudeCodeRun({
+      ...scope,
+      leaseToken,
+      status: 'completed',
+    });
+    expect((await model().getRun(scope.operationId))?.status).toBe('completed');
+    expect(dispatchHooks).toHaveBeenCalledTimes(1);
+    expect((await model().getProjectionState(scope.operationId))?.settled).toBe(true);
+  });
+});
diff --git a/apps/server/src/services/claudeCode/__tests__/interventionSettlement.integration.test.ts b/apps/server/src/services/claudeCode/__tests__/interventionSettlement.integration.test.ts
