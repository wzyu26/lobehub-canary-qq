@@ -0,0 +1,32 @@
+import { drizzle } from 'drizzle-orm/node-postgres';
+import { Pool } from 'pg';
+
+import type { LobeChatDatabase } from '../../../packages/database/src/type';
+
+/** The one-shot admin command needs PostgreSQL only, not application secrets. */
+export const withAdminDatabase = async <T>(
+  connectionString: string,
+  action: (db: LobeChatDatabase) => Promise<T>,
+): Promise<T> => {
+  const pool = new Pool({
+    application_name: 'lobehub-claude-worker-admin',
+    connectionString,
+    connectionTimeoutMillis: 10_000,
+    idle_in_transaction_session_timeout: 15_000,
+    max: 1,
+    query_timeout: 20_000,
+    statement_timeout: 15_000,
+  });
+  let connectionFailed = false;
+  // pg idle errors can include connection details. Let the CLI report one safe error.
+  pool.on('error', () => {
+    connectionFailed = true;
+  });
+  try {
+    const result = await action(drizzle(pool) as unknown as LobeChatDatabase);
+    if (connectionFailed) throw new Error('Administration database connection failed');
+    return result;
+  } finally {
+    await pool.end();
+  }
+};
diff --git a/apps/claude-code-worker/admin/index.ts b/apps/claude-code-worker/admin/index.ts
new file mode 100644
index 0000000000..1e09c39245
--- /dev/null
+++ b/apps/claude-code-worker/admin/index.ts
@@ -0,0 +1,71 @@
+import { parseArgs } from 'node:util';
+
+import { withAdminDatabase } from './database';
+import { provisionWorker } from './provision';
+
+const usage =
+  'provision|enable|disable|status --user-id ID --worker-id ID [--workspace-id ID] [--token-file ABSOLUTE_PATH]';
+
+// Run as a one-shot administration container, never in the persistent worker.
+try {
+  const { positionals, values } = parseArgs({
+    allowPositionals: true,
+    options: {
+      'help': { short: 'h', type: 'boolean' },
+      'token-file': { type: 'string' },
+      'user-id': { type: 'string' },
+      'worker-id': { type: 'string' },
+      'workspace-id': { type: 'string' },
+    },
+  });
+  if (values.help) {
+    console.info(usage);
+    process.exit(0);
+  }
+  const mode = positionals[0];
+  if (
+    !['provision', 'enable', 'disable', 'status'].includes(mode) ||
+    positionals.length !== 1 ||
+    !values['user-id'] ||
+    !values['worker-id']
+  ) {
+    throw new Error(`Expected ${usage}`);
+  }
+  if (!process.env.DATABASE_URL)
+    throw new Error('DATABASE_URL must be provided by the administration environment');
+  const { ClaudeCodeModel } = await import('../../../packages/database/src/models/claudeCode');
+  const binding = await withAdminDatabase(process.env.DATABASE_URL, async (db) => {
+    const model = new ClaudeCodeModel(db, values['user-id']!, values['workspace-id']);
+    if (mode === 'provision') {
+      if (!values['token-file']) throw new Error('Provision requires --token-file');
+      return provisionWorker(
+        {
+          getBinding: () => model.getBinding(),
+          provisionBinding: (input) => model.provisionBinding(input),
+          resolveWorker: (workerId, secretHash) =>
+            ClaudeCodeModel.resolveWorker(db, workerId, secretHash),
+        },
+        values['worker-id']!,
+        values['token-file'],
+      );
+    }
+    const existing = await model.getBinding();
+    if (!existing || existing.workerId !== values['worker-id'])
+      throw new Error('No matching worker binding for this owner');
+    return mode === 'status' ? existing : model.setBindingEnabled(mode === 'enable');
+  });
+  console.info(
+    JSON.stringify({
+      enabled: binding?.enabled,
+      workerId: binding?.workerId,
+      workspaceId: binding?.workspaceId,
+    }),
+  );
+  process.exit(0);
+} catch {
+  // Database driver errors can contain connection strings. Never echo them.
+  console.error(
+    'Worker administration failed. Check arguments, owner scope, database migration, and token-file permissions. Existing bindings and service token files were not replaced.',
+  );
+  process.exit(1);
+}
