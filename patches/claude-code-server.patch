+// @vitest-environment node
+import type { Redis } from 'ioredis';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { InMemoryStreamEventManager } from './InMemoryStreamEventManager';
+import { publishStreamEventOnce } from './publishStreamEventOnce';
+import { StreamEventManager } from './StreamEventManager';
+
+const connection = vi.hoisted(() => ({ eval: vi.fn(), expire: vi.fn(), xadd: vi.fn() }));
+vi.mock('./redis', () => ({ getAgentRuntimeRedisClient: () => connection }));
+
+beforeEach(() => {
+  vi.resetAllMocks();
+  connection.eval.mockResolvedValue('42-0');
+});
+
+describe('durable event publication', () => {
+  it('passes two operation-scoped keys, the durable identity and complete fields to one EVAL', async () => {
+    const fields = ['type', 'stream_chunk', 'data', '{"text":"A"}'];
+    await expect(
+      publishStreamEventOnce(
+        connection as unknown as Redis,
+        'stream:operation',
+        'claude-code:7',
+        7200,
+        fields,
+      ),
+    ).resolves.toBe('42-0');
+    expect(connection.eval).toHaveBeenCalledExactlyOnceWith(
+      expect.any(String),
+      2,
+      'stream:operation',
+      'stream:operation:delivery-receipts',
+      'claude-code:7',
+      '7200',
+      ...fields,
+    );
+    expect(connection.xadd).not.toHaveBeenCalled();
+  });
+
+  it('preserves publication failure instead of reporting an acknowledged event', async () => {
+    connection.eval.mockRejectedValue(new Error('connection lost after commit'));
+    await expect(
+      publishStreamEventOnce(
+        connection as unknown as Redis,
+        'stream:operation',
+        'claude-code:7',
+        7200,
+        ['data', '{}'],
+      ),
+    ).rejects.toThrow('connection lost');
+  });
+
+  it('routes only events with a durable identity through atomic append', async () => {
+    const manager = new StreamEventManager();
+    const event = {
+      data: { content: 'same' },
+      deduplicationKey: 'claude-code:1',
+      stepIndex: 3,
+      type: 'stream_chunk' as const,
+    };
+    await expect(manager.publishStreamEvent('operation', event)).resolves.toBe('42-0');
+    await expect(manager.publishStreamEvent('operation', event)).resolves.toBe('42-0');
+    expect(connection.eval).toHaveBeenCalledTimes(2);
+    for (const [, keys, stream, receipts, identity, retention, ...fields] of connection.eval.mock
+      .calls) {
+      expect([keys, stream, receipts, identity, retention]).toEqual([
+        2,
+        'agent_runtime_stream:operation',
+        'agent_runtime_stream:operation:delivery-receipts',
+        'claude-code:1',
+        '7200',
+      ]);
+      expect(fields).toEqual([
+        'type',
+        'stream_chunk',
+        'stepIndex',
+        '3',
+        'operationId',
+        'operation',
+        'data',
+        '{"content":"same"}',
+        'timestamp',
+        expect.any(String),
+      ]);
+    }
+    expect(connection.xadd).not.toHaveBeenCalled();
+    connection.xadd.mockResolvedValue('43-0');
+    await expect(
+      manager.publishStreamEvent('legacy', { data: {}, stepIndex: 0, type: 'stream_chunk' }),
+    ).resolves.toBe('43-0');
+    expect(connection.xadd).toHaveBeenCalledOnce();
+  });
+
+  it('does not append or notify twice in memory, but retains equal content at distinct sequences', async () => {
+    const manager = new InMemoryStreamEventManager();
+    const notify = vi.fn();
+    manager.subscribe('operation', notify);
+    const event = {
+      data: { content: 'A' },
+      deduplicationKey: 'claude-code:1',
+      stepIndex: 0,
+      type: 'stream_chunk' as const,
+    };
+    const first = await manager.publishStreamEvent('operation', event);
+    expect(await manager.publishStreamEvent('operation', event)).toBe(first);
+    await manager.publishStreamEvent('operation', { ...event, deduplicationKey: 'claude-code:2' });
+    await manager.publishStreamEvent('other-operation', event);
+    expect(manager.getAllEvents('operation')).toHaveLength(2);
+    expect(manager.getAllEvents('other-operation')).toHaveLength(1);
+    expect(notify).toHaveBeenCalledTimes(2);
+    manager.clear();
+  });
+});
