+import { createHash } from 'node:crypto';
+import { mkdtemp, readFile, rm, stat } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { ensureServiceSecret, provisionWorker } from './provision';
+
+describe('administrator worker provisioning', () => {
+  let root: string;
+  beforeEach(async () => {
+    root = await mkdtemp(path.join(os.tmpdir(), 'worker-provision-'));
+  });
+  afterEach(async () => {
+    await rm(root, { force: true, recursive: true });
+  });
+
+  it('creates a private random service token and sends only its SHA-256 hash to the database', async () => {
+    const tokenFile = path.join(root, 'token');
+    const binding = { enabled: false, userId: 'user-1', workerId: 'worker-1', workspaceId: null };
+    const provisionBinding = vi.fn(async () => binding);
+    await expect(
+      provisionWorker(
+        {
+          getBinding: async () => undefined,
+          provisionBinding,
+          resolveWorker: async () => undefined,
+        },
+        'worker-1',
+        tokenFile,
+      ),
+    ).resolves.toEqual(binding);
+    const token = (await readFile(tokenFile, 'utf8')).trim();
+    expect(token).toMatch(/^[a-f\d]{64}$/);
+    expect(provisionBinding).toHaveBeenCalledWith({
+      secretHash: createHash('sha256').update(token).digest('hex'),
+      workerId: 'worker-1',
+    });
+    if (process.platform !== 'win32') expect((await stat(tokenFile)).mode & 0o077).toBe(0);
+    expect(await ensureServiceSecret(tokenFile)).toBe(token);
+  });
+
+  it('idempotently accepts only the existing owner and exact token without enabling or replacing them', async () => {
+    const binding = { enabled: false, userId: 'user-1', workerId: 'worker-1', workspaceId: null };
+    const provisionBinding = vi.fn();
+    const tokenFile = path.join(root, 'token');
+    const store = {
+      getBinding: async () => binding,
+      provisionBinding,
+      resolveWorker: async () => binding,
+    };
+    await expect(provisionWorker(store, 'worker-1', tokenFile)).resolves.toEqual(binding);
+    expect(provisionBinding).not.toHaveBeenCalled();
+    await expect(
+      provisionWorker(
+        { ...store, resolveWorker: async () => ({ ...binding, userId: 'other' }) },
+        'worker-1',
+        tokenFile,
+      ),
+    ).rejects.toThrow('does not match');
+    await expect(provisionWorker(store, 'worker-2', tokenFile)).rejects.toThrow('different worker');
+  });
+});
diff --git a/apps/claude-code-worker/admin/provision.ts b/apps/claude-code-worker/admin/provision.ts
new file mode 100644
index 0000000000..e80cd9352a
--- /dev/null
+++ b/apps/claude-code-worker/admin/provision.ts
@@ -0,0 +1,70 @@
+import { createHash, randomBytes } from 'node:crypto';
+import { lstat, mkdir, open, readFile } from 'node:fs/promises';
+import path from 'node:path';
+
+export interface BindingIdentity {
+  enabled: boolean;
+  userId: string;
+  workerId: string;
+  workspaceId: string | null;
+}
+
+interface ProvisionStore {
+  getBinding: () => Promise<BindingIdentity | undefined>;
+  provisionBinding: (input: { secretHash: string; workerId: string }) => Promise<BindingIdentity>;
+  resolveWorker: (workerId: string, secretHash: string) => Promise<BindingIdentity | undefined>;
+}
+
+/** Never print or place the generated service credential in a process argument. */
+export const ensureServiceSecret = async (filename: string): Promise<string> => {
+  if (!path.isAbsolute(filename)) throw new Error('Token file path must be absolute');
+  await mkdir(path.dirname(filename), { mode: 0o700, recursive: true });
+  try {
+    const handle = await open(filename, 'wx', 0o600);
+    try {
+      await handle.writeFile(`${randomBytes(32).toString('hex')}\n`);
+      await handle.sync();
+    } finally {
+      await handle.close();
+    }
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error;
+  }
+  const stat = await lstat(filename);
+  if (
+    !stat.isFile() ||
+    stat.isSymbolicLink() ||
+    stat.size > 128 ||
+    (process.platform !== 'win32' && (stat.mode & 0o077) !== 0)
+  ) {
+    throw new Error('Token file must be a private regular file');
+  }
+  const secret = (await readFile(filename, 'utf8')).trim();
+  if (!/^[a-f\d]{64}$/.test(secret)) throw new Error('Invalid worker service token file');
+  return secret;
+};
+
+export const provisionWorker = async (
+  store: ProvisionStore,
+  workerId: string,
+  tokenFile: string,
+): Promise<BindingIdentity> => {
+  if (!/^[\w-]{1,128}$/.test(workerId)) throw new Error('Invalid worker ID');
+  const existing = await store.getBinding();
+  if (existing && existing.workerId !== workerId)
+    throw new Error('User already has a different worker binding');
+  const secret = await ensureServiceSecret(tokenFile);
+  const secretHash = createHash('sha256').update(secret).digest('hex');
+  if (existing) {
+    const authenticated = await store.resolveWorker(workerId, secretHash);
+    if (
+      authenticated?.userId !== existing.userId ||
+      authenticated?.workspaceId !== existing.workspaceId
+    ) {
+      throw new Error('Existing binding does not match this service token');
+    }
+    return existing;
+  }
+  // The database defaults enabled=false. Never activate a new account here.
+  return store.provisionBinding({ secretHash, workerId });
+};
