+  private readonly sequences = new Map<string, number>();
+
+  accept(event: AgentStreamEvent): boolean {
+    const sequence = event.data?.claudeCodeSequence;
+    if (!Number.isSafeInteger(sequence) || sequence < 1) return true;
+    const previous = this.sequences.get(event.operationId) ?? 0;
+    if (sequence <= previous) return false;
+    this.sequences.set(event.operationId, sequence);
+    return true;
+  }
+}
