+    await db
+      .update(messages)
+      .set({ content: 'after-edit', metadata: {} })
+      .where(eq(messages.id, queued.userMessageId!));
+    const prepared = (await claim()).preparedRequest as any;
+    expect(JSON.stringify(prepared.request)).toContain('after-edit');
+    for (const text of ['before-edit', '/removed-current-image.png', 'removed-current-skill-body'])
+      expect(JSON.stringify(prepared.request)).not.toContain(text);
+  });
+
+  it('honors a server topic pin without requiring its old offline project device or injecting its OS', async () => {
+    const agent = await createAgent();
+    await db
+      .update(agents)
+      .set({
+        provider: 'anthropic',
+        model: 'claude-api',
+        chatConfig: { runtimeEnv: { workingDirectory: 'C:\\private-windows-workspace' } },
+      })
+      .where(eq(agents.id, agent.id));
+    const [project] = await db.insert(projects).values({ name: 'project', userId }).returning();
+    const [directory] = await db
+      .insert(projectWorkingDirectories)
+      .values({
+        name: 'old directory',
+        path: 'C:\\private-windows-workspace',
+        projectId: project.id,
+        addedByUserId: userId,
+      })
+      .returning();
+    const [topic] = await db
+      .insert(topics)
+      .values({
+        agentId: agent.id,
+        model: 'default',
+        provider: 'claude-code',
+        projectId: project.id,
+        projectWorkingDirectoryId: directory.id,
+        metadata: { workingDirectory: directory.path },
+        userId,
+      })
+      .returning();
+    const queued = await caller().execAgent({
+      agentId: agent.id,
+      appContext: { topicId: topic.id },
+      prompt: 'Use the server worker',
+    });
