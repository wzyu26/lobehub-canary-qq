+    expect(prepare(makeState(), context).request.prompt).toContainEqual({
+      source: { type: 'url', url: 'https://example.com/image.png' },
+      type: 'image',
+    });
+    context.messages[4] = {
+      content: [{ type: 'video_url', video_url: 'video.mp4' }],
+      role: 'user',
+    };
+    expect(() => prepare(makeState(), context)).toThrow('prepared attachment type: video_url');
+  });
+
+  it('offers only server tools and explicitly marks client tools unavailable', () => {
+    const { request, unavailableTools } = prepare();
+    expect(request.tools).toEqual([
+      {
+        apiName: 'createDocument',
+        description: 'Create a document',
+        identifier: 'lobe-notebook',
+        inputSchema: parameters,
+        name: serverName,
+        type: 'builtin',
+      },
+    ]);
+    expect(unavailableTools).toEqual([browserName]);
+    expect(request.systemPrompt).toContain(`unavailable: ${browserName}`);
+  });
+
+  it('preserves historical tool IDs, arguments and structured results', () => {
+    const context = makeContext();
+    const calls = [
+      {
+        id: 'toolu_real',
+        type: 'function',
+        function: { name: serverName, arguments: '{"title":"hello"}' },
+      },
+    ];
+    context.messages.splice(
+      4,
+      0,
+      { content: '', role: 'assistant', tool_calls: calls },
+      { content: '{"documentId":"doc-one"}', role: 'tool', tool_call_id: 'toolu_real' },
+    );
+    const { request } = prepare(makeState(), context);
+    expect(request.prompt).toContainEqual({
+      text: JSON.stringify({ tool_calls: calls }),
+      type: 'text',
+    });
+    expect(request.prompt).toContainEqual({
+      text: '{"role":"tool","tool_call_id":"toolu_real"}',
+      type: 'text',
+    });
+    expect(request.prompt).toContainEqual({ text: '{"documentId":"doc-one"}', type: 'text' });
+  });
+
+  it('rejects schemas that cannot be registered safely', () => {
+    const context = makeContext();
+    context.resolvedTools!.tools[0].function.parameters = { type: 'string' };
+    expect(() => prepare(makeState(), context)).toThrow('no object schema');
+  });
+
+  it('requires an owned topic and the ordinary Claude Code backend', () => {
+    const state = makeState();
+    state.origin = { userId: 'user-one' };
+    expect(() => prepare(state)).toThrow('requires an owned topic');
