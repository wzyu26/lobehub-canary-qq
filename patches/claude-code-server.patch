+import { isHeterogeneousAgentModelId } from '@lobechat/const';
+import type { HeterogeneousProviderConfig } from '@lobechat/types';
+import { resolveAssistantRuntimeBackend } from '@lobechat/types';
+
+interface ModelSelection {
+  agentId?: string | null;
+  id?: string;
+  model?: string | null;
+  provider?: string | null;
+}
+
+/** Topic pins select an ordinary backend; explicit external agents keep their own routing. */
+export const resolveAssistantTransport = (
+  agent: ModelSelection | undefined,
+  isGatewayMode: boolean,
+  configuredProvider?: HeterogeneousProviderConfig,
+  topic?: ModelSelection,
+  agentId = agent?.id,
+) => {
+  const ownTopic = !topic?.agentId || topic.agentId === agentId;
+  const provider = ownTopic && topic?.model ? topic.provider || agent?.provider : agent?.provider;
+  const runtimeBackend = configuredProvider ? 'api' : resolveAssistantRuntimeBackend(provider);
+  const heterogeneousProvider =
+    configuredProvider ??
+    (!isGatewayMode &&
+    runtimeBackend !== 'claude-code' &&
+    agent?.provider !== 'claude-code' &&
+    isHeterogeneousAgentModelId(agent?.model)
+      ? { type: agent.model }
+      : undefined);
+  return { heterogeneousProvider, runtimeBackend };
+};
