+// @vitest-environment node
+import { randomUUID } from 'node:crypto';
+
+import Redis from 'ioredis';
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+
+import { publishStreamEventOnce } from '../publishStreamEventOnce';
+
+// Explicit opt-in only. Never fall back to the application's production REDIS_URL.
+const testUrl = process.env.TEST_REDIS_URL;
+
+describe.skipIf(!testUrl)('atomic event delivery on a dedicated test Redis', () => {
+  let redis: Redis;
+  const keys: string[] = [];
+  const stream = () => {
+    const key = `test:claude-code-events:${randomUUID()}`;
+    keys.push(key, `${key}:delivery-receipts`);
+    return key;
+  };
+
+  beforeAll(async () => {
+    redis = new Redis(testUrl!, {
+      connectTimeout: 3000,
+      lazyConnect: true,
+      maxRetriesPerRequest: 0,
+      retryStrategy: () => null,
+    });
+    await redis.connect();
+  });
+  afterAll(async () => {
+    if (!redis) return;
+    try {
+      if (keys.length) await redis.del(...keys);
+    } finally {
+      redis.disconnect();
+    }
+  });
+
+  it('keeps one stream entry across simultaneous delivery and reply-loss retry', async () => {
+    const key = stream();
+    const fields = ['type', 'stream_chunk', 'data', '{"content":"A"}'];
+    const ids = await Promise.all(
+      Array.from({ length: 8 }, () =>
+        publishStreamEventOnce(redis, key, 'sequence:1', 120, fields),
+      ),
+    );
+    expect(new Set(ids).size).toBe(1);
+    expect(await redis.xlen(key)).toBe(1);
+    expect(await publishStreamEventOnce(redis, key, 'sequence:1', 120, fields)).toBe(ids[0]);
+    await publishStreamEventOnce(redis, key, 'sequence:2', 120, fields);
+    expect(await redis.xlen(key)).toBe(2);
+    expect(await redis.hlen(`${key}:delivery-receipts`)).toBe(2);
+  });
+
+  it('renews receipt retention together with the stream on duplicate delivery', async () => {
+    const key = stream();
+    const receiptKey = `${key}:delivery-receipts`;
+    const id = await publishStreamEventOnce(redis, key, 'sequence:1', 120, ['data', '{}']);
+    await redis.expire(key, 5);
+    await redis.expire(receiptKey, 5);
+    expect(await publishStreamEventOnce(redis, key, 'sequence:1', 120, ['data', '{}'])).toBe(id);
+    expect(await redis.ttl(key)).toBeGreaterThanOrEqual(115);
+    expect(await redis.ttl(receiptKey)).toBeGreaterThanOrEqual(115);
+    expect(await redis.xlen(key)).toBe(1);
+  });
+});
