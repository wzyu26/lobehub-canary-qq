+import type { ClaudeCodeStatus } from '@lobechat/types';
+import { describe, expect, it } from 'vitest';
+
+import type { EnabledProviderWithModels } from '@/types/aiProvider';
+
+import { appendClaudeCodeModels, claudeCodeAvailabilityNotice } from './claudeCodeModels';
+
+const apiProviders: EnabledProviderWithModels[] = [
+  {
+    children: [{ abilities: {}, displayName: 'API model', id: 'api-model' }],
+    id: 'anthropic',
+    name: 'Anthropic',
+    source: 'builtin',
+  },
+];
+const status: ClaudeCodeStatus = {
+  authStatus: 'logged_in',
+  available: true,
+  enabled: true,
+  models: [
+    { displayName: 'Default', id: 'default' },
+    { displayName: 'Opus', id: 'opus' },
+  ],
+};
+
+describe('ordinary assistant server model options', () => {
+  it('does not expose the backend without the current user binding and worker model list', () => {
+    expect(appendClaudeCodeModels(apiProviders, undefined, 'server')).toBe(apiProviders);
+    expect(appendClaudeCodeModels(apiProviders, { ...status, enabled: false }, 'server')).toBe(
+      apiProviders,
+    );
+    expect(appendClaudeCodeModels(apiProviders, { ...status, models: [] }, 'server')).toBe(
+      apiProviders,
+    );
+    const stale = [
+      ...apiProviders,
+      { children: [], id: 'claude-code', name: 'stale user binding', source: 'builtin' as const },
+    ];
+    expect(appendClaudeCodeModels(stale, undefined, 'server')).toEqual(apiProviders);
+  });
+
+  it('uses the worker catalog without changing aliases, inventing prices, or mutating API providers', () => {
+    const list = appendClaudeCodeModels(apiProviders, status, 'Claude Code（服务器）');
+    expect(list[0]).toBe(apiProviders[0]);
+    expect(apiProviders).toHaveLength(1);
+    expect(list[1]).toMatchObject({
+      children: [
+        { displayName: 'Claude Code（服务器） · Default', id: 'default' },
+        { displayName: 'Claude Code（服务器） · Opus', id: 'opus' },
+      ],
+      id: 'claude-code',
+      name: 'Claude Code（服务器）',
+    });
+    expect(list[1].children.every((model) => model.pricing === undefined)).toBe(true);
+  });
+
+  it('does not duplicate model rows across refreshes or advertise an empty CLI id', () => {
+    const workerStatus = {
+      ...status,
+      models: [...status.models, status.models[0], { displayName: 'bad', id: '' }],
+    };
+    const first = appendClaudeCodeModels(apiProviders, workerStatus, 'server');
+    const second = appendClaudeCodeModels(first, workerStatus, 'server');
+    expect(second).toHaveLength(2);
+    expect(second[1].children.map((model) => model.id)).toEqual(['default', 'opus']);
+  });
+
+  it('keeps the chosen backend identifiable when login expires instead of choosing an API provider', () => {
+    const expired = { ...status, authStatus: 'expired' as const, available: false };
+    expect(appendClaudeCodeModels(apiProviders, expired, 'server')[1].id).toBe('claude-code');
+    expect(claudeCodeAvailabilityNotice('claude-code', expired)).toBe('expired');
+    expect(claudeCodeAvailabilityNotice('anthropic', expired)).toBeUndefined();
+    expect(claudeCodeAvailabilityNotice('claude-code', status, true)).toBe('unavailable');
+    expect(claudeCodeAvailabilityNotice('claude-code', { ...status, enabled: false })).toBe(
+      'disabled',
+    );
+    expect(
+      claudeCodeAvailabilityNotice('claude-code', { ...status, authStatus: 'logged_out' }),
+    ).toBe('loggedOut');
+  });
+});
diff --git a/src/hooks/claudeCodeModels.ts b/src/hooks/claudeCodeModels.ts
new file mode 100644
index 0000000000..4fce58550b
--- /dev/null
+++ b/src/hooks/claudeCodeModels.ts
@@ -0,0 +1,53 @@
+import type { ClaudeCodeStatus } from '@lobechat/types';
+import { ModelProvider } from 'model-bank/modelProvider';
+import { claudeCodeProvider } from 'model-bank/modelProviders/claude-code';
+
+import type { EnabledProviderWithModels } from '@/types/aiProvider';
+
+/** Only explicit ordinary-chat surfaces opt into this list. */
+export const appendClaudeCodeModels = (
+  providers: EnabledProviderWithModels[],
+  status: ClaudeCodeStatus | undefined,
+  providerName: string,
+): EnabledProviderWithModels[] => {
+  const apiProviders = providers.some((provider) => provider.id === ModelProvider.ClaudeCode)
+    ? providers.filter((provider) => provider.id !== ModelProvider.ClaudeCode)
+    : providers;
+  if (!status?.enabled || status.models.length === 0) return apiProviders;
+
+  const seen = new Set<string>();
+  const models = status.models.filter((model) => {
+    if (!model.id || seen.has(model.id)) return false;
+    seen.add(model.id);
+    return true;
+  });
+  if (models.length === 0) return apiProviders;
+
+  return [
+    ...apiProviders,
+    {
+      children: models.map((model) => ({
+        abilities: { files: true, functionCall: true, vision: true },
+        displayName: `${providerName} · ${model.displayName}`,
+        id: model.id,
+      })),
+      id: ModelProvider.ClaudeCode,
+      name: providerName || claudeCodeProvider.name,
+      source: 'builtin',
+    },
+  ];
+};
+
+export const claudeCodeAvailabilityNotice = (
+  provider: string | undefined,
+  status: ClaudeCodeStatus | undefined,
+  hasError = false,
+): 'checking' | 'disabled' | 'expired' | 'loggedOut' | 'unavailable' | undefined => {
+  if (provider !== ModelProvider.ClaudeCode) return;
+  if (hasError) return 'unavailable';
+  if (!status) return 'checking';
+  if (!status.enabled) return 'disabled';
+  if (status.authStatus === 'expired') return 'expired';
+  if (status.authStatus === 'logged_out') return 'loggedOut';
+  if (!status.available || status.authStatus === 'unknown') return 'unavailable';
+};
