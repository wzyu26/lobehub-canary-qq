+import type {
+  ClaudeCodeAuthStatus,
+  ClaudeCodePreparedRequest,
+  ClaudeCodeRunStatus,
+  ClaudeCodeToolReceiptStatus,
+  ClaudeCodeWorkerCapabilities,
+} from '@lobechat/types';
+import { sql } from 'drizzle-orm';
+import {
+  boolean,
+  index,
+  integer,
+  jsonb,
+  pgTable,
+  primaryKey,
+  text,
+  uniqueIndex,
+} from 'drizzle-orm/pg-core';
+
+import { timestamps, timestamptz } from './_helpers';
+import { agentOperations } from './agentOperations';
+import { threads, topics } from './topic';
+import { users } from './user';
+import { workspaces } from './workspace';
+
+export const claudeCodeBindings = pgTable(
+  'claude_code_bindings',
+  {
+    workerId: text('worker_id').primaryKey().notNull(),
+    userId: text('user_id')
+      .references(() => users.id, { onDelete: 'cascade' })
+      .notNull(),
+    workspaceId: text('workspace_id').references(() => workspaces.id, { onDelete: 'cascade' }),
+    enabled: boolean('enabled').default(false).notNull(),
+    /** SHA-256 of a random service credential; never a Claude OAuth credential. */
+    secretHash: text('secret_hash').notNull(),
+    authStatus: text('auth_status').$type<ClaudeCodeAuthStatus>().default('unknown').notNull(),
+    capabilities: jsonb('capabilities').$type<ClaudeCodeWorkerCapabilities>().default({}).notNull(),
+    lastSeenAt: timestamptz('last_seen_at'),
+    ...timestamps,
+  },
+  (t) => [
+    uniqueIndex('claude_code_bindings_owner_unique').on(
+      t.userId,
+      sql`coalesce(${t.workspaceId}, '')`,
+    ),
+  ],
+);
+
+export const claudeCodeRuns = pgTable(
+  'claude_code_runs',
+  {
+    operationId: text('operation_id')
+      .references(() => agentOperations.id, { onDelete: 'cascade' })
+      .primaryKey()
+      .notNull(),
+    userId: text('user_id')
+      .references(() => users.id, { onDelete: 'cascade' })
+      .notNull(),
+    workspaceId: text('workspace_id').references(() => workspaces.id, { onDelete: 'cascade' }),
+    topicId: text('topic_id')
+      .references(() => topics.id, { onDelete: 'cascade' })
+      .notNull(),
+    threadId: text('thread_id').references(() => threads.id, { onDelete: 'cascade' }),
+    workerId: text('worker_id')
+      .references(() => claudeCodeBindings.workerId)
+      .notNull(),
+    requestId: text('request_id').notNull(),
+    requestHash: text('request_hash').notNull(),
+    status: text('status').$type<ClaudeCodeRunStatus>().default('queued').notNull(),
+    preparedRequest: jsonb('prepared_request').$type<ClaudeCodePreparedRequest>().notNull(),
+    leaseTokenHash: text('lease_token_hash'),
+    leaseExpiresAt: timestamptz('lease_expires_at'),
+    heartbeatAt: timestamptz('heartbeat_at'),
+    queuedAt: timestamptz('queued_at').defaultNow().notNull(),
+    startedAt: timestamptz('started_at'),
+    endedAt: timestamptz('ended_at'),
+    error: text('error'),
+    lastEventSequence: integer('last_event_sequence').default(0).notNull(),
+    projectedSequence: integer('projected_sequence').default(0).notNull(),
+    ...timestamps,
+  },
+  (t) => [
+    uniqueIndex('claude_code_runs_request_unique').on(
+      t.userId,
+      sql`coalesce(${t.workspaceId}, '')`,
+      t.requestId,
+    ),
+    // A database invariant, in addition to the queue's transaction advisory lock.
+    uniqueIndex('claude_code_runs_single_active')
+      .on(sql`(1)`)
+      .where(sql`${t.status} IN ('running', 'cancelling')`),
+    index('claude_code_runs_queue_idx').on(t.status, t.queuedAt),
+    index('claude_code_runs_owner_topic_idx').on(t.userId, t.topicId),
+  ],
+);
+
+export const claudeCodeEvents = pgTable(
+  'claude_code_events',
+  {
+    runId: text('run_id')
+      .references(() => claudeCodeRuns.operationId, { onDelete: 'cascade' })
+      .notNull(),
+    sequence: integer('sequence').notNull(),
+    payload: jsonb('payload').$type<Record<string, unknown>>().notNull(),
+    payloadHash: text('payload_hash').notNull(),
+    projected: boolean('projected').default(false).notNull(),
+    ...timestamps,
+  },
+  (t) => [primaryKey({ columns: [t.runId, t.sequence] })],
+);
+
+export const claudeCodeToolReceipts = pgTable(
+  'claude_code_tool_receipts',
+  {
+    runId: text('run_id')
+      .references(() => claudeCodeRuns.operationId, { onDelete: 'cascade' })
+      .notNull(),
+    toolCallId: text('tool_call_id').notNull(),
+    name: text('name').notNull(),
+    argumentHash: text('argument_hash').notNull(),
+    status: text('status').$type<ClaudeCodeToolReceiptStatus>().default('started').notNull(),
+    result: jsonb('result').$type<Record<string, unknown>>(),
+    ...timestamps,
+  },
+  (t) => [primaryKey({ columns: [t.runId, t.toolCallId] })],
+);
+
+export type ClaudeCodeBindingItem = typeof claudeCodeBindings.$inferSelect;
+export type ClaudeCodeRunItem = typeof claudeCodeRuns.$inferSelect;
+export type ClaudeCodeEventItem = typeof claudeCodeEvents.$inferSelect;
+export type ClaudeCodeToolReceiptItem = typeof claudeCodeToolReceipts.$inferSelect;
