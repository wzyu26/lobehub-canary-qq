@@ -0,0 +1,161 @@
+import type { AgentState, ContextBuilder, ContextBuildInput } from '@lobechat/agent-runtime';
+import { MessagesEngine } from '@lobechat/context-engine';
+import type { UIChatMessage } from '@lobechat/types';
+import { describe, expect, it, vi } from 'vitest';
+
+import { buildClaudeCodeContext } from './buildContext';
+import { prepareClaudeCodeContext } from './prepareContext';
+
+const history = [
+  { content: 'Historical user question', id: 'old-user', role: 'user' },
+  { content: 'Historical assistant answer', id: 'old-assistant', role: 'assistant' },
+] as UIChatMessage[];
+const state = (memory: string): AgentState =>
+  ({
+    messages: [...history, { content: 'First turn question', id: 'current-user', role: 'user' }],
+    modelRuntimeConfig: { model: 'default', provider: 'claude-code' },
+    origin: { topicId: 'topic', userId: 'user' },
+    world: {
+      agent: { systemRole: 'Ordinary assistant role' },
+      userMemory: {
+        enabled: true,
+        memories: {
+          contexts: [{ description: memory, id: 'memory', title: 'Preference' }],
+          experiences: [],
+          preferences: [],
+        },
+      },
+    },
+  }) as AgentState;
+
+// Use the real shared memory injector, first-user merge and final cleanup.
+const createBuilder = (historyCount?: number) => {
+  const build = vi.fn(async (input: ContextBuildInput) => {
+    const processed = await new MessagesEngine({
+      enableHistoryCount: historyCount !== undefined,
+      historyCount,
+      messages: input.payload.messages as UIChatMessage[],
+      model: input.model,
+      provider: input.provider,
+      systemRole: input.state.world?.agent?.systemRole,
+      userMemory: input.state.world?.userMemory,
+    }).process();
+    return { messages: processed.messages, replayAssistantReasoning: false };
+  });
+  return { build } satisfies ContextBuilder;
+};
+
+describe('Claude Code independent-turn shared-context integration', () => {
+  it('builds once per turn and sends latest injected memory plus all current LobeHub history', async () => {
+    const firstState = state('Memory version one');
+    const builder = createBuilder();
+    const firstContext = await buildClaudeCodeContext(builder, firstState);
+    const first = prepareClaudeCodeContext({
+      context: firstContext,
+      isServerTool: () => false,
+      state: firstState,
+    }).request;
+    expect(JSON.stringify(first.prompt)).toContain('Memory version one');
+    const secondState = state('Memory version two');
+    secondState.messages = [
+      ...firstState.messages,
+      { content: 'First turn saved answer', id: 'first-answer', role: 'assistant' },
+      { content: 'Second turn question', id: 'second-user', role: 'user' },
+    ];
+    const secondContext = await buildClaudeCodeContext(builder, secondState);
+    const prepared = secondContext.messages as Array<{ content: string; role: string }>;
+    const injectionIndex = prepared.findIndex((message) =>
+      message.content.includes('Memory version two'),
+    );
+    const oldUserIndex = prepared.findIndex(
+      (message) => message.content === 'Historical user question',
+    );
+    expect(injectionIndex).toBeGreaterThanOrEqual(0);
+    expect(injectionIndex).toBeLessThan(oldUserIndex);
+    expect(prepared[injectionIndex].role).toBe('user');
+    expect(prepared[injectionIndex]).not.toHaveProperty('meta');
+    expect(prepared[injectionIndex]).not.toHaveProperty('id');
+    const second = prepareClaudeCodeContext({
+      context: secondContext,
+      isServerTool: () => false,
+      state: secondState,
+    }).request;
+    const prompt = JSON.stringify(second.prompt);
+    expect(prompt).toContain('Memory version two');
+    expect(prompt).not.toContain('Memory version one');
+    expect(prompt.match(/Memory version two/g)).toHaveLength(1);
+    for (const message of secondState.messages)
+      expect(prompt.split(message.content as string)).toHaveLength(2);
+    // The exact prepared list is authoritative; no resumed or reconstructed history.
+    expect(second.prompt).toEqual(
+      prepared
+        .filter((message) => message.role !== 'system')
+        .flatMap((message) => [
+          { text: JSON.stringify({ role: message.role }), type: 'text' },
+          { text: message.content, type: 'text' },
+        ]),
+    );
+    expect(Object.keys(second).sort()).toEqual([
+      'model',
+      'prompt',
+      'protocol',
+      'systemPrompt',
+      'tools',
+    ]);
+    expect(builder.build).toHaveBeenCalledTimes(2);
+    expect(builder.build.mock.calls[0][0].state).toBe(firstState);
+    const secondInput = builder.build.mock.calls[1][0];
+    expect(secondInput.state).toBe(secondState);
+    expect(secondInput.payload.messages).toBe(secondState.messages);
+    expect(secondInput.state.messages).toBe(secondInput.payload.messages);
+    expect(secondInput.state.world).toBe(secondState.world);
+  });
+
+  it('reflects edited LobeHub history and removed memory on the next independent turn', async () => {
+    const builder = createBuilder();
+    const current = state('Memory before deletion');
+    const firstContext = await buildClaudeCodeContext(builder, current);
+    const first = prepareClaudeCodeContext({
+      context: firstContext,
+      isServerTool: () => false,
+      state: current,
+    });
+    expect(JSON.stringify(first.request.prompt)).toContain('Memory before deletion');
+    current.world!.userMemory = {
+      enabled: true,
+      memories: { contexts: [], experiences: [], preferences: [] },
+    };
+    current.messages = current.messages.map((message) =>
+      message.id === 'old-user' ? { ...message, content: 'Edited historical question' } : message,
+    );
+    const context = await buildClaudeCodeContext(builder, current);
+    const request = prepareClaudeCodeContext({
+      context,
+      isServerTool: () => false,
+      state: current,
+    }).request;
+    const prompt = JSON.stringify(request.prompt);
+    expect(prompt).toContain('Edited historical question');
+    expect(prompt).not.toContain('Historical user question');
+    expect(prompt).not.toContain('Memory before deletion');
+    expect(builder.build).toHaveBeenCalledTimes(2);
+  });
+
+  it('respects the ordinary context history limit without restoring omitted raw messages', async () => {
+    const current = state('Latest memory');
+    const builder = createBuilder(1);
+    const context = await buildClaudeCodeContext(builder, current);
+    const request = prepareClaudeCodeContext({
+      context,
+      isServerTool: () => false,
+      state: current,
+    }).request;
+    const prompt = JSON.stringify(request.prompt);
+    expect(prompt).toContain('Latest memory');
+    expect(prompt).toContain('First turn question');
+    expect(prompt).not.toContain('Historical user question');
+    expect(prompt).not.toContain('Historical assistant answer');
+    expect(builder.build).toHaveBeenCalledTimes(1);
+    expect(current.messages).toHaveLength(3);
+  });
+});
