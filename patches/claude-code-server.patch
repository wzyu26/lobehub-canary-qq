@@ -0,0 +1,92 @@
+import type { ClaudeCodeAssistantTool } from '@lobechat/heterogeneous-agents/protocol';
+import { describe, expect, it, vi } from 'vitest';
+
+import type { WorkerApi } from './api';
+import { testEvent } from './testUtils';
+import { awaitToolResult, mapToolEvent } from './toolBridge';
+
+describe('tool forwarding', () => {
+  it('polls pending and ambiguous writes with the original call ID until actual completion', async () => {
+    const result = {
+      content: [{ text: 'Saved', type: 'text' }],
+      structuredContent: { documentId: 'doc' },
+    };
+    const post = vi
+      .fn()
+      .mockRejectedValueOnce(new Error('lost response'))
+      .mockResolvedValueOnce({ status: 'pending' })
+      .mockResolvedValueOnce({ status: 'completed', result });
+    const request = {
+      args: { text: 'hello' },
+      leaseToken: 'lease',
+      name: 'create',
+      toolCallId: 'toolu_1',
+    };
+    await expect(
+      awaitToolResult({ post } as WorkerApi, 'op', request, new AbortController().signal),
+    ).resolves.toEqual(result);
+    expect(post).toHaveBeenCalledTimes(3);
+    expect(post.mock.calls.every(([, body]) => body === request)).toBe(true);
+  });
+
+  it('does not treat interrupted or submitted work as tool success', async () => {
+    const post = vi.fn().mockResolvedValue({ status: 'interrupted' });
+    await expect(
+      awaitToolResult(
+        { post } as WorkerApi,
+        'op',
+        {
+          args: {},
+          leaseToken: 'lease',
+          name: 'write',
+          toolCallId: 'toolu_2',
+        },
+        new AbortController().signal,
+      ),
+    ).rejects.toThrow('interrupted');
+  });
+
+  it('keeps Claude IDs and maps only registered tool names onto native cards and structured results', () => {
+    const tools: ClaudeCodeAssistantTool[] = [
+      {
+        apiName: 'createDocument',
+        description: 'create',
+        identifier: 'lobe-documents',
+        inputSchema: { type: 'object' },
+        name: 'documents_create',
+        type: 'builtin',
+      },
+    ];
+    const toolCalling = {
+      apiName: 'mcp__lobe_cc__documents_create',
+      arguments: '{}',
+      id: 'toolu_3',
+      identifier: 'claude-code',
+    };
+    const results = new Map([
+      [
+        'toolu_3',
+        {
+          content: [{ type: 'text' as const, text: 'Real saved result' }],
+          structuredContent: { documentId: 'doc-1' },
+        },
+      ],
+    ]);
+    expect(
+      mapToolEvent(testEvent('tool_start', { toolCalling }), tools, results).data.toolCalling,
+    ).toMatchObject({ apiName: 'createDocument', id: 'toolu_3', identifier: 'lobe-documents' });
+    expect(
+      mapToolEvent(
+        testEvent('tool_result', { toolCallId: 'toolu_3', content: 'Model summary' }),
+        tools,
+        results,
+      ).data,
+    ).toMatchObject({
+      content: 'Real saved result',
+      pluginState: { documentId: 'doc-1' },
+      toolCallId: 'toolu_3',
+    });
+    const builtin = testEvent('tool_start', { toolCalling: { ...toolCalling, apiName: 'Bash' } });
+    expect(mapToolEvent(builtin, tools, results)).toEqual(builtin);
