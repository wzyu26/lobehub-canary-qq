+// @vitest-environment node
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import type { LobeChatDatabase } from '@/database/type';
+
+import { getClaudeCodeStatus } from './status';
+
+const mocks = vi.hoisted(() => ({ binding: vi.fn(), recover: vi.fn() }));
+vi.mock('@/database/models/claudeCode', () => ({
+  ClaudeCodeModel: class {
+    getBinding = mocks.binding;
+  },
+}));
+vi.mock('./recover', () => ({ recoverClaudeCodeRuns: mocks.recover }));
+const db = {} as LobeChatDatabase;
+beforeEach(() => vi.resetAllMocks());
+afterEach(() => vi.unstubAllEnvs());
+describe('Claude Code status recovery', () => {
+  it('settles persisted terminal work after restart even while the feature or binding is disabled', async () => {
+    vi.stubEnv('CLAUDE_CODE_SERVER_ENABLED', '0');
+    mocks.binding.mockResolvedValue({ enabled: false });
+    expect(await getClaudeCodeStatus(db, 'owner', 'workspace')).toMatchObject({ enabled: false });
+    expect(mocks.recover).toHaveBeenCalledWith(db, { userId: 'owner', workspaceId: 'workspace' });
+  });
+  it('does no recovery work for an account without a binding', async () => {
+    mocks.binding.mockResolvedValue(undefined);
+    await getClaudeCodeStatus(db, 'owner');
+    expect(mocks.recover).not.toHaveBeenCalled();
+  });
+});
