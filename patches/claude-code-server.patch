+      .update(messages)
+      .set({ metadata: { activeBranchIndex: 1 } })
+      .where(eq(messages.id, 'claim-root'));
+    await addMessage('claim-future-user', 'user', 'future-question', queued.assistantMessageId, {
+      selectedSkillIds: [skills[2].identifier],
+    });
+    const prepared = (await claim()).preparedRequest as any;
+    const context = JSON.stringify(prepared.request);
+    for (const text of [
+      'shared-root',
+      'chosen-question',
+      'chosen-answer',
+      'chosen-tail',
+      'queued-question',
+      'secret-chosen-skill-body',
+    ])
+      expect(context).toContain(text);
+    for (const text of [
+      'inactive-question',
+      'inactive-answer',
+      'future-question',
+      'secret-inactive-skill-body',
+      'secret-future-skill-body',
+    ])
+      expect(context).not.toContain(text);
+    expect(
+      prepared.state.messages.filter((message: any) => message.content === 'queued-question'),
+    ).toHaveLength(1);
+  });
+
+  it('uses edited current-turn attachment relations and skill selections after queuing', async () => {
+    const agent = await createAgent();
+    const [skill] = await db
+      .insert(agentSkills)
+      .values({
+        content: 'removed-current-skill-body',
+        description: 'skill',
+        identifier: 'removed-current',
+        name: 'removed-current',
+        source: 'user',
+        userId,
+      })
+      .returning();
+    const [image] = await db
+      .insert(files)
+      .values({
+        fileType: 'image/png',
+        name: 'remove.png',
+        size: 10,
+        url: '/removed-current-image.png',
+        userId,
+      })
+      .returning();
+    const queued = await caller().execAgent({
+      agentId: agent.id,
+      attachedFileIds: [image.id],
+      prompt: 'before-edit',
+      selectedSkillIds: [skill.identifier],
+    });
