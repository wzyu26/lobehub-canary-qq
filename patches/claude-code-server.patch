+    vi.mocked(execFile).mockImplementation(((
+      _command: string,
+      _args: string[],
+      _options: object,
+      callback: (error: Error | null, output: { stdout: string; stderr: string }) => void,
+    ) => {
+      callback(null, { stdout: '2.1.999 (Claude Code)', stderr: '' });
+    }) as typeof execFile);
+    await expect(discoverClaudeModels(testConfig(process.cwd()))).rejects.toThrow(
+      'differs from the worker build',
