+++ b/apps/server/src/services/claudeCode/__tests__/projection.integration.test.ts
@@ -0,0 +1,182 @@
+import { eq } from 'drizzle-orm';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { ClaudeCodeModel } from '@/database/models/claudeCode';
+import { MessageModel } from '@/database/models/message';
+import { messagePlugins, messages } from '@/database/schemas';
+import type { IStreamEventManager } from '@/server/modules/AgentRuntime/types';
+import { HeterogeneousPersistenceHandler } from '@/server/services/heterogeneousAgent/HeterogeneousPersistenceHandler';
+
+import { projectClaudeCodeEvents, restoreClaudeCodeProjection } from '../projectEvents';
+import {
+  db,
+  event,
+  leaseToken,
+  model,
+  other,
+  owner,
+  prepareRows,
+  resetRows,
+  running,
+  topicId,
+} from './testUtils';
+
+vi.mock('@/server/modules/AgentRuntime', () => ({ createStreamEventManager: vi.fn() }));
+
+describe('durable ordinary-assistant projection with real database models', () => {
+  beforeEach(prepareRows);
+  afterEach(async () => {
+    vi.restoreAllMocks();
+    await resetRows();
+  });
+
+  it('updates the ordinary origin assistant row without a duplicate bubble and keeps equal deltas', async () => {
+    const { scope, assistantMessageId } = await running();
+    await model().appendEvents(scope.operationId, leaseToken, [
+      event(1, 'stream_chunk', { chunkType: 'text', content: 'A' }),
+      event(2, 'stream_chunk', { chunkType: 'text', content: 'A' }),
+    ]);
+    await projectClaudeCodeEvents(scope, {
+      publishStreamEvent: vi.fn(),
+    } as unknown as IStreamEventManager);
+    expect((await new MessageModel(db, owner).findById(assistantMessageId))?.content).toBe('AA');
+    const topicMessages = await new MessageModel(db, owner).query({ topicId });
+    expect(
+      topicMessages.filter((message) => message.role === 'assistant').map((message) => message.id),
+    ).toEqual([assistantMessageId]);
+  });
+
+  it('restores Maps and Sets on a cold projector and does not duplicate tool rows or text on receipt retries', async () => {
+    const { scope, assistantMessageId } = await running();
+    const tool = {
+      apiName: 'createDocument',
+      arguments: '{}',
+      id: 'toolu_one',
+      identifier: 'lobe-documents',
+      type: 'builtin',
+    };
+    const batch = [
+      event(1, 'stream_chunk', { chunkType: 'text', content: 'Saved ' }),
+      event(2, 'stream_chunk', { chunkType: 'tools_calling', toolsCalling: [tool] }),
+      event(3, 'tool_result', {
+        toolCallId: 'toolu_one',
+        content: 'actual result',
+        pluginState: { documentId: 'doc-1' },
+      }),
+    ];
+    const publishStreamEvent = vi.fn();
+    const stream = { publishStreamEvent } as unknown as IStreamEventManager;
+    await model().appendEvents(scope.operationId, leaseToken, batch);
+    await projectClaudeCodeEvents(scope, stream);
+    const checkpoint = await model().getProjectionState(scope.operationId);
+    const restored = restoreClaudeCodeProjection(checkpoint).get(scope.operationId)!;
+    expect(restored.processedKeys).toBeInstanceOf(Set);
+    expect(restored.toolMsgIdByCallId).toBeInstanceOf(Map);
+    expect(restored.toolMsgIdByCallId.size).toBe(1);
+    await model().appendEvents(scope.operationId, leaseToken, batch);
+    await projectClaudeCodeEvents(scope, stream);
+    await model().appendEvents(scope.operationId, leaseToken, [
+      event(4, 'stream_chunk', { chunkType: 'text', content: 'once.' }),
+    ]);
+    await projectClaudeCodeEvents(scope, stream);
+    expect((await new MessageModel(db, owner).findById(assistantMessageId))?.content).toBe(
+      'Saved once.',
+    );
+    const cards = await db
+      .select()
+      .from(messagePlugins)
+      .where(eq(messagePlugins.toolCallId, tool.id));
+    expect(cards).toHaveLength(1);
+    expect(cards[0].state).toMatchObject({ documentId: 'doc-1' });
+    expect(publishStreamEvent).toHaveBeenCalledTimes(4);
+  });
+
+  it('replays a lost stream acknowledgement with the same sequence key after committed message projection', async () => {
+    const { scope, assistantMessageId } = await running();
+    await model().appendEvents(scope.operationId, leaseToken, [
+      event(1, 'stream_chunk', { chunkType: 'text', content: 'one' }),
+    ]);
+    const delivered = new Set<string>();
+    let loseReply = true;
+    const publish = vi.fn(async (_operationId: string, published: { deduplicationKey: string }) => {
+      delivered.add(published.deduplicationKey);
+      if (loseReply) {
+        loseReply = false;
+        throw new Error('Reply lost after XADD');
+      }
+    });
+    const stream = { publishStreamEvent: publish } as unknown as IStreamEventManager;
+    await expect(projectClaudeCodeEvents(scope, stream)).rejects.toThrow('Reply lost');
+    expect((await model().getRun(scope.operationId))?.projectedSequence).toBe(1);
+    await projectClaudeCodeEvents(scope, stream);
+    expect(delivered.size).toBe(1);
+    expect(publish.mock.calls[0][1].deduplicationKey).toBe(
+      publish.mock.calls[1][1].deduplicationKey,
+    );
+    expect((await new MessageModel(db, owner).findById(assistantMessageId))?.content).toBe('one');
+  });
+
+  it('keeps branch results scoped and rejects a different user reading or projecting the run', async () => {
+    const { scope } = await running('branch-op', 'branch-one');
+    await db.insert(messages).values({
+      id: 'main-assistant',
+      role: 'assistant',
+      content: 'main stays',
+      userId: owner,
+      topicId,
+    });
+    await model().appendEvents(scope.operationId, leaseToken, [
+      event(1, 'stream_chunk', { chunkType: 'text', content: 'branch only' }, scope.operationId),
+      event(2, 'stream_start', { newStep: true }, scope.operationId, 1),
+      event(
+        3,
+        'stream_chunk',
+        { chunkType: 'text', content: 'next branch step' },
+        scope.operationId,
+        1,
+      ),
+    ]);
+    await projectClaudeCodeEvents(scope, {
+      publishStreamEvent: vi.fn(),
+    } as unknown as IStreamEventManager);
+    const rows = await db.select().from(messages);
+    expect(rows.find((row) => row.id === 'main-assistant')?.content).toBe('main stays');
+    expect(
+      rows
+        .filter((row) => row.role === 'assistant' && row.id !== 'main-assistant')
+        .every((row) => row.threadId === 'branch-one'),
+    ).toBe(true);
+    expect(await new ClaudeCodeModel(db, other).getRun(scope.operationId)).toBeUndefined();
+    await expect(
+      projectClaudeCodeEvents({ ...scope, userId: other }, {
+        publishStreamEvent: vi.fn(),
+      } as unknown as IStreamEventManager),
+    ).rejects.toThrow('Run not found');
+  });
+
+  it('rolls back message writes and reducer cursor together when projection fails mid-batch', async () => {
+    const { scope, assistantMessageId } = await running();
+    await model().appendEvents(scope.operationId, leaseToken, [
+      event(1, 'stream_chunk', { chunkType: 'text', content: 'first ' }),
+      event(2, 'stream_chunk', { chunkType: 'text', content: 'second' }),
+    ]);
+    const original = HeterogeneousPersistenceHandler.prototype.ingest;
+    let writes = 0;
+    const injected = vi
+      .spyOn(HeterogeneousPersistenceHandler.prototype, 'ingest')
+      .mockImplementation(async function (this: HeterogeneousPersistenceHandler, ...args) {
+        const result = await original.apply(this, args);
+        if (++writes === 2) throw new Error('Projection transaction interrupted');
+        return result;
+      });
+    const stream = { publishStreamEvent: vi.fn() } as unknown as IStreamEventManager;
+    await expect(projectClaudeCodeEvents(scope, stream)).rejects.toThrow('transaction interrupted');
+    injected.mockRestore();
+    expect((await model().getRun(scope.operationId))?.projectedSequence).toBe(0);
+    expect((await new MessageModel(db, owner).findById(assistantMessageId))?.content).toBe('');
+    await projectClaudeCodeEvents(scope, stream);
+    expect((await new MessageModel(db, owner).findById(assistantMessageId))?.content).toBe(
+      'first second',
+    );
+  });
+});
diff --git a/apps/server/src/services/claudeCode/__tests__/recover.integration.test.ts b/apps/server/src/services/claudeCode/__tests__/recover.integration.test.ts
