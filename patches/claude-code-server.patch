+// @vitest-environment node
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import type { LobeChatDatabase } from '@/database/type';
+
+import { CompletionLifecycle } from '.';
+
+const mocks = vi.hoisted(() => ({
+  after: vi.fn(),
+  instantiate: vi.fn(),
+  persist: vi.fn(),
+  recall: vi.fn(),
+  recordStart: vi.fn(),
+  registerWorks: vi.fn(),
+  settleRepair: vi.fn(),
+  verify: vi.fn(),
+  verifyLookup: vi.fn(),
+}));
+vi.mock('@/database/models/agentOperation', () => ({
+  AgentOperationModel: class {
+    constructor(readonly db: unknown) {}
+    recordStart = mocks.recordStart;
+  },
+}));
+vi.mock('@/database/models/message', () => ({
+  MessageModel: class {
+    constructor(readonly db: unknown) {}
+  },
+}));
+vi.mock('@/database/models/verifyRun', () => ({
+  VerifyRunModel: class {
+    constructor(private readonly db: unknown) {}
+    findByOperation = (operationId: string) => mocks.verifyLookup(this.db, operationId);
+  },
+}));
+vi.mock('@/server/services/verify', () => ({
+  instantiateVerifyPlanOnStart: mocks.instantiate,
+  runVerifyOnCompletion: mocks.verify,
+  settleFailedRepair: mocks.settleRepair,
+}));
+vi.mock('@/server/utils/scheduleAfterResponse', () => ({ after: mocks.after }));
+vi.mock('../hooks', () => ({
+  CriticalHookDeliveryError: class extends Error {},
+  hookDispatcher: { dispatch: vi.fn(), unregister: vi.fn() },
+}));
+vi.mock('./persistence', () => ({ persistCompletion: mocks.persist }));
+vi.mock('./recall', () => ({ recallUserOnCompletion: mocks.recall }));
+vi.mock('./fileWorks', () => ({ registerFileWorks: mocks.registerWorks }));
+
+beforeEach(() => {
+  vi.resetAllMocks();
+  mocks.persist.mockResolvedValue(true);
+  mocks.recall.mockResolvedValue(undefined);
+  mocks.instantiate.mockResolvedValue(undefined);
+});
+
+describe('CompletionLifecycle connection lifetime', () => {
+  const state = {
+    host: { hooks: [] },
+    messages: [{ content: 'A saved answer', role: 'assistant' }],
+    origin: { userId: 'owner' },
+  };
+
+  it.each([true, false])(
+    'keeps synchronous writes scoped and background work usable (separate=%s)',
+    async (separate) => {
+      const transaction = { kind: 'transaction' } as unknown as LobeChatDatabase;
+      const base = { kind: 'base' } as unknown as LobeChatDatabase;
+      const background = separate ? base : transaction;
+      const lifecycle = new CompletionLifecycle(
+        transaction,
+        'owner',
+        'workspace',
+        separate ? { backgroundDB: base } : undefined,
+      );
+      await lifecycle.dispatchHooks('run', state, 'done');
+      expect(mocks.persist.mock.calls[0][0].serverDB).toBe(transaction);
+      expect(mocks.verifyLookup).toHaveBeenCalledWith(transaction, 'run');
+      expect(mocks.registerWorks.mock.calls[0][0].serverDB).toBe(transaction);
+      const recallDeps = mocks.recall.mock.calls[0][0];
+      expect(recallDeps.serverDB).toBe(background);
+      expect(recallDeps.agentOperationModel.db).toBe(background);
+      expect(recallDeps.messageModel.db).toBe(background);
+      expect(mocks.verify).not.toHaveBeenCalled();
+      for (const [deferred] of mocks.after.mock.calls) await deferred();
+      expect(mocks.verify).toHaveBeenCalledWith(
+        background,
+        'owner',
+        expect.objectContaining({ operationId: 'run' }),
+        'workspace',
+      );
+    },
+  );
+
+  it('keeps interrupted repair and fire-and-forget plan creation off the transaction connection', async () => {
+    const transaction = {} as LobeChatDatabase;
+    const base = {} as LobeChatDatabase;
+    const lifecycle = new CompletionLifecycle(transaction, 'owner', undefined, {
+      backgroundDB: base,
+    });
+    await lifecycle.recordStart({ operationId: 'run', taskId: 'task', userId: 'owner' } as any);
+    expect(mocks.instantiate).toHaveBeenCalledWith(
+      base,
+      'owner',
+      { operationId: 'run', taskId: 'task' },
+      undefined,
+    );
+    await lifecycle.dispatchHooks('run', state, 'interrupted');
+    for (const [deferred] of mocks.after.mock.calls) await deferred();
+    expect(mocks.settleRepair).toHaveBeenCalledWith(base, 'owner', 'run', undefined);
+    expect(mocks.persist.mock.calls[0][0].serverDB).toBe(transaction);
+  });
+});
