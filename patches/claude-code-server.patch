+import type * as ChildProcess from 'node:child_process';
+import { execFile, spawn } from 'node:child_process';
+import { EventEmitter } from 'node:events';
+import { PassThrough } from 'node:stream';
+
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+import { discoverClaudeModels } from './claudeStatus';
+import { testConfig } from './testUtils';
+
+vi.mock('node:child_process', async (importOriginal) => ({
+  ...(await importOriginal<typeof ChildProcess>()),
+  execFile: vi.fn(),
+  spawn: vi.fn(),
+}));
+
+describe('official CLI model initialization', () => {
+  afterEach(() => vi.clearAllMocks());
+
+  it('initializes the pinned CLI with no model prompt and extracts official choices', async () => {
+    vi.mocked(execFile).mockImplementation(((
+      _command: string,
+      _args: string[],
+      _options: object,
+      callback: (error: Error | null, output: { stdout: string; stderr: string }) => void,
+    ) => {
+      callback(null, { stdout: '2.1.301 (Claude Code)', stderr: '' });
+    }) as typeof execFile);
+    const child = Object.assign(new EventEmitter(), {
+      exitCode: null,
+      signalCode: null,
+      stderr: new PassThrough(),
+      stdin: new PassThrough(),
+      stdout: new PassThrough(),
+      kill: vi.fn(),
+    });
+    const inputs: any[] = [];
+    child.stdin.on('data', (chunk) => {
+      const request = JSON.parse(chunk.toString());
+      inputs.push(request);
+      queueMicrotask(() =>
+        child.stdout.write(
+          `${JSON.stringify({ type: 'control_response', response: { request_id: request.request_id, subtype: 'success', response: { models: [{ value: 'sonnet', displayName: 'Sonnet' }] } } })}\n`,
+        ),
+      );
+    });
+    vi.mocked(spawn).mockReturnValue(child as unknown as ReturnType<typeof spawn>);
+    const models = await discoverClaudeModels(testConfig(process.cwd()));
+    expect(models).toContainEqual({ id: 'sonnet', label: 'Sonnet' });
+    expect(inputs).toHaveLength(1);
+    expect(inputs[0]).toMatchObject({
+      type: 'control_request',
+      request: { subtype: 'initialize' },
+    });
+    const env = vi.mocked(spawn).mock.calls[0][2]?.env;
+    expect(env).not.toHaveProperty('ANTHROPIC_API_KEY');
+    expect(env).not.toHaveProperty('LOBEHUB_WORKER_TOKEN');
+    expect(child.kill).toHaveBeenCalledWith('SIGKILL');
