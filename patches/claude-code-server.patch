@@ -0,0 +1,294 @@
+import { mkdir, mkdtemp, readdir, readFile, rm, writeFile } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { PassThrough } from 'node:stream';
+
+import type { AskUserBridge } from '@lobechat/heterogeneous-agents/askUser';
+import type {
+  LobeBuiltinMcpServer,
+  McpOperationOptions,
+} from '@lobechat/heterogeneous-agents/builtinMcp';
+import type { SpawnAgentHandle, SpawnAgentOptions } from '@lobechat/heterogeneous-agents/spawn';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import type { WorkerApi } from './api';
+import { runOperation } from './runner';
+import { testClaim, testConfig, testEvent } from './testUtils';
+
+describe('ordinary assistant worker execution', () => {
+  let root: string;
+  beforeEach(async () => {
+    root = await mkdtemp(path.join(os.tmpdir(), 'worker-run-'));
+  });
+  afterEach(async () => {
+    await rm(root, { force: true, recursive: true });
+  });
+
+  const server = () => {
+    let operation: McpOperationOptions;
+    let bridge: AskUserBridge;
+    const mcp = {
+      registerOperation: (_id: string, activeBridge: AskUserBridge, tools: McpOperationOptions) => {
+        operation = tools;
+        bridge = activeBridge;
+        return bridge;
+      },
+      unregisterOperation: vi.fn(),
+      urlForOperation: () => 'http://127.0.0.1:1234/mcp?op=operation-1',
+    } as unknown as LobeBuiltinMcpServer;
+    return { mcp, operation: () => operation, bridge: () => bridge };
+  };
+
+  it('runs a fresh model, correlates native results and returns the web answer', async () => {
+    const harness = server();
+    const claim = testClaim();
+    claim.request.systemPrompt = '- Assistant role\n---\n' + 'Current context\n'.repeat(12_000);
+    claim.request.tools = [
+      {
+        apiName: 'createDocument',
+        description: 'Create document',
+        identifier: 'lobe-documents',
+        inputSchema: { type: 'object' },
+        name: 'documents_create',
+        type: 'builtin',
+      },
+    ];
+    const delivered: Array<ReturnType<typeof testEvent>> = [];
+    let toolRequests = 0;
+    let questionRequests = 0;
+    const post = vi.fn(async (route: string, body: any) => {
+      if (route.endsWith('/heartbeat'))
+        return { leaseExpiresAt: claim.leaseExpiresAt, status: 'running' };
+      if (route.endsWith('/events')) {
+        delivered.push(...body.events.map((item: any) => item.event));
+        return { acceptedSequence: body.events.at(-1).sequence };
+      }
+      if (route.endsWith('/tool')) {
+        toolRequests++;
+        return {
+          status: 'completed',
+          result: {
+            content: [{ type: 'text', text: 'Document saved' }],
+            structuredContent: { documentId: 'document-1' },
+          },
+        };
+      }
+      if (route.endsWith('/intervention')) {
+        questionRequests++;
+        return questionRequests === 1 ? { pending: true } : { result: { choice: 'Yes' } };
+      }
+      return {};
+    });
+    const spawn = vi.fn(async (options: SpawnAgentOptions): Promise<SpawnAgentHandle> => ({
+      events: (async function* () {
+        const args = options.extraArgs!;
+        const promptFile = args[args.indexOf('--append-system-prompt-file') + 1];
+        expect(await readFile(promptFile, 'utf8')).toBe(claim.request.systemPrompt);
+        yield testEvent('tool_start', {
+          toolCalling: {
+            apiName: 'mcp__lobe_cc__documents_create',
+            id: 'toolu_write',
+            identifier: 'claude-code',
+            arguments: '{}',
+          },
+        });
+        await harness
+          .operation()
+          .tools![0].handler(
+            { operationId: claim.operationId, toolCallId: 'toolu_write' },
+            { text: 'actual document' },
+          );
+        yield testEvent('tool_result', {
+          toolCallId: 'toolu_write',
+          content: 'CLI textual rendering',
+        });
+        const answer = await harness
+          .bridge()
+          .pending({ arguments: { question: 'Continue?' }, toolCallId: 'toolu_question' });
+        expect(answer).toEqual({ result: { choice: 'Yes' } });
+        yield testEvent('agent_runtime_end');
+        expect(options.env).not.toHaveProperty('ANTHROPIC_API_KEY');
+      })(),
+      exit: Promise.resolve({ code: 0, signal: null }),
+      kill: vi.fn(),
+      pid: 42,
+      sessionId: '12345678-1234-1234-1234-123456789012',
+      stderr: new PassThrough(),
+    }));
+    await runOperation(claim, {
+      api: { post } as WorkerApi,
+      config: testConfig(root),
+      mcp: harness.mcp,
+      signal: new AbortController().signal,
+      spawn,
+    });
+    expect(spawn).toHaveBeenCalledTimes(1);
+    const spawned = spawn.mock.calls[0][0];
+    expect(spawned.extraArgs).toContain('--append-system-prompt-file');
+    expect(spawned.extraArgs).not.toContain(claim.request.systemPrompt);
+    const promptFile =
+      spawned.extraArgs![spawned.extraArgs!.indexOf('--append-system-prompt-file') + 1];
+    await expect(readFile(promptFile)).rejects.toMatchObject({ code: 'ENOENT' });
+    expect(spawned.extraArgs).toContain('--session-id');
+    expect(spawned.extraArgs).not.toContain('--resume');
+    expect(spawned).not.toHaveProperty('resumeSessionId');
+    expect(spawned.prompt).toBe('hello');
+    expect(toolRequests).toBe(1);
+    expect(questionRequests).toBe(2);
+    const questions = post.mock.calls.filter(([route]) => route.endsWith('/intervention'));
+    expect(questions[0][1].request).toEqual(questions[1][1].request);
+    expect(delivered.find((event) => event.type === 'tool_result')?.data).toMatchObject({
+      content: 'Document saved',
+      pluginState: { documentId: 'document-1' },
+      toolCallId: 'toolu_write',
+    });
+    expect(delivered.find((event) => event.type === 'tool_start')?.data.toolCalling).toMatchObject({
+      apiName: 'createDocument',
+      id: 'toolu_write',
+      identifier: 'lobe-documents',
+    });
+    expect(delivered.filter((event) => event.type === 'agent_intervention_request')).toHaveLength(
+      1,
+    );
+    expect(post).toHaveBeenLastCalledWith(
+      '/runs/operation-1/finish',
+      { error: undefined, leaseToken: claim.leaseToken, status: 'completed' },
+      expect.any(AbortSignal),
+    );
+    expect(await readdir(testConfig(root).stateDir)).toEqual([]);
+  });
+
+  it('starts separate CLI sessions on consecutive turns while keeping official login and files', async () => {
+    const config = testConfig(root);
+    await mkdir(config.configDir, { recursive: true });
+    const loginFile = path.join(config.configDir, 'official-login-fixture');
+    await writeFile(loginFile, 'saved-by-official-login');
+    const harness = server();
+    const post = vi.fn(async (route: string, body: any) => {
+      if (route.endsWith('/heartbeat'))
+        return { leaseExpiresAt: new Date(Date.now() + 60_000).toISOString(), status: 'running' };
+      if (route.endsWith('/events')) return { acceptedSequence: body.events.at(-1).sequence };
+      return {};
+    });
+    const spawn = vi.fn(async (options: SpawnAgentOptions): Promise<SpawnAgentHandle> => ({
+      events: (async function* () {
+        expect(options.env?.CLAUDE_CONFIG_DIR).toBe(config.configDir);
+        expect(options.env?.HOME).toBe(config.home);
+        expect(await readFile(loginFile, 'utf8')).toBe('saved-by-official-login');
+        const document = path.join(options.cwd!, 'document.txt');
+        if (options.operationId === 'operation-1') await writeFile(document, 'first turn file');
+        else expect(await readFile(document, 'utf8')).toBe('first turn file');
+        yield { ...testEvent('agent_runtime_end'), operationId: options.operationId };
+      })(),
+      exit: Promise.resolve({ code: 0, signal: null }),
+      kill: vi.fn(),
+      pid: 42,
+      sessionId: 'not-a-cross-turn-mapping',
+      stderr: new PassThrough(),
+    }));
+    for (const operationId of ['operation-1', 'operation-2']) {
+      const claim = testClaim({ operationId });
+      claim.request.prompt = `Prepared full context for ${operationId}`;
+      await runOperation(claim, {
+        api: { post } as WorkerApi,
+        config,
+        mcp: harness.mcp,
+        signal: new AbortController().signal,
+        spawn,
+      });
+    }
+    expect(spawn).toHaveBeenCalledTimes(2);
+    const sessions = spawn.mock.calls.map(([options]) => {
+      expect(options.cwd).toBe(config.workspaceDir);
+      expect(options.prompt).toBe(`Prepared full context for ${options.operationId}`);
+      expect(options.extraArgs).not.toContain('--resume');
+      expect(options).not.toHaveProperty('resumeSessionId');
+      const sessionId = options.extraArgs![options.extraArgs!.indexOf('--session-id') + 1];
+      expect(sessionId).toMatch(/^[a-f\d]{8}-[a-f\d]{4}-4[a-f\d]{3}-[89ab][a-f\d]{3}-[a-f\d]{12}$/);
+      return sessionId;
+    });
+    expect(new Set(sessions).size).toBe(2);
+    expect(await readFile(loginFile, 'utf8')).toBe('saved-by-official-login');
+    const finishes = post.mock.calls.filter(([route]) => route.endsWith('/finish'));
+    expect(finishes).toHaveLength(2);
+    finishes.forEach(([, body]) => expect(body).not.toHaveProperty('sessionId'));
+  });
+
+  it('does not equate exit zero with success when the official stream reports an error', async () => {
+    const harness = server();
+    const claim = testClaim();
+    const post = vi.fn(async (route: string, body: any) =>
+      route.endsWith('/heartbeat')
+        ? { leaseExpiresAt: claim.leaseExpiresAt, status: 'running' }
+        : route.endsWith('/events')
+          ? { acceptedSequence: body.events.at(-1).sequence }
+          : {},
+    );
+    const spawn = vi.fn(async (): Promise<SpawnAgentHandle> => ({
+      events: (async function* () {
+        yield testEvent('error', { kind: 'auth_required' });
+      })(),
+      exit: Promise.resolve({ code: 0, signal: null }),
+      kill: vi.fn(),
+      pid: 42,
+      sessionId: undefined,
+      stderr: new PassThrough(),
+    }));
+    await runOperation(claim, {
+      api: { post } as WorkerApi,
+      config: testConfig(root),
+      mcp: harness.mcp,
+      signal: new AbortController().signal,
+      spawn,
+    });
+    expect(post).toHaveBeenLastCalledWith(
+      '/runs/operation-1/finish',
+      expect.objectContaining({ status: 'error' }),
+      expect.any(AbortSignal),
+    );
+  });
+
+  it('escalates a lost lease to SIGKILL and only finishes after the process exits', async () => {
+    const harness = server();
+    const claim = testClaim({ leaseExpiresAt: new Date(Date.now() + 5100).toISOString() });
+    let exitProcess!: (value: { code: null; signal: NodeJS.Signals }) => void;
+    const exit = new Promise<{ code: null; signal: NodeJS.Signals }>((resolve) => {
+      exitProcess = resolve;
+    });
+    const kill = vi.fn((signal?: NodeJS.Signals) => {
+      if (signal === 'SIGKILL') exitProcess({ code: null, signal });
+    });
+    const post = vi.fn(async (route: string, body: any, signal?: AbortSignal) => {
+      if (route.endsWith('/heartbeat'))
+        return new Promise((_resolve, reject) => {
+          signal!.addEventListener('abort', () => reject(new Error('aborted')), { once: true });
+        });
+      if (route.endsWith('/events')) return { acceptedSequence: body.events.at(-1).sequence };
+      return {};
+    });
+    const spawn = vi.fn(async (): Promise<SpawnAgentHandle> => ({
+      events: (async function* () {
+        yield testEvent();
+        await exit;
+      })(),
+      exit,
+      kill,
+      pid: 42,
+      sessionId: undefined,
+      stderr: new PassThrough(),
+    }));
+    await runOperation(claim, {
+      api: { post } as WorkerApi,
+      config: testConfig(root),
+      mcp: harness.mcp,
+      signal: new AbortController().signal,
+      spawn,
+    });
+    expect(kill.mock.calls.map(([signal]) => signal)).toEqual(['SIGTERM', 'SIGKILL']);
+    expect(post).toHaveBeenLastCalledWith(
+      '/runs/operation-1/finish',
+      expect.objectContaining({ status: 'interrupted' }),
+      expect.any(AbortSignal),
+    );
+  });
+});
diff --git a/apps/claude-code-worker/src/runner.ts b/apps/claude-code-worker/src/runner.ts
new file mode 100644
index 0000000000..b804f4ba95
--- /dev/null
+++ b/apps/claude-code-worker/src/runner.ts
@@ -0,0 +1,228 @@
+import { randomUUID } from 'node:crypto';
+import { mkdir, rm, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { setTimeout as delay } from 'node:timers/promises';
+
+import type { AgentStreamEvent } from '@lobechat/agent-gateway-client';
+import { AskUserBridge, type InterventionAnswer } from '@lobechat/heterogeneous-agents/askUser';
+import type { LobeBuiltinMcpServer } from '@lobechat/heterogeneous-agents/builtinMcp';
+import {
+  CLAUDE_CODE_WORKER_PROTOCOL,
+  type ClaudeCodeWorkerClaim,
+  type ClaudeCodeWorkerToolResult,
+} from '@lobechat/heterogeneous-agents/protocol';
+import { spawnAgent, type SpawnAgentHandle } from '@lobechat/heterogeneous-agents/spawn';
+
+import type { WorkerApi } from './api';
+import { runRoute, WorkerApiError } from './api';
+import type { WorkerConfig } from './config';
+import { workerCliEnvironment } from './config';
+import { RunLease } from './lease';
+import { type RunFinish, RunOutbox } from './outbox';
+import { awaitToolResult, mapToolEvent } from './toolBridge';
+
+interface RunnerDependencies {
+  api: WorkerApi;
+  config: WorkerConfig;
+  mcp: LobeBuiltinMcpServer;
+  signal: AbortSignal;
+  spawn?: typeof spawnAgent;
+}
+
+export const runOperation = async (
+  claim: ClaudeCodeWorkerClaim,
+  deps: RunnerDependencies,
+): Promise<void> => {
+  const { api, config, mcp, signal } = deps;
+  const box = await RunOutbox.create(config.stateDir, claim);
+  const systemPromptFile = path.join(box.directory, 'system-prompt.txt');
+  const results = new Map<string, ClaudeCodeWorkerToolResult>();
+  const requests = new Set<Promise<void>>();
+  const delivery = new AbortController();
+  let handle: SpawnAgentHandle | undefined;
+  let escalation: ReturnType<typeof setTimeout> | undefined;
+  let stepIndex = 0;
+  let streamFailed = false;
+  let streamInterrupted = false;
+  const bridge = new AskUserBridge(claim.operationId, { getStepIndex: () => stepIndex });
+  const lease = new RunLease(api, claim.operationId, claim.leaseToken, claim.leaseExpiresAt, () => {
+    bridge.cancelAll('session_ended');
+    handle?.kill('SIGTERM');
+    escalation = setTimeout(() => handle?.kill('SIGKILL'), 3000);
+  });
+  const shutdown = () => lease.stop('interrupted');
+  signal.addEventListener('abort', shutdown, { once: true });
+  if (signal.aborted) shutdown();
+  lease.start();
+
+  const append = async (event: AgentStreamEvent) => {
+    stepIndex = Math.max(stepIndex, event.stepIndex);
+    if (
+      event.type === 'error' ||
+      (event.type === 'agent_runtime_end' && event.data?.reason === 'error')
+    )
+      streamFailed = true;
+    if (event.type === 'agent_runtime_end' && event.data?.reason === 'interrupted')
+      streamInterrupted = true;
+    await box.append(mapToolEvent(event, claim.request.tools, results));
+  };
+  const answerQuestion = async (event: AgentStreamEvent) => {
+    while (!lease.controller.signal.aborted) {
+      try {
+        const answer = await api.post<InterventionAnswer | { pending: true }>(
+          runRoute(claim.operationId, 'intervention'),
+          {
+            leaseToken: claim.leaseToken,
+            request: event.data,
+          },
+          lease.controller.signal,
+        );
+        if ('pending' in answer && answer.pending) {
+          await delay(500, undefined, { signal: lease.controller.signal });
+          continue;
+        }
+        bridge.resolve(event.data.toolCallId, answer as InterventionAnswer);
+        return;
+      } catch (error) {
+        if (error instanceof WorkerApiError && error.status < 500 && error.status !== 429) {
+          bridge.resolve(event.data.toolCallId, { cancelReason: 'session_ended', cancelled: true });
+          return;
+        }
+        try {
+          await delay(500, undefined, { signal: lease.controller.signal });
+        } catch {
+          return;
+        }
+      }
+    }
+  };
+  const bridgeEvents = (async () => {
+    for await (const event of bridge.events()) {
+      await append(event);
+      if (event.type === 'agent_intervention_request') {
+        const request = answerQuestion(event).finally(() => requests.delete(request));
+        requests.add(request);
+      }
+    }
+  })().catch(() => {
+    streamFailed = true;
+    lease.stop('interrupted');
+  });
+  const deliveries = (async () => {
+    while (!delivery.signal.aborted) {
+      try {
+        await box.deliver(api, delivery.signal);
+      } catch {
+        /* Retry only the event journal. */
+      }
+      try {
+        await delay(250, undefined, { signal: delivery.signal });
+      } catch {
+        return;
+      }
+    }
+  })();
+
+  let finish: RunFinish;
+  try {
+    if (claim.request.protocol !== CLAUDE_CODE_WORKER_PROTOCOL)
+      throw new Error('Unsupported worker protocol');
+    const cwd = config.workspaceDir;
+    await mkdir(cwd, { mode: 0o700, recursive: true });
+    lease.controller.signal.throwIfAborted();
+    mcp.registerOperation(claim.operationId, bridge, {
+      tools: claim.request.tools.map((tool) => ({
+        description: tool.description,
+        handler: async ({ operationId, toolCallId }, args) => {
+          if (operationId !== claim.operationId) throw new Error('MCP operation mismatch');
+          const result = await awaitToolResult(
+            api,
+            operationId,
+            {
+              args,
+              leaseToken: claim.leaseToken,
+              name: tool.name,
+              toolCallId,
+            },
+            lease.controller.signal,
+          );
+          results.set(toolCallId, result);
+          return result;
+        },
+        inputSchema: tool.inputSchema,
+        name: tool.name,
+      })),
+    });
+    const extraArgs = [
+      '--mcp-config',
+      JSON.stringify({
+        mcpServers: { lobe_cc: { type: 'http', url: mcp.urlForOperation(claim.operationId) } },
+      }),
+    ];
+    if (claim.request.model !== 'default') extraArgs.push('--model', claim.request.model);
+    if (claim.request.effort) extraArgs.push('--effort', claim.request.effort);
+    // Every LobeHub turn supplies its complete prepared context to a fresh CLI
+    // session. Only the user's official login and workspace files persist.
+    if (claim.request.systemPrompt) {
+      // Keep arbitrary prompt text and large prepared context out of argv.
+      await writeFile(systemPromptFile, claim.request.systemPrompt, { flag: 'wx', mode: 0o600 });
+      extraArgs.push('--append-system-prompt-file', systemPromptFile);
+    }
+    extraArgs.push('--session-id', randomUUID());
+    handle = await (deps.spawn ?? spawnAgent)({
+      agentType: 'claude-code',
+      askUserBridge: bridge,
+      command: config.cliCommand,
+      commandVersion: config.cliVersion,
+      cwd,
+      env: workerCliEnvironment(config),
+      extraArgs,
+      includePartialMessages: true,
+      inheritEnv: false,
+      integrationMode: 'lobehub-assistant',
+      operationId: claim.operationId,
+      prompt: claim.request.prompt,
+    });
+    // No raw stderr logging: it can contain account identifiers or tool arguments.
+    handle.stderr.resume();
+    if (lease.controller.signal.aborted) {
+      handle.kill('SIGTERM');
+      escalation = setTimeout(() => handle?.kill('SIGKILL'), 3000);
+    }
+    for await (const event of handle.events) await append(event);
+    const exit = await handle.exit;
+    finish = lease.status
+      ? { status: lease.status }
+      : streamInterrupted
+        ? { status: 'interrupted' }
+        : exit.code === 0 && !streamFailed
+          ? { status: 'completed' }
+          : {
+              error: 'Claude Code execution failed; check login and worker availability',
+              status: 'error',
+            };
+  } catch {
+    // Do not replay the prompt after any spawn/stream/disk failure.
+    lease.stop('interrupted');
+    if (handle) await handle.exit;
+    finish = {
+      error: 'Claude Code execution was interrupted',
+      status: lease.status ?? 'interrupted',
+    };
+  } finally {
+    clearTimeout(escalation);
+    signal.removeEventListener('abort', shutdown);
+    bridge.cancelAll('session_ended');
+    lease.controller.abort();
+    await bridgeEvents;
+    await Promise.all(requests);
+    await lease.close();
+    mcp.unregisterOperation(claim.operationId);
+    delivery.abort();
+    await deliveries;
+    await rm(systemPromptFile, { force: true });
+  }
+  await box.setFinish(finish);
+  // A failure leaves the journal for recovery; no new model task is attempted.
+  await box.finish(api, signal);
+};
