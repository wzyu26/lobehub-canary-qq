index 0000000000..3b0b6d7ad3
--- /dev/null
+++ b/packages/heterogeneous-agents/src/builtinMcp/LobeBuiltinMcpServer.operationTools.test.ts
@@ -0,0 +1,366 @@
+import { Client, StreamableHTTPClientTransport } from '@modelcontextprotocol/client';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { z } from 'zod';
+
+import { ASK_USER_TOOL_NAME } from '../askUser/constants';
+import { LobeBuiltinMcpServer } from './LobeBuiltinMcpServer';
+import type { McpOperationTool } from './operationTools';
+
+let server: LobeBuiltinMcpServer;
+const clients: Client[] = [];
+
+afterEach(async () => {
+  await Promise.all(clients.splice(0).map((client) => client.close()));
+  await server?.stop();
+});
+
+const connect = async (operationId: string) => {
+  const transport = new StreamableHTTPClientTransport(new URL(server.urlForOperation(operationId)));
+  const client = new Client({ name: 'operation-tools-test', version: '1' });
+  clients.push(client);
+  await client.connect(transport);
+  return { client, transport };
+};
+
+const echoTool = (name: string): McpOperationTool => ({
+  description: 'Echo the original call identity and business arguments',
+  handler: async (context, args) => ({
+    content: [{ text: JSON.stringify(context), type: 'text' }],
+    structuredContent: { args, ...context },
+  }),
+  inputSchema: {
+    properties: { value: { type: 'string' } },
+    required: ['value'],
+    type: 'object',
+  },
+  name,
+});
+
+describe('operation-scoped MCP tools', () => {
+  it('lists only the operation allowlist and preserves the original JSON Schema', async () => {
+    server = new LobeBuiltinMcpServer({
+      extraTools: [
+        {
+          description: 'Legacy desktop tool',
+          handler: async () => ({ content: [{ text: 'legacy', type: 'text' }] }),
+          inputSchema: { value: z.string() },
+          name: 'legacy_browser',
+        },
+      ],
+    });
+    await server.start();
+    const toolA = echoTool('knowledge_search');
+    server.registerOperation('user-A-run', undefined, { tools: [toolA] });
+    server.registerOperation('user-B-run', undefined, {
+      includeAskUser: false,
+      tools: [echoTool('document_create')],
+    });
+    server.registerOperation('legacy-run');
+
+    const { client: clientA } = await connect('user-A-run');
+    const { client: clientB } = await connect('user-B-run');
+    const { client: legacy } = await connect('legacy-run');
+
+    const listA = await clientA.listTools();
+    expect(listA.tools.map((tool) => tool.name)).toEqual([ASK_USER_TOOL_NAME, 'knowledge_search']);
+    expect(listA.tools.find((tool) => tool.name === 'knowledge_search')?.inputSchema).toEqual(
+      toolA.inputSchema,
+    );
+    expect((await clientB.listTools()).tools.map((tool) => tool.name)).toEqual(['document_create']);
+    expect((await legacy.listTools()).tools.map((tool) => tool.name)).toEqual([
+      ASK_USER_TOOL_NAME,
+      'legacy_browser',
+    ]);
+  });
+
+  it('uses only transport metadata for the original Claude call identity', async () => {
+    server = new LobeBuiltinMcpServer();
+    await server.start();
+    server.registerOperation('real-operation', undefined, { tools: [echoTool('echo')] });
+    const { client } = await connect('real-operation');
+
+    const result = await client.callTool({
+      _meta: { 'claudecode/toolUseId': 'toolu_original' },
+      arguments: { operationId: 'spoofed-operation', toolCallId: 'spoofed-id', value: 'hello' },
+      name: 'echo',
+    });
+
+    expect(result.isError).toBeFalsy();
+    expect(result.structuredContent).toEqual({
+      args: { operationId: 'spoofed-operation', toolCallId: 'spoofed-id', value: 'hello' },
+      operationId: 'real-operation',
+      toolCallId: 'toolu_original',
+    });
+  });
+
+  it('retains the ask-user bridge with the same required Claude identity in scoped mode', async () => {
+    server = new LobeBuiltinMcpServer();
+    await server.start();
+    const bridge = server.registerOperation('run', undefined, { tools: [] });
+    const { client } = await connect('run');
+    const args = {
+      questions: [
+        {
+          header: 'Color',
+          options: [
+            { description: 'Red color', label: 'Red' },
+            { description: 'Blue color', label: 'Blue' },
+          ],
+          question: 'Choose a color',
+        },
+      ],
+    };
+    expect(await client.callTool({ arguments: args, name: ASK_USER_TOOL_NAME })).toMatchObject({
+      isError: true,
+    });
+
+    const respond = (async () => {
+      for await (const event of bridge.events()) {
+        if (event.type !== 'agent_intervention_request') continue;
+        expect(event.data.toolCallId).toBe('toolu_question');
+        bridge.resolve(event.data.toolCallId, { result: { 'Choose a color': 'Blue' } });
+        break;
+      }
+    })();
+    const result = await client.callTool({
+      _meta: { 'claudecode/toolUseId': 'toolu_question' },
+      arguments: args,
+      name: ASK_USER_TOOL_NAME,
+    });
+    await respond;
+    expect(result.isError).toBeFalsy();
+    expect(result.content).toEqual([
+      { text: 'User answers:\n- Choose a color: Blue', type: 'text' },
+    ]);
+  });
+
+  it('keeps a pending tool alive and returns only its real completion result', async () => {
+    server = new LobeBuiltinMcpServer({ progressIntervalMs: 5 });
+    await server.start();
+    let finish: (() => void) | undefined;
+    const finished = new Promise<void>((resolve) => {
+      finish = resolve;
+    });
+    let observedProgress: (() => void) | undefined;
+    const progress = new Promise<void>((resolve) => {
+      observedProgress = resolve;
+    });
+    server.registerOperation('run', undefined, {
+      tools: [
+        {
+          ...echoTool('write'),
+          handler: async () => {
+            await finished;
+            return { content: [{ text: 'persisted', type: 'text' }] };
+          },
+        },
+      ],
+    });
+    const { client } = await connect('run');
+    let settled = false;
+    const result = client
+      .callTool(
+        {
+          _meta: { 'claudecode/toolUseId': 'toolu_wait', 'progressToken': 'wait' },
+          arguments: { value: 'write after approval' },
+          name: 'write',
+        },
+        { onprogress: () => observedProgress?.() },
+      )
+      .then((value) => {
+        settled = true;
+        return value;
+      });
+    await progress;
+    expect(settled).toBe(false);
+    finish?.();
+    expect(await result).toMatchObject({ content: [{ text: 'persisted', type: 'text' }] });
+  });
+
+  it.each([undefined, '', ' ', 123])(
+    'rejects missing or invalid Claude tool identity: %s',
+    async (id) => {
+      const handler = vi.fn(echoTool('echo').handler);
+      server = new LobeBuiltinMcpServer();
+      await server.start();
+      server.registerOperation('run', undefined, { tools: [{ ...echoTool('echo'), handler }] });
+      const { client } = await connect('run');
+
+      const result = await client.callTool({
+        _meta: { 'claudecode/toolUseId': id },
+        arguments: { toolCallId: 'cannot-impersonate-transport', value: 'hello' },
+        name: 'echo',
+      });
+
+      expect(result.isError).toBe(true);
+      expect(handler).not.toHaveBeenCalled();
+    },
+  );
+
+  it('validates nested existing JSON Schema constraints before executing a write tool', async () => {
+    const handler = vi.fn(async () => ({ content: [{ text: 'saved', type: 'text' as const }] }));
+    server = new LobeBuiltinMcpServer();
+    await server.start();
+    server.registerOperation('run', undefined, {
+      tools: [
+        {
+          description: 'Create a document',
+          handler,
+          inputSchema: {
+            additionalProperties: false,
+            properties: {
+              sections: {
+                items: {
+                  additionalProperties: false,
+                  properties: {
+                    heading: { minLength: 2, type: 'string' },
+                    priority: { maximum: 3, minimum: 1, type: 'integer' },
+                  },
+                  required: ['heading'],
+                  type: 'object',
+                },
+                minItems: 1,
+                type: 'array',
+              },
+            },
+            required: ['sections'],
+            type: 'object',
+          },
+          name: 'document_create',
+        },
+      ],
+    });
+    const { client } = await connect('run');
+
+    for (const args of [
+      { sections: [] },
+      { sections: [{ heading: 'x' }] },
+      { sections: [{ heading: 'Title', priority: 4 }] },
+      { sections: [{ heading: 'Title' }], userId: 'another-user' },
+    ]) {
+      const result = await client.callTool({
+        _meta: { 'claudecode/toolUseId': 'toolu_invalid' },
+        arguments: args,
+        name: 'document_create',
+      });
+      expect(result.isError).toBe(true);
+    }
+    expect(handler).not.toHaveBeenCalled();
+
+    const result = await client.callTool({
+      _meta: { 'claudecode/toolUseId': 'toolu_valid' },
+      arguments: { sections: [{ heading: 'Title', priority: 2 }] },
+      name: 'document_create',
+    });
+    expect(result.isError).toBeFalsy();
+    expect(result.content).toEqual([{ text: 'saved', type: 'text' }]);
+    expect(handler).toHaveBeenCalledTimes(1);
+  });
+
+  it('fails registration for unsupported schemas instead of dropping their constraints', () => {
+    server = new LobeBuiltinMcpServer();
+    expect(() =>
+      server.registerOperation('run', undefined, {
+        tools: [
+          {
+            ...echoTool('write'),
+            inputSchema: { type: 'object', unsupportedConstraint: true },
+          },
+        ],
+      }),
+    ).toThrow(/unknown keyword|unsupportedConstraint/);
+    expect(server.hasOperation('run')).toBe(false);
+  });
+
+  it('freezes schemas at operation registration and allows an explicitly empty tool set', async () => {
+    server = new LobeBuiltinMcpServer();
+    await server.start();
+    const tool = echoTool('echo');
+    server.registerOperation('run', undefined, { includeAskUser: false, tools: [tool] });
+    tool.inputSchema.required = [];
+    const { client } = await connect('run');
+    const result = await client.callTool({
+      _meta: { 'claudecode/toolUseId': 'toolu_missing_argument' },
+      arguments: {},
+      name: 'echo',
+    });
+    expect(result.isError).toBe(true);
+
+    server.registerOperation('empty', undefined, { includeAskUser: false, tools: [] });
+    expect((await (await connect('empty')).client.listTools()).tools).toEqual([]);
+  });
+
+  it('rejects name collisions before publishing the operation', () => {
+    server = new LobeBuiltinMcpServer();
+    expect(() =>
+      server.registerOperation('ask-collision', undefined, {
+        tools: [echoTool(ASK_USER_TOOL_NAME)],
+      }),
+    ).toThrow(/duplicate/);
+    expect(() =>
+      server.registerOperation('duplicate', undefined, {
+        tools: [echoTool('echo'), echoTool('echo')],
+      }),
+    ).toThrow(/duplicate/);
+    expect(server.operationCount).toBe(0);
+  });
+
+  it('rejects an unregistered operation before allocating an MCP session', async () => {
+    server = new LobeBuiltinMcpServer();
+    await server.start();
+    await expect(connect('not-registered')).rejects.toThrow();
+    expect(server.sessionCount).toBe(0);
+  });
+
+  it('cannot reuse a session for a different operation or after unregister and re-register', async () => {
+    server = new LobeBuiltinMcpServer();
+    await server.start();
+    const handler = vi.fn(echoTool('echo').handler);
+    for (const id of ['user-A-run', 'user-B-run']) {
+      server.registerOperation(id, undefined, { tools: [{ ...echoTool('echo'), handler }] });
+    }
+    const { transport } = await connect('user-A-run');
+    const sessionId = transport.sessionId!;
+
+    const invoke = (operationId: string) =>
+      fetch(server.urlForOperation(operationId), {
+        body: JSON.stringify({
+          id: 20,
+          jsonrpc: '2.0',
+          method: 'tools/call',
+          params: {
+            _meta: { 'claudecode/toolUseId': 'toolu_cross_operation' },
+            arguments: { value: 'hello' },
+            name: 'echo',
+          },
+        }),
+        headers: {
+          'accept': 'application/json, text/event-stream',
+          'content-type': 'application/json',
+          'mcp-session-id': sessionId,
+        },
+        method: 'POST',
+      });
+
+    expect((await invoke('user-B-run')).status).toBe(403);
+    server.unregisterOperation('user-A-run');
+    expect((await invoke('user-A-run')).status).toBe(400);
+    server.registerOperation('user-A-run', undefined, {
+      tools: [{ ...echoTool('echo'), handler }],
+    });
+    expect((await invoke('user-A-run')).status).toBe(403);
+    expect(handler).not.toHaveBeenCalled();
+
+    const { client: reconnected } = await connect('user-A-run');
+    expect(
+      await reconnected.callTool({
+        _meta: { 'claudecode/toolUseId': 'toolu_new_session' },
+        arguments: { value: 'after reconnect' },
+        name: 'echo',
+      }),
+    ).toMatchObject({
+      structuredContent: { operationId: 'user-A-run', toolCallId: 'toolu_new_session' },
+    });
+    expect(handler).toHaveBeenCalledTimes(1);
+  });
+});
