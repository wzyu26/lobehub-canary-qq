--- /dev/null
+++ b/apps/server/src/services/claudeCode/resolveTools.ts
@@ -0,0 +1,33 @@
+import type { AgentState, ContextBuildOutput } from '@lobechat/agent-runtime';
+import { ToolResolver } from '@lobechat/context-engine';
+
+/** Expand only this run's pre-authorized discovery pool for its MCP tool bridge. */
+export const resolveClaudeCodeTools = (state: AgentState, context: ContextBuildOutput) => {
+  const operation = state.operationToolSet;
+  const initial = context.resolvedTools;
+  if (!operation) return initial;
+  const disabled = new Set(state.world?.disabledPluginIds ?? []);
+  const allowed = [...new Set(operation.activatableToolIds ?? [])].filter(
+    (id) => !disabled.has(id) && !!operation.manifestMap[id],
+  );
+  // operationPrep produced activatableToolIds through the existing tool-mode,
+  // model capability, disabled-tool, device and share gates. A manifest's mere
+  // presence never grants exposure here; never expand Object.keys(manifestMap).
+  return new ToolResolver().resolve(
+    {
+      ...operation,
+      enabledToolIds: initial?.enabledToolIds ?? [],
+      manifestMap: { ...operation.manifestMap, ...initial?.manifestMap },
+      sourceMap: { ...operation.sourceMap, ...initial?.sourceMap },
+      tools: initial?.tools ?? [],
+    },
+    {
+      activatedTools: allowed.map((id) => ({
+        id,
+        manifest: operation.manifestMap[id],
+        source: 'discovery',
+      })),
+      deactivatedToolIds: state.forceFinish ? ['*'] : undefined,
+    },
+  );
+};
