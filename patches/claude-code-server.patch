+import { describe, expect, it } from 'vitest';
+
+import type { AiProviderRuntimeState } from '@/types/aiProvider';
+
+import { withClaudeCodeModels } from './runtimeState';
+
+const state = {
+  enabledAiModels: [],
+  enabledAiProviders: [],
+  enabledChatAiProviders: [],
+  enabledImageAiProviders: [],
+  enabledVideoAiProviders: [],
+  runtimeConfig: {},
+} as unknown as AiProviderRuntimeState;
+
+const status = {
+  authStatus: 'logged_in' as const,
+  available: false,
+  enabled: true,
+  models: [{ displayName: 'Default', id: 'default' }],
+};
+
+describe('withClaudeCodeModels', () => {
+  it('keeps an offline worker model selectable, with its effort control', () => {
+    const result = withClaudeCodeModels(state, status);
+    expect(result.enabledChatAiProviders.map(({ id }) => id)).toEqual(['claude-code']);
+    expect(result.enabledAiModels[0]).toMatchObject({
+      id: 'default',
+      providerId: 'claude-code',
+      settings: { extendParams: ['opus47Effort'] },
+      type: 'chat',
+    });
+  });
+
+  it('adds nothing for an account without an enabled worker', () => {
+    expect(withClaudeCodeModels(state, { ...status, enabled: false })).toBe(state);
+  });
+});
