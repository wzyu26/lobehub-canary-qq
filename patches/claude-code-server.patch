@@ -0,0 +1,44 @@
+import { ModelProvider } from 'model-bank/modelProvider';
+
+import type { AiProviderRuntimeState } from '@/types/aiProvider';
+
+import type { getClaudeCodeStatus } from './status';
+
+const PROVIDER_NAME = 'Claude Code (server)';
+
+type ClaudeCodeStatus = Awaited<ReturnType<typeof getClaudeCodeStatus>>;
+
+/**
+ * Serve the account's worker models with the ordinary model list, so a client without its own
+ * Claude Code entry, such as the released desktop app, can still show and reselect them.
+ */
+export const withClaudeCodeModels = (
+  state: AiProviderRuntimeState,
+  status: ClaudeCodeStatus,
+): AiProviderRuntimeState => {
+  if (!status.enabled || status.models.length === 0) return state;
+
+  const provider = {
+    id: ModelProvider.ClaudeCode,
+    name: PROVIDER_NAME,
+    source: 'builtin' as const,
+  };
+  const models = [...new Map(status.models.map((model) => [model.id, model])).values()];
+  return {
+    ...state,
+    enabledAiModels: [
+      ...state.enabledAiModels,
+      ...models.map(({ displayName, id }) => ({
+        abilities: { files: true, functionCall: true, vision: true },
+        displayName: `${PROVIDER_NAME} · ${displayName}`,
+        enabled: true,
+        id,
+        providerId: ModelProvider.ClaudeCode,
+        settings: { extendParams: ['opus47Effort' as const] },
+        type: 'chat' as const,
+      })),
+    ],
+    enabledAiProviders: [...state.enabledAiProviders, provider],
+    enabledChatAiProviders: [...state.enabledChatAiProviders, provider],
+  };
+};
