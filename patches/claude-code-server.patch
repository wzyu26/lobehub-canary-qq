@@ -0,0 +1,89 @@
+import { z } from 'zod';
+
+const id = z.string().min(1).max(256);
+export const leaseBody = z.object({ leaseToken: z.string().min(32).max(256) }).strict();
+export const workerStatusBody = z
+  .object({
+    authStatus: z.enum(['unknown', 'logged_in', 'logged_out', 'expired']),
+    capabilities: z
+      .object({
+        cliVersion: z.string().max(64).optional(),
+        models: z
+          .array(z.object({ id, label: z.string().max(256) }).strict())
+          .max(100)
+          .optional(),
+        protocolVersion: z.literal(1),
+      })
+      .strict(),
+  })
+  .strict();
+
+export const eventsBody = leaseBody
+  .extend({
+    events: z
+      .array(
+        z
+          .object({
+            event: z
+              .object({
+                data: z.record(z.string(), z.unknown()),
+                operationId: id,
+                stepIndex: z.number().int().nonnegative(),
+                timestamp: z.number().finite().nonnegative(),
+                type: z.enum([
+                  'stream_start',
+                  'stream_chunk',
+                  'stream_end',
+                  'stream_retry',
+                  'step_start',
+                  'step_complete',
+                  'tool_start',
+                  'tool_end',
+                  'tool_result',
+                  'agent_intervention_request',
+                  'agent_intervention_response',
+                  'agent_runtime_end',
+                  'visible_output_end',
+                  'error',
+                ]),
+              })
+              .strict(),
+            sequence: z.number().int().positive(),
+          })
+          .strict(),
+      )
+      .min(1)
+      .max(200),
+  })
+  .strict();
+
+export const toolBody = leaseBody
+  .extend({
+    args: z.record(z.string(), z.unknown()),
+    name: id,
+    toolCallId: id,
+  })
+  .strict();
+
+export const interventionBody = leaseBody
+  .extend({
+    request: z
+      .object({
+        apiName: z.literal('askUserQuestion'),
+        arguments: z.string().max(64_000),
+        deadline: z.number().finite(),
+        identifier: z.literal('claude-code'),
+        interactionKind: z.enum(['question', 'permission', 'plan']).optional(),
+        provider: z.literal('claude-code').optional(),
+        toolCallId: id,
+      })
+      .passthrough(),
+  })
+  .strict();
+
+export const finishBody = leaseBody
+  .extend({
+    error: z.string().max(16_000).optional(),
+    status: z.enum(['completed', 'error', 'cancelled', 'interrupted']),
+  })
+  .strict();
