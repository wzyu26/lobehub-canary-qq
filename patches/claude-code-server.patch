@@ -0,0 +1,160 @@
+import type { AgentState } from '@lobechat/agent-runtime';
+import type { AgentRunInitRequest } from '@lobechat/types';
+import { and, eq, isNull } from 'drizzle-orm';
+
+import { ClaudeCodeModel, ClaudeCodeStateError } from '@/database/models/claudeCode';
+import { agentOperations, claudeCodeRuns } from '@/database/schemas';
+import type { LobeChatDatabase } from '@/database/type';
+import type { AgentRuntimeService } from '@/server/services/agentRuntime';
+import type { InternalExecAgentParams } from '@/server/services/aiAgent/types';
+
+import { isClaudeCodeServerEnabled } from './status';
+
+export type ClaudeCodeTurnOverrides = Pick<
+  InternalExecAgentParams,
+  'chatConfigOverride' | 'instructions' | 'toolModeOverride'
+>;
+
+/** A waiting CLI ancestor owns the only execution slot, even through API children. */
+export const assertNoActiveClaudeCodeAncestor = async (
+  db: LobeChatDatabase,
+  scope: { operationId: string; userId: string; workspaceId?: string },
+  parentOperationId?: string,
+) => {
+  const visited = new Set([scope.operationId]);
+  let parentId = parentOperationId;
+  while (parentId) {
+    if (visited.has(parentId) || visited.size > 64) {
+      throw new ClaudeCodeStateError(
+        'invalid_parent_operation',
+        'The parent assistant chain is invalid. Start this assistant in a separate conversation.',
+      );
+    }
+    visited.add(parentId);
+    const [parent] = await db
+      .select({
+        parentOperationId: agentOperations.parentOperationId,
+        claudeCodeStatus: claudeCodeRuns.status,
+      })
+      .from(agentOperations)
+      .leftJoin(
+        claudeCodeRuns,
+        and(
+          eq(claudeCodeRuns.operationId, agentOperations.id),
+          eq(claudeCodeRuns.userId, scope.userId),
+          scope.workspaceId
+            ? eq(claudeCodeRuns.workspaceId, scope.workspaceId)
+            : isNull(claudeCodeRuns.workspaceId),
+        ),
+      )
+      .where(
+        and(
+          eq(agentOperations.id, parentId),
+          eq(agentOperations.userId, scope.userId),
+          scope.workspaceId
+            ? eq(agentOperations.workspaceId, scope.workspaceId)
+            : isNull(agentOperations.workspaceId),
+        ),
+      )
+      .limit(1);
+    if (!parent) {
+      throw new ClaudeCodeStateError(
+        'invalid_parent_operation',
+        'The parent assistant is no longer accessible. Start this assistant in a separate conversation.',
+      );
+    }
+    if (
+      parent.claudeCodeStatus &&
+      ['queued', 'running', 'cancelling'].includes(parent.claudeCodeStatus)
+    ) {
+      throw new ClaudeCodeStateError(
+        'nested_claude_code_run',
+        'Global single-task mode does not support nested Claude Code assistants. Run this assistant separately after the parent finishes; the model was not changed.',
+      );
+    }
+    parentId = parent.parentOperationId ?? undefined;
+  }
+};
+
+export const assertClaudeCodeAvailable = async (
+  db: LobeChatDatabase,
+  userId: string,
+  workspaceId?: string,
+) => {
+  if (!isClaudeCodeServerEnabled()) throw new Error('Claude Code server backend is disabled');
+  const binding = await new ClaudeCodeModel(db, userId, workspaceId).getBinding();
+  if (!binding?.enabled)
+    throw new Error('No enabled Claude Code worker is assigned to this account');
+  if (binding.authStatus !== 'logged_in') {
+    throw new Error('Sign in using claude auth login in your assigned server environment');
+  }
+  if (!binding.lastSeenAt || Date.now() - binding.lastSeenAt.getTime() > 60_000) {
+    throw new Error('Your Claude Code server worker is unavailable');
+  }
+  if (binding.capabilities.protocolVersion !== 1)
+    throw new Error('Claude Code worker protocol is incompatible');
+  return binding;
+};
+
+/** Persist the turn's intent. Its executable context is resolved only after claim. */
+export const enqueueClaudeCodeOperation = async ({
+  db,
+  initRequest,
+  operationId,
+  overrides,
+  runtimeService,
+  userId,
+  workspaceId,
+}: {
+  db: LobeChatDatabase;
+  initRequest: AgentRunInitRequest;
+  operationId: string;
+  overrides?: ClaudeCodeTurnOverrides;
+  runtimeService: AgentRuntimeService;
+  userId: string;
+  workspaceId?: string;
+}) => {
+  const state: AgentState | null = await runtimeService
+    .getCoordinator()
+    .loadAgentState(operationId);
+  if (
+    !state ||
+    state.origin?.userId !== userId ||
+    (state.origin.workspaceId ?? undefined) !== workspaceId ||
+    !state.origin.topicId
+  ) {
+    throw new Error('Claude Code operation does not belong to this account');
+  }
+  if (state.modelRuntimeConfig?.provider !== 'claude-code')
+    throw new Error('Invalid Claude Code operation provider');
+  await assertNoActiveClaudeCodeAncestor(
+    db,
+    { operationId, userId, workspaceId },
+    state.origin.lineage?.parentOperationId,
+  );
+  const binding = await assertClaudeCodeAvailable(db, userId, workspaceId);
+  if (!binding.capabilities.models?.some(({ id }) => id === state.modelRuntimeConfig!.model)) {
+    throw new Error('This model is not available in your Claude Code worker');
+  }
+  return new ClaudeCodeModel(db, userId, workspaceId).enqueueRun({
+    operationId,
+    preparedRequest: {
+      // No cached attachment content, signed URLs or executable CLI prompt in the queue intent.
+      initRequest: {
+        ...initRequest,
+        detachedFileContentIds: undefined,
+        runAttachments: {
+          fileIds: initRequest.runAttachments.fileIds,
+          warnings: initRequest.runAttachments.warnings,
+        },
+      },
+      overrides,
+      runtimeBackend: 'claude-code',
+      // Server-private state supports cancellation and lifecycle recovery before execution.
+      state,
+    },
+    requestId: operationId,
+    threadId: state.origin.threadId,
+    topicId: state.origin.topicId,
+  });
+};
diff --git a/apps/server/src/services/claudeCode/finish.ts b/apps/server/src/services/claudeCode/finish.ts
new file mode 100644
index 0000000000..9204ab23cf
--- /dev/null
+++ b/apps/server/src/services/claudeCode/finish.ts
@@ -0,0 +1,138 @@
+import type { AgentState } from '@lobechat/agent-runtime';
+import { parse } from '@lobechat/conversation-flow';
+import superjson from 'superjson';
+
+import { ClaudeCodeModel } from '@/database/models/claudeCode';
+import { MessageModel } from '@/database/models/message';
+import type { LobeChatDatabase } from '@/database/type';
+import { AgentRuntimeCoordinator, createStreamEventManager } from '@/server/modules/AgentRuntime';
+import { CompletionLifecycle } from '@/server/services/agentRuntime/CompletionLifecycle';
+
+import {
+  type ClaudeCodeProjectionScope,
+  closeClaudeCodeInterventions,
+  drainClaudeCodeEvents,
+  restoreClaudeCodeProjection,
+} from './projectEvents';
+
+const INTERRUPTED_MESSAGE =
+  'The server Claude Code worker stopped before this turn finished. It was not retried; send the message again to continue.';
+
+/** Reconcile a terminal queue record with the ordinary operation/message lifecycle.
+ * This is also called by the heartbeat sweeper after a worker lease expires. */
+export const settleClaudeCodeRun = async (scope: ClaudeCodeProjectionScope) => {
+  const model = new ClaudeCodeModel(scope.db, scope.userId, scope.workspaceId);
+  const run = await model.getRun(scope.operationId);
+  if (!run || ['queued', 'running', 'cancelling'].includes(run.status)) return;
+  if (!(await drainClaudeCodeEvents(scope))) return;
+
+  await model.withProjectionState(scope.operationId, async (tx, current, checkpoint) => {
+    if (checkpoint?.settled || checkpoint?.lifecycleComplete) return checkpoint;
+    const state = current.preparedRequest.state as unknown as AgentState;
+    const states = restoreClaudeCodeProjection(checkpoint);
+    await closeClaudeCodeInterventions(tx as unknown as LobeChatDatabase, current, states);
+    const projection = states.get(current.operationId);
+    const assistantMessageId =
+      projection?.main.currentAssistantId ??
+      state.origin?.assistantMessageId ??
+      state.metadata?.assistantMessageId;
+    const reason =
+      current.status === 'completed'
+        ? 'done'
+        : current.status === 'error'
+          ? 'error'
+          : 'interrupted';
+    const messages = new MessageModel(
+      tx as unknown as LobeChatDatabase,
+      scope.userId,
+      scope.workspaceId,
+    );
+    // The client keys its failure banner off `message.error`; a cancelled turn has its own state.
+    if (current.status === 'interrupted' && assistantMessageId) {
+      const message = current.error ?? INTERRUPTED_MESSAGE;
+      await messages.update(assistantMessageId, {
+        error: { body: { message }, message, type: 'AgentRuntimeError' },
+      });
+    }
+    const history = await messages.query({
+      agentId: state.origin?.agentId,
+      groupId: state.origin?.groupId,
+      threadId: current.threadId ?? undefined,
+      topicId: current.topicId,
+    });
+    const finalState = {
+      ...state,
+      error: current.error ? { message: current.error, type: 'AgentRuntimeError' } : undefined,
+      lastModified: new Date().toISOString(),
+      messages: parse(history, undefined, { threadId: current.threadId ?? undefined }).flatList,
+      metadata: { ...state.metadata, assistantMessageId },
+      status: reason,
+    };
+    await new CompletionLifecycle(
+      tx as unknown as LobeChatDatabase,
+      scope.userId,
+      scope.workspaceId,
+      { backgroundDB: scope.db },
+    ).dispatchHooks(current.operationId, finalState, reason);
+    // Commit the lifecycle receipt before retryable Redis/socket publication.
+    // Existing hook retry semantics still apply to a crash inside dispatchHooks;
+    // this checkpoint never promises exactly-once external webhook delivery.
+    return {
+      ...checkpoint,
+      completionState: superjson.stringify(finalState),
+      completionStepIndex: projection?.lastStepIndex ?? state.stepCount,
+      lifecycleComplete: true,
+      reducer: superjson.stringify(projection),
+    };
+  });
+
+  await model.withProjectionState(scope.operationId, async (_tx, current, checkpoint) => {
+    if (checkpoint?.settled) return checkpoint;
+    if (!checkpoint?.lifecycleComplete || typeof checkpoint.completionState !== 'string') {
+      throw new Error('Claude Code lifecycle has not completed');
+    }
+    const finalState = superjson.parse<AgentState>(checkpoint.completionState);
+    const reason =
+      current.status === 'completed'
+        ? 'done'
+        : current.status === 'error'
+          ? 'error'
+          : 'interrupted';
+    await new AgentRuntimeCoordinator().saveAgentState(
+      current.operationId,
+      finalState as AgentState,
+    );
+    await createStreamEventManager().publishStreamEvent(current.operationId, {
+      data: {
+        operationId: current.operationId,
+        phase: 'execution_complete',
+        reason,
+        reasonDetail:
+          current.error ??
+          (reason === 'done' ? 'Claude Code completed' : 'Claude Code interrupted'),
+      },
+      deduplicationKey: 'claude-code:terminal',
+      stepIndex: Number(checkpoint.completionStepIndex ?? 0),
+      type: 'agent_runtime_end',
+    });
+    return { ...checkpoint, settled: true };
+  });
+};
+
+export const finishClaudeCodeRun = async (
+  scope: ClaudeCodeProjectionScope & {
+    error?: string;
+    leaseToken: string;
+    status: 'completed' | 'error' | 'cancelled' | 'interrupted';
+  },
+) => {
+  const run = await drainClaudeCodeEvents(scope);
+  if (!run) throw new Error('Run does not belong to this account');
+  const model = new ClaudeCodeModel(scope.db, scope.userId, scope.workspaceId);
+  const finished = await model.finishRun(scope.operationId, scope.leaseToken, {
+    error: scope.error,
+    status: scope.status,
+  });
+  await settleClaudeCodeRun(scope);
+  return { status: finished.status };
+};
diff --git a/apps/server/src/services/claudeCode/interventionBridge.test.ts b/apps/server/src/services/claudeCode/interventionBridge.test.ts
