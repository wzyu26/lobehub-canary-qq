+++ b/src/hooks/useClaudeCodeModels.ts
@@ -0,0 +1,41 @@
+import { useMemo } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import { useClientDataSWR } from '@/libs/swr';
+import { claudeCodeKeys } from '@/libs/swr/keys';
+import { claudeCodeService } from '@/services/claudeCode';
+import { useUserStore } from '@/store/user';
+import type { EnabledProviderWithModels } from '@/types/aiProvider';
+
+import { appendClaudeCodeModels } from './claudeCodeModels';
+
+/**
+ * Worker presence/auth is transient: keep it in the scoped SWR response, not
+ * in the persistent API-provider catalog. No account credentials enter here.
+ */
+export const useClaudeCodeModels = (providers: EnabledProviderWithModels[], enabled = true) => {
+  const { t } = useTranslation('chat');
+  const userId = useUserStore((s) => (s.isSignedIn ? s.user?.id : undefined));
+  const response = useClientDataSWR(
+    enabled && userId ? claudeCodeKeys.status(userId) : null,
+    () => claudeCodeService.getStatus(),
+    {
+      dedupingInterval: 10_000,
+      focusThrottleInterval: 10_000,
+      keepPreviousData: false,
+      refreshInterval: 30_000,
+    },
+  );
+  const providerName = t('claudeCodeServer.name');
+  const enabledList = useMemo(
+    () =>
+      appendClaudeCodeModels(
+        providers,
+        enabled && userId ? response.data : undefined,
+        providerName,
+      ),
+    [enabled, providerName, providers, response.data, userId],
+  );
+
+  return { ...response, enabledList };
+};
