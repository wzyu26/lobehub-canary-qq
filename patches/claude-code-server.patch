@@ -0,0 +1,141 @@
+import { appendFile, mkdtemp, readdir, readFile, rm } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import type { WorkerApi } from './api';
+import { WorkerApiError } from './api';
+import { recoverRuns, RunOutbox } from './outbox';
+import { testClaim, testEvent } from './testUtils';
+
+describe('durable execution outbox', () => {
+  let root: string;
+  beforeEach(async () => {
+    root = await mkdtemp(path.join(os.tmpdir(), 'worker-outbox-'));
+  });
+  afterEach(async () => {
+    await rm(root, { force: true, recursive: true });
+  });
+
+  it('retries the same durable sequence after an ambiguous delivery without creating new events', async () => {
+    const box = await RunOutbox.create(root, testClaim());
+    await Promise.all([
+      box.append(testEvent('stream_chunk', { text: 'one' })),
+      box.append(testEvent('stream_chunk', { text: 'two' })),
+    ]);
+    const received: unknown[] = [];
+    const post = vi.fn(async (_route: string, body: unknown) => {
+      received.push(body);
+      if (received.length === 1) throw new Error('Lost response after server commit');
+      return { acceptedSequence: 2 };
+    });
+    const api = { post } as WorkerApi;
+    await expect(box.deliver(api)).rejects.toThrow('Lost response');
+    const [recovered] = await RunOutbox.recover(root);
+    await recovered.deliver(api);
+    expect(received[0]).toEqual(received[1]);
+    await recovered.deliver(api);
+    expect(post).toHaveBeenCalledTimes(2);
+    expect(JSON.parse(await readFile(path.join(box.directory, 'ack.json'), 'utf8'))).toEqual({
+      sequence: 2,
+    });
+  });
+
+  it('recovers a torn last line, delivers complete records and finishes interrupted without invoking tools', async () => {
+    const box = await RunOutbox.create(root, testClaim());
+    await box.append(testEvent());
+    await appendFile(path.join(box.directory, 'events.jsonl'), '{"sequence":2,"event":');
+    const post = vi.fn(async (route: string) =>
+      route.endsWith('/events') ? { acceptedSequence: 1 } : {},
+    );
+    await recoverRuns(root, { post } as WorkerApi);
+    expect(post.mock.calls.map(([route]) => route)).toEqual([
+      '/runs/operation-1/events',
+      '/runs/operation-1/finish',
+    ]);
+    expect(post).toHaveBeenLastCalledWith(
+      '/runs/operation-1/finish',
+      expect.objectContaining({ status: 'interrupted' }),
+      undefined,
+    );
+    expect(await readdir(root)).toEqual([]);
+  });
+
+  it('never reports completed on restart, even when the CLI had exited before a lost finish receipt', async () => {
+    const box = await RunOutbox.create(root, testClaim());
+    await box.setFinish({ status: 'completed' });
+    const post = vi.fn(async () => ({}));
+    await recoverRuns(root, { post } as WorkerApi);
+    expect(post).toHaveBeenCalledWith(
+      '/runs/operation-1/finish',
+      expect.objectContaining({ status: 'interrupted' }),
+      undefined,
+    );
+  });
+
+  it('rejects a duplicate claim and foreign events instead of overwriting its journal', async () => {
+    const box = await RunOutbox.create(root, testClaim());
+    await expect(RunOutbox.create(root, testClaim())).rejects.toMatchObject({ code: 'EEXIST' });
+    await expect(box.append({ ...testEvent(), operationId: 'another-user' })).rejects.toThrow(
+      'operation mismatch',
+    );
+  });
+
+  it('rejects acknowledgement beyond the sent batch and keeps the run for recovery', async () => {
+    const box = await RunOutbox.create(root, testClaim());
+    await box.append(testEvent());
+    await expect(
+      box.deliver({ post: vi.fn(async () => ({ acceptedSequence: 99 })) } as WorkerApi),
+    ).rejects.toThrow('invalid event acknowledgement');
+    expect(await RunOutbox.recover(root)).toHaveLength(1);
+  });
+
+  it.each([404, 410])(
+    'quarantines a removed run (%s) and continues recovering other journals',
+    async (status) => {
+      const removed = await RunOutbox.create(root, testClaim());
+      await removed.append(testEvent());
+      const retained = await RunOutbox.create(root, testClaim({ operationId: 'retained' }));
+      await retained.append({ ...testEvent(), operationId: 'retained' });
+      const post = vi.fn(async (route: string) => {
+        if (route.includes('/operation-1/')) throw new WorkerApiError(status);
+        return route.endsWith('/events') ? { acceptedSequence: 1 } : {};
+      });
+      await recoverRuns(root, { post } as WorkerApi);
+      expect(post).toHaveBeenCalledWith(
+        '/runs/retained/finish',
+        expect.objectContaining({ status: 'interrupted' }),
+        undefined,
+      );
+      expect(await RunOutbox.recover(root)).toEqual([]);
+      const quarantine = path.join(root, 'quarantine', path.basename(removed.directory));
+      expect(
+        JSON.parse(await readFile(path.join(quarantine, 'quarantine.json'), 'utf8')).httpStatus,
+      ).toBe(status);
+      expect(await readFile(path.join(quarantine, 'events.jsonl'), 'utf8')).toContain(
+        'operation-1',
+      );
+      const calls = post.mock.calls.length;
+      await recoverRuns(root, { post } as WorkerApi);
+      expect(post).toHaveBeenCalledTimes(calls);
+    },
+  );
+
+  it.each([401, 403, 409, 500])(
+    'preserves a journal on HTTP %s without treating it as deleted',
+    async (status) => {
+      const box = await RunOutbox.create(root, testClaim());
+      await box.append(testEvent());
+      await expect(
+        recoverRuns(root, {
+          post: vi.fn(async () => {
+            throw new WorkerApiError(status);
+          }),
+        } as WorkerApi),
+      ).rejects.toMatchObject({ status });
+      expect(await RunOutbox.recover(root)).toHaveLength(1);
+      expect(await readdir(root)).not.toContain('quarantine');
+    },
+  );
+});
diff --git a/apps/claude-code-worker/src/outbox.ts b/apps/claude-code-worker/src/outbox.ts
new file mode 100644
index 0000000000..a35c8b763b
--- /dev/null
+++ b/apps/claude-code-worker/src/outbox.ts
@@ -0,0 +1,244 @@
+import { createHash, randomUUID } from 'node:crypto';
+import { mkdir, open, readdir, readFile, rename, rm } from 'node:fs/promises';
+import path from 'node:path';
+
+import type { AgentStreamEvent } from '@lobechat/agent-gateway-client';
+import type {
+  ClaudeCodeWorkerClaim,
+  ClaudeCodeWorkerEvent,
+} from '@lobechat/heterogeneous-agents/protocol';
+
+import type { WorkerApi } from './api';
+import { runRoute, WorkerApiError } from './api';
+
+export interface RunFinish {
+  error?: string;
+  status: 'completed' | 'error' | 'cancelled' | 'interrupted';
+}
+
+export interface RunRecord {
+  finish?: RunFinish;
+  leaseExpiresAt: string;
+  leaseToken: string;
+  operationId: string;
+}
+
+const syncDirectory = async (directory: string) => {
+  // Windows does not expose directory fsync; the deployed worker is Linux.
+  if (process.platform === 'win32') return;
+  const handle = await open(directory, 'r');
+  try {
+    await handle.sync();
+  } finally {
+    await handle.close();
+  }
+};
+
+const durableJson = async (filename: string, value: unknown) => {
+  const temporary = `${filename}.${randomUUID()}.tmp`;
+  const handle = await open(temporary, 'wx', 0o600);
+  try {
+    await handle.writeFile(JSON.stringify(value));
+    await handle.sync();
+  } finally {
+    await handle.close();
+  }
+  await rename(temporary, filename);
+  await syncDirectory(path.dirname(filename));
+};
+
+const directoryFor = (root: string, operationId: string) =>
+  path.join(root, createHash('sha256').update(operationId).digest('hex'));
+
+/** A write-ahead event log: acknowledging transport never reruns the producer. */
+export class RunOutbox {
+  private acceptedSequence = 0;
+  private events: ClaudeCodeWorkerEvent[] = [];
+  private pending: Promise<void> = Promise.resolve();
+
+  private constructor(
+    readonly directory: string,
+    readonly record: RunRecord,
+  ) {}
+
+  static async create(root: string, claim: ClaudeCodeWorkerClaim): Promise<RunOutbox> {
+    await mkdir(root, { mode: 0o700, recursive: true });
+    const directory = directoryFor(root, claim.operationId);
+    // Never overwrite a previous operation, even if the server reissues it.
+    await mkdir(directory, { mode: 0o700 });
+    await syncDirectory(root);
+    const record = {
+      leaseExpiresAt: claim.leaseExpiresAt,
+      leaseToken: claim.leaseToken,
+      operationId: claim.operationId,
+    };
+    await durableJson(path.join(directory, 'run.json'), record);
+    return new RunOutbox(directory, record);
+  }
+
+  static async recover(root: string): Promise<RunOutbox[]> {
+    await mkdir(root, { mode: 0o700, recursive: true });
+    const boxes: RunOutbox[] = [];
+    for (const entry of await readdir(root, { withFileTypes: true })) {
+      if (!entry.isDirectory() || !/^[a-f\d]{64}$/.test(entry.name)) continue;
+      const directory = path.join(root, entry.name);
+      let record: RunRecord;
+      try {
+        record = JSON.parse(await readFile(path.join(directory, 'run.json'), 'utf8'));
+      } catch (error) {
+        // A crash between mkdir and run.json happened before any model launch.
+        if ((error as NodeJS.ErrnoException).code === 'ENOENT') continue;
+        throw error;
+      }
+      if (
+        typeof record.operationId !== 'string' ||
+        !record.leaseToken ||
+        directoryFor(root, record.operationId) !== directory
+      )
+        throw new Error('Invalid worker run record');
+      const box = new RunOutbox(directory, record);
+      const log = await open(path.join(directory, 'events.jsonl'), 'r+').catch(
+        (error: NodeJS.ErrnoException) => {
+          if (error.code !== 'ENOENT') throw error;
+          return open(path.join(directory, 'events.jsonl'), 'w+', 0o600);
+        },
+      );
+      try {
+        const contents = await log.readFile('utf8');
+        const complete = contents.slice(0, contents.lastIndexOf('\n') + 1);
+        for (const line of complete.split('\n').filter(Boolean)) {
+          const item = JSON.parse(line) as ClaudeCodeWorkerEvent;
+          if (
+            item.sequence !== box.events.length + 1 ||
+            item.event.operationId !== record.operationId
+          ) {
+            throw new Error('Invalid worker event journal');
+          }
+          box.events.push(item);
+        }
+        // Discard only a torn, never-delivered final record.
+        if (complete.length !== contents.length) {
+          await log.truncate(Buffer.byteLength(complete));
+          await log.sync();
+        }
+      } finally {
+        await log.close();
+      }
+      try {
+        const ack = JSON.parse(await readFile(path.join(directory, 'ack.json'), 'utf8'));
+        if (
+          !Number.isInteger(ack.sequence) ||
+          ack.sequence < 0 ||
+          ack.sequence > box.events.length
+        ) {
+          throw new Error('Invalid worker delivery cursor');
+        }
+        box.acceptedSequence = ack.sequence;
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+      }
+      boxes.push(box);
+    }
+    return boxes;
+  }
+
+  append(event: AgentStreamEvent): Promise<void> {
+    this.pending = this.pending.then(async () => {
+      if (event.operationId !== this.record.operationId)
+        throw new Error('Event operation mismatch');
+      const item = { event, sequence: this.events.length + 1 };
+      const handle = await open(path.join(this.directory, 'events.jsonl'), 'a', 0o600);
+      try {
+        await handle.writeFile(`${JSON.stringify(item)}\n`);
+        await handle.sync();
+      } finally {
+        await handle.close();
+      }
+      if (this.events.length === 0) await syncDirectory(this.directory);
+      this.events.push(item);
+    });
+    return this.pending;
+  }
+
+  async setFinish(finish: RunFinish): Promise<void> {
+    await this.pending;
+    this.record.finish = finish;
+    await durableJson(path.join(this.directory, 'run.json'), this.record);
+  }
+
+  async deliver(api: WorkerApi, signal?: AbortSignal): Promise<void> {
+    await this.pending;
+    while (this.acceptedSequence < this.events.length) {
+      const batch = this.events.slice(this.acceptedSequence, this.acceptedSequence + 64);
+      const response = await api.post<{ acceptedSequence: number }>(
+        runRoute(this.record.operationId, 'events'),
+        { events: batch, leaseToken: this.record.leaseToken },
+        signal,
+      );
+      if (
+        !Number.isInteger(response.acceptedSequence) ||
+        response.acceptedSequence <= this.acceptedSequence ||
+        response.acceptedSequence > batch.at(-1)!.sequence
+      ) {
+        throw new Error('Server returned an invalid event acknowledgement');
+      }
+      await durableJson(path.join(this.directory, 'ack.json'), {
+        sequence: response.acceptedSequence,
+      });
+      this.acceptedSequence = response.acceptedSequence;
+    }
+  }
+
+  async finish(api: WorkerApi, signal?: AbortSignal): Promise<void> {
+    if (!this.record.finish) throw new Error('Run must be stopped before finishing its outbox');
+    await this.deliver(api, signal);
+    await api.post(
+      runRoute(this.record.operationId, 'finish'),
+      {
+        error: this.record.finish.error,
+        leaseToken: this.record.leaseToken,
+        status: this.record.finish.status,
+      },
+      signal,
+    );
+    // directory is a fixed hash under the configured state directory.
+    await rm(this.directory, { recursive: true });
+    await syncDirectory(path.dirname(this.directory));
+  }
+
+  async quarantine(httpStatus: 404 | 410): Promise<void> {
+    await this.pending;
+    const root = path.dirname(this.directory);
+    const quarantine = path.join(root, 'quarantine');
+    await mkdir(quarantine, { mode: 0o700, recursive: true });
+    await durableJson(path.join(this.directory, 'quarantine.json'), {
+      httpStatus,
+      quarantinedAt: new Date().toISOString(),
+      reason: 'Server run is no longer available; execution must not be replayed',
+    });
+    // Both paths stay under the configured state volume. Keep the complete
+    // journal for administrator inspection; recover() ignores this directory.
+    await rename(this.directory, path.join(quarantine, path.basename(this.directory)));
+    await syncDirectory(quarantine);
+    await syncDirectory(root);
+  }
+}
+
+/** Recovery only closes old executions. It never calls the model or a tool. */
+export const recoverRuns = async (root: string, api: WorkerApi, signal?: AbortSignal) => {
+  for (const box of await RunOutbox.recover(root)) {
+    if (!box.record.finish || box.record.finish.status === 'completed') {
+      await box.setFinish({ error: 'Worker restarted during execution', status: 'interrupted' });
+    }
+    try {
+      await box.finish(api, signal);
+    } catch (error) {
+      if (error instanceof WorkerApiError && (error.status === 404 || error.status === 410)) {
+        await box.quarantine(error.status);
+        continue;
+      }
+      // Authentication, network and server failures cannot prove run deletion.
+      throw error;
+    }
+  }
+};
diff --git a/apps/claude-code-worker/src/runner.test.ts b/apps/claude-code-worker/src/runner.test.ts
