@@ -0,0 +1,34 @@
+import type { Redis } from 'ioredis';
+
+/** XADD and its delivery receipt are one Redis transaction, including retries
+ * after a successful append whose HTTP response was lost. */
+const APPEND_ONCE = `
+local previous = redis.call('HGET', KEYS[2], ARGV[1])
+if previous then
+  redis.call('EXPIRE', KEYS[1], ARGV[2])
+  redis.call('EXPIRE', KEYS[2], ARGV[2])
+  return previous
+end
+local id = redis.call('XADD', KEYS[1], '*', unpack(ARGV, 3))
+redis.call('HSET', KEYS[2], ARGV[1], id)
+redis.call('EXPIRE', KEYS[1], ARGV[2])
+redis.call('EXPIRE', KEYS[2], ARGV[2])
+return id
+`;
+
+export const publishStreamEventOnce = async (
+  redis: Redis,
+  streamKey: string,
+  deduplicationKey: string,
+  retention: number,
+  fields: string[],
+): Promise<string> =>
+  (await redis.eval(
+    APPEND_ONCE,
+    2,
+    streamKey,
+    `${streamKey}:delivery-receipts`,
+    deduplicationKey,
+    retention.toString(),
+    ...fields,
+  )) as string;
