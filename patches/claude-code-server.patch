@@ -0,0 +1,66 @@
+import { readFile } from 'node:fs/promises';
+import path from 'node:path';
+
+export interface WorkerConfig {
+  buildRevision: string;
+  cliCommand: string;
+  cliVersion: string;
+  configDir: string;
+  heartbeatIntervalMs: number;
+  home: string;
+  pollIntervalMs: number;
+  serverUrl: string;
+  stateDir: string;
+  token: string;
+  workerId: string;
+  workspaceDir: string;
+}
+
+export const loadWorkerConfig = async (env: NodeJS.ProcessEnv): Promise<WorkerConfig> => {
+  const required = (name: string) => {
+    const value = env[name]?.trim();
+    if (!value) throw new Error(`Missing worker configuration: ${name}`);
+    return value;
+  };
+  const absolute = (name: string, fallback: string) => {
+    const value = env[name] ?? fallback;
+    if (!path.isAbsolute(value)) throw new Error(`${name} must be absolute`);
+    return value;
+  };
+  const url = new URL(required('LOBEHUB_WORKER_SERVER_URL'));
+  if (
+    !['http:', 'https:'].includes(url.protocol) ||
+    url.username ||
+    url.password ||
+    url.search ||
+    url.hash
+  ) {
+    throw new Error('Worker server URL must use HTTP(S) without embedded credentials');
+  }
+  const token = (await readFile(required('LOBEHUB_WORKER_TOKEN_FILE'), 'utf8')).trim();
+  if (!token || /[\r\n]/.test(token)) throw new Error('Invalid worker service token file');
+  const workerId = required('LOBEHUB_WORKER_ID');
+  if (!/^[\w-]{1,128}$/.test(workerId)) throw new Error('Invalid worker id');
+  return {
+    buildRevision: required('LOBEHUB_BUILD_REVISION'),
+    cliCommand: absolute('CLAUDE_CODE_COMMAND', '/usr/local/bin/claude'),
+    cliVersion: required('CLAUDE_CODE_VERSION'),
+    configDir: absolute('CLAUDE_CONFIG_DIR', '/home/claude/.claude'),
+    home: absolute('CLAUDE_CODE_HOME', '/home/claude'),
+    heartbeatIntervalMs: 15_000,
+    pollIntervalMs: 3000,
+    serverUrl: url.toString().replace(/\/$/, ''),
+    stateDir: absolute('LOBEHUB_WORKER_STATE_DIR', '/state'),
+    token,
+    workerId,
+    workspaceDir: absolute('LOBEHUB_WORKER_WORKSPACE_DIR', '/workspace'),
+  };
+};
+
+export const workerCliEnvironment = (config: WorkerConfig): Record<string, string> => ({
+  CLAUDE_CONFIG_DIR: config.configDir,
+  HOME: config.home,
+  LANG: 'C.UTF-8',
+  PATH: '/usr/local/bin:/usr/bin:/bin',
+  TMPDIR: '/tmp',
+});
