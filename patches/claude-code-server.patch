+// @vitest-environment node
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import type { LobeChatDatabase } from '@/database/type';
+
+import {
+  executeClaudeCodeTool,
+  isClaudeCodeDeferredResultTerminal,
+  validateClaudeCodeToolArguments,
+} from './toolBridge';
+
+const mocks = vi.hoisted(() => ({
+  buildHost: vi.fn(),
+  checkPolicy: vi.fn(),
+  claim: vi.fn(),
+  complete: vi.fn(),
+  ensure: vi.fn(),
+  execute: vi.fn(),
+  findMessage: vi.fn(),
+  getBinding: vi.fn(),
+  getRun: vi.fn(),
+  heartbeat: vi.fn(),
