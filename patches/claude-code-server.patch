+      reason: 'server-worker',
+    });
+    expect(prepared.state.binding?.device).toBeUndefined();
+    expect(prepared.state.plan.workingDirectory).toBeUndefined();
+    expect(JSON.stringify(prepared.request)).not.toContain('private-windows-workspace');
+    expect(
+      prepared.request.tools.some((tool: any) => tool.identifier === 'lobe-local-system'),
+    ).toBe(false);
+    expect(deviceReads).not.toHaveBeenCalled();
+    const [saved] = await db.select().from(agents).where(eq(agents.id, agent.id));
+    expect(saved.chatConfig?.runtimeEnv?.workingDirectory).toBe('C:\\private-windows-workspace');
+  });
+});
diff --git a/apps/server/src/services/claudeCode/__tests__/finish.integration.test.ts b/apps/server/src/services/claudeCode/__tests__/finish.integration.test.ts
