+import type { AgentState, ContextBuilder } from '@lobechat/agent-runtime';
+
+/** Prepare the full ordinary-assistant context once for one independent CLI run. */
+export const buildClaudeCodeContext = async (builder: ContextBuilder, state: AgentState) => {
+  return builder.build({
+    model: state.modelRuntimeConfig!.model,
+    payload: {
+      isFirstMessage: true,
+      messages: state.messages,
+      model: state.modelRuntimeConfig!.model,
+      provider: 'claude-code',
+      tools: [],
+    },
+    provider: 'claude-code',
+    state,
+  });
+};
