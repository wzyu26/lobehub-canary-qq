+// @vitest-environment node
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import type { LobeChatDatabase } from '@/database/type';
+
+import { cancelClaudeCodeRun } from './cancel';
+
+const mocks = vi.hoisted(() => ({ cancel: vi.fn(), settle: vi.fn() }));
+vi.mock('@/database/models/claudeCode', () => ({
+  ClaudeCodeModel: class {
+    cancelRun = mocks.cancel;
+  },
+}));
+vi.mock('./finish', () => ({ settleClaudeCodeRun: mocks.settle }));
+const scope = {
+  db: {} as LobeChatDatabase,
+  operationId: 'run',
+  userId: 'owner',
+  workspaceId: 'workspace',
+};
+beforeEach(() => vi.resetAllMocks());
+describe('Claude Code cancellation', () => {
+  it('settles a queued cancellation immediately without waiting for an offline worker', async () => {
+    mocks.cancel.mockResolvedValue({ status: 'cancelled' });
+    await cancelClaudeCodeRun(scope);
+    expect(mocks.settle).toHaveBeenCalledWith(scope);
+  });
+  it('retains the global active slot until a running worker acknowledges termination', async () => {
+    mocks.cancel.mockResolvedValue({ status: 'cancelling' });
+    await cancelClaudeCodeRun(scope);
+    expect(mocks.settle).not.toHaveBeenCalled();
+  });
+  it("does not settle another user's operation", async () => {
+    mocks.cancel.mockResolvedValue(undefined);
+    await cancelClaudeCodeRun(scope);
+    expect(mocks.settle).not.toHaveBeenCalled();
+  });
+});
