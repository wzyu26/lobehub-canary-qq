+import path from 'node:path';
+
+import type { AgentStreamEvent } from '@lobechat/agent-gateway-client';
+import type { ClaudeCodeWorkerClaim } from '@lobechat/heterogeneous-agents/protocol';
+
+import type { WorkerConfig } from './config';
+
+export const testClaim = (
+  overrides: Partial<ClaudeCodeWorkerClaim> = {},
+): ClaudeCodeWorkerClaim => ({
+  leaseExpiresAt: new Date(Date.now() + 60_000).toISOString(),
+  leaseToken: 'lease-secret',
+  operationId: 'operation-1',
+  request: {
+    model: 'default',
+    prompt: 'hello',
+    protocol: 1,
+    systemPrompt: 'Assistant role',
+    tools: [],
+  },
+  ...overrides,
+});
+
+export const testEvent = (
+  type: AgentStreamEvent['type'] = 'stream_chunk',
+  data: unknown = {},
+): AgentStreamEvent => ({
+  data,
+  operationId: 'operation-1',
+  stepIndex: 0,
+  timestamp: Date.now(),
+  type,
+});
+
+export const testConfig = (root: string): WorkerConfig => ({
+  buildRevision: 'test',
+  cliCommand: path.join(root, 'claude'),
+  cliVersion: '2.1.301',
+  configDir: path.join(root, 'home', '.claude'),
+  home: path.join(root, 'home'),
+  heartbeatIntervalMs: 20,
+  pollIntervalMs: 100,
+  serverUrl: 'https://lobehub.example',
+  stateDir: path.join(root, 'state'),
+  token: 'service-secret',
+  workerId: 'worker-1',
+  workspaceDir: path.join(root, 'workspace'),
+});
