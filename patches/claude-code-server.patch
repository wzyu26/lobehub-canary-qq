+// @vitest-environment node
+import { createHash } from 'node:crypto';
+
+import { AgentDocumentsIdentifier } from '@lobechat/builtin-tool-agent-documents';
+import type { ClaudeCodeAssistantRequest } from '@lobechat/heterogeneous-agents/protocol';
+import { and, eq } from 'drizzle-orm';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { getTestDB } from '@/database/core/getTestDB';
+import { ClaudeCodeModel } from '@/database/models/claudeCode';
+import { MessageModel } from '@/database/models/message';
+import {
+  agentDocuments,
+  agentOperations,
+  agents,
+  documents,
+  messagePlugins,
+  messages,
+  users,
+  works,
+  workVersions,
+} from '@/database/schemas';
+import type { LobeChatDatabase } from '@/database/type';
+import { inMemoryAgentStateManager } from '@/server/modules/AgentRuntime/InMemoryAgentStateManager';
+import { inMemoryStreamEventManager } from '@/server/modules/AgentRuntime/InMemoryStreamEventManager';
+import { aiAgentRouter } from '@/server/routers/lambda/aiAgent';
+import { AiAgentService } from '@/server/services/aiAgent';
+
+import { assertNoActiveClaudeCodeAncestor } from '../enqueue';
+import { finishClaudeCodeRun } from '../finish';
+import { prepareClaimedClaudeCodeRun } from '../prepareClaim';
+import { executeClaudeCodeTool } from '../toolBridge';
+
+let db: LobeChatDatabase;
+vi.mock('@/database/core/db-adaptor', () => ({ getServerDB: () => db }));
+// URL signing is an external storage boundary. Native document content,
+// executor, runtime, permissions, resources and message writes remain real.
+vi.mock('@/server/services/file', () => ({
+  FileService: class {
+    getFullFileUrl(path: string) {
+      return path ? `/files${path}` : null;
+    }
+    getFileAccessUrl({ url }: { url: string }) {
+      return url;
+    }
+  },
+}));
+const apiAttempt = vi.hoisted(() =>
+  vi.fn(() => {
+    throw new Error('Unexpected API billing');
+  }),
+);
+vi.mock('@/server/modules/AgentRuntime/adapters/ServerModelRuntime', () => ({
+  ServerModelRuntime: class {
+    generate = apiAttempt;
+  },
+}));
+
+const userId = 'claude-tools-integration-owner';
+const workerId = 'claude-tools-integration-worker';
+const leaseToken = 'claude-tools-integration-lease-at-least-32-characters';
+const model = () => new ClaudeCodeModel(db, userId);
+const caller = () => aiAgentRouter.createCaller({ jwtPayload: { userId }, userId });
+const claim = async () => {
+  const run = await model().claimNextRun(workerId, leaseToken);
+  expect(run).toBeDefined();
+  return prepareClaimedClaudeCodeRun({ db, leaseToken, run: run!, userId });
+};
+
+beforeEach(async () => {
+  vi.stubEnv('CLAUDE_CODE_SERVER_ENABLED', '1');
+  db = await getTestDB();
+  await db.insert(users).values({ id: userId });
+  await model().provisionBinding({
+    secretHash: createHash('sha256').update('integration-service-token').digest('hex'),
+    workerId,
+  });
