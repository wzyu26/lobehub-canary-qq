+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { withAdminDatabase } from './database';
+
+const { constructor, database, end, on } = vi.hoisted(() => ({
+  constructor: vi.fn(),
+  database: {},
+  end: vi.fn(async () => {}),
+  on: vi.fn(),
+}));
+
+vi.mock('pg', () => ({
+  Pool: class {
+    end = end;
+    on = on;
+
+    constructor(options: unknown) {
+      constructor(options);
+    }
+  },
+}));
+vi.mock('drizzle-orm/node-postgres', () => ({ drizzle: () => database }));
+
+beforeEach(() => vi.clearAllMocks());
+
+describe('one-shot administration database connection', () => {
+  it('connects with only DATABASE_URL and closes the single bounded connection', async () => {
+    await expect(
+      withAdminDatabase('postgres://test@127.0.0.1/test', async (db) => {
+        expect(db).toBe(database);
+        return 'complete';
+      }),
+    ).resolves.toBe('complete');
+    expect(constructor).toHaveBeenCalledWith({
+      application_name: 'lobehub-claude-worker-admin',
+      connectionString: 'postgres://test@127.0.0.1/test',
+      connectionTimeoutMillis: 10_000,
+      idle_in_transaction_session_timeout: 15_000,
+      max: 1,
+      query_timeout: 20_000,
+      statement_timeout: 15_000,
+    });
+    expect(end).toHaveBeenCalledOnce();
+  });
+
+  it('closes the connection when a scoped administration operation fails', async () => {
+    await expect(
+      withAdminDatabase('postgres://test@127.0.0.1/test', async () => {
+        throw new Error('scope rejected');
+      }),
+    ).rejects.toThrow('scope rejected');
+    expect(end).toHaveBeenCalledOnce();
+  });
+
+  it('absorbs raw idle-driver errors and fails without including their secrets', async () => {
+    await expect(
+      withAdminDatabase('postgres://test@127.0.0.1/test', async () => {
+        on.mock.calls[0][1](new Error('postgres://private:secret@example/database'));
+      }),
+    ).rejects.toThrow('Administration database connection failed');
+    expect(end).toHaveBeenCalledOnce();
+  });
+});
