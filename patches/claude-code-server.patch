+import { createHash } from 'node:crypto';
+
+import type {
+  ClaudeCodeAuthStatus,
+  ClaudeCodeEnqueueInput,
+  ClaudeCodePreparedRequest,
+  ClaudeCodeRunEvent,
+  ClaudeCodeRunStatus,
+  ClaudeCodeToolCallInput,
+  ClaudeCodeWorkerCapabilities,
+} from '@lobechat/types';
+import { and, asc, eq, gt, inArray, isNull, lt, or, sql } from 'drizzle-orm';
+import type { AnyPgColumn } from 'drizzle-orm/pg-core';
+
+import { agentOperations } from '../schemas/agentOperations';
+import type {
+  ClaudeCodeBindingItem,
+  ClaudeCodeEventItem,
+  ClaudeCodeRunItem,
+} from '../schemas/claudeCode';
+import {
+  claudeCodeBindings,
+  claudeCodeEvents,
+  claudeCodeRuns,
+  claudeCodeToolReceipts,
+} from '../schemas/claudeCode';
+import type { LobeChatDatabase, Transaction } from '../type';
+
+export type ClaudeCodeBindingView = Omit<ClaudeCodeBindingItem, 'secretHash'>;
+export type ClaudeCodeRunView = Omit<ClaudeCodeRunItem, 'leaseTokenHash'>;
+
+export class ClaudeCodeStateError extends Error {
+  constructor(
+    readonly code: string,
+    message: string,
+  ) {
+    super(message);
+    this.name = 'ClaudeCodeStateError';
+  }
+}
+
+const bindingView = ({
+  secretHash: _secretHash,
+  ...row
+}: ClaudeCodeBindingItem): ClaudeCodeBindingView => row;
+const runView = ({
+  leaseTokenHash: _leaseTokenHash,
+  preparedRequest,
+  ...row
+}: ClaudeCodeRunItem): ClaudeCodeRunView => {
+  const {
+    _serverInterventions: _interventions,
+    _serverProjectionState: _state,
+    _serverPreparedRequestHash: _preparedHash,
+    ...request
+  } = preparedRequest;
+  return { ...row, preparedRequest: request };
+};
+
+const projectionState = (run: ClaudeCodeRunItem): Record<string, unknown> | undefined => {
+  const state = run.preparedRequest._serverProjectionState;
+  return state && typeof state === 'object' && !Array.isArray(state)
+    ? (state as Record<string, unknown>)
+    : undefined;
+};
+
+export type ClaudeCodeEventProjector = (
+  tx: Transaction,
+  run: ClaudeCodeRunView,
+  event: ClaudeCodeEventItem,
+  state: Record<string, unknown> | undefined,
+) => Promise<Record<string, unknown>>;
+export interface ClaudeCodeInterventionReceipt {
+  answer?: Record<string, unknown>;
+  request: Record<string, unknown>;
+  requestHash: string;
+}
+const interventions = (run: ClaudeCodeRunItem) =>
+  (run.preparedRequest._serverInterventions ?? {}) as Record<string, ClaudeCodeInterventionReceipt>;
+const activeStatuses: ClaudeCodeRunStatus[] = ['running', 'cancelling'];
+const sha256 = (value: string) => createHash('sha256').update(value).digest('hex');
+
+/** JSON key order is not part of a request or tool call's identity. */
+export const hashClaudeCodePayload = (value: unknown): string => {
+  const sort = (item: unknown): unknown => {
+    if (Array.isArray(item)) return item.map(sort);
+    if (item && typeof item === 'object') {
+      return Object.fromEntries(
+        Object.entries(item)
+          .sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0))
+          .map(([key, val]) => [key, sort(val)]),
+      );
+    }
+    return item;
+  };
+  const json = JSON.stringify(value);
+  if (json === undefined)
+    throw new ClaudeCodeStateError('invalid_payload', 'Expected a JSON payload');
+  return sha256(JSON.stringify(sort(JSON.parse(json))));
+};
+
+/**
+ * Private even inside a shared workspace. Never use buildWorkspaceWhere here:
+ * that helper deliberately grants workspace members shared content access.
+ */
+export class ClaudeCodeModel {
+  constructor(
+    private readonly db: LobeChatDatabase,
+    private readonly userId: string,
+    private readonly workspaceId?: string,
+  ) {}
+
+  private scope(table: { userId: AnyPgColumn; workspaceId: AnyPgColumn }) {
+    return and(
+      eq(table.userId, this.userId),
+      this.workspaceId ? eq(table.workspaceId, this.workspaceId) : isNull(table.workspaceId),
+    );
+  }
+
+  private async lockQueue(tx: Transaction) {
+    await tx.execute(sql`SELECT pg_advisory_xact_lock(hashtext('lobehub:claude-code:queue:v1'))`);
+  }
+
+  /** Admin-provisioned binding; this stores only the worker service secret hash. */
+  async provisionBinding(input: { secretHash: string; workerId: string }) {
+    if (!/^[a-f\d]{64}$/i.test(input.secretHash))
+      throw new ClaudeCodeStateError(
+        'invalid_secret_hash',
+        'Expected a SHA-256 service secret hash',
+      );
+    const [row] = await this.db
+      .insert(claudeCodeBindings)
+      .values({
+        ...input,
+        userId: this.userId,
+        workspaceId: this.workspaceId ?? null,
+      })
+      .returning();
+    return bindingView(row);
+  }
+
+  async getBinding() {
+    const [row] = await this.db
+      .select()
+      .from(claudeCodeBindings)
+      .where(this.scope(claudeCodeBindings))
+      .limit(1);
+    return row ? bindingView(row) : undefined;
+  }
+
+  /** Authenticate before constructing a scoped model. Callers cannot choose a user. */
+  static async resolveWorker(db: LobeChatDatabase, workerId: string, secretHash: string) {
+    const [row] = await db
+      .select()
+      .from(claudeCodeBindings)
+      .where(
+        and(
+          eq(claudeCodeBindings.workerId, workerId),
+          eq(claudeCodeBindings.secretHash, secretHash),
+        ),
+      )
+      .limit(1);
+    return row ? bindingView(row) : undefined;
+  }
+
+  async setBindingEnabled(enabled: boolean) {
+    return this.db.transaction(async (tx) => {
+      await this.lockQueue(tx);
+      const [previous] = await tx
+        .select()
+        .from(claudeCodeBindings)
+        .where(this.scope(claudeCodeBindings))
+        .for('update');
+      if (!previous) return undefined;
+      if (previous.enabled === enabled) return bindingView(previous);
+      const [row] = await tx
+        .update(claudeCodeBindings)
+        .set({
+          enabled,
+        })
+        .where(this.scope(claudeCodeBindings))
+        .returning();
+      return bindingView(row);
+    });
+  }
+
+  async updateWorkerStatus(
+    workerId: string,
+    input: { authStatus: ClaudeCodeAuthStatus; capabilities: ClaudeCodeWorkerCapabilities },
+  ) {
+    const [row] = await this.db
+      .update(claudeCodeBindings)
+      .set({ ...input, lastSeenAt: new Date() })
+      .where(and(this.scope(claudeCodeBindings), eq(claudeCodeBindings.workerId, workerId)))
+      .returning();
+    return row ? bindingView(row) : undefined;
+  }
+
+  async enqueueRun(input: ClaudeCodeEnqueueInput) {
+    return this.db.transaction(async (tx) => {
+      await this.lockQueue(tx);
+      const requestHash = hashClaudeCodePayload(input);
+      const [existing] = await tx
+        .select()
+        .from(claudeCodeRuns)
+        .where(and(this.scope(claudeCodeRuns), eq(claudeCodeRuns.requestId, input.requestId)))
+        .limit(1);
+      if (existing) {
+        if (existing.requestHash !== requestHash)
+          throw new ClaudeCodeStateError(
+            'request_conflict',
+            'Request ID was already used with different input',
+          );
+        return runView(existing);
+      }
+      const [binding] = await tx
+        .select()
+        .from(claudeCodeBindings)
+        .where(this.scope(claudeCodeBindings))
+        .limit(1);
+      if (!binding?.enabled)
+        throw new ClaudeCodeStateError('worker_disabled', 'Claude Code worker is not enabled');
+      if (binding.authStatus !== 'logged_in')
+        throw new ClaudeCodeStateError(
+          'auth_required',
+          'Log in to Claude Code in the assigned worker',
+        );
+      const [operation] = await tx
+        .select()
+        .from(agentOperations)
+        .where(and(eq(agentOperations.id, input.operationId), this.scope(agentOperations)))
+        .limit(1);
+      if (
+        !operation ||
+        operation.topicId !== input.topicId ||
+        operation.threadId !== (input.threadId ?? null) ||
+        !['idle', 'running'].includes(operation.status)
+      ) {
+        throw new ClaudeCodeStateError(
+          'invalid_operation',
+          'Operation does not match this run owner, topic, or branch',
+        );
+      }
+      const [row] = await tx
+        .insert(claudeCodeRuns)
+        .values({
+          ...input,
+          requestHash,
+          userId: this.userId,
+          workerId: binding.workerId,
+          workspaceId: this.workspaceId ?? null,
+        })
+        .returning();
+      return runView(row);
+    });
+  }
+
+  async getRun(runId: string) {
+    const [row] = await this.db
+      .select()
+      .from(claudeCodeRuns)
+      .where(and(eq(claudeCodeRuns.operationId, runId), this.scope(claudeCodeRuns)))
+      .limit(1);
+    return row ? runView(row) : undefined;
+  }
+
+  /** Only the authenticated binding's worker can claim. A replay never claims an active run. */
+  async claimNextRun(
+    workerId: string,
+    leaseToken: string,
+    options: { leaseMs?: number; workerFreshMs?: number } = {},
+  ) {
+    const leaseMs = options.leaseMs ?? 60_000;
+    if (leaseToken.length < 32 || leaseMs < 1000 || leaseMs > 300_000)
+      throw new ClaudeCodeStateError('invalid_lease', 'Invalid worker lease');
+    return this.db.transaction(async (tx) => {
+      await this.lockQueue(tx);
+      const [binding] = await tx
+        .select()
+        .from(claudeCodeBindings)
+        .where(
+          and(
+            this.scope(claudeCodeBindings),
+            eq(claudeCodeBindings.workerId, workerId),
+            eq(claudeCodeBindings.enabled, true),
+            eq(claudeCodeBindings.authStatus, 'logged_in'),
+          ),
+        )
+        .limit(1);
+      if (!binding)
+        throw new ClaudeCodeStateError('worker_unavailable', 'Worker is disabled or not logged in');
+      const [active] = await tx
+        .select({ id: claudeCodeRuns.operationId })
+        .from(claudeCodeRuns)
+        .where(inArray(claudeCodeRuns.status, activeStatuses))
+        .limit(1);
+      if (active) return undefined;
+      // Global FIFO among workers currently reporting ready. An offline worker
+      // does not prevent another user's queued conversation from progressing.
+      const [candidate] = await tx
+        .select({ run: claudeCodeRuns })
+        .from(claudeCodeRuns)
+        .innerJoin(
+          claudeCodeBindings,
+          and(
+            eq(claudeCodeRuns.workerId, claudeCodeBindings.workerId),
+            eq(claudeCodeRuns.userId, claudeCodeBindings.userId),
+            sql`${claudeCodeRuns.workspaceId} IS NOT DISTINCT FROM ${claudeCodeBindings.workspaceId}`,
+          ),
+        )
+        .where(
+          and(
+            eq(claudeCodeRuns.status, 'queued'),
+            eq(claudeCodeBindings.enabled, true),
+            eq(claudeCodeBindings.authStatus, 'logged_in'),
+            gt(
+              claudeCodeBindings.lastSeenAt,
+              new Date(Date.now() - (options.workerFreshMs ?? 60_000)),
+            ),
+          ),
+        )
+        .orderBy(asc(claudeCodeRuns.queuedAt), asc(claudeCodeRuns.operationId))
+        .limit(1);
+      if (
+        !candidate ||
+        candidate.run.workerId !== workerId ||
+        candidate.run.userId !== this.userId ||
+        candidate.run.workspaceId !== (this.workspaceId ?? null)
+      )
+        return undefined;
+      const now = new Date();
+      const [row] = await tx
+        .update(claudeCodeRuns)
+        .set({
+          heartbeatAt: now,
+          leaseExpiresAt: new Date(now.getTime() + leaseMs),
+          leaseTokenHash: sha256(leaseToken),
+          startedAt: now,
+          status: 'running',
+        })
+        .where(
+          and(
+            eq(claudeCodeRuns.operationId, candidate.run.operationId),
+            eq(claudeCodeRuns.status, 'queued'),
+            this.scope(claudeCodeRuns),
+          ),
+        )
+        .returning();
+      return row ? runView(row) : undefined;
+    });
+  }
+
+  private async leasedRun(
+    tx: Transaction,
+    runId: string,
+    leaseToken: string,
+    allowTerminal = false,
+  ) {
+    const [row] = await tx
+      .select()
+      .from(claudeCodeRuns)
+      .where(
+        and(
+          eq(claudeCodeRuns.operationId, runId),
+          this.scope(claudeCodeRuns),
+          eq(claudeCodeRuns.leaseTokenHash, sha256(leaseToken)),
+        ),
+      )
+      .for('update')
+      .limit(1);
+    if (!row) throw new ClaudeCodeStateError('invalid_lease', 'Run is outside this worker lease');
+    if (
+      !allowTerminal &&
+      (!activeStatuses.includes(row.status) ||
+        !row.leaseExpiresAt ||
+        row.leaseExpiresAt.getTime() <= Date.now())
+    )
+      throw new ClaudeCodeStateError('lease_expired', 'Run lease expired or ended');
+    return row;
+  }
+
+  /**
+   * Claim reserves the global slot before preparing the current turn. Only publish
+   * this returned request to the worker: queued snapshots are never executable.
+   * The first successful preparation is immutable for this lease, so an HTTP
+   * retry cannot replace the context of an already-started CLI process.
+   */
+  async replaceClaimedRequest(
+    runId: string,
+    leaseToken: string,
+    preparedRequest: ClaudeCodePreparedRequest,
+  ) {
+    return this.db.transaction(async (tx) => {
+      const run = await this.leasedRun(tx, runId, leaseToken);
+      if (run.status !== 'running')
+        throw new ClaudeCodeStateError('run_not_active', 'Run was cancelled during preparation');
+      const [binding] = await tx
+        .select()
+        .from(claudeCodeBindings)
+        .where(and(this.scope(claudeCodeBindings), eq(claudeCodeBindings.workerId, run.workerId)))
+        .for('share')
+        .limit(1);
+      if (!binding?.enabled || binding.authStatus !== 'logged_in')
+        throw new ClaudeCodeStateError('worker_unavailable', 'Worker is disabled or not logged in');
+      if (!run.leaseExpiresAt || run.leaseExpiresAt.getTime() <= Date.now())
+        throw new ClaudeCodeStateError('lease_expired', 'Run lease expired during preparation');
+      if (Object.keys(preparedRequest).some((key) => key.startsWith('_server')))
+        throw new ClaudeCodeStateError(
+          'invalid_payload',
+          'Private execution state is server-owned',
+        );
+      const requestHash = hashClaudeCodePayload(preparedRequest);
+      const previousHash = run.preparedRequest._serverPreparedRequestHash;
+      if (previousHash) {
+        if (previousHash !== requestHash)
+          throw new ClaudeCodeStateError('request_conflict', 'Claimed request is already prepared');
+        return runView(run);
+      }
+      if (run.lastEventSequence > 0)
+        throw new ClaudeCodeStateError('run_already_started', 'Cannot replace a started execution');
+      const [receipt] = await tx
+        .select({ id: claudeCodeToolReceipts.toolCallId })
+        .from(claudeCodeToolReceipts)
+        .where(eq(claudeCodeToolReceipts.runId, runId))
+        .limit(1);
+      if (receipt)
+        throw new ClaudeCodeStateError('run_already_started', 'Cannot replace a started execution');
+      const [updated] = await tx
+        .update(claudeCodeRuns)
+        .set({
+          preparedRequest: {
+            ...preparedRequest,
+            _serverPreparedRequestHash: requestHash,
+            ...(run.preparedRequest._serverProjectionState !== undefined
+              ? { _serverProjectionState: run.preparedRequest._serverProjectionState }
+              : {}),
+            ...(run.preparedRequest._serverInterventions !== undefined
+              ? { _serverInterventions: run.preparedRequest._serverInterventions }
+              : {}),
+          },
+        })
+        .where(eq(claudeCodeRuns.operationId, runId))
+        .returning();
+      return runView(updated);
+    });
+  }
+
+  async heartbeat(runId: string, leaseToken: string, leaseMs = 60_000) {
+    if (leaseMs < 1000 || leaseMs > 300_000)
+      throw new ClaudeCodeStateError('invalid_lease', 'Invalid heartbeat lease duration');
+    return this.db.transaction(async (tx) => {
+      const run = await this.leasedRun(tx, runId, leaseToken);
+      const [binding] = await tx
+        .select()
+        .from(claudeCodeBindings)
+        .where(
+          and(
+            eq(claudeCodeBindings.workerId, run.workerId),
+            this.scope(claudeCodeBindings),
+            eq(claudeCodeBindings.enabled, true),
+          ),
+        )
+        .limit(1);
+      if (!binding) throw new ClaudeCodeStateError('worker_disabled', 'Worker binding was revoked');
+      const now = new Date();
+      const [row] = await tx
+        .update(claudeCodeRuns)
+        .set({ heartbeatAt: now, leaseExpiresAt: new Date(now.getTime() + leaseMs) })
+        .where(eq(claudeCodeRuns.operationId, runId))
+        .returning();
+      return runView(row);
+    });
+  }
+
+  async cancelRun(runId: string) {
+    return this.db.transaction(async (tx) => {
+      await this.lockQueue(tx);
+      const [run] = await tx
+        .select()
+        .from(claudeCodeRuns)
+        .where(and(eq(claudeCodeRuns.operationId, runId), this.scope(claudeCodeRuns)))
+        .for('update')
+        .limit(1);
+      if (!run) return undefined;
+      if (!['queued', 'running'].includes(run.status)) return runView(run);
+      const [row] = await tx
+        .update(claudeCodeRuns)
+        .set(
+          run.status === 'queued'
+            ? { endedAt: new Date(), status: 'cancelled' }
+            : { status: 'cancelling' },
+        )
+        .where(eq(claudeCodeRuns.operationId, runId))
+        .returning();
+      return runView(row);
+    });
+  }
+
+  async finishRun(
+    runId: string,
+    leaseToken: string,
+    input: { error?: string; status: 'completed' | 'error' | 'cancelled' | 'interrupted' },
+  ) {
+    return this.db.transaction(async (tx) => {
+      const run = await this.leasedRun(tx, runId, leaseToken, true);
+      if (!activeStatuses.includes(run.status)) return runView(run);
+      if (
+        (!run.leaseExpiresAt || run.leaseExpiresAt.getTime() <= Date.now()) &&
+        input.status !== 'interrupted' &&
+        input.status !== 'cancelled'
+      )
+        throw new ClaudeCodeStateError('lease_expired', 'Expired worker cannot finish a run');
+      const status = run.status === 'cancelling' ? 'cancelled' : input.status;
+      const [row] = await tx
+        .update(claudeCodeRuns)
+        .set({ endedAt: new Date(), error: input.error, status })
+        .where(eq(claudeCodeRuns.operationId, runId))
+        .returning();
+      await tx
+        .update(claudeCodeToolReceipts)
+        .set({ status: 'interrupted' })
+        .where(
+          and(
+            eq(claudeCodeToolReceipts.runId, runId),
+            eq(claudeCodeToolReceipts.status, 'started'),
+          ),
+        );
+      return runView(row);
+    });
+  }
+
+  /** Lost workers are interrupted, never returned to queued or replayed. */
+  static async interruptStaleRuns(db: LobeChatDatabase) {
+    return db.transaction(async (tx) => {
+      await tx.execute(sql`SELECT pg_advisory_xact_lock(hashtext('lobehub:claude-code:queue:v1'))`);
+      const rows = await tx
+        .update(claudeCodeRuns)
+        .set({
+          endedAt: new Date(),
+          error: 'Worker or tool handler lease expired; execution was not replayed.',
+          status: 'interrupted',
+        })
+        .where(
+          and(
+            inArray(claudeCodeRuns.status, activeStatuses),
+            or(
+              lt(claudeCodeRuns.leaseExpiresAt, new Date()),
+              sql`EXISTS (SELECT 1 FROM ${claudeCodeToolReceipts} WHERE
+                  ${claudeCodeToolReceipts.runId} = ${claudeCodeRuns.operationId}
+                  AND ${claudeCodeToolReceipts.status} = 'started'
+                  AND coalesce((${claudeCodeToolReceipts.result}->>'_executionLeaseExpiresAt')::bigint,
+                    (extract(epoch from ${claudeCodeToolReceipts.createdAt}) * 1000)::bigint + 60000)
+                    < ${Date.now()})`,
+            ),
+          ),
+        )
+        .returning();
+      for (const row of rows) {
+        await tx
+          .update(claudeCodeToolReceipts)
+          .set({ status: 'interrupted' })
+          .where(
+            and(
+              eq(claudeCodeToolReceipts.runId, row.operationId),
+              eq(claudeCodeToolReceipts.status, 'started'),
+            ),
+          );
+      }
+      return rows.map(runView);
+    });
+  }
+
+  async appendEvents(runId: string, leaseToken: string, events: ClaudeCodeRunEvent[]) {
+    return this.db.transaction(async (tx) => {
+      const run = await this.leasedRun(tx, runId, leaseToken, true);
+      let lastSequence = run.lastEventSequence;
+      for (const event of events) {
+        if (!Number.isSafeInteger(event.sequence) || event.sequence < 1)
+          throw new ClaudeCodeStateError(
+            'invalid_sequence',
+            'Event sequence must be a positive integer',
+          );
+        const payloadHash = hashClaudeCodePayload(event.payload);
+        const [existing] = await tx
+          .select()
+          .from(claudeCodeEvents)
+          .where(
+            and(eq(claudeCodeEvents.runId, runId), eq(claudeCodeEvents.sequence, event.sequence)),
+          )
+          .limit(1);
+        if (existing) {
+          if (existing.payloadHash !== payloadHash)
+            throw new ClaudeCodeStateError(
+              'event_conflict',
+              'Event sequence was reused with different content',
+            );
+          continue;
+        }
+        // A restarted worker may drain an on-disk outbox using this original
+        // run's lease. These are transcript receipts only: they never extend
+        // the lease, change terminal status, or authorize a tool execution.
+        // The projection layer treats the durable run status as authoritative
+        // and must not turn a late CLI "success" into successful completion.
+        if (event.sequence !== lastSequence + 1)
+          throw new ClaudeCodeStateError(
+            'sequence_gap',
+            'Events must be delivered in contiguous order',
+          );
+        await tx.insert(claudeCodeEvents).values({ ...event, payloadHash, runId });
+        lastSequence = event.sequence;
+      }
+      await tx
+        .update(claudeCodeRuns)
+        .set({ lastEventSequence: lastSequence })
+        .where(eq(claudeCodeRuns.operationId, runId));
+      return { acceptedSequence: lastSequence };
+    });
+  }
+
+  async getEvents(runId: string, afterSequence = 0, limit = 200) {
+    if (!(await this.getRun(runId))) return [];
+    return this.db
+      .select()
+      .from(claudeCodeEvents)
+      .where(and(eq(claudeCodeEvents.runId, runId), gt(claudeCodeEvents.sequence, afterSequence)))
+      .orderBy(asc(claudeCodeEvents.sequence))
+      .limit(Math.min(Math.max(limit, 1), 1000));
+  }
+
+  /**
+   * The callback must write messages through this transaction and return a
+   * JSON-serializable reducer snapshot (for example a SuperJSON envelope).
+   * Do not publish to the gateway inside it: a rollback must have no external
+   * side effects. A retried transaction sees neither partial messages nor a
+   * prematurely advanced event receipt.
+   */
+  async projectEvents(runId: string, project: ClaudeCodeEventProjector, limit = 200) {
+    return this.db.transaction(async (tx) => {
+      const [run] = await tx
+        .select()
+        .from(claudeCodeRuns)
+        .where(and(eq(claudeCodeRuns.operationId, runId), this.scope(claudeCodeRuns)))
+        .for('update')
+        .limit(1);
+      if (!run) throw new ClaudeCodeStateError('run_not_found', 'Run not found');
+      const events = await tx
+        .select()
+        .from(claudeCodeEvents)
+        .where(
+          and(
+            eq(claudeCodeEvents.runId, runId),
+            gt(claudeCodeEvents.sequence, run.projectedSequence),
+          ),
+        )
+        .orderBy(asc(claudeCodeEvents.sequence))
+        .limit(Math.min(Math.max(limit, 1), 1000));
+      let state = projectionState(run);
+      for (const event of events) {
+        if (event.sequence !== run.projectedSequence + 1 || event.projected)
+          throw new ClaudeCodeStateError('sequence_gap', 'Projection receipt is inconsistent');
+        state = await project(tx, runView(run), event, state);
+        run.projectedSequence = event.sequence;
+        run.preparedRequest = { ...run.preparedRequest, _serverProjectionState: state };
+        await tx
+          .update(claudeCodeEvents)
+          .set({ projected: true })
+          .where(
+            and(eq(claudeCodeEvents.runId, runId), eq(claudeCodeEvents.sequence, event.sequence)),
+          );
+        await tx
+          .update(claudeCodeRuns)
+          .set({ preparedRequest: run.preparedRequest, projectedSequence: event.sequence })
+          .where(eq(claudeCodeRuns.operationId, runId));
+      }
+      return events.map((event) => ({ ...event, projected: true }));
+    });
+  }
+
+  async getProjectionState(runId: string) {
+    const [run] = await this.db
+      .select()
+      .from(claudeCodeRuns)
+      .where(and(eq(claudeCodeRuns.operationId, runId), this.scope(claudeCodeRuns)))
+      .limit(1);
+    return run ? projectionState(run) : undefined;
+  }
+
+  /** Serialize host-side cards/finish with worker projection without replacing its request. */
+  async withProjectionState(
+    runId: string,
+    mutate: (
+      tx: Transaction,
+      run: ClaudeCodeRunView,
+      state: Record<string, unknown> | undefined,
+    ) => Promise<Record<string, unknown> | undefined>,
+  ) {
+    return this.db.transaction(async (tx) => {
+      const [run] = await tx
+        .select()
+        .from(claudeCodeRuns)
+        .where(and(this.scope(claudeCodeRuns), eq(claudeCodeRuns.operationId, runId)))
+        .for('update');
+      if (!run)
+        throw new ClaudeCodeStateError('run_not_found', 'Run does not belong to this account');
+      const state = await mutate(tx, runView(run), projectionState(run));
+      if (state !== undefined)
+        await tx
+          .update(claudeCodeRuns)
+          .set({
+            preparedRequest: { ...run.preparedRequest, _serverProjectionState: state },
+          })
+          .where(eq(claudeCodeRuns.operationId, runId));
+      return state;
+    });
+  }
+
+  /** Called only after the existing persistence projection succeeds. */
+  async markEventProjected(runId: string, sequence: number) {
+    return this.db.transaction(async (tx) => {
+      const [run] = await tx
+        .select()
+        .from(claudeCodeRuns)
+        .where(and(eq(claudeCodeRuns.operationId, runId), this.scope(claudeCodeRuns)))
+        .for('update')
+        .limit(1);
+      if (!run) throw new ClaudeCodeStateError('run_not_found', 'Run not found');
+      if (sequence <= run.projectedSequence) return;
+      if (sequence !== run.projectedSequence + 1 || sequence > run.lastEventSequence)
+        throw new ClaudeCodeStateError('sequence_gap', 'Project events in their persisted order');
+      await tx
+        .update(claudeCodeEvents)
+        .set({ projected: true })
+        .where(and(eq(claudeCodeEvents.runId, runId), eq(claudeCodeEvents.sequence, sequence)));
+      await tx
+        .update(claudeCodeRuns)
+        .set({ projectedSequence: sequence })
+        .where(eq(claudeCodeRuns.operationId, runId));
+    });
+  }
+
+  async claimToolCall(runId: string, leaseToken: string, input: ClaudeCodeToolCallInput) {
+    return this.db.transaction(async (tx) => {
+      const run = await this.leasedRun(tx, runId, leaseToken, true);
+      const argumentHash = hashClaudeCodePayload(input.arguments);
+      const [existing] = await tx
+        .select()
+        .from(claudeCodeToolReceipts)
+        .where(
+          and(
+            eq(claudeCodeToolReceipts.runId, runId),
+            eq(claudeCodeToolReceipts.toolCallId, input.toolCallId),
+          ),
+        )
+        .limit(1);
+      if (existing) {
+        if (existing.name !== input.name || existing.argumentHash !== argumentHash)
+          throw new ClaudeCodeStateError(
+            'tool_conflict',
+            'Tool call ID was reused with different parameters',
+          );
+        return {
+          disposition:
+            existing.status === 'completed'
+              ? ('replay' as const)
+              : existing.status === 'started'
+                ? ('in_progress' as const)
+                : ('interrupted' as const),
+          receipt: existing,
+        };
+      }
+      if (
+        run.status !== 'running' ||
+        !run.leaseExpiresAt ||
+        run.leaseExpiresAt.getTime() <= Date.now()
+      )
+        throw new ClaudeCodeStateError('lease_expired', 'Cannot start tools on an inactive run');
+      const [binding] = await tx
+        .select()
+        .from(claudeCodeBindings)
+        .where(and(this.scope(claudeCodeBindings), eq(claudeCodeBindings.workerId, run.workerId)))
+        .limit(1);
+      if (!binding?.enabled || binding.authStatus !== 'logged_in')
+        throw new ClaudeCodeStateError('worker_unavailable', 'Worker is disabled or not logged in');
+      const [busy] = await tx
+        .select({ id: claudeCodeToolReceipts.toolCallId })
+        .from(claudeCodeToolReceipts)
+        .where(
+          and(
+            eq(claudeCodeToolReceipts.runId, runId),
+            eq(claudeCodeToolReceipts.status, 'started'),
+          ),
+        )
+        .limit(1);
+      if (busy) return { disposition: 'busy' as const, receipt: undefined };
+      const [receipt] = await tx
+        .insert(claudeCodeToolReceipts)
+        .values({
+          argumentHash,
+          name: input.name,
+          runId,
+          toolCallId: input.toolCallId,
+          result: { _executionLeaseExpiresAt: Date.now() + 60_000 },
+        })
+        .returning();
+      return { disposition: 'execute' as const, receipt };
+    });
+  }
+
+  async completeToolCall(
+    runId: string,
+    leaseToken: string,
+    toolCallId: string,
+    result: Record<string, unknown>,
+  ) {
+    return this.db.transaction(async (tx) => {
+      await this.leasedRun(tx, runId, leaseToken);
+      const [receipt] = await tx
+        .select()
+        .from(claudeCodeToolReceipts)
+        .where(
+          and(
+            eq(claudeCodeToolReceipts.runId, runId),
+            eq(claudeCodeToolReceipts.toolCallId, toolCallId),
+          ),
+        )
+        .limit(1);
+      if (!receipt || receipt.status === 'interrupted')
+        throw new ClaudeCodeStateError('tool_not_active', 'Tool call is not active');
+      if (receipt.status === 'completed') {
+        if (hashClaudeCodePayload(receipt.result) !== hashClaudeCodePayload(result))
+          throw new ClaudeCodeStateError(
+            'tool_conflict',
+            'Completed tool result cannot be replaced',
+          );
+        return receipt;
+      }
+      if (Number(receipt.result?._executionLeaseExpiresAt ?? 0) <= Date.now())
+        throw new ClaudeCodeStateError('tool_not_active', 'Tool handler lease expired');
+      const [row] = await tx
+        .update(claudeCodeToolReceipts)
+        .set({ result, status: 'completed' })
+        .where(
+          and(
+            eq(claudeCodeToolReceipts.runId, runId),
+            eq(claudeCodeToolReceipts.toolCallId, toolCallId),
+          ),
+        )
+        .returning();
+      return row;
+    });
+  }
+
+  /** The handler owns this lease independently of the still-live CLI worker. */
+  async heartbeatToolCall(runId: string, leaseToken: string, toolCallId: string) {
+    return this.db.transaction(async (tx) => {
+      await this.leasedRun(tx, runId, leaseToken);
+      const [row] = await tx
+        .update(claudeCodeToolReceipts)
+        .set({
+          result: { _executionLeaseExpiresAt: Date.now() + 60_000 },
+        })
+        .where(
+          and(
+            eq(claudeCodeToolReceipts.runId, runId),
+            eq(claudeCodeToolReceipts.toolCallId, toolCallId),
+            eq(claudeCodeToolReceipts.status, 'started'),
+            sql`(${claudeCodeToolReceipts.result}->>'_executionLeaseExpiresAt')::bigint > ${Date.now()}`,
+          ),
+        )
+        .returning();
+      if (!row)
+        throw new ClaudeCodeStateError('tool_not_active', 'Tool handler lease expired or ended');
+    });
+  }
+
+  async getToolReceipt(runId: string, toolCallId: string) {
+    if (!(await this.getRun(runId))) return undefined;
+    const [row] = await this.db
+      .select()
+      .from(claudeCodeToolReceipts)
+      .where(
+        and(
+          eq(claudeCodeToolReceipts.runId, runId),
+          eq(claudeCodeToolReceipts.toolCallId, toolCallId),
+        ),
+      )
+      .limit(1);
+    return row;
+  }
+
+  /** Persist tool-derived state without ever scheduling a model step. */
+  async updateRuntimeState(runId: string, leaseToken: string, state: unknown) {
+    return this.db.transaction(async (tx) => {
+      const run = await this.leasedRun(tx, runId, leaseToken);
+      await tx
+        .update(claudeCodeRuns)
+        .set({
+          preparedRequest: { ...run.preparedRequest, state },
+        })
+        .where(eq(claudeCodeRuns.operationId, runId));
+    });
+  }
+
+  /** Register before displaying a question; retries cannot replace its meaning. */
+  async registerIntervention(
+    runId: string,
+    leaseToken: string,
+    toolCallId: string,
+    request: Record<string, unknown>,
+  ) {
+    return this.db.transaction(async (tx) => {
+      const run = await this.leasedRun(tx, runId, leaseToken);
+      const ledger = interventions(run);
+      const requestHash = hashClaudeCodePayload(request);
+      const previous = ledger[toolCallId];
+      if (previous) {
+        if (previous.requestHash !== requestHash)
+          throw new ClaudeCodeStateError('intervention_conflict', 'Question changed during retry');
+        return previous;
+      }
+      const receipt: ClaudeCodeInterventionReceipt = { request, requestHash };
+      await tx
+        .update(claudeCodeRuns)
+        .set({
+          preparedRequest: {
+            ...run.preparedRequest,
+            _serverInterventions: { ...ledger, [toolCallId]: receipt },
+          },
+        })
+        .where(eq(claudeCodeRuns.operationId, runId));
+      return receipt;
+    });
+  }
+
+  async getIntervention(runId: string, leaseToken: string, toolCallId: string) {
+    return this.db.transaction(async (tx) => {
+      const run = await this.leasedRun(tx, runId, leaseToken);
+      return interventions(run)[toolCallId];
+    });
+  }
+
+  /** Browser answer: scope comes from its authenticated user, never request arguments. */
+  async resolveIntervention(runId: string, toolCallId: string, answer: Record<string, unknown>) {
+    return this.db.transaction(async (tx) => {
+      const [run] = await tx
+        .select()
+        .from(claudeCodeRuns)
+        .where(and(this.scope(claudeCodeRuns), eq(claudeCodeRuns.operationId, runId)))
+        .for('update');
+      if (!run)
+        throw new ClaudeCodeStateError('run_not_found', 'Run does not belong to this account');
+      const ledger = interventions(run);
+      const previous = ledger[toolCallId];
+      if (!previous) throw new ClaudeCodeStateError('intervention_not_found', 'Unknown question');
+      if (previous.answer) return previous.answer;
+      if (!answer.cancelled && Number(previous.request.deadline ?? 0) <= Date.now())
+        throw new ClaudeCodeStateError('intervention_expired', 'The question deadline has passed');
+      if (
+        run.status !== 'running' ||
+        !run.leaseExpiresAt ||
+        run.leaseExpiresAt.getTime() <= Date.now()
+      )
+        throw new ClaudeCodeStateError('run_not_active', 'The question is no longer active');
+      await tx
+        .update(claudeCodeRuns)
+        .set({
+          preparedRequest: {
+            ...run.preparedRequest,
+            _serverInterventions: { ...ledger, [toolCallId]: { ...previous, answer } },
+          },
+        })
+        .where(eq(claudeCodeRuns.operationId, runId));
+      return answer;
+    });
+  }
+}
