@@ -0,0 +1,244 @@
+import { createHash } from 'node:crypto';
+
+import { eq } from 'drizzle-orm';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { getTestDB } from '@/database/core/getTestDB';
+import { ClaudeCodeModel } from '@/database/models/claudeCode';
+import { UserPersonaModel } from '@/database/models/userMemory/persona';
+import { agentOperations, agents, messages, topics, users } from '@/database/schemas';
+import type { LobeChatDatabase } from '@/database/type';
+import { inMemoryAgentStateManager } from '@/server/modules/AgentRuntime/InMemoryAgentStateManager';
+import { inMemoryStreamEventManager } from '@/server/modules/AgentRuntime/InMemoryStreamEventManager';
+import { aiAgentRouter } from '@/server/routers/lambda/aiAgent';
+
+import { finishClaudeCodeRun } from '../finish';
+import { prepareClaimedClaudeCodeRun } from '../prepareClaim';
+
+let db: LobeChatDatabase;
+vi.mock('@/database/core/db-adaptor', () => ({ getServerDB: () => db }));
+vi.mock('@/server/services/file', () => ({
+  FileService: class {
+    getFullFileUrl(path: string) {
+      return path ? `/files${path}` : null;
+    }
+    getFileAccessUrl({ url }: { url: string }) {
+      return url;
+    }
+  },
+}));
+const apiAttempt = vi.hoisted(() =>
+  vi.fn(() => {
+    throw new Error('Unexpected API billing');
+  }),
+);
+vi.mock('@/server/modules/AgentRuntime/adapters/ServerModelRuntime', () => ({
+  ServerModelRuntime: class {
+    generate = apiAttempt;
+  },
+}));
+
+const userId = 'claude-ordinary-test';
+const workerId = 'claude-ordinary-worker';
+const caller = () => aiAgentRouter.createCaller({ jwtPayload: { userId }, userId });
+const leaseToken = 'ordinary-integration-lease-token';
+const claim = async () => {
+  const run = await new ClaudeCodeModel(db, userId).claimNextRun(workerId, leaseToken);
+  expect(run).toBeDefined();
+  return prepareClaimedClaudeCodeRun({ db, leaseToken, run: run!, userId });
+};
+
+beforeEach(async () => {
+  vi.stubEnv('CLAUDE_CODE_SERVER_ENABLED', '1');
+  db = await getTestDB();
+  await db.insert(users).values({ id: userId });
+  const model = new ClaudeCodeModel(db, userId);
+  await model.provisionBinding({
+    secretHash: createHash('sha256').update('test-service-token').digest('hex'),
+    workerId,
+  });
+  await model.setBindingEnabled(true);
+  await model.updateWorkerStatus(workerId, {
+    authStatus: 'logged_in',
+    capabilities: {
+      cliVersion: '2.1.301',
+      models: [{ id: 'default', label: 'Default' }],
+      protocolVersion: 1,
+    },
+  });
+});
+
+afterEach(async () => {
+  await db.delete(users).where(eq(users.id, userId));
+  inMemoryAgentStateManager.clear();
+  inMemoryStreamEventManager.clear();
+  vi.unstubAllEnvs();
+  vi.clearAllMocks();
+});
+
+describe('ordinary assistant to server Claude Code', () => {
+  it('prepares the ordinary prompt and memory tools, then queues without an API or external-agent dispatch', async () => {
+    const [agent] = await db
+      .insert(agents)
+      .values({
+        chatConfig: { memory: { enabled: true } },
+        model: 'default',
+        provider: 'claude-code',
+        systemRole: 'Always explain with small examples.',
+        title: 'Ordinary assistant',
+        userId,
+      })
+      .returning();
+    const result = await caller().execAgent({ agentId: agent.id, prompt: 'Hello from a phone' });
+    expect(result.success).toBe(true);
+    const run = await new ClaudeCodeModel(db, userId).getRun(result.operationId);
+    expect(run?.status).toBe('queued');
+    expect(run?.preparedRequest.runtimeBackend).toBe('claude-code');
+    expect(run?.preparedRequest.request).toBeUndefined();
+    const request = (await claim()).preparedRequest.request as any;
+    expect(request.systemPrompt).toContain('Always explain with small examples.');
+    expect(JSON.stringify(request.prompt)).toContain('Hello from a phone');
+    expect(request.tools.some((tool: any) => tool.identifier === 'lobe-user-memory')).toBe(true);
+    const [operation] = await db
+      .select()
+      .from(agentOperations)
+      .where(eq(agentOperations.id, result.operationId));
+    expect(operation.metadata?.runtimeBackend).toBe('claude-code');
+    const [savedAgent] = await db.select().from(agents).where(eq(agents.id, agent.id));
+    expect(savedAgent.agencyConfig?.heterogeneousProvider).toBeUndefined();
+    expect(savedAgent.systemRole).toBe('Always explain with small examples.');
+    expect(apiAttempt).not.toHaveBeenCalled();
+  });
+
+  it('uses current memory, assistant configuration and LobeHub history on each independent turn', async () => {
+    const [agent] = await db
+      .insert(agents)
+      .values({
+        chatConfig: { memory: { enabled: true } },
+        model: 'default',
+        provider: 'claude-code',
+        systemRole: 'Initial role.',
+        userId,
+      })
+      .returning();
+    const persona = new UserPersonaModel(db, userId);
+    await persona.upsertPersona({ persona: 'memory-v1: prefers short answers.' });
+    const first = await caller().execAgent({ agentId: agent.id, prompt: 'First question' });
+    const firstRun = await claim();
+    const firstRequest = firstRun.preparedRequest.request as any;
+    expect(JSON.stringify(firstRequest.prompt)).toContain('memory-v1');
+    // Persist the first answer in the same LobeHub rows consumed by ordinary history loading.
+    await db
+      .update(messages)
+      .set({ content: 'First saved answer' })
+      .where(eq(messages.id, first.assistantMessageId));
+    await finishClaudeCodeRun({
+      db,
+      userId,
+      operationId: first.operationId,
+      leaseToken,
+      status: 'completed',
+    });
+
+    await persona.upsertPersona({ persona: 'memory-v2: prefers detailed answers.' });
+    const second = await caller().execAgent({
+      agentId: agent.id,
+      appContext: { topicId: first.topicId },
+      prompt: 'Second question',
+    });
+    expect(second.success).toBe(true);
+    // Both are changed while this second turn is queued, before worker claim.
+    await persona.upsertPersona({ persona: 'memory-v3: prefers numbered examples.' });
+    await db
+      .update(agents)
+      .set({ systemRole: 'Updated role.', chatConfig: { memory: { enabled: true } } })
+      .where(eq(agents.id, agent.id));
+    const secondRequest = (await claim()).preparedRequest.request as any;
+    const prompt = JSON.stringify(secondRequest.prompt);
+    expect(secondRequest.systemPrompt).toContain('Updated role.');
+    expect(prompt).toContain('memory-v3');
+    expect(prompt).not.toContain('memory-v1');
+    expect(prompt).not.toContain('memory-v2');
+    for (const text of ['First question', 'First saved answer', 'Second question']) {
+      expect(prompt.split(text)).toHaveLength(2);
+    }
+    expect(Object.keys(secondRequest).sort()).toEqual([
+      'model',
+      'prompt',
+      'protocol',
+      'systemPrompt',
+      'tools',
+    ]);
+    expect(apiAttempt).not.toHaveBeenCalled();
+  });
+
+  it('re-evaluates memory and tool permission switches after queuing', async () => {
+    const [agent] = await db
+      .insert(agents)
+      .values({
+        chatConfig: { memory: { enabled: true } },
+        model: 'default',
+        provider: 'claude-code',
+        userId,
+      })
+      .returning();
+    await new UserPersonaModel(db, userId).upsertPersona({
+      persona: 'private-memory-before-queue',
+    });
+    await caller().execAgent({ agentId: agent.id, prompt: 'Check current context' });
+    await db
+      .update(agents)
+      .set({
+        chatConfig: { memory: { enabled: false } },
+        plugins: [{ identifier: 'lobe-user-memory', mode: 'disabled' }],
+      })
+      .where(eq(agents.id, agent.id));
+    const request = (await claim()).preparedRequest.request as any;
+    expect(JSON.stringify(request)).not.toContain('private-memory-before-queue');
+    expect(request.tools.some((tool: any) => tool.identifier === 'lobe-user-memory')).toBe(false);
+  });
+
+  it('fails before model execution when the official account is not logged in', async () => {
+    const [agent] = await db
+      .insert(agents)
+      .values({ model: 'default', provider: 'claude-code', userId })
+      .returning();
+    await new ClaudeCodeModel(db, userId).updateWorkerStatus(workerId, {
+      authStatus: 'expired',
+      capabilities: { protocolVersion: 1 },
+    });
+    await expect(caller().execAgent({ agentId: agent.id, prompt: 'Hello' })).rejects.toThrow(
+      'claude auth login',
+    );
+    expect(apiAttempt).not.toHaveBeenCalled();
+  });
+
+  it('honors an explicit API topic selection even when the default Claude Code backend is disabled', async () => {
+    const [agent] = await db
+      .insert(agents)
+      .values({ model: 'default', provider: 'claude-code', userId })
+      .returning();
+    const [topic] = await db
+      .insert(topics)
+      .values({ agentId: agent.id, model: 'gpt-4o-mini', provider: 'openai', userId })
+      .returning();
+    vi.stubEnv('CLAUDE_CODE_SERVER_ENABLED', '0');
+    await new ClaudeCodeModel(db, userId).updateWorkerStatus(workerId, {
+      authStatus: 'expired',
+      capabilities: { protocolVersion: 1 },
+    });
+    const result = await caller().execAgent({
+      agentId: agent.id,
+      appContext: { topicId: topic.id },
+      autoStart: false,
+      prompt: 'Use the API model I selected for this topic',
+    });
+    expect(result.success).toBe(true);
+    expect(await new ClaudeCodeModel(db, userId).getRun(result.operationId)).toBeUndefined();
+    const [message] = await db
+      .select()
+      .from(messages)
+      .where(eq(messages.id, result.assistantMessageId));
+    expect(message).toMatchObject({ model: 'gpt-4o-mini', provider: 'openai' });
+  });
+});
diff --git a/apps/server/src/services/claudeCode/__tests__/projection.integration.test.ts b/apps/server/src/services/claudeCode/__tests__/projection.integration.test.ts
