+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import type { WorkerApi } from './api';
+import { RunLease } from './lease';
+
+describe('run lease fencing', () => {
+  beforeEach(() => vi.useFakeTimers());
+  afterEach(() => vi.useRealTimers());
+
+  it('finishes forced termination before the server can release an expired global slot', async () => {
+    const stop = vi.fn();
+    let processAlive = true;
+    stop.mockImplementation(() =>
+      setTimeout(() => {
+        processAlive = false;
+      }, 3000),
+    );
+    const api = {
+      post: vi.fn(
+        (_route, _body, signal) =>
+          new Promise((_resolve, reject) => {
+            signal?.addEventListener('abort', () => reject(new Error('aborted')), { once: true });
+          }),
+      ),
+    } as WorkerApi;
+    const lease = new RunLease(
+      api,
+      'op',
+      'token',
+      new Date(Date.now() + 10_000).toISOString(),
+      stop,
+    );
+    lease.start();
+    await vi.advanceTimersByTimeAsync(4999);
+    expect(stop).not.toHaveBeenCalled();
+    await vi.advanceTimersByTimeAsync(1);
+    expect(stop).toHaveBeenCalledTimes(1);
+    expect(lease.status).toBe('interrupted');
+    expect(lease.controller.signal.aborted).toBe(true);
+    await vi.advanceTimersByTimeAsync(3000);
+    expect(processAlive).toBe(false);
+    // At the database's original deadline, another worker can start safely.
+    await vi.advanceTimersByTimeAsync(2000);
+    expect(processAlive).toBe(false);
+    await lease.close();
+  });
+
+  it('refuses to start a run without enough lease time to terminate safely', async () => {
+    const stop = vi.fn();
+    const lease = new RunLease(
+      { post: vi.fn() } as WorkerApi,
+      'op',
+      'token',
+      new Date(Date.now() + 4999).toISOString(),
+      stop,
+    );
+    expect(stop).toHaveBeenCalledOnce();
+    expect(lease.status).toBe('interrupted');
+    await lease.close();
+  });
+
+  it('preserves explicit cancellation instead of converting it to completion', async () => {
+    const stop = vi.fn();
+    const lease = new RunLease(
+      { post: vi.fn(async () => ({ status: 'cancelling' })) } as WorkerApi,
+      'op',
+      'token',
+      new Date(Date.now() + 10_000).toISOString(),
+      stop,
+    );
+    lease.start();
+    await vi.advanceTimersByTimeAsync(0);
+    expect(lease.status).toBe('cancelled');
+    expect(stop).toHaveBeenCalledTimes(1);
+    await lease.close();
+  });
+});
diff --git a/apps/claude-code-worker/src/lease.ts b/apps/claude-code-worker/src/lease.ts
new file mode 100644
index 0000000000..7c2fc55bf1
--- /dev/null
+++ b/apps/claude-code-worker/src/lease.ts
@@ -0,0 +1,83 @@
+import { setTimeout as delay } from 'node:timers/promises';
+
+import type { WorkerApi } from './api';
+import { runRoute, WorkerApiError } from './api';
+
+interface LeaseReply {
+  leaseExpiresAt: string;
+  status: string;
+}
+
+// Leave room for the runner's 3s SIGTERM-to-SIGKILL escalation before the
+// server expires the lease and admits another user's process.
+const TERMINATION_ALLOWANCE_MS = 5000;
+
+/** The local expiry timer is independent of a slow or disconnected HTTP call. */
+export class RunLease {
+  readonly controller = new AbortController();
+  private expiry?: ReturnType<typeof setTimeout>;
+  private readonly polling = new AbortController();
+  private loop?: Promise<void>;
+  status: 'cancelled' | 'interrupted' | undefined;
+
+  constructor(
+    private readonly api: WorkerApi,
+    private readonly operationId: string,
+    private readonly token: string,
+    expiresAt: string,
+    private readonly onStop: () => void,
+  ) {
+    this.renew(expiresAt);
+  }
+
+  private renew(expiresAt: string) {
+    const remaining = Date.parse(expiresAt) - Date.now() - TERMINATION_ALLOWANCE_MS;
+    if (!Number.isFinite(remaining) || remaining <= 0) return this.stop('interrupted');
+    clearTimeout(this.expiry);
+    this.expiry = setTimeout(() => this.stop('interrupted'), remaining);
+  }
+
+  stop(status: 'cancelled' | 'interrupted') {
+    if (this.controller.signal.aborted) return;
+    this.status = status;
+    this.controller.abort(new Error(`Run ${status}`));
+    this.polling.abort();
+    clearTimeout(this.expiry);
+    this.onStop();
+  }
+
+  start(intervalMs = 2000) {
+    this.loop = (async () => {
+      while (!this.polling.signal.aborted) {
+        try {
+          const reply = await this.api.post<LeaseReply>(
+            runRoute(this.operationId, 'heartbeat'),
+            { leaseToken: this.token },
+            this.polling.signal,
+          );
+          if (reply.status === 'running') this.renew(reply.leaseExpiresAt);
+          else
+            this.stop(
+              ['cancelling', 'cancelled'].includes(reply.status) ? 'cancelled' : 'interrupted',
+            );
+        } catch (error) {
+          if (error instanceof WorkerApiError && error.status < 500 && error.status !== 429) {
+            this.stop('interrupted');
+          }
+          // Keep the previous deadline on network failure. Never infer a renewal.
+        }
+        try {
+          await delay(intervalMs, undefined, { signal: this.polling.signal });
+        } catch {
+          break;
+        }
+      }
+    })();
+  }
+
+  async close() {
+    this.polling.abort();
+    clearTimeout(this.expiry);
+    await this.loop;
+  }
+}
