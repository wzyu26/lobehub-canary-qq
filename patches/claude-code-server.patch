+import { describe, expect, it } from 'vitest';
+
+import {
+  assertAssistantArgs,
+  assertAssistantSessionId,
+  buildAssistantEnvironment,
+} from './assistantIntegration';
+
+const isolatedEnv = { CLAUDE_CONFIG_DIR: '/home/claude/.claude', HOME: '/home/claude' };
+
+describe('assistant integration environment', () => {
+  it('preserves the private official login directories without introducing API credentials', () => {
+    expect(buildAssistantEnvironment({ ...isolatedEnv, PATH: '/usr/local/bin:/usr/bin' })).toEqual({
+      ...isolatedEnv,
+      CLAUDE_CODE_DISABLE_AUTO_MEMORY: '1',
+      CLAUDE_CODE_RESUME_INTERRUPTED_TURN: '0',
+      DISABLE_AUTOUPDATER: '1',
+      DISABLE_UPDATES: '1',
+      MCP_CONNECTION_NONBLOCKING: 'false',
+      PATH: '/usr/local/bin:/usr/bin',
+    });
+  });
+
+  it.each([
+    'ANTHROPIC_API_KEY',
+    'ANTHROPIC_AUTH_TOKEN',
+    'ANTHROPIC_BASE_URL',
+    'ANTHROPIC_PROFILE',
+    'CLAUDE_CODE_OAUTH_TOKEN',
+    'CLAUDE_CODE_USE_BEDROCK',
+    'CLAUDE_CODE_SIMPLE',
+    'OPENAI_API_KEY',
+    'LOBEHUB_JWT',
+    'NODE_OPTIONS',
+    'BASH_ENV',
+    'HTTP_PROXY',
+    'CLAUDE_CODE_RESUME_INTERRUPTED_TURN',
+    'CLAUDE_CODE_DISABLE_AUTO_MEMORY',
+  ])('rejects explicit %s without disclosing its value', (key) => {
+    let error: unknown;
+    try {
+      buildAssistantEnvironment({ ...isolatedEnv, [key]: 'private-value' });
+    } catch (caught) {
+      error = caught;
+    }
+    expect(error).toBeInstanceOf(Error);
+    expect((error as Error).message).toContain(key);
+    expect((error as Error).message).not.toContain('private-value');
+  });
+
+  it.each(['HOME', 'CLAUDE_CONFIG_DIR'])('requires an explicit absolute %s', (key) => {
+    expect(() => buildAssistantEnvironment({ ...isolatedEnv, [key]: '' })).toThrow(key);
+    expect(() => buildAssistantEnvironment({ ...isolatedEnv, [key]: 'relative' })).toThrow(key);
+  });
+});
+
+describe('assistant integration arguments', () => {
+  it('accepts model, prepared context and the operation-scoped MCP configuration', () => {
+    expect(() =>
+      assertAssistantArgs([
+        '--model',
+        'default',
+        '--system-prompt',
+        'Prepared assistant instructions',
+        '--mcp-config={"mcpServers":{}}',
+        '--session-id=11111111-2222-3333-4444-555555555555',
+      ]),
+    ).not.toThrow();
+  });
+
+  it.each([
+    '--bare',
+    '--setting-sources=user',
+    '--settings={"apiKeyHelper":"get-key"}',
+    '--plugin-dir',
+    '--add-dir',
+    '--continue',
+    '--resume',
+    '--permission-mode',
+    '--fallback-model',
+  ])('rejects %s rather than allowing an isolation override', (flag) => {
+    expect(() => assertAssistantArgs([flag, 'value'])).toThrow('Unsupported');
+  });
+
+  it('rejects missing values and flag injection through optional CLI arguments', () => {
+    expect(() => assertAssistantArgs(['--model'])).toThrow('requires a value');
+    expect(() => assertAssistantArgs(['--model', '--bare'])).toThrow('requires a value');
+    expect(() => assertAssistantArgs(['--session-id=--continue'])).toThrow();
+  });
+
+  it('accepts only explicit run UUIDs, never names or transcript paths', () => {
+    expect(() => assertAssistantSessionId('11111111-2222-3333-4444-555555555555')).not.toThrow();
+    for (const value of ['latest', '../another-user/transcript.jsonl', '--continue', '']) {
+      expect(() => assertAssistantSessionId(value)).toThrow('server-assigned UUID');
+    }
+  });
+});
