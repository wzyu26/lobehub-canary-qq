+import { mkdtemp, rm } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import type { WorkerApi } from './api';
+import { discoverClaudeModels, readClaudeAuthStatus } from './claudeStatus';
+import { runOperation } from './runner';
+import { serveWorker } from './service';
+import { testClaim, testConfig } from './testUtils';
+
+vi.mock('./claudeStatus', () => ({ readClaudeAuthStatus: vi.fn(), discoverClaudeModels: vi.fn() }));
+vi.mock('./runner', () => ({ runOperation: vi.fn() }));
+vi.mock('@lobechat/heterogeneous-agents/builtinMcp', () => ({
+  LobeBuiltinMcpServer: class {
+    async start() {}
+    async stop() {}
+  },
+}));
+
+describe('worker service admission and health', () => {
+  let root: string;
+  beforeEach(async () => {
+    root = await mkdtemp(path.join(os.tmpdir(), 'worker-service-'));
+    if (process.getuid) vi.spyOn(process, 'getuid').mockReturnValue(10001);
+    vi.mocked(discoverClaudeModels).mockResolvedValue([{ id: 'default', label: 'Default' }]);
+  });
+  afterEach(async () => {
+    vi.restoreAllMocks();
+    vi.clearAllMocks();
+    await rm(root, { force: true, recursive: true });
+  });
+
+  it('keeps binding heartbeat alive during a long run without claiming a second task', async () => {
+    vi.mocked(readClaudeAuthStatus).mockResolvedValue('logged_in');
+    vi.mocked(runOperation).mockImplementation(
+      async (_claim, { signal }) =>
+        new Promise((resolve) => {
+          signal.addEventListener('abort', () => resolve(), { once: true });
+        }),
+    );
+    const shutdown = new AbortController();
+    const post = vi.fn(async (route: string) => (route === '/claim' ? testClaim() : { ok: true }));
+    const active = serveWorker(testConfig(root), { post } as WorkerApi, shutdown.signal);
+    try {
+      await vi.waitFor(() => expect(runOperation).toHaveBeenCalledTimes(1));
+      await vi.waitFor(() =>
+        expect(
+          post.mock.calls.filter(([route]) => route === '/heartbeat').length,
+        ).toBeGreaterThanOrEqual(2),
+      );
+      expect(post.mock.calls.filter(([route]) => route === '/claim')).toHaveLength(1);
+    } finally {
+      shutdown.abort();
+      await active;
+    }
+  });
+
+  it('reports login needed without discovering models or claiming billable work', async () => {
+    vi.mocked(readClaudeAuthStatus).mockResolvedValue('logged_out');
+    const shutdown = new AbortController();
+    const post = vi.fn(async () => ({ ok: true }));
+    const active = serveWorker(testConfig(root), { post } as WorkerApi, shutdown.signal);
+    await vi.waitFor(() => expect(post).toHaveBeenCalled());
+    expect(post).toHaveBeenCalledWith(
+      '/heartbeat',
+      expect.objectContaining({ authStatus: 'logged_out' }),
+      shutdown.signal,
+    );
+    expect(discoverClaudeModels).not.toHaveBeenCalled();
+    expect(runOperation).not.toHaveBeenCalled();
+    shutdown.abort();
+    await active;
+  });
+});
