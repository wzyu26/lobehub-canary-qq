+import { z } from 'zod';
+
+import { authedProcedure, router } from '@/libs/trpc/lambda';
+import { serverDatabase } from '@/libs/trpc/lambda/middleware';
+import { cancelClaudeCodeRun } from '@/server/services/claudeCode/cancel';
+import { getClaudeCodeStatus } from '@/server/services/claudeCode/status';
+
+const claudeCodeProcedure = authedProcedure.use(serverDatabase);
+
+export const claudeCodeRouter = router({
+  cancel: claudeCodeProcedure
+    .input(z.object({ operationId: z.string() }))
+    .mutation(async ({ ctx, input }) => {
+      const run = await cancelClaudeCodeRun({
+        db: ctx.serverDB,
+        operationId: input.operationId,
+        userId: ctx.userId,
+        workspaceId: ctx.workspaceId ?? undefined,
+      });
+      return { status: run?.status ?? 'not_found' };
+    }),
+  status: claudeCodeProcedure.query(({ ctx }) =>
+    getClaudeCodeStatus(ctx.serverDB, ctx.userId, ctx.workspaceId ?? undefined),
+  ),
+});
