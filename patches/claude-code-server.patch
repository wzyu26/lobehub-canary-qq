@@ -0,0 +1,83 @@
+import { mkdir } from 'node:fs/promises';
+import { setTimeout as delay } from 'node:timers/promises';
+
+import { LobeBuiltinMcpServer } from '@lobechat/heterogeneous-agents/builtinMcp';
+import {
+  CLAUDE_CODE_WORKER_PROTOCOL,
+  type ClaudeCodeWorkerClaim,
+} from '@lobechat/heterogeneous-agents/protocol';
+import type { ClaudeCodeAuthStatus, ClaudeCodeWorkerCapabilities } from '@lobechat/types';
+
+import type { WorkerApi } from './api';
+import { discoverClaudeModels, readClaudeAuthStatus } from './claudeStatus';
+import type { WorkerConfig } from './config';
+import { recoverRuns } from './outbox';
+import { runOperation } from './runner';
+
+/** One worker belongs to one user. Global admission is serialized by /claim. */
+export const serveWorker = async (config: WorkerConfig, api: WorkerApi, signal: AbortSignal) => {
+  if (process.getuid?.() === 0) throw new Error('Claude Code worker must run as a non-root user');
+  for (const directory of [config.home, config.configDir, config.workspaceDir, config.stateDir]) {
+    await mkdir(directory, { mode: 0o700, recursive: true });
+  }
+  const mcp = new LobeBuiltinMcpServer();
+  await mcp.start();
+  const capabilities: ClaudeCodeWorkerCapabilities = {
+    cliVersion: config.cliVersion,
+    protocolVersion: CLAUDE_CODE_WORKER_PROTOCOL,
+  };
+  const health: { authStatus: ClaudeCodeAuthStatus; lastHeartbeat: number } = {
+    authStatus: 'unknown',
+    lastHeartbeat: 0,
+  };
+  // Binding health must keep flowing while a long run is consuming /claim.
+  const heartbeats = (async () => {
+    while (!signal.aborted) {
+      try {
+        health.authStatus = await readClaudeAuthStatus(config);
+        if (health.authStatus === 'logged_in' && !capabilities.models) {
+          capabilities.models = await discoverClaudeModels(config);
+        } else if (health.authStatus !== 'logged_in') capabilities.models = undefined;
+        await api.post('/heartbeat', { authStatus: health.authStatus, capabilities }, signal);
+        health.lastHeartbeat = Date.now();
+      } catch {
+        health.lastHeartbeat = 0;
+        if (!signal.aborted) console.error('Worker login or health check unavailable');
+      }
+      try {
+        await delay(config.heartbeatIntervalMs, undefined, { signal });
+      } catch {
+        break;
+      }
+    }
+  })();
+  try {
+    while (!signal.aborted) {
+      try {
+        // Finish every saved operation before taking new work. Recovery has no
+        // path to spawnAgent, and cannot repeat a previous model/tool execution.
+        await recoverRuns(config.stateDir, api, signal);
+        if (
+          health.authStatus === 'logged_in' &&
+          capabilities.models &&
+          Date.now() - health.lastHeartbeat < 30_000
+        ) {
+          const claim = await api.post<ClaudeCodeWorkerClaim | null>('/claim', {}, signal);
+          if (claim) await runOperation(claim, { api, config, mcp, signal });
+        }
+      } catch {
+        // Keep diagnostics free of prompts, account identifiers and credentials.
+        if (!signal.aborted)
+          console.error('Worker cycle failed; queued work and local receipts are retained');
+      }
+      try {
+        await delay(config.pollIntervalMs, undefined, { signal });
+      } catch {
+        break;
+      }
+    }
+  } finally {
+    await heartbeats;
+    await mcp.stop();
+  }
+};
