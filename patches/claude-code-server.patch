+
+export interface ClaudeCodeEnqueueInput {
+  operationId: string;
+  preparedRequest: ClaudeCodePreparedRequest;
+  requestId: string;
+  threadId?: string;
+  topicId: string;
+}
+
+export interface ClaudeCodeToolCallInput {
+  arguments: Record<string, unknown>;
+  name: string;
+  toolCallId: string;
+}
