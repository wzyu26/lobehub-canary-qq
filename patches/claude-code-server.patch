+
+describe('Claude Code internal worker boundary', () => {
+  it('rejects missing service credentials before reading any worker binding', async () => {
+    const response = await post('/claim', {}, { authorization: '' });
+    expect(response.status).toBe(401);
+    expect(mock.resolve).not.toHaveBeenCalled();
+  });
+
+  it('hashes service credentials and never trusts user identity in the body', async () => {
+    mock.tool.mockResolvedValue({ status: 'completed' });
+    const response = await post('/runs/run-a/tool', {
+      args: {},
+      leaseToken: secret,
+      name: 'write',
+      toolCallId: 'tool-a',
+      userId: 'victim',
+    });
+    expect(response.status).toBe(400);
+    expect(mock.resolve.mock.calls[0][2]).not.toBe(secret);
+    expect(mock.tool).not.toHaveBeenCalled();
+  });
+
+  it('does not dispatch a run assigned to another worker', async () => {
+    mock.getRun.mockResolvedValue({ workerId: 'worker-b' });
+    const response = await post('/runs/other/tool', {
+      args: {},
+      leaseToken: secret,
+      name: 'write',
+      toolCallId: 'a',
+    });
+    expect(response.status).toBe(404);
+    expect(mock.tool).not.toHaveBeenCalled();
+  });
+
+  it('leaves new dispatch disabled by the feature flag', async () => {
+    mock.enabled = false;
+    expect(await (await post('/claim')).json()).toBeNull();
+    expect(mock.claim).not.toHaveBeenCalled();
+  });
+
+  it('claims with a fresh lease and returns only the prepared public request', async () => {
+    mock.claim.mockResolvedValue({
+      leaseExpiresAt: new Date('2030-01-01'),
+      operationId: 'run-a',
+      preparedRequest: { request: { prompt: 'hello' }, state: { providerSecret: 'private' } },
+    });
+    const response = await post('/claim');
+    const body = await response.json();
+    expect(body.request).toEqual({ prompt: 'hello' });
+    expect(JSON.stringify(body)).not.toContain('private');
+    expect(body.leaseToken).toHaveLength(64);
+    expect(mock.prepare).toHaveBeenCalledWith(
+      expect.objectContaining({
+        userId: 'owner',
+        run: expect.objectContaining({ operationId: 'run-a' }),
+      }),
+    );
+  });
+
+  it('does not hand a queued snapshot to the worker when current preparation fails', async () => {
+    mock.claim.mockResolvedValue({ operationId: 'run-a', preparedRequest: { state: {} } });
+    mock.prepare.mockRejectedValue(new Error('Workspace access has been revoked'));
+    expect(await (await post('/claim')).json()).toBeNull();
+    expect(mock.finish).toHaveBeenCalledWith(
+      expect.objectContaining({ operationId: 'run-a', status: 'error' }),
+    );
+  });
+
+  it('interrupts an abandoned pre-execution claim without returning its context', async () => {
+    const controller = new AbortController();
+    mock.claim.mockResolvedValue({ operationId: 'run-a', preparedRequest: { state: {} } });
+    let started!: () => void;
+    const preparing = new Promise<void>((resolve) => {
+      started = resolve;
+    });
+    mock.prepare.mockImplementation(() => {
+      started();
+      return new Promise(() => {});
+    });
+    const response = app.request('/api/claude-code/worker/claim', {
+      body: '{}',
+      method: 'POST',
+      signal: controller.signal,
+      headers: {
+        'authorization': `Bearer ${secret}`,
+        'content-type': 'application/json',
+        'x-lobehub-worker-id': 'worker-a',
+      },
+    });
+    await preparing;
+    controller.abort();
+    expect(await (await response).json()).toBeNull();
+    expect(mock.finish).toHaveBeenCalledWith(
+      expect.objectContaining({ operationId: 'run-a', status: 'error' }),
+    );
+    expect(mock.prepare.mock.calls[0][0].signal.aborted).toBe(true);
+  });
+
+  it('does not accept events naming a different operation', async () => {
+    const response = await post('/runs/run-a/events', {
+      events: [
+        {
+          event: {
+            data: {},
+            operationId: 'victim',
+            stepIndex: 0,
+            timestamp: 1,
+            type: 'stream_start',
+          },
+          sequence: 1,
+        },
+      ],
+      leaseToken: secret,
+    });
+    expect(response.status).toBe(400);
+    expect(mock.append).not.toHaveBeenCalled();
+  });
+
+  it('persists events before projection and accepts completion while entry is disabled', async () => {
+    mock.append.mockResolvedValue({ acceptedSequence: 1 });
+    const event = {
+      data: { content: 'hello' },
+      operationId: 'run-a',
+      stepIndex: 0,
+      timestamp: 1,
+      type: 'stream_chunk',
+    };
+    expect(
+      (await post('/runs/run-a/events', { events: [{ event, sequence: 1 }], leaseToken: secret }))
+        .status,
+    ).toBe(200);
+    expect(mock.append).toHaveBeenCalledWith('run-a', secret, [{ payload: event, sequence: 1 }]);
+    expect(mock.append.mock.invocationCallOrder[0]).toBeLessThan(
+      mock.project.mock.invocationCallOrder[0],
+    );
+    mock.enabled = false;
+    mock.finish.mockResolvedValue({ status: 'completed' });
+    expect(
+      (await post('/runs/run-a/finish', { leaseToken: secret, status: 'completed' })).status,
+    ).toBe(200);
+    expect(mock.finish).toHaveBeenCalledWith(
+      expect.objectContaining({ userId: 'owner', workspaceId: 'workspace-a' }),
+    );
+  });
+});
diff --git a/apps/server/src/router-hono/claude-code/index.ts b/apps/server/src/router-hono/claude-code/index.ts
new file mode 100644
index 0000000000..ce2a0b3185
--- /dev/null
+++ b/apps/server/src/router-hono/claude-code/index.ts
@@ -0,0 +1,201 @@
+import { createHash, randomBytes } from 'node:crypto';
+
+import type { AgentInterventionRequestData } from '@lobechat/agent-gateway-client';
+import { Hono } from 'hono';
+import { bodyLimit } from 'hono/body-limit';
+import { ZodError } from 'zod';
+
+import { getServerDB } from '@/database/core/db-adaptor';
+import { ClaudeCodeModel, ClaudeCodeStateError } from '@/database/models/claudeCode';
+import type { LobeChatDatabase } from '@/database/type';
+import { finishClaudeCodeRun } from '@/server/services/claudeCode/finish';
+import { waitClaudeCodeIntervention } from '@/server/services/claudeCode/interventionBridge';
+import { prepareClaimedClaudeCodeRun } from '@/server/services/claudeCode/prepareClaim';
+import { projectClaudeCodeEvents } from '@/server/services/claudeCode/projectEvents';
+import { recoverClaudeCodeRuns } from '@/server/services/claudeCode/recover';
+import { isClaudeCodeServerEnabled } from '@/server/services/claudeCode/status';
+import { executeClaudeCodeTool } from '@/server/services/claudeCode/toolBridge';
+
+import {
+  eventsBody,
+  finishBody,
+  interventionBody,
+  leaseBody,
+  toolBody,
+  workerStatusBody,
+} from './schema';
+
+interface WorkerScope {
+  db: LobeChatDatabase;
+  userId: string;
+  workerId: string;
+  workspaceId?: string;
+}
+
+/** Internal per-worker service credentials. No Claude credential is received. */
+export const claudeCodeWorkerApp = new Hono<{ Variables: { worker: WorkerScope } }>().basePath(
+  '/api/claude-code/worker',
+);
+const app = claudeCodeWorkerApp;
+
+app.use('*', bodyLimit({ maxSize: 16 * 1024 * 1024 }));
+app.use('*', async (c, next) => {
+  const workerId = c.req.header('x-lobehub-worker-id');
+  const authorization = c.req.header('authorization');
+  const token = authorization?.startsWith('Bearer ') ? authorization.slice(7) : '';
+  if (!workerId || workerId.length > 256 || token.length < 32 || token.length > 256)
+    return c.json({ error: 'Unauthorized worker' }, 401);
+  const db = await getServerDB();
+  const binding = await ClaudeCodeModel.resolveWorker(
+    db,
+    workerId,
+    createHash('sha256').update(token).digest('hex'),
+  );
+  if (!binding) return c.json({ error: 'Unauthorized worker' }, 401);
+  c.set('worker', {
+    db,
+    userId: binding.userId,
+    workerId,
+    workspaceId: binding.workspaceId ?? undefined,
+  });
+  await next();
+});
+
+app.use('/runs/:operationId/*', async (c, next) => {
+  const scope = c.get('worker');
+  const run = await new ClaudeCodeModel(scope.db, scope.userId, scope.workspaceId).getRun(
+    c.req.param('operationId'),
+  );
+  if (!run || run.workerId !== scope.workerId) return c.json({ error: 'Run not found' }, 404);
+  await next();
+});
+
+app.onError((error, c) => {
+  if (error instanceof ZodError || error instanceof SyntaxError)
+    return c.json({ error: 'Invalid worker request' }, 400);
+  if (error instanceof ClaudeCodeStateError)
+    return c.json({ code: error.code, error: error.message }, 409);
+  // Never return or log DB exceptions containing bound context or service secrets.
+  return c.json({ error: 'Claude Code service request failed' }, 500);
+});
+
+app.post('/heartbeat', async (c) => {
+  const scope = c.get('worker');
+  await new ClaudeCodeModel(scope.db, scope.userId, scope.workspaceId).updateWorkerStatus(
+    scope.workerId,
+    workerStatusBody.parse(await c.req.json()),
+  );
+  await recoverClaudeCodeRuns(scope.db);
+  return c.json({ ok: true });
+});
+
+app.post('/claim', async (c) => {
+  if (!isClaudeCodeServerEnabled()) return c.json(null);
+  const scope = c.get('worker');
+  const leaseToken = randomBytes(32).toString('hex');
+  const model = new ClaudeCodeModel(scope.db, scope.userId, scope.workspaceId);
+  let run = await model.claimNextRun(scope.workerId, leaseToken);
+  if (!run) return c.json(null);
+  const operationId = run.operationId;
+  // Preparation may resolve files and tools for longer than one lease interval.
+  // This only keeps the reservation alive; no CLI process has started yet.
+  const timer = setInterval(() => {
+    void model.heartbeat(operationId, leaseToken).catch(() => {});
+  }, 10_000);
+  const preparationSignal = AbortSignal.any([c.req.raw.signal, AbortSignal.timeout(90_000)]);
+  let abortPreparation: () => void = () => {};
+  const aborted = new Promise<never>((_resolve, reject) => {
+    abortPreparation = () =>
+      reject(new Error('Claude Code context preparation was interrupted or timed out'));
+    if (preparationSignal.aborted) abortPreparation();
+    else preparationSignal.addEventListener('abort', abortPreparation, { once: true });
+  });
+  try {
+    run = await Promise.race([
+      prepareClaimedClaudeCodeRun({ ...scope, leaseToken, run, signal: preparationSignal }),
+      aborted,
+    ]);
+    preparationSignal.throwIfAborted();
+    return c.json({
+      leaseExpiresAt: run.leaseExpiresAt!.toISOString(),
+      leaseToken,
+      operationId,
+      request: run.preparedRequest.request,
+    });
+  } catch (error) {
+    await finishClaudeCodeRun({
+      ...scope,
+      leaseToken,
+      operationId,
+      status: 'error',
+      error: error instanceof Error ? error.message : 'Could not prepare current assistant context',
+    });
+    return c.json(null);
+  } finally {
+    clearInterval(timer);
+    preparationSignal.removeEventListener('abort', abortPreparation);
+  }
+});
+
+app.post('/runs/:operationId/heartbeat', async (c) => {
+  const scope = c.get('worker');
+  const operationId = c.req.param('operationId');
+  const model = new ClaudeCodeModel(scope.db, scope.userId, scope.workspaceId);
+  const current = await model.getRun(operationId);
+  if (current && !['running', 'cancelling'].includes(current.status))
+    return c.json({ status: current.status });
+  const run = await model.heartbeat(operationId, leaseBody.parse(await c.req.json()).leaseToken);
+  await projectClaudeCodeEvents({ ...scope, operationId });
+  return c.json({ leaseExpiresAt: run.leaseExpiresAt?.toISOString(), status: run.status });
+});
+
+app.post('/runs/:operationId/events', async (c) => {
+  const scope = c.get('worker');
+  const operationId = c.req.param('operationId');
+  const { events, leaseToken } = eventsBody.parse(await c.req.json());
+  if (events.some(({ event }) => event.operationId !== operationId))
+    return c.json({ error: 'Event belongs to another run' }, 400);
+  const result = await new ClaudeCodeModel(scope.db, scope.userId, scope.workspaceId).appendEvents(
+    operationId,
+    leaseToken,
+    events.map(({ event, sequence }) => ({ payload: event, sequence })),
+  );
+  await projectClaudeCodeEvents({ ...scope, operationId });
+  return c.json(result);
+});
+
+app.post('/runs/:operationId/tool', async (c) =>
+  c.json(
+    await executeClaudeCodeTool({
+      ...c.get('worker'),
+      ...toolBody.parse(await c.req.json()),
+      operationId: c.req.param('operationId'),
+    }),
+  ),
+);
+
+app.post('/runs/:operationId/intervention', async (c) => {
+  const body = interventionBody.parse(await c.req.json());
+  return c.json(
+    await waitClaudeCodeIntervention({
+      ...c.get('worker'),
+      ...body,
+      operationId: c.req.param('operationId'),
+      maxWaitMs: 15_000,
+      request: body.request as AgentInterventionRequestData,
+      signal: c.req.raw.signal,
+    }),
+  );
+});
+
+app.post('/runs/:operationId/finish', async (c) =>
+  c.json(
+    await finishClaudeCodeRun({
+      ...c.get('worker'),
+      ...finishBody.parse(await c.req.json()),
+      operationId: c.req.param('operationId'),
+    }),
+  ),
+);
+
+export default app;
