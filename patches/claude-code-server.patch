+export type ClaudeCodeRunStatus =
+  'queued' | 'running' | 'cancelling' | 'completed' | 'error' | 'cancelled' | 'interrupted';
+
+export type ClaudeCodeToolReceiptStatus = 'started' | 'completed' | 'interrupted';
+
+/** Server-prepared context. Never include provider credentials or Claude credentials. */
+export type ClaudeCodePreparedRequest = Record<string, unknown>;
