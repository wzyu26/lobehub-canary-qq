diff --git a/apps/claude-code-worker/src/claudeStatus.ts b/apps/claude-code-worker/src/claudeStatus.ts
new file mode 100644
index 0000000000..7a006c575e
--- /dev/null
+++ b/apps/claude-code-worker/src/claudeStatus.ts
@@ -0,0 +1,138 @@
+import { execFile, spawn } from 'node:child_process';
+import { randomUUID } from 'node:crypto';
+import { promisify } from 'node:util';
+
+import { buildAssistantEnvironment } from '@lobechat/heterogeneous-agents/spawn';
+import type { ClaudeCodeAuthStatus, ClaudeCodeWorkerCapabilities } from '@lobechat/types';
+
+import type { WorkerConfig } from './config';
+import { workerCliEnvironment } from './config';
+
+const execute = promisify(execFile);
+
+export const parseAuthStatus = (value: unknown): ClaudeCodeAuthStatus => {
+  if (!value || typeof value !== 'object') return 'unknown';
+  const status = value as { authMethod?: string; loggedIn?: boolean };
+  if (status.loggedIn === false || status.authMethod === 'none') return 'logged_out';
+  // A stored API key, provider profile or externally supplied OAuth token is
+  // never silently accepted as this worker's official per-user subscription.
+  return status.loggedIn === true && status.authMethod === 'claude.ai' ? 'logged_in' : 'unknown';
+};
+
+export const readClaudeAuthStatus = async (config: WorkerConfig): Promise<ClaudeCodeAuthStatus> => {
+  try {
+    const { stdout } = await execute(config.cliCommand, ['auth', 'status'], {
+      env: buildAssistantEnvironment(workerCliEnvironment(config)),
+      maxBuffer: 128 * 1024,
+      timeout: 15_000,
+    });
+    return parseAuthStatus(JSON.parse(stdout));
+  } catch (error) {
+    const failure = error as { code?: number; stdout?: string };
+    if (failure.stdout) {
+      try {
+        return parseAuthStatus(JSON.parse(failure.stdout));
+      } catch {
+        return 'unknown';
+      }
+    }
+    return failure.code === 1 ? 'logged_out' : 'unknown';
+  }
+};
+
+export const parseModelCatalog = (
+  value: unknown,
+): NonNullable<ClaudeCodeWorkerCapabilities['models']> => {
+  if (!Array.isArray(value)) throw new Error('CLI initialization returned no model catalog');
+  const models = value.map((row: unknown) => {
+    const model = row as { displayName?: unknown; value?: unknown };
+    if (typeof model?.value !== 'string' || typeof model.displayName !== 'string') {
+      throw new Error('Invalid CLI model catalog entry');
+    }
+    return { id: model.value, label: model.displayName };
+  });
+  // The CLI describes its account default separately from named aliases.
+  return models.some(({ id }) => id === 'default')
+    ? models
+    : [{ id: 'default', label: 'Default (Claude Code)' }, ...models];
+};
+
+/** Read the official initialization catalog without submitting a model prompt. */
+export const discoverClaudeModels = async (
+  config: WorkerConfig,
+): Promise<NonNullable<ClaudeCodeWorkerCapabilities['models']>> => {
+  const env = buildAssistantEnvironment(workerCliEnvironment(config));
+  const { stdout } = await execute(config.cliCommand, ['--version'], { env, timeout: 10_000 });
+  if (stdout.match(/\d+\.\d+\.\d+/)?.[0] !== config.cliVersion) {
+    throw new Error('Installed Claude Code version differs from the worker build');
+  }
+  const requestId = randomUUID();
+  const child = spawn(
+    config.cliCommand,
+    [
+      '-p',
+      '--input-format',
+      'stream-json',
+      '--output-format',
+      'stream-json',
+      '--verbose',
+      '--permission-prompt-tool',
+      'stdio',
+      '--setting-sources',
+      '',
+      '--strict-mcp-config',
+      '--mcp-config',
+      '{"mcpServers":{}}',
+    ],
+    { cwd: config.workspaceDir, env, stdio: ['pipe', 'pipe', 'pipe'] },
+  );
+  try {
+    return await new Promise((resolve, reject) => {
+      let buffered = '';
+      const timeout = setTimeout(() => reject(new Error('CLI model discovery timed out')), 15_000);
+      const complete = (
+        error?: Error,
+        models?: NonNullable<ClaudeCodeWorkerCapabilities['models']>,
+      ) => {
+        clearTimeout(timeout);
+        if (error) reject(error);
+        else resolve(models!);
+      };
+      child.once('error', complete);
+      child.once('exit', () =>
+        complete(new Error('CLI exited before returning its model catalog')),
+      );
+      child.stderr.resume();
+      child.stdout.on('data', (chunk: Buffer) => {
+        buffered += chunk.toString();
+        if (buffered.length > 2 * 1024 * 1024)
+          return complete(new Error('CLI discovery output too large'));
+        let newline: number;
+        while ((newline = buffered.indexOf('\n')) !== -1) {
+          const line = buffered.slice(0, newline);
+          buffered = buffered.slice(newline + 1);
+          try {
+            const message = JSON.parse(line);
+            if (message.type !== 'control_response' || message.response?.request_id !== requestId)
+              continue;
+            if (message.response.subtype !== 'success')
+              return complete(new Error('CLI initialization failed'));
+            complete(undefined, parseModelCatalog(message.response.response?.models));
+          } catch {
+            complete(new Error('CLI returned an invalid model catalog'));
+          }
+        }
+      });
+      child.stdin.write(
+        `${JSON.stringify({
+          request: { subtype: 'initialize' },
+          request_id: requestId,
+          type: 'control_request',
+        })}\n`,
+      );
+    });
+  } finally {
+    child.stdin.end();
+    if (child.exitCode === null && child.signalCode === null) child.kill('SIGKILL');
+  }
+};
