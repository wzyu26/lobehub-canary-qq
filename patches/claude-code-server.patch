+import type { ChildProcess, SpawnOptions } from 'node:child_process';
+import * as childProcess from 'node:child_process';
+import { EventEmitter } from 'node:events';
+import type * as os from 'node:os';
+import { PassThrough } from 'node:stream';
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { spawnAgent, type SpawnAgentOptions } from './spawnAgent';
+
+vi.mock('node:child_process', async (importOriginal) => ({
+  ...(await importOriginal<typeof childProcess>()),
+  spawn: vi.fn(),
+}));
+
+vi.mock('node:os', async (importOriginal) => ({
+  ...(await importOriginal<typeof os>()),
+  platform: () => 'linux',
+}));
+
+const privateEnv = { CLAUDE_CONFIG_DIR: '/home/claude/.claude', HOME: '/home/claude' };
+const assistantOptions: SpawnAgentOptions = {
+  agentType: 'claude-code',
+  env: privateEnv,
+  integrationMode: 'lobehub-assistant',
+  operationId: 'op-assistant',
+  prompt: 'Use my ordinary assistant instructions',
+};
+
+const spawn = vi.mocked(childProcess.spawn);
+
+const createProc = () => {
+  const input: string[] = [];
+  const stdin = new PassThrough();
+  stdin.on('data', (chunk: Buffer) => input.push(chunk.toString()));
+  const proc = Object.assign(new EventEmitter(), {
+    exitCode: null as number | null,
+    kill: vi.fn(() => true),
+    killed: false,
+    pid: 12345,
+    signalCode: null as NodeJS.Signals | null,
+    stderr: new PassThrough(),
+    stdin,
+    stdout: new PassThrough(),
+  });
+  return { input, proc };
+};
+
+const run = async (options: SpawnAgentOptions) => {
+  const fake = createProc();
+  spawn.mockReturnValue(fake.proc as unknown as ChildProcess);
+  const handle = await spawnAgent(options);
+  const drain = (async () => {
+    for await (const _event of handle.events);
+  })();
+  fake.proc.stdout.end();
+  fake.proc.stderr.end();
+  fake.proc.exitCode = 0;
+  fake.proc.emit('exit', 0, null);
+  await drain;
+  const call = spawn.mock.calls.at(-1)!;
+  return {
+    args: call[1] as string[],
+    env: (call[2] as SpawnOptions).env!,
+    input: JSON.parse(fake.input.join('')),
+  };
+};
+
+describe('spawnAgent ordinary assistant integration', () => {
+  beforeEach(() => spawn.mockReset());
+  afterEach(() => vi.unstubAllEnvs());
+
+  it('starts with only private runtime settings despite API and lh credentials in the host', async () => {
+    vi.stubEnv('ANTHROPIC_API_KEY', 'host-api-secret');
+    vi.stubEnv('ANTHROPIC_BASE_URL', 'https://host-provider.invalid');
+    vi.stubEnv('CLAUDE_CODE_OAUTH_TOKEN', 'other-account-token');
+    vi.stubEnv('CLAUDE_CODE_DISABLE_AUTO_MEMORY', '0');
+    vi.stubEnv('LOBEHUB_JWT', 'host-lobe-token');
+    vi.stubEnv('LOBEHUB_TOPIC_ID', 'other-topic');
+    vi.stubEnv('HOME', '/another-user');
+    vi.stubEnv('UNRELATED_HOST_VARIABLE', 'must-not-inherit');
+
+    const result = await run({
+      ...assistantOptions,
+      extraArgs: ['--model', 'default', '--mcp-config', '/run/operation-mcp.json'],
+    });
+
+    expect(result.env.HOME).toBe('/home/claude');
+    expect(result.env.CLAUDE_CONFIG_DIR).toBe('/home/claude/.claude');
+    expect(result.env.CLAUDE_CODE_DISABLE_AUTO_MEMORY).toBe('1');
+    expect(result.env.CLAUDE_CODE_DISABLE_CLAUDE_MDS).toBeUndefined();
+    expect(JSON.stringify(result.env)).not.toMatch(
+      /host-api|host-provider|other-account|host-lobe/,
+    );
+    expect(result.env.UNRELATED_HOST_VARIABLE).toBeUndefined();
+    expect(result.env.LOBEHUB_TOPIC_ID).toBeUndefined();
+    expect(result.args).toContain('--strict-mcp-config');
+    expect(result.args[result.args.indexOf('--setting-sources') + 1]).toBe('');
+    expect(result.args).not.toContain('--bare');
+    expect(result.args).not.toContain('--plugin-dir');
+    expect(result.input.message.content).toEqual([{ text: assistantOptions.prompt, type: 'text' }]);
+  });
+
+  it('keeps the original environment behavior unless isolation is requested', async () => {
+    vi.stubEnv('ANTHROPIC_API_KEY', 'existing-api-secret');
+    vi.stubEnv('CLAUDE_CODE_DISABLE_AUTO_MEMORY', '0');
+    const result = await run({
+      ...assistantOptions,
+      env: { MCP_CONNECTION_NONBLOCKING: 'true' },
+      integrationMode: undefined,
+    });
+    expect(result.env.ANTHROPIC_API_KEY).toBe('existing-api-secret');
+    expect(result.env.CLAUDE_CODE_DISABLE_AUTO_MEMORY).toBe('0');
+    expect(result.env.MCP_CONNECTION_NONBLOCKING).toBe('true');
+    expect(result.args).not.toContain('--strict-mcp-config');
+    expect(result.args).not.toContain('--setting-sources');
+  });
+
+  it('can explicitly disable inheritance for an existing JSONL integration', async () => {
+    vi.stubEnv('ANTHROPIC_API_KEY', 'host-api-secret');
+    const result = await run({
+      ...assistantOptions,
+      env: { PATH: '/usr/bin' },
+      inheritEnv: false,
