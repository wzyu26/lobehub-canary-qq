@@ -0,0 +1,87 @@
+// @vitest-environment node
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { ClaudeCodeModel } from '@/database/models/claudeCode';
+import { agentOperations, claudeCodeRuns, topics } from '@/database/schemas';
+
+import { recoverClaudeCodeRuns } from '../recover';
+import { db, leaseToken, model, other, owner, prepareRows, resetRows, running } from './testUtils';
+
+const settle = vi.hoisted(() => vi.fn());
+vi.mock('../finish', () => ({ settleClaudeCodeRun: settle }));
+
+describe('Claude Code restart recovery scope', () => {
+  beforeEach(async () => {
+    vi.resetAllMocks();
+    await prepareRows();
+  });
+  afterEach(resetRows);
+
+  it('recovers only the caller scope and unsettled terminal rows without rerunning work', async () => {
+    await running('already-settled');
+    await model().finishRun('already-settled', leaseToken, { status: 'completed' });
+    await model().withProjectionState('already-settled', async () => ({ settled: true }));
+    await running('unfinished-settlement');
+    await model().finishRun('unfinished-settlement', leaseToken, { status: 'error' });
+
+    const foreign = new ClaudeCodeModel(db, other);
+    await foreign.provisionBinding({ secretHash: 'a'.repeat(64), workerId: 'foreign-worker' });
+    await db.insert(topics).values({ id: 'foreign-topic', userId: other });
+    await db.insert(agentOperations).values({
+      id: 'foreign-run',
+      status: 'running',
+      topicId: 'foreign-topic',
+      userId: other,
+    });
+    await db.insert(claudeCodeRuns).values({
+      operationId: 'foreign-run',
+      preparedRequest: {},
+      requestHash: 'foreign-hash',
+      requestId: 'foreign-request',
+      status: 'interrupted',
+      topicId: 'foreign-topic',
+      userId: other,
+      workerId: 'foreign-worker',
+    });
+
+    await recoverClaudeCodeRuns(db, { userId: owner, workspaceId: 'unrelated-workspace' });
+    expect(settle).not.toHaveBeenCalled();
+    await recoverClaudeCodeRuns(db, { userId: owner });
+    expect(settle).toHaveBeenCalledExactlyOnceWith({
+      db,
+      operationId: 'unfinished-settlement',
+      userId: owner,
+      workspaceId: undefined,
+    });
+    settle.mockClear();
+    await recoverClaudeCodeRuns(db);
+    expect(settle.mock.calls.map(([scope]) => scope.operationId).sort()).toEqual([
+      'foreign-run',
+      'unfinished-settlement',
+    ]);
+    expect(await db.select().from(claudeCodeRuns)).toHaveLength(3);
+    expect((await model().getRun('unfinished-settlement'))?.status).toBe('error');
+    expect(await model().claimNextRun('worker-projection', leaseToken)).toBeUndefined();
+  });
+
+  it('keeps processing other terminal runs when one journal needs another recovery attempt', async () => {
+    for (const id of ['failed-journal', 'healthy-journal']) {
+      await running(id);
+      await model().finishRun(id, leaseToken, { status: 'error' });
+    }
+    const warning = vi.spyOn(console, 'warn').mockImplementation(() => {});
+    settle
+      .mockRejectedValueOnce(new Error('Do not log sensitive context'))
+      .mockResolvedValueOnce(undefined);
+    try {
+      await expect(recoverClaudeCodeRuns(db, { userId: owner })).resolves.toBeUndefined();
+      expect(settle).toHaveBeenCalledTimes(2);
+      expect(warning).toHaveBeenCalledWith(
+        '[Claude Code] Run settlement requires retry:',
+        'failed-journal',
+      );
+    } finally {
+      warning.mockRestore();
+    }
+  });
+});
