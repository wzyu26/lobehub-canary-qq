+
+const deps = { db: {}, userId: 'user' } as TurnSetupDeps;
+
+describe('Claude Code ordinary topic model snapshot', () => {
+  it('keeps a model named claude-code on the ordinary server backend', async () => {
+    const config = {
+      id: 'agent',
+      model: 'claude-code',
+      provider: 'claude-code',
+    } as AgentConfigWithId;
+    expect(await resolveNewTopicSnapshot(deps, config)).toEqual({
+      metadata: undefined,
+      model: 'claude-code',
+      provider: 'claude-code',
+    });
+  });
+
+  it('keeps explicit heterogeneous entry model selection behavior', async () => {
+    const config = {
+      id: 'agent',
+      model: 'claude-code',
+      provider: 'claude-code',
+      agencyConfig: { heterogeneousProvider: { type: 'claude-code', model: 'opus' } },
+    } as AgentConfigWithId;
+    expect(await resolveNewTopicSnapshot(deps, config)).toMatchObject({
+      model: 'opus',
+      provider: 'claude-code',
+    });
+  });
+
+  it('preserves legacy bare-model inference for existing providers', async () => {
+    const config = {
+      id: 'agent',
+      model: 'claude-code',
+      provider: 'anthropic',
+    } as AgentConfigWithId;
+    expect(await resolveNewTopicSnapshot(deps, config)).toEqual({
+      metadata: undefined,
+      model: undefined,
+      provider: 'claude-code',
+    });
+  });
+});
