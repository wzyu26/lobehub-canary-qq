+import type { DocumentCommentSelectionAnchor } from '@lobechat/types';
+import { index, jsonb, pgTable, text, uuid } from 'drizzle-orm/pg-core';
+
+import { createdAt, updatedAt } from './_helpers';
+import { documents } from './file';
+import { users } from './user';
+
+export interface DocumentAiCommentMessage {
+  content: string;
+  createdAt: string;
+  /** Set on an assistant turn whose generation failed; `content` holds what arrived. */
+  error?: string;
+  model?: string;
+  provider?: string;
+  role: 'assistant' | 'user';
+}
+
+/**
+ * Private "ask AI about this passage" threads on a page. Each row is one thread
+ * anchored to a text selection; the assistant's answers are the comments.
+ *
+ * Kept apart from `document_comments`, which are human collaboration threads
+ * owned by a Workspace: these belong to one user, work on personal pages and
+ * are never shared with other members.
+ *
+ * Kept out of `documents.metadata` too: writing there bumps the document's
+ * `updated_at`, which the editor uses as its save precondition.
+ */
+export const documentAiComments = pgTable(
+  'document_ai_comments',
+  {
+    id: uuid('id').defaultRandom().notNull().primaryKey(),
+    userId: text('user_id')
+      .references(() => users.id, { onDelete: 'cascade' })
+      .notNull(),
+    documentId: text('document_id')
+      .references(() => documents.id, { onDelete: 'cascade' })
+      .notNull(),
+    /** Same text-quote anchor as `document_comments.selection_anchor`. */
+    selectionAnchor: jsonb('selection_anchor').$type<DocumentCommentSelectionAnchor>().notNull(),
+    messages: jsonb('messages').$type<DocumentAiCommentMessage[]>().notNull().default([]),
+    createdAt: createdAt(),
+    updatedAt: updatedAt(),
+  },
+  (t) => [index('document_ai_comments_document_id_user_id_idx').on(t.documentId, t.userId)],
+);
+
+export type DocumentAiCommentItem = typeof documentAiComments.$inferSelect;
+export type NewDocumentAiComment = typeof documentAiComments.$inferInsert;
