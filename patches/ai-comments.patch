+import { act, renderHook, waitFor } from '@testing-library/react';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { createStore } from '../store';
+import { useAICommentsState } from './useAICommentsState';
+
+const pageStore = vi.hoisted(() => ({ current: undefined as any }));
+vi.mock('../store', async (importOriginal) => {
+  const actual = await importOriginal<Record<string, unknown>>();
+  return {
+    ...actual,
+    usePageEditorStore: (selector: (s: any) => unknown) => pageStore.current(selector),
+  };
+});
+
+const service = vi.hoisted(() => ({
+  create: vi.fn(),
+  delete: vi.fn(),
+  list: vi.fn(),
+  updateMessages: vi.fn(),
+}));
+const chat = vi.hoisted(() => ({ fetchPresetTaskResult: vi.fn() }));
+
+vi.mock('@/services/documentAiComment', () => ({ documentAiCommentService: service }));
+vi.mock('@/services/chat', () => ({ chatService: chat }));
+vi.mock('@/store/agent', () => ({ getAgentStoreState: () => ({ activeAgentId: 'agent-1' }) }));
+vi.mock('@/store/agent/selectors', () => ({
+  agentByIdSelectors: {
+    getAgentModelById: () => () => 'test-model',
+    getAgentModelProviderById: () => () => 'test-provider',
+    isAgentHeterogeneousById: () => () => false,
+  },
+  builtinAgentSelectors: { pageAgentId: () => 'page-agent' },
+}));
+vi.mock('react-i18next', () => ({ useTranslation: () => ({ t: (key: string) => key }) }));
+
+const anchor = { end: 9, quote: 'brown', start: 4 };
+
+const body = () => {
+  const root = document.createElement('div');
+  root.innerHTML = '<p>the brown fox</p>';
+  return root;
+};
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  service.list.mockResolvedValue([]);
+  service.updateMessages.mockResolvedValue({});
+  const root = body();
+  pageStore.current = createStore({
+    editor: { getRootElement: () => root } as any,
+    title: 'Fox',
+  });
+});
+
+describe('useAICommentsState', () => {
+  it('saves the question, streams the answer and saves it under the new thread', async () => {
+    service.create.mockResolvedValue({ id: 'thread-1' });
+    chat.fetchPresetTaskResult.mockImplementation(async ({ onMessageHandle, onFinish, params }) => {
+      expect(params.model).toBe('test-model');
+      expect(params.provider).toBe('test-provider');
+      expect(params.messages[1].content).toContain('the <<<brown>>> fox');
+      expect(params.messages[1].content).toContain('pageEditor.aiComments.defaultQuestion');
+      onMessageHandle({ text: 'A ', type: 'text' });
+      onMessageHandle({ text: 'colour.', type: 'text' });
+      await onFinish('A colour.');
+    });
+
+    const { result } = renderHook(() => useAICommentsState('doc-1'));
+    await waitFor(() => expect(result.current.isLoading).toBe(false));
+
+    await act(async () => {
+      await result.current.ask(anchor, '  ');
+    });
+
+    expect(service.create).toHaveBeenCalledWith(
+      expect.objectContaining({ documentId: 'doc-1', selectionAnchor: anchor }),
+    );
+    expect(result.current.threads).toHaveLength(1);
+    expect(result.current.threads[0].id).toBe('thread-1');
+    expect(result.current.threads[0].messages.map((m) => [m.role, m.content])).toEqual([
+      ['user', 'pageEditor.aiComments.defaultQuestion'],
+      ['assistant', 'A colour.'],
+    ]);
+    expect(service.updateMessages).toHaveBeenCalledWith('thread-1', [
+      expect.objectContaining({ role: 'user' }),
+      expect.objectContaining({ content: 'A colour.', model: 'test-model', role: 'assistant' }),
+    ]);
+    expect(result.current.streamingIds.size).toBe(0);
+  });
+
+  it('marks a failed answer and replaces it on retry', async () => {
+    service.list.mockResolvedValue([
+      {
+        id: 'thread-1',
+        messages: [{ content: 'why?', createdAt: '1', role: 'user' }],
+        selectionAnchor: anchor,
+      },
+    ]);
+    chat.fetchPresetTaskResult.mockImplementationOnce(async ({ onError }) => {
+      onError(new Error('quota'));
+    });
+
+    const { result } = renderHook(() => useAICommentsState('doc-1'));
+    await waitFor(() => expect(result.current.threads).toHaveLength(1));
+
+    await act(async () => {
+      await result.current.retry('thread-1');
+    });
+    expect(result.current.threads[0].messages.at(-1)).toMatchObject({
+      error: 'quota',
+      role: 'assistant',
+    });
+
+    chat.fetchPresetTaskResult.mockImplementationOnce(async ({ onFinish }) => {
+      await onFinish('because.');
+    });
+    await act(async () => {
+      await result.current.retry('thread-1');
+    });
+
+    const messages = result.current.threads[0].messages;
+    expect(messages).toHaveLength(2);
+    expect(messages[1]).toMatchObject({ content: 'because.', role: 'assistant' });
+    expect(messages[1].error).toBeUndefined();
+  });
+
+  it('restores the selection when the question cannot be saved', async () => {
+    service.create.mockRejectedValue(new Error('offline'));
+    pageStore.current.setState({ documentId: 'doc-1' });
+
+    const { result } = renderHook(() => useAICommentsState('doc-1'));
+    await waitFor(() => expect(result.current.isLoading).toBe(false));
+
+    await act(async () => {
+      await result.current.ask(anchor, 'what?');
+    });
+
+    expect(result.current.threads).toEqual([]);
+    expect(chat.fetchPresetTaskResult).not.toHaveBeenCalled();
+    expect(pageStore.current.getState().pendingCommentAnchor).toEqual({
+      anchor,
+      documentId: 'doc-1',
+    });
+  });
+});
diff --git a/src/features/PageEditor/AIComments/useAICommentsState.ts b/src/features/PageEditor/AIComments/useAICommentsState.ts
new file mode 100644
index 00000000..0ed2a0a0
--- /dev/null
+++ b/src/features/PageEditor/AIComments/useAICommentsState.ts
@@ -0,0 +1,324 @@
+'use client';
+
+import {
+  type DocumentCommentSelectionAnchor,
+  isChatGroupSessionId,
+  RequestTrigger,
+} from '@lobechat/types';
+import { toast } from '@lobehub/ui';
+import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import type {
+  DocumentAiCommentItem,
+  DocumentAiCommentMessage,
+} from '@/database/schemas/documentAiComment';
+import { useSingleton } from '@/hooks/useSingleton';
+import { chatService } from '@/services/chat';
+import { documentAiCommentService } from '@/services/documentAiComment';
+import { getAgentStoreState } from '@/store/agent';
+import { agentByIdSelectors, builtinAgentSelectors } from '@/store/agent/selectors';
+
+import { flattenEditorText, locateAnchor } from '../DocumentComments/anchor/textAnchor';
+import { usePageEditorStore } from '../store';
+import { buildChatMessages, buildDocumentContext } from './prompt';
+
+export interface AIThread {
+  /** Server id; a thread being created carries a temporary `local-` id until it is saved. */
+  id: string;
+  messages: DocumentAiCommentMessage[];
+  selectionAnchor: DocumentCommentSelectionAnchor;
+}
+
+const LOCAL_PREFIX = 'local-';
+const now = () => new Date().toISOString();
+
+const toThread = (row: DocumentAiCommentItem): AIThread => ({
+  id: row.id,
+  messages: row.messages ?? [],
+  selectionAnchor: row.selectionAnchor,
+});
+
+/**
+ * The model the page copilot ("Ask Lobe AI") talks to: the active agent, or
+ * the built-in page agent when the active one cannot drive a page (a group or
+ * an agent on an external runtime) — the same rule as `PageAgentProvider`.
+ */
+const resolveCopilotModel = () => {
+  const state = getAgentStoreState();
+  const activeAgentId = state.activeAgentId;
+  const pageAgentId = builtinAgentSelectors.pageAgentId(state);
+  const agentId =
+    !activeAgentId ||
+    isChatGroupSessionId(activeAgentId) ||
+    agentByIdSelectors.isAgentHeterogeneousById(activeAgentId)(state)
+      ? pageAgentId
+      : activeAgentId;
+
+  return {
+    model: agentByIdSelectors.getAgentModelById(agentId ?? '')(state),
+    provider: agentByIdSelectors.getAgentModelProviderById(agentId ?? '')(state),
+  };
+};
+
+export const useAICommentsState = (documentId: string) => {
+  const { t } = useTranslation('file');
+  const editor = usePageEditorStore((s) => s.editor);
+  const title = usePageEditorStore((s) => s.title);
+  const setPendingCommentAnchor = usePageEditorStore((s) => s.setPendingCommentAnchor);
+
+  const [threads, setThreadsState] = useState<AIThread[]>([]);
+  const [isLoading, setIsLoading] = useState(true);
+  const [loadError, setLoadError] = useState<Error | undefined>();
+  const [streamingIds, setStreamingIds] = useState<ReadonlySet<string>>(() => new Set());
+  // The source of truth for the async flows below, which read a thread back
+  // right after changing it — before React has rendered the change.
+  const threadsRef = useRef(threads);
+  const setThreads = useCallback((update: AIThread[] | ((current: AIThread[]) => AIThread[])) => {
+    threadsRef.current = typeof update === 'function' ? update(threadsRef.current) : update;
+    setThreadsState(threadsRef.current);
+  }, []);
+  const aborters = useSingleton(() => new Map<string, AbortController>());
+  const removed = useSingleton(() => new Set<string>());
+
+  const load = useCallback(async () => {
+    setIsLoading(true);
+    setLoadError(undefined);
+    try {
+      const rows = await documentAiCommentService.list(documentId);
+      setThreads(rows.map(toThread));
+    } catch (error) {
+      setLoadError(error as Error);
+    } finally {
+      setIsLoading(false);
+    }
+  }, [documentId]);
+
+  useEffect(() => {
+    void load();
+    return () => {
+      for (const controller of aborters.values()) controller.abort();
+      aborters.clear();
+    };
+  }, [load]);
+
+  const patchThread = useCallback(
+    (id: string, patch: (thread: AIThread) => AIThread) => {
+      setThreads((current) => current.map((thread) => (thread.id === id ? patch(thread) : thread)));
+    },
+    [setThreads],
+  );
+
+  const setStreaming = useCallback((id: string, on: boolean) => {
+    setStreamingIds((current) => {
+      const next = new Set(current);
+      if (on) next.add(id);
+      else next.delete(id);
+      return next;
+    });
+  }, []);
+
+  const buildContext = useCallback(
+    (anchor: DocumentCommentSelectionAnchor) => {
+      const flat = flattenEditorText(editor?.getRootElement?.());
+      return buildDocumentContext({
+        anchor,
+        bodyText: flat.text,
+        match: locateAnchor(flat, anchor),
+        title,
+      });
+    },
+    [editor, title],
+  );
+
+  /**
+   * Stream an answer to the thread's last question into a new assistant turn,
+   * then persist the thread. A failed answer keeps what arrived and is marked,
+   * so it can be retried.
+   */
+  const answer = useCallback(
+    async (id: string) => {
+      const thread = threadsRef.current.find((item) => item.id === id);
+      if (!thread) return;
+
+      const { model, provider } = resolveCopilotModel();
+      const messages = buildChatMessages(buildContext(thread.selectionAnchor), thread.messages);
+      const controller = new AbortController();
+      aborters.set(id, controller);
+      setStreaming(id, true);
+
+      let content = '';
+      let error: string | undefined;
+      const createdAt = now();
+      const assistantMessage = (): DocumentAiCommentMessage => ({
+        content,
+        createdAt,
+        ...(error ? { error } : {}),
+        model,
+        provider,
+        role: 'assistant',
+      });
+      const writeAssistant = () =>
+        patchThread(id, (current) => ({
+          ...current,
+          messages: [...thread.messages, assistantMessage()],
+        }));
+      writeAssistant();
+
+      await chatService.fetchPresetTaskResult({
+        abortController: controller,
+        onError: (e) => {
+          error = e.message || 'error';
+        },
+        onFinish: async (text) => {
+          if (text) content = text;
+        },
+        onMessageHandle: (chunk) => {
+          if (chunk.type !== 'text') return;
+          content += chunk.text;
+          writeAssistant();
+        },
+        params: { messages: messages as any, model, provider, stream: true },
+        trigger: RequestTrigger.Chat,
+      });
+
+      aborters.delete(id);
+      if (removed.has(id)) return;
+      // A stopped answer keeps what arrived, like a finished one.
+      if (controller.signal.aborted) error = undefined;
+      if (!error && !content.trim()) {
+        error = t(
+          controller.signal.aborted
+            ? 'pageEditor.aiComments.stopped'
+            : 'pageEditor.aiComments.emptyAnswer',
+        );
+      }
+      writeAssistant();
+      setStreaming(id, false);
+
+      const finalMessages = [...thread.messages, assistantMessage()];
+      try {
+        await documentAiCommentService.updateMessages(id, finalMessages);
+      } catch {
+        toast.error(t('pageEditor.aiComments.saveFailed'));
+      }
+    },
+    [buildContext, patchThread, setStreaming, t],
+  );
+
+  /** Start a thread on the pending selection. An empty question asks for an explanation. */
+  const ask = useCallback(
+    async (anchor: DocumentCommentSelectionAnchor, question: string) => {
+      const firstMessage: DocumentAiCommentMessage = {
+        content: question.trim() || t('pageEditor.aiComments.defaultQuestion'),
+        createdAt: now(),
+        role: 'user',
+      };
+      const localId = `${LOCAL_PREFIX}${Date.now()}`;
+      setThreads((current) => [
+        ...current,
+        { id: localId, messages: [firstMessage], selectionAnchor: anchor },
+      ]);
+      setPendingCommentAnchor(undefined);
+
+      // Save the question first so the thread has a server id to keep the
+      // answer under, then stream the answer into it.
+      let id: string;
+      try {
+        const row = await documentAiCommentService.create({
+          documentId,
+          messages: [firstMessage],
+          selectionAnchor: anchor,
+        });
+        id = row.id;
+      } catch {
+        setThreads((current) => current.filter((thread) => thread.id !== localId));
+        setPendingCommentAnchor({ anchor, documentId });
+        toast.error(t('pageEditor.aiComments.saveFailed'));
+        return;
+      }
+      if (removed.has(localId)) {
+        void documentAiCommentService.delete(id).catch(() => {});
+        return;
+      }
+      setThreads((current) =>
+        current.map((thread) => (thread.id === localId ? { ...thread, id } : thread)),
+      );
+      await answer(id);
+      return id;
+    },
+    [answer, documentId, setPendingCommentAnchor, t],
+  );
+
+  const followUp = useCallback(
+    async (id: string, question: string) => {
+      const content = question.trim();
+      if (!content || streamingIds.has(id)) return;
+      const message: DocumentAiCommentMessage = { content, createdAt: now(), role: 'user' };
+      patchThread(id, (thread) => ({ ...thread, messages: [...thread.messages, message] }));
+      await answer(id);
+    },
+    [answer, patchThread, streamingIds],
+  );
+
+  /** Drop a failed answer and ask again. */
+  const retry = useCallback(
+    async (id: string) => {
+      const strip = (thread: AIThread) => {
+        const last = thread.messages.at(-1);
+        return last?.role === 'assistant' && last.error
+          ? { ...thread, messages: thread.messages.slice(0, -1) }
+          : thread;
+      };
+      patchThread(id, strip);
+      await answer(id);
+    },
+    [answer, patchThread],
+  );
+
+  const stop = useCallback((id: string) => {
+    aborters.get(id)?.abort();
+  }, []);
+
+  const remove = useCallback(
+    async (id: string) => {
+      removed.add(id);
+      aborters.get(id)?.abort();
+      aborters.delete(id);
+      setStreaming(id, false);
+      const previous = threadsRef.current;
+      setThreads((current) => current.filter((thread) => thread.id !== id));
+      if (id.startsWith(LOCAL_PREFIX)) return;
+      try {
+        await documentAiCommentService.delete(id);
+      } catch {
+        removed.delete(id);
+        setThreads(previous);
+        toast.error(t('pageEditor.aiComments.deleteFailed'));
+      }
+    },
+    [setStreaming, t],
+  );
+
+  const anchors = useMemo(
+    () => threads.map(({ id, selectionAnchor }) => ({ id, selectionAnchor })),
+    [threads],
+  );
+
+  return {
+    anchors,
+    ask,
+    documentId,
+    followUp,
+    isLoading,
+    load,
+    loadError,
+    remove,
+    retry,
+    stop,
+    streamingIds,
+    threads,
+  };
+};
+
+export type AICommentsState = ReturnType<typeof useAICommentsState>;
