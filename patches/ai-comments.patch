+import { describe, expect, it } from 'vitest';
+
+import {
+  buildChatMessages,
+  buildDocumentContext,
+  CONTEXT_AFTER,
+  CONTEXT_BEFORE,
+  SELECTION_CLOSE,
+  SELECTION_OPEN,
+} from './prompt';
+
+const anchor = { end: 9, quote: 'brown', start: 4 };
+
+describe('buildDocumentContext', () => {
+  it('marks the selection inside a small document', () => {
+    const context = buildDocumentContext({
+      anchor,
+      bodyText: 'the brown fox',
+      match: { end: 9, start: 4 },
+      title: 'Fox',
+    });
+
+    expect(context).toBe(
+      `Title: Fox\n\nDocument:\nthe ${SELECTION_OPEN}brown${SELECTION_CLOSE} fox`,
+    );
+  });
+
+  it('keeps only a window around the selection in a long document', () => {
+    const before = 'a'.repeat(20_000);
+    const after = 'b'.repeat(20_000);
+    const bodyText = `${before}QUOTE${after}`;
+    const context = buildDocumentContext({
+      anchor: { end: 20_005, quote: 'QUOTE', start: 20_000 },
+      bodyText,
+      match: { end: 20_005, start: 20_000 },
+    });
+
+    expect(context).toContain(`${SELECTION_OPEN}QUOTE${SELECTION_CLOSE}`);
+    expect(context.match(/a/g)).toHaveLength(CONTEXT_BEFORE);
+    expect(context.match(/b/g)).toHaveLength(CONTEXT_AFTER);
+    expect(context.startsWith('Document:\n…')).toBe(true);
+    expect(context.endsWith('…')).toBe(true);
+  });
+
+  it('falls back to the stored quote when it was edited away', () => {
+    const context = buildDocumentContext({ anchor, bodyText: 'something else', match: null });
+
+    expect(context).toContain(`${SELECTION_OPEN}brown${SELECTION_CLOSE}`);
+    expect(context).toContain('something else');
+  });
+});
+
+describe('buildChatMessages', () => {
+  it('puts the context on the first question only and drops failed answers', () => {
+    const messages = buildChatMessages('CTX', [
+      { content: 'what?', createdAt: '1', role: 'user' },
+      { content: 'partial', createdAt: '2', error: 'boom', role: 'assistant' },
+      { content: 'what?', createdAt: '3', role: 'user' },
+      { content: 'answer', createdAt: '4', role: 'assistant' },
+      { content: 'more?', createdAt: '5', role: 'user' },
+    ]);
+
+    expect(messages.map((m) => m.role)).toEqual(['system', 'user', 'assistant', 'user']);
+    expect(messages[1].content).toContain('CTX');
+    expect(messages[1].content).toContain('what?\n\nwhat?');
+    expect(messages[2].content).toBe('answer');
+    expect(messages[3].content).toBe('more?');
+  });
+});
diff --git a/src/features/PageEditor/AIComments/prompt.ts b/src/features/PageEditor/AIComments/prompt.ts
new file mode 100644
index 00000000..f2aae0c1
--- /dev/null
+++ b/src/features/PageEditor/AIComments/prompt.ts
@@ -0,0 +1,91 @@
+import type { DocumentCommentSelectionAnchor } from '@lobechat/types';
+
+import type { DocumentAiCommentMessage } from '@/database/schemas/documentAiComment';
+
+/** Below this the whole page goes into the prompt; above it, a window around the quote. */
+export const FULL_DOCUMENT_LIMIT = 16_000;
+export const CONTEXT_BEFORE = 6000;
+export const CONTEXT_AFTER = 3000;
+
+export const SELECTION_OPEN = '<<<';
+export const SELECTION_CLOSE = '>>>';
+
+const SYSTEM_PROMPT = `You answer comments in the margin of a document.
+The reader selected a passage (marked ${SELECTION_OPEN} … ${SELECTION_CLOSE} in the document below) and asked about it.
+- Focus on the selected passage; use the rest of the document only as context.
+- Reply like a margin comment: direct and short (usually under 200 words) unless the reader asks for more.
+- Reply in the language of the reader's question; if there is no question, in the document's language.
+- Markdown is fine. Do not rewrite the whole document.`;
+
+interface ChatMessage {
+  content: string;
+  role: 'assistant' | 'system' | 'user';
+}
+
+export interface DocumentContextParams {
+  anchor: DocumentCommentSelectionAnchor;
+  /** Flattened body text at the time of asking. */
+  bodyText: string;
+  /** Where the quote sits in `bodyText` now; `null` when it was edited away. */
+  match: { end: number; start: number } | null;
+  title?: string;
+}
+
+/**
+ * The document as the model sees it: the selection marked in place, the whole
+ * page when it is small, otherwise a window around the selection. When the
+ * quote no longer exists in the body the stored quote is given on its own.
+ */
+export const buildDocumentContext = ({
+  anchor,
+  bodyText,
+  match,
+  title,
+}: DocumentContextParams): string => {
+  const heading = title?.trim() ? `Title: ${title.trim()}\n\n` : '';
+
+  if (!match) {
+    return `${heading}Selected passage (no longer present in the current text):\n${SELECTION_OPEN}${anchor.quote}${SELECTION_CLOSE}\n\nDocument:\n${bodyText.slice(0, FULL_DOCUMENT_LIMIT)}`;
+  }
+
+  const small = bodyText.length <= FULL_DOCUMENT_LIMIT;
+  const from = small ? 0 : Math.max(0, match.start - CONTEXT_BEFORE);
+  const to = small ? bodyText.length : Math.min(bodyText.length, match.end + CONTEXT_AFTER);
+
+  const marked =
+    (from > 0 ? '…' : '') +
+    bodyText.slice(from, match.start) +
+    SELECTION_OPEN +
+    bodyText.slice(match.start, match.end) +
+    SELECTION_CLOSE +
+    bodyText.slice(match.end, to) +
+    (to < bodyText.length ? '…' : '');
+
+  return `${heading}Document:\n${marked}`;
+};
+
+/**
+ * The full chat for one thread. The document context rides on the first user
+ * turn only, rebuilt from the current body on every ask so a follow-up sees
+ * edits made since the thread started.
+ */
+export const buildChatMessages = (
+  context: string,
+  thread: readonly DocumentAiCommentMessage[],
+): ChatMessage[] => {
+  const turns = thread.filter((message) => message.role === 'user' || !message.error);
+
+  const chat: ChatMessage[] = [];
+  for (const message of turns) {
+    const previous = chat.at(-1);
+    // A failed answer leaves two questions back to back; providers that
+    // require alternating roles reject that, so they are sent as one turn.
+    if (previous?.role === message.role) previous.content += `\n\n${message.content}`;
+    else chat.push({ content: message.content, role: message.role });
+  }
+  if (chat[0]?.role === 'user') {
+    chat[0].content = `${context}\n\nReader's question about the selected passage:\n${chat[0].content}`;
+  }
+
+  return [{ content: SYSTEM_PROMPT, role: 'system' }, ...chat];
+};
