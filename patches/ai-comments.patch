@@ -0,0 +1,79 @@
+import { TRPCError } from '@trpc/server';
+import { z } from 'zod';
+
+import { wsCompatProcedure } from '@/business/server/trpc-middlewares/workspaceAuth';
+import { DocumentModel } from '@/database/models/document';
+import { DocumentAiCommentModel } from '@/database/models/documentAiComment';
+import { router } from '@/libs/trpc/lambda';
+import { serverDatabase } from '@/libs/trpc/lambda/middleware';
+
+/** Mirrors the client's `ANCHOR_QUOTE_MAX_LENGTH` / `ANCHOR_CONTEXT_LENGTH`. */
+const selectionAnchorSchema = z.object({
+  end: z.number().int().min(0),
+  prefix: z.string().max(200).optional(),
+  quote: z.string().min(1).max(2000),
+  start: z.number().int().min(0),
+  suffix: z.string().max(200).optional(),
+});
+
+const messageSchema = z.object({
+  content: z.string().max(100_000),
+  createdAt: z.string().max(64),
+  error: z.string().max(2000).optional(),
+  model: z.string().max(255).optional(),
+  provider: z.string().max(255).optional(),
+  role: z.enum(['assistant', 'user']),
+});
+
+const messagesSchema = z.array(messageSchema).max(200);
+
+const documentAiCommentProcedure = wsCompatProcedure
+  .use(serverDatabase)
+  .use(async ({ ctx, next }) =>
+    next({
+      ctx: {
+        documentAiCommentModel: new DocumentAiCommentModel(ctx.serverDB, ctx.userId),
+        documentModel: new DocumentModel(ctx.serverDB, ctx.userId, ctx.workspaceId ?? undefined),
+      },
+    }),
+  );
+
+/**
+ * Private AI threads anchored to a page selection. Rows are scoped to their
+ * author; the document is checked through the caller's ordinary document
+ * scope so a thread can only be started on a page the caller can open.
+ */
+export const documentAiCommentRouter = router({
+  create: documentAiCommentProcedure
+    .input(
+      z.object({
+        documentId: z.string().trim().min(1).max(255),
+        messages: messagesSchema,
+        selectionAnchor: selectionAnchorSchema,
+      }),
+    )
+    .mutation(async ({ ctx, input }) => {
+      const document = await ctx.documentModel.findById(input.documentId);
+      if (!document) throw new TRPCError({ code: 'NOT_FOUND', message: 'Document not found' });
+
+      return ctx.documentAiCommentModel.create(input);
+    }),
+
+  delete: documentAiCommentProcedure
+    .input(z.object({ id: z.string().uuid() }))
+    .mutation(async ({ ctx, input }) => {
+      await ctx.documentAiCommentModel.delete(input.id);
+    }),
+
+  list: documentAiCommentProcedure
+    .input(z.object({ documentId: z.string().trim().min(1).max(255) }))
+    .query(async ({ ctx, input }) => ctx.documentAiCommentModel.listByDocument(input.documentId)),
+
+  updateMessages: documentAiCommentProcedure
+    .input(z.object({ id: z.string().uuid(), messages: messagesSchema }))
+    .mutation(async ({ ctx, input }) => {
+      const row = await ctx.documentAiCommentModel.updateMessages(input.id, input.messages);
+      if (!row) throw new TRPCError({ code: 'NOT_FOUND', message: 'AI comment not found' });
+      return row;
+    }),
+});
