@@ -0,0 +1,91 @@
+// @vitest-environment node
+import { inArray } from 'drizzle-orm';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+
+import { getTestDB } from '../../core/getTestDB';
+import { documents, users } from '../../schemas';
+import { documentAiComments } from '../../schemas/documentAiComment';
+import type { LobeChatDatabase } from '../../type';
+import { DocumentAiCommentModel } from '../documentAiComment';
+
+const serverDB: LobeChatDatabase = await getTestDB();
+
+const ownerId = 'document-ai-comment-owner';
+const otherId = 'document-ai-comment-other';
+const documentId = 'document-ai-comment-document';
+
+const anchor = { end: 9, quote: 'brown', start: 4 };
+const question = { content: 'what?', createdAt: '2026-10-30T00:00:00Z', role: 'user' as const };
+
+const cleanup = async () => {
+  await serverDB.delete(documents).where(inArray(documents.id, [documentId]));
+  await serverDB.delete(users).where(inArray(users.id, [ownerId, otherId]));
+};
+
+beforeEach(async () => {
+  await cleanup();
+  await serverDB.insert(users).values([{ id: ownerId }, { id: otherId }]);
+  await serverDB.insert(documents).values({
+    fileType: 'custom',
+    id: documentId,
+    source: documentId,
+    sourceType: 'api',
+    totalCharCount: 0,
+    totalLineCount: 0,
+    userId: ownerId,
+  });
+});
+
+afterEach(cleanup);
+
+describe('DocumentAiCommentModel', () => {
+  it('creates, lists, updates and deletes a thread for its owner', async () => {
+    const model = new DocumentAiCommentModel(serverDB, ownerId);
+
+    const created = await model.create({
+      documentId,
+      messages: [question],
+      selectionAnchor: anchor,
+    });
+    expect(created.userId).toBe(ownerId);
+
+    const answer = {
+      content: 'an answer',
+      createdAt: '2026-10-30T00:00:01Z',
+      role: 'assistant' as const,
+    };
+    const updated = await model.updateMessages(created.id, [question, answer]);
+    expect(updated?.messages).toEqual([question, answer]);
+
+    const listed = await model.listByDocument(documentId);
+    expect(listed.map((row) => row.id)).toEqual([created.id]);
+    expect(listed[0].selectionAnchor).toEqual(anchor);
+
+    await model.delete(created.id);
+    expect(await model.listByDocument(documentId)).toEqual([]);
+  });
+
+  it('keeps threads private to their author', async () => {
+    const owner = new DocumentAiCommentModel(serverDB, ownerId);
+    const other = new DocumentAiCommentModel(serverDB, otherId);
+    const created = await owner.create({
+      documentId,
+      messages: [question],
+      selectionAnchor: anchor,
+    });
+
+    expect(await other.listByDocument(documentId)).toEqual([]);
+    expect(await other.updateMessages(created.id, [])).toBeUndefined();
+    await other.delete(created.id);
+    expect(await owner.listByDocument(documentId)).toHaveLength(1);
+  });
+
+  it('goes away with its document', async () => {
+    const model = new DocumentAiCommentModel(serverDB, ownerId);
+    await model.create({ documentId, messages: [question], selectionAnchor: anchor });
+
+    await serverDB.delete(documents).where(inArray(documents.id, [documentId]));
+
+    expect(await serverDB.select().from(documentAiComments)).toEqual([]);
+  });
+});
