@@ -0,0 +1,57 @@
+import { and, asc, eq } from 'drizzle-orm';
+
+import type { DocumentAiCommentItem, DocumentAiCommentMessage } from '../schemas/documentAiComment';
+import { documentAiComments } from '../schemas/documentAiComment';
+import type { LobeChatDatabase } from '../type';
+
+/** Every query is scoped to the calling user: AI comment threads are private. */
+export class DocumentAiCommentModel {
+  private userId: string;
+  private db: LobeChatDatabase;
+
+  constructor(db: LobeChatDatabase, userId: string) {
+    this.userId = userId;
+    this.db = db;
+  }
+
+  private own = (id: string) =>
+    and(eq(documentAiComments.id, id), eq(documentAiComments.userId, this.userId));
+
+  listByDocument = async (documentId: string): Promise<DocumentAiCommentItem[]> =>
+    this.db
+      .select()
+      .from(documentAiComments)
+      .where(
+        and(
+          eq(documentAiComments.documentId, documentId),
+          eq(documentAiComments.userId, this.userId),
+        ),
+      )
+      .orderBy(asc(documentAiComments.createdAt));
+
+  create = async (
+    params: Pick<DocumentAiCommentItem, 'documentId' | 'messages' | 'selectionAnchor'>,
+  ): Promise<DocumentAiCommentItem> => {
+    const [row] = await this.db
+      .insert(documentAiComments)
+      .values({ ...params, userId: this.userId })
+      .returning();
+    return row;
+  };
+
+  updateMessages = async (
+    id: string,
+    messages: DocumentAiCommentMessage[],
+  ): Promise<DocumentAiCommentItem | undefined> => {
+    const [row] = await this.db
+      .update(documentAiComments)
+      .set({ messages })
+      .where(this.own(id))
+      .returning();
+    return row;
+  };
+
+  delete = async (id: string) => {
+    await this.db.delete(documentAiComments).where(this.own(id));
+  };
+}
