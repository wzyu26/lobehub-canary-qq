+'use client';
+
+import { cx, Empty, Flexbox, Text } from '@lobehub/ui';
+import { SparklesIcon } from 'lucide-react';
+import { memo, type ReactNode, type RefObject, useEffect, useRef, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import AsyncError from '@/components/AsyncError';
+import SurfaceSkeleton from '@/components/Skeleton/Surface';
+import NavHeader from '@/features/NavHeader';
+import RightPanel from '@/features/RightPanel';
+import ToggleRightPanelButton from '@/features/RightPanel/ToggleRightPanelButton';
+
+import { useCommentAnchors } from '../DocumentComments/anchor/context';
+import { useForwardWheel } from '../DocumentComments/Gutter/useForwardWheel';
+import { PENDING_CARD_ID, useGutterLayout } from '../DocumentComments/Gutter/useGutterLayout';
+import { styles } from '../DocumentComments/styles';
+import { usePageAgentPanelControl } from '../RightPanel/OverrideContext';
+import { usePageEditorStore } from '../store';
+import AskComposer from './Composer';
+import { useAIComments } from './context';
+import ThreadCard from './ThreadCard';
+import type { AICommentsState } from './useAICommentsState';
+
+const PanelBody = memo<{ paneRef: RefObject<HTMLElement | null>; state: AICommentsState }>(
+  ({ paneRef, state }) => {
+    const { t } = useTranslation('file');
+    const { documentId, threads, streamingIds } = state;
+    const { selectedRootId, selectRoot } = useCommentAnchors();
+    const pendingAnchor = usePageEditorStore((s) =>
+      s.pendingCommentAnchor?.documentId === documentId ? s.pendingCommentAnchor.anchor : undefined,
+    );
+    const pickVersion = usePageEditorStore((s) => s.pendingCommentAnchorVersion);
+    const setPendingCommentAnchor = usePageEditorStore((s) => s.setPendingCommentAnchor);
+    const hasPending = Boolean(pendingAnchor);
+    const hostRef = useRef<HTMLDivElement>(null);
+    const trackRef = useRef<HTMLDivElement>(null);
+    const ids = threads.map(({ id }) => id);
+    const activeId = hasPending ? PENDING_CARD_ID : selectedRootId;
+    const { registerCard, scrollBy, tops } = useGutterLayout({
+      activeId,
+      hasPending,
+      ids,
+      paneRef,
+      trackRef,
+    });
+    useForwardWheel(hostRef, scrollBy);
+    const isEmpty = threads.length === 0 && !hasPending && !state.isLoading && !state.loadError;
+
+    const renderCard = (id: string, active: boolean, children: ReactNode) => {
+      const top = tops.get(id);
+      return (
+        <div
+          key={id}
+          ref={registerCard(id)}
+          style={{ top }}
+          className={cx(
+            styles.gutterCard,
+            top !== undefined && styles.gutterCardPositioned,
+            active && styles.gutterCardActive,
+            id === PENDING_CARD_ID && styles.gutterCardComposer,
+          )}
+          onClick={id === PENDING_CARD_ID ? undefined : () => selectRoot(id)}
+        >
+          {children}
+        </div>
+      );
+    };
+
+    return (
+      <div data-document-comment-gutter className={styles.gutter} ref={hostRef}>
+        {state.loadError ? (
+          <AsyncError error={state.loadError} variant={'block'} onRetry={() => void state.load()} />
+        ) : state.isLoading ? (
+          <SurfaceSkeleton header={false} variant={'list'} />
+        ) : (
+          isEmpty && (
+            <Flexbox align={'center'} className={styles.gutterEmpty} justify={'center'}>
+              <Empty description={t('pageEditor.aiComments.empty')} icon={SparklesIcon} />
+            </Flexbox>
+          )
+        )}
+        <div className={styles.gutterTrack} ref={trackRef}>
+          {pendingAnchor &&
+            renderCard(
+              PENDING_CARD_ID,
+              true,
+              <AskComposer
+                anchor={pendingAnchor}
+                focusKey={pickVersion}
+                placeholder={t('pageEditor.aiComments.placeholder')}
+                onCancel={() => setPendingCommentAnchor(undefined)}
+                onSubmit={(question) => {
+                  void state.ask(pendingAnchor, question).then((id) => {
+                    if (id) selectRoot(id);
+                  });
+                }}
+              />,
+            )}
+          {threads.map((thread) =>
+            renderCard(
+              thread.id,
+              selectedRootId === thread.id,
+              <ThreadCard
+                active={selectedRootId === thread.id}
+                streaming={streamingIds.has(thread.id)}
+                thread={thread}
+                onDelete={() => void state.remove(thread.id)}
+                onFollowUp={(question) => void state.followUp(thread.id, question)}
+                onRetry={() => void state.retry(thread.id)}
+                onStop={() => state.stop(thread.id)}
+              />,
+            ),
+          )}
+        </div>
+      </div>
+    );
+  },
+);
+
+PanelBody.displayName = 'AICommentsPanelBody';
+
+const DEFAULT_PANEL_WIDTH = 360;
+
+/**
+ * The AI comments sidebar. It takes the place of the human comments panel on
+ * pages outside a Workspace and shares its layout: cards sit level with the
+ * run they quote and follow the document's scroll.
+ */
+const AICommentsPanel = memo<{ paneRef: RefObject<HTMLElement | null> }>(({ paneRef }) => {
+  const { t } = useTranslation('file');
+  const state = useAIComments();
+  const [open, setOpen] = usePageEditorStore((s) => [s.commentsPanelOpen, s.setCommentsPanelOpen]);
+  const [width, setWidth] = useState<number | string>(DEFAULT_PANEL_WIDTH);
+  const { expand: agentOpen, toggle: toggleAgent } = usePageAgentPanelControl();
+
+  // Same rule as the comments panel: the two sidebars never show side by side.
+  const wasOpenRef = useRef(open);
+  const wasAgentOpenRef = useRef(agentOpen);
+  useEffect(() => {
+    const opened = open && !wasOpenRef.current;
+    const agentOpened = agentOpen && !wasAgentOpenRef.current;
+    wasOpenRef.current = open;
+    wasAgentOpenRef.current = agentOpen;
+    if (opened && agentOpen) toggleAgent(false);
+    else if (agentOpened && open) setOpen(false);
+  }, [agentOpen, open, setOpen, toggleAgent]);
+
+  if (!state) return null;
+
+  return (
+    <RightPanel
+      defaultWidth={width}
+      expand={open}
+      onExpandChange={setOpen}
+      onSizeChange={(size) => {
+        if (size?.width) setWidth(size.width);
+      }}
+    >
+      <Flexbox flex={1} height={'100%'} style={{ minHeight: 0 }}>
+        <NavHeader
+          showTogglePanelButton={false}
+          left={
+            <Text
+              ellipsis={{ tooltipWhenOverflow: true }}
+              style={{ fontSize: 13, fontWeight: 500, marginLeft: 8 }}
+              type={'secondary'}
+            >
+              {t('pageEditor.aiComments.title')}
+            </Text>
+          }
+          right={
+            <ToggleRightPanelButton
+              expand
+              showActive={false}
+              title={t('pageEditor.aiComments.title')}
+              onToggle={() => setOpen(false)}
+            />
+          }
+        />
+        <PanelBody paneRef={paneRef} state={state} />
+      </Flexbox>
+    </RightPanel>
+  );
+});
+
+AICommentsPanel.displayName = 'AICommentsPanel';
+
+export default AICommentsPanel;
