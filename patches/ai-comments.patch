@@ -0,0 +1,68 @@
+'use client';
+
+import { createContext, type ReactNode, use, useEffect } from 'react';
+
+import { DocumentCommentAnchorsProvider } from '../DocumentComments/anchor/context';
+import DocumentCommentHighlightStyle from '../DocumentComments/anchor/HighlightStyle';
+import { useDocumentCommentAnchors } from '../DocumentComments/anchor/useDocumentCommentAnchors';
+import { usePageEditorStore } from '../store';
+import type { AICommentsState } from './useAICommentsState';
+import { useAICommentsState } from './useAICommentsState';
+
+const AICommentsContext = createContext<AICommentsState | null>(null);
+
+const AICommentsStateProvider = ({
+  children,
+  documentId,
+}: {
+  children: ReactNode;
+  documentId: string;
+}) => {
+  const state = useAICommentsState(documentId);
+  const anchors = useDocumentCommentAnchors(state.anchors, { hasGutter: true });
+  const setCommentsPanelOpen = usePageEditorStore((s) => s.setCommentsPanelOpen);
+
+  // A selection sent from the toolbar, or a highlighted run clicked in the
+  // body, is answered in the panel: open it on demand (see the same rule in
+  // `DocumentCommentsProvider`).
+  const pickVersion = usePageEditorStore((s) =>
+    s.pendingCommentAnchor?.documentId === documentId ? s.pendingCommentAnchorVersion : 0,
+  );
+  const { pickTick, selectedRootId } = anchors;
+  useEffect(() => {
+    if (!(pickVersion || pickTick || selectedRootId)) return;
+    setCommentsPanelOpen(true);
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [pickVersion, pickTick, selectedRootId]);
+
+  return (
+    <AICommentsContext value={state}>
+      <DocumentCommentAnchorsProvider value={anchors}>
+        <DocumentCommentHighlightStyle />
+        {children}
+      </DocumentCommentAnchorsProvider>
+    </AICommentsContext>
+  );
+};
+
+/**
+ * Pages outside a Workspace have no human comment threads; their selection
+ * "Comment" action asks the AI instead, and the answers are the comments.
+ */
+export const AICommentsProvider = ({
+  children,
+  documentId,
+}: {
+  children: ReactNode;
+  documentId?: string;
+}) => {
+  if (!documentId) return children;
+  return (
+    <AICommentsStateProvider documentId={documentId} key={documentId}>
+      {children}
+    </AICommentsStateProvider>
+  );
+};
+
+/** `null` outside a provider, i.e. on Workspace pages and before a document loads. */
+export const useAIComments = () => use(AICommentsContext);
