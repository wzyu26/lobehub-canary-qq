+'use client';
+
+import type { DocumentCommentSelectionAnchor } from '@lobechat/types';
+import { Button, Flexbox, TextArea } from '@lobehub/ui';
+import { SendHorizontal } from 'lucide-react';
+import { memo, useEffect, useRef, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import AnchorQuote from '../DocumentComments/anchor/AnchorQuote';
+import { styles } from '../DocumentComments/styles';
+
+interface AskComposerProps {
+  anchor?: DocumentCommentSelectionAnchor;
+  /** Re-focus the input when this changes (a new pick of the same text). */
+  focusKey?: number;
+  onCancel?: () => void;
+  onSubmit: (question: string) => void;
+  /** Follow-up mode: an empty question cannot be sent and there is no quote. */
+  placeholder: string;
+  submitDisabled?: boolean;
+}
+
+/**
+ * The question box. On a fresh selection an empty question is allowed (the AI
+ * explains the passage); a follow-up needs words.
+ */
+const AskComposer = memo<AskComposerProps>(
+  ({ anchor, focusKey, onCancel, onSubmit, placeholder, submitDisabled }) => {
+    const { t } = useTranslation('file');
+    const [value, setValue] = useState('');
+    const inputRef = useRef<any>(null);
+    const allowEmpty = Boolean(anchor);
+    const canSend = !submitDisabled && (allowEmpty || value.trim().length > 0);
+
+    useEffect(() => {
+      if (!anchor) return;
+      // The panel slides in; focus once it is there.
+      const timer = setTimeout(() => inputRef.current?.focus?.(), 120);
+      return () => clearTimeout(timer);
+    }, [anchor, focusKey]);
+
+    const send = () => {
+      if (!canSend) return;
+      onSubmit(value);
+      setValue('');
+    };
+
+    return (
+      <Flexbox gap={8}>
+        {anchor && <AnchorQuote anchor={anchor} onDismiss={onCancel} />}
+        <TextArea
+          autoSize={{ maxRows: 8, minRows: anchor ? 2 : 1 }}
+          className={styles.textarea}
+          placeholder={placeholder}
+          ref={inputRef}
+          value={value}
+          variant={'borderless'}
+          onChange={(event) => setValue(event.target.value)}
+          onKeyDown={(event) => {
+            if (event.key === 'Escape' && onCancel) {
+              event.preventDefault();
+              onCancel();
+              return;
+            }
+            if (event.key !== 'Enter' || event.shiftKey || event.nativeEvent.isComposing) return;
+            event.preventDefault();
+            send();
+          }}
+        />
+        <Flexbox horizontal gap={8} justify={'flex-end'}>
+          {onCancel && (
+            <Button size={'small'} onClick={onCancel}>
+              {t('pageEditor.aiComments.cancel')}
+            </Button>
+          )}
+          <Button
+            disabled={!canSend}
+            icon={<SendHorizontal size={14} />}
+            size={'small'}
+            type={'primary'}
+            onClick={send}
+          >
+            {t('pageEditor.aiComments.send')}
+          </Button>
+        </Flexbox>
+      </Flexbox>
+    );
+  },
+);
+
+AskComposer.displayName = 'AICommentAskComposer';
+
+export default AskComposer;
