+'use client';
+
+import { DEFAULT_INBOX_AVATAR } from '@lobechat/const';
+import { ActionIcon, Avatar, Button, Flexbox, Markdown, Text } from '@lobehub/ui';
+import { Square, Trash2 } from 'lucide-react';
+import { memo } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import AnchorQuote from '../DocumentComments/anchor/AnchorQuote';
+import { useCommentAnchors } from '../DocumentComments/anchor/context';
+import AskComposer from './Composer';
+import { aiStyles } from './styles';
+import type { AIThread } from './useAICommentsState';
+
+interface ThreadCardProps {
+  active: boolean;
+  onDelete: () => void;
+  onFollowUp: (question: string) => void;
+  onRetry: () => void;
+  onStop: () => void;
+  streaming: boolean;
+  thread: AIThread;
+}
+
+const ThreadCard = memo<ThreadCardProps>(
+  ({ active, onDelete, onFollowUp, onRetry, onStop, streaming, thread }) => {
+    const { t } = useTranslation('file');
+    const { locateInBody, orphanedRootIds } = useCommentAnchors();
+    const last = thread.messages.at(-1);
+
+    return (
+      <Flexbox data-document-comment-id={thread.id} gap={8}>
+        <Flexbox horizontal align={'center'} gap={4}>
+          <div style={aiStyles.quote}>
+            <AnchorQuote
+              anchor={thread.selectionAnchor}
+              orphaned={orphanedRootIds.has(thread.id)}
+              onLocate={() => locateInBody(thread.id)}
+            />
+          </div>
+          <ActionIcon
+            icon={Trash2}
+            size={'small'}
+            title={t('pageEditor.aiComments.delete')}
+            onClick={(event) => {
+              event.stopPropagation();
+              onDelete();
+            }}
+          />
+        </Flexbox>
+        {thread.messages.map((message, index) =>
+          message.role === 'user' ? (
+            <Text key={index} style={aiStyles.question}>
+              {message.content}
+            </Text>
+          ) : (
+            <Flexbox gap={4} key={index}>
+              <Flexbox horizontal align={'center'} gap={6}>
+                <Avatar avatar={DEFAULT_INBOX_AVATAR} shape={'square'} size={18} />
+                <Text style={aiStyles.meta} type={'secondary'}>
+                  {message.model || 'AI'}
+                </Text>
+              </Flexbox>
+              {message.content ? (
+                <Markdown fontSize={13} variant={'chat'}>
+                  {message.content}
+                </Markdown>
+              ) : (
+                !message.error && (
+                  <Text style={aiStyles.meta} type={'secondary'}>
+                    {t('pageEditor.aiComments.thinking')}
+                  </Text>
+                )
+              )}
+              {message.error && (
+                <Flexbox horizontal align={'center'} gap={8}>
+                  <Text style={aiStyles.meta} type={'danger'}>
+                    {t('pageEditor.aiComments.failed')}: {message.error}
+                  </Text>
+                  {index === thread.messages.length - 1 && !streaming && (
+                    <Button size={'small'} onClick={onRetry}>
+                      {t('pageEditor.aiComments.retry')}
+                    </Button>
+                  )}
+                </Flexbox>
+              )}
+            </Flexbox>
+          ),
+        )}
+        {streaming ? (
+          <Flexbox horizontal justify={'flex-end'}>
+            <Button icon={<Square size={12} />} size={'small'} onClick={onStop}>
+              {t('pageEditor.aiComments.stop')}
+            </Button>
+          </Flexbox>
+        ) : (
+          active &&
+          !last?.error && (
+            <AskComposer
+              placeholder={t('pageEditor.aiComments.replyPlaceholder')}
+              onSubmit={onFollowUp}
+            />
+          )
+        )}
+      </Flexbox>
+    );
+  },
+);
+
+ThreadCard.displayName = 'AICommentThreadCard';
+
+export default ThreadCard;
