@@ -0,0 +1,21 @@
+import type { DocumentCommentSelectionAnchor } from '@lobechat/types';
+
+import type { DocumentAiCommentMessage } from '@/database/schemas/documentAiComment';
+import { lambdaClient } from '@/libs/trpc/client';
+
+class DocumentAiCommentService {
+  create = (input: {
+    documentId: string;
+    messages: DocumentAiCommentMessage[];
+    selectionAnchor: DocumentCommentSelectionAnchor;
+  }) => lambdaClient.documentAiComment.create.mutate(input);
+
+  delete = (id: string) => lambdaClient.documentAiComment.delete.mutate({ id });
+
+  list = (documentId: string) => lambdaClient.documentAiComment.list.query({ documentId });
+
+  updateMessages = (id: string, messages: DocumentAiCommentMessage[]) =>
+    lambdaClient.documentAiComment.updateMessages.mutate({ id, messages });
+}
+
+export const documentAiCommentService = new DocumentAiCommentService();
